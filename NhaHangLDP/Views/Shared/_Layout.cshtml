@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Quản lý Nhà Hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
            background: url('/Content/images/bg-restaurant.jpg') no-repeat center center fixed;
            background-size: cover;
            position: relative;
            color: #212529;
        }
            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(255,255,255,0.85);
                z-index: -1;
            }
        .navbar {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(6px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        .navbar-brand {
            font-weight: bold;
            color: #dc7633 !important;
            font-size: 1.3rem;
        }

        .navbar-nav .nav-link {
            color: #495057 !important;
            margin-right: 15px;
            transition: 0.3s;
        }

            .navbar-nav .nav-link:hover {
                color: #dc7633 !important;
            }
        .main-container {
            margin-top: 80px;
            padding: 20px;
            min-height: calc(100vh - 80px - 70px);
            animation: fadeIn 1s ease;
        }
        footer {
            text-align: center;
            padding: 15px;
            background: rgba(255,255,255,0.9);
            border-top: 1px solid rgba(0,0,0,0.1);
            font-size: 0.9rem;
            color: #495057;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Custom SweetAlert2 Styling */
        .swal2-popup {
            font-family: 'Segoe UI', sans-serif !important;
            border-radius: 1rem !important;
        }

        .swal2-title {
            font-weight: 700 !important;
            color: #212529 !important;
        }

        .swal2-html-container {
            color: #6c757d !important;
        }

        .swal2-confirm {
            background: linear-gradient(135deg, #dc7633 0%, #c0392b 100%) !important;
            border-radius: 0.5rem !important;
            padding: 10px 25px !important;
            font-weight: 600 !important;
        }

        .swal2-cancel {
            background: #6c757d !important;
            color: white !important;
            border-radius: 0.5rem !important;
            padding: 10px 25px !important;
            font-weight: 600 !important;
        }

        .swal2-icon {
            border-width: 3px !important;
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Login","Account")">
                <i class="fa-solid fa-utensils"></i> Quản Lý Nhà Hàng
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span><i class="fa fa-bars text-dark"></i></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString("Username") != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user"></i> @Context.Session.GetString("Username")
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Dashboard", "Management")">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("LogOut", "Account")">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login","Account")">Đăng nhập</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register","Account")">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid main-container">
        @RenderBody()
    </div>

    <footer>
        © 2025 - Quản lý Nhà Hàng LDP
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Global SweetAlert Helper Functions -->
    <script>
        // Helper function for success messages
        function showSuccess(title, text) {
            Swal.fire({
                icon: 'success',
                title: title || 'Thành công!',
                text: text,
                confirmButtonText: 'Đóng',
                timer: 3000,
                timerProgressBar: true
            });
        }

        // Helper function for error messages
        function showError(title, text) {
            Swal.fire({
                icon: 'error',
                title: title || 'Có lỗi xảy ra!',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for warning messages
        function showWarning(title, text) {
            Swal.fire({
                icon: 'warning',
                title: title || 'Cảnh báo!',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for info messages
        function showInfo(title, text) {
            Swal.fire({
                icon: 'info',
                title: title || 'Thông tin',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for confirmation dialog
        function showConfirm(title, text, confirmCallback) {
            Swal.fire({
                title: title || 'Xác nhận',
                text: text,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed && confirmCallback) {
                    confirmCallback();
                }
            });
        }

        // Helper function for loading state
        function showLoading(title, text) {
            Swal.fire({
                title: title || 'Đang xử lý...',
                text: text || 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }

        // Helper function to close loading
        function closeLoading() {
            Swal.close();
        }

        // Toast notification
        function showToast(icon, title, position) {
            const Toast = Swal.mixin({
                toast: true,
                position: position || 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: icon || 'success',
                title: title
            });
        }

        // Override default alert
        window.alert = function(message) {
            Swal.fire({
                title: 'Thông báo',
                text: message,
                icon: 'info',
                confirmButtonText: 'Đóng'
            });
        };

        // Override default confirm
        window.confirm = function(message) {
            return Swal.fire({
                title: 'Xác nhận',
                text: message,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy'
            }).then((result) => result.isConfirmed);
        };
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>