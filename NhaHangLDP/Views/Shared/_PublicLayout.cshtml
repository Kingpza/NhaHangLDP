@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Nhà hàng Hỷ Lạc Hotpot</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Chatbot CSS -->
    <link href="~/Content/chatbot.css" rel="stylesheet" />

    <style>
        :root {
            --primary-golden: #F6E2A3;
            --header-orange: #C96628;
            --header-light-orange: #DB873C;
            --text-dark: #3F2C1B;
            --text-light: #ffffff;
            --price-bg: #4CAF50;
            --price-text: #ffffff;
            --food-card-border: #F6E2A3;
            --food-card-bg: #ffffff;
            --body-bg-dark: #2c2c2c;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Roboto', sans-serif;
            background-color: var(--body-bg-dark);
            color: var(--text-dark);
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

        .restaurant-header {
            background: linear-gradient(to right, var(--header-orange), var(--header-light-orange));
            text-align: center;
            padding: 2.5rem 1rem;
            border-bottom-left-radius: 50% 20px;
            border-bottom-right-radius: 50% 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            position: relative;
            z-index: 2;
        }

            .restaurant-header .brand-name {
                font-family: 'Playfair Display', serif;
                font-size: 3.2rem;
                font-weight: 700;
                color: var(--text-light);
                margin: 0;
                letter-spacing: 2px;
                text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            }

            .restaurant-header .sub-title {
                font-family: 'Roboto', sans-serif;
                font-size: 1.4rem;
                color: var(--text-light);
                opacity: 0.9;
                margin-top: 0.5rem;
                letter-spacing: 1px;
            }

        .main-menu-wrapper {
            background-color: var(--primary-golden);
            border-radius: 15px;
            padding: 30px;
            margin: -30px auto 40px auto;
            max-width: 1200px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 10;
            border: 2px solid rgba(255, 255, 255, 0.5);
            flex-grow: 1;
        }

        .main-container {
            animation: fadeIn 1s ease;
            color: var(--text-dark);
        }

            .main-container h1 {
                color: var(--header-orange) !important;
                font-family: 'Playfair Display', serif;
                font-weight: 700;
            }

            .main-container .lead {
                color: var(--text-dark);
                opacity: 0.9;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .food-card {
            background-color: var(--food-card-bg);
            border-radius: 10px;
            border: 2px solid var(--food-card-border);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            overflow: hidden;
        }

            .food-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
            }

            .food-card .card-img-top {
                border-bottom: 1px solid rgba(0,0,0,0.05);
            }

            .food-card .card-body {
                padding: 1rem;
                color: var(--text-dark);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .food-card .card-title {
                font-weight: 700;
                color: var(--text-dark);
                font-size: 1.1rem;
                margin-bottom: 0.75rem;
            }

            .food-card .card-text {
                font-weight: 700;
                font-size: 1.05rem;
                color: var(--price-bg);
                text-align: right;
                margin-top: auto;
            }

        footer {
            text-align: center;
            padding: 15px;
            background: rgba(255,255,255,0.9);
            border-top: 1px solid rgba(0,0,0,0.1);
            font-size: 0.9rem;
            color: #495057;
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>

    <header class="restaurant-header">
        <h1 class="brand-name">NHÀ HÀNG HỶ LẠC HOTPOT</h1>
        <p class="sub-title">MENU</p>
    </header>

    <div class="main-menu-wrapper">
        <div class="container main-container">
            @RenderBody()
        </div>
    </div>

    <footer>
        © 2025 - Quản lý Nhà hàng Hỷ Lạc Hotpot
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>