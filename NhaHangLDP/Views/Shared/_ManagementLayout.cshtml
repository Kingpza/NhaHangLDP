<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản Lý Nhà Hàng</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            color: #212529;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .management-sidebar {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        .sidebar-menu .nav-link {
            color: #495057;
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }

            .sidebar-menu .nav-link:hover,
            .sidebar-menu .nav-link.active {
                background: rgba(220, 118, 51, 0.1);
                border-left-color: #dc7633;
                transform: translateX(5px);
                color: #dc7633;
            }

        .main-content {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 30px;
            margin: 20px 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            min-height: calc(100vh - 40px);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
            border: 1px solid rgba(0, 0, 0, 0.1);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 15px;
        }

        .navbar-brand {
            font-weight: 700;
            color: #dc7633 !important;
        }

        .btn-custom {
            background: rgba(220, 118, 51, 0.1);
            border: 2px solid #dc7633;
            color: #dc7633;
            padding: 10px 25px;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

            .btn-custom:hover {
                background: #dc7633;
                color: #fff;
            }

        .table-custom {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

            .table-custom th {
                background: rgba(220, 118, 51, 0.2);
                border: none;
                color: #495057;
            }

            .table-custom td {
                border-color: rgba(0, 0, 0, 0.1);
                color: #495057;
            }

            .table-custom .badge {
                color: #fff !important;
            }

            .table-custom .btn {
                color: inherit !important;
            }

        /* Inventory specific styles */
        .inventory-item {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 10px;
            border-left: 4px solid #28a745;
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

            .inventory-item.low-stock {
                border-left-color: #ffc107;
            }

            .inventory-item.out-of-stock {
                border-left-color: #dc3545;
            }

        .progress-custom {
            height: 8px;
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.2);
            color: #495057;
            border-radius: 10px;
        }

            .form-select option {
                background: #fff;
                color: #495057;
            }

            .form-control:focus, .form-select:focus {
                background: rgba(255, 255, 255, 1);
                border-color: #dc7633;
                color: #495057;
                box-shadow: 0 0 0 0.2rem rgba(220, 118, 51, 0.25);
            }

            .form-control::placeholder {
                color: rgba(73, 80, 87, 0.6);
            }

        .form-label {
            color: #495057;
            font-weight: 500;
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0, 0, 0, 0.1);">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Dashboard", "Management")">
                <i class="fas fa-utensils me-2"></i>LDP Restaurant Manager
            </a>

            <div class="ms-auto d-flex align-items-center">
                <span class="me-3 text-dark"><i class="fas fa-user-circle"></i> Quản lý: @(Session["FullName"] ?? Session["Username"] ?? "Admin")</span>
                <span class="me-3 text-dark"><i class="fas fa-clock"></i> <span id="currentTime"></span></span>
                <a href="@Url.Action("LogOut", "Account")" class="btn btn-outline-danger btn-sm">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="management-sidebar">
                    <div class="text-center mb-4">
                        <h5 class="text-dark"><i class="fas fa-chart-line"></i> Bảng Điều Khiển</h5>
                    </div>
                    <ul class="nav flex-column sidebar-menu">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Management")">
                                <i class="fas fa-home me-2"></i>Tổng Quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("MenuManagement", "Management")">
                                <i class="fas fa-utensils me-2"></i>Quản Lý Thực Đơn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("TableManagement", "Management")">
                                <i class="fas fa-table me-2"></i>Quản Lý Bàn
                            </a>
                        </li>

                        <!-- Inventory Management Section -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="collapse" data-bs-target="#inventorySubmenu" aria-expanded="false">
                                <i class="fas fa-warehouse me-2"></i>Quản Lý Kho
                            </a>
                            <div class="collapse" id="inventorySubmenu">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("Inventory", "Management")">
                                            <i class="fas fa-boxes me-2"></i>Tổng Quan Kho
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("IngredientList", "Management")">
                                            <i class="fas fa-list me-2"></i>Danh Sách Nguyên Liệu
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("StockInbound", "Management")">
                                            <i class="fas fa-plus-circle me-2"></i>Nhập Kho
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("StockOutbound", "Management")">
                                            <i class="fas fa-minus-circle me-2"></i>Xuất Kho
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("DamagedStock", "Management")">
                                            <i class="fas fa-exclamation-triangle me-2"></i>Báo Cáo Hàng Hỏng
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1" href="@Url.Action("InventoryReport", "Management")">
                                            <i class="fas fa-chart-bar me-2"></i>Báo Cáo Kho
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("EmployeeManagement", "Management")">
                                <i class="fas fa-users me-2"></i>Quản Lý Nhân Viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Reports", "Management")">
                                <i class="fas fa-chart-bar me-2"></i>Báo Cáo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "ReturnManagement")">
                                <i class="fas fa-undo-alt me-2"></i>Quản Lý Trả Hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Settings")">
                                <i class="fas fa-cog me-2"></i>Cài Đặt
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9">
                <div class="main-content">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Cập nhật thời gian thực
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleString('vi-VN');
            document.getElementById('currentTime').textContent = timeString;
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Active menu highlight
        const currentPath = window.location.pathname;
        document.querySelectorAll('.sidebar-menu .nav-link').forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });
    </script>

    @RenderSection("scripts", required: false)
    <!-- Ingredient Detail Modal -->
    <div class="modal fade" id="ingredientDetailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background: rgba(255, 255, 255, 0.95); color: #333;">
                <div class="modal-header">
                    <h5 class="modal-title">Chi Tiết Nguyên Liệu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="ingredientDetailContent">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                            <p class="mt-2">Đang tải thông tin...</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <a href="#" id="editIngredientBtn" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i>Chỉnh sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>