    <!-- Global SweetAlert Helper Functions -->
    <script>
        // Helper function for success messages
        function showSuccess(title, text, callback) {
            Swal.fire({
                icon: 'success',
                title: title || 'Thành công!',
                text: text,
                confirmButtonText: 'Đóng',
                timer: 3000,
                timerProgressBar: true
            }).then((result) => {
                if (callback) callback(result);
            });
        }

        // Helper function for error messages
        function showError(title, text) {
            Swal.fire({
                icon: 'error',
                title: title || 'Có lỗi xảy ra!',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for warning messages
        function showWarning(title, text) {
            Swal.fire({
                icon: 'warning',
                title: title || 'Cảnh báo!',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for info messages
        function showInfo(title, text) {
            Swal.fire({
                icon: 'info',
                title: title || 'Thông tin',
                text: text,
                confirmButtonText: 'Đóng'
            });
        }

        // Helper function for confirmation dialog - USE THIS INSTEAD OF confirm()
        function showConfirm(title, text, confirmCallback, cancelCallback) {
            Swal.fire({
                title: title || 'Xác nhận',
                text: text,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed && confirmCallback) {
                    confirmCallback();
                } else if (result.isDismissed && cancelCallback) {
                    cancelCallback();
                }
            });
        }

        // Helper function for delete confirmation
        function showDeleteConfirm(title, text, confirmCallback) {
            Swal.fire({
                title: title || 'Xác nhận xóa',
                text: text || 'Bạn có chắc chắn muốn xóa? Hành động này không thể hoàn tác!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                confirmButtonColor: '#ef4444',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed && confirmCallback) {
                    confirmCallback();
                }
            });
        }

        // Helper function for loading state
        function showLoading(title, text) {
            Swal.fire({
                title: title || 'Đang xử lý...',
                text: text || 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }

        // Helper function to close loading
        function closeLoading() {
            Swal.close();
        }

        // Toast notification
        function showToast(icon, title, position) {
            const Toast = Swal.mixin({
                toast: true,
                position: position || 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: icon || 'success',
                title: title
            });
        }

        // KHÔNG override window.confirm vì gây bug - giữ native confirm
        // Nếu cần confirm đẹp, dùng showConfirm() hoặc Swal.fire() trực tiếp
    </script>

    <script>
        // Cập nhật thời gian thực theo định dạng tiếng Việt
        function updateTime() {
            const now = new Date();
            const options = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            };
            const dateStr = now.toLocaleDateString('vi-VN', options);
            document.getElementById('currentTime').innerHTML = `<i class="far fa-calendar-alt me-1"></i> ${dateStr}`;
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Active menu highlight
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll('.sidebar-menu .nav-link').forEach(link => {
            const href = link.getAttribute('href');
            if (href && currentPath.includes(href.toLowerCase().split('/').pop())) {
                link.classList.add('active');
                // Mở submenu nếu là item con
                const parentCollapse = link.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');
                    const parentLink = parentCollapse.previousElementSibling;
                    if (parentLink) {
                        parentLink.setAttribute('aria-expanded', 'true');
                    }
                }
            }
        });
    </script>

