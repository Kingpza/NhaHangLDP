@model NhaHangLDP.Models.KitchenDisplayViewModel
@{
    ViewBag.Title = "Kitchen Display";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Display System - Nhà Hàng LDP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .kds-header {
            background: linear-gradient(135deg, #16213e 0%, #0f3460 100%);
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #0f3460;
        }
        .kds-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .kds-logo i {
            font-size: 28px;
            color: #e94560;
        }
        .kds-logo h1 {
            font-size: 22px;
            font-weight: 700;
            margin: 0;
        }
        .kds-stats {
            display: flex;
            gap: 25px;
        }
        .kds-stat {
            text-align: center;
            padding: 8px 20px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }
        .kds-stat-value {
            font-size: 28px;
            font-weight: 700;
        }
        .kds-stat-label {
            font-size: 11px;
            text-transform: uppercase;
            opacity: 0.7;
        }
        .stat-pending .kds-stat-value { color: #ffc107; }
        .stat-preparing .kds-stat-value { color: #17a2b8; }
        .stat-ready .kds-stat-value { color: #28a745; }
        .stat-overdue .kds-stat-value { color: #dc3545; }
        
        .kds-time {
            font-size: 24px;
            font-weight: 600;
        }
        
        .kds-content {
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }
        
        .ticket-card {
            background: #16213e;
            border-radius: 15px;
            overflow: hidden;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        .ticket-card.status-pending { border-color: #ffc107; }
        .ticket-card.status-preparing { border-color: #17a2b8; }
        .ticket-card.status-ready { border-color: #28a745; }
        .ticket-card.overdue { 
            border-color: #dc3545;
            animation: pulse-border 1s infinite;
        }
        
        @@keyframes pulse-border {
            0%, 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
            50% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
        }
        
        .ticket-header {
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .ticket-table {
            font-size: 32px;
            font-weight: 700;
        }
        .ticket-code {
            background: rgba(255,255,255,0.1);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-family: monospace;
        }
        .ticket-time {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
        }
        .ticket-time.overdue { color: #dc3545; }
        .ticket-time i { font-size: 16px; }
        
        .ticket-body {
            padding: 15px 20px;
        }
        
        .ticket-item {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .ticket-item:last-child { border-bottom: none; }
        
        .item-qty {
            font-size: 24px;
            font-weight: 700;
            width: 50px;
            text-align: center;
            color: #e94560;
        }
        .item-name {
            flex: 1;
            font-size: 16px;
        }
        .item-notes {
            font-size: 12px;
            color: #ffc107;
            margin-top: 3px;
        }
        .item-status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        .item-status.pending { background: rgba(255,193,7,0.2); color: #ffc107; }
        .item-status.preparing { background: rgba(23,162,184,0.2); color: #17a2b8; }
        .item-status.completed { background: rgba(40,167,69,0.2); color: #28a745; }
        
        .ticket-footer {
            padding: 15px 20px;
            background: rgba(0,0,0,0.2);
            display: flex;
            gap: 10px;
        }
        .ticket-btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
        }
        .ticket-btn:hover { transform: translateY(-2px); }
        .btn-start {
            background: #17a2b8;
            color: white;
        }
        .btn-complete {
            background: #28a745;
            color: white;
        }
        .btn-serve {
            background: #e94560;
            color: white;
        }
        
        .priority-badge {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .priority-1 { background: #6c757d; }
        .priority-2 { background: #17a2b8; }
        .priority-3 { background: #ffc107; color: #000; }
        .priority-4 { background: #fd7e14; }
        .priority-5 { background: #dc3545; animation: blink 1s infinite; }
        
        @@keyframes blink {
            50% { opacity: 0.5; }
        }
        
        .no-tickets {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px;
            color: rgba(255,255,255,0.5);
        }
        .no-tickets i {
            font-size: 60px;
            margin-bottom: 20px;
        }
        
        .station-filter {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .station-btn {
            padding: 8px 16px;
            background: rgba(255,255,255,0.1);
            border: none;
            border-radius: 20px;
            color: white;
            cursor: pointer;
            transition: all 0.2s;
        }
        .station-btn:hover, .station-btn.active {
            background: #e94560;
        }
        
        /* Progress bar */
        .ticket-progress {
            height: 4px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            margin-top: 10px;
        }
        .ticket-progress-bar {
            height: 100%;
            background: #28a745;
            border-radius: 2px;
            transition: width 0.3s;
        }
    </style>
</head>
<body>
    <div class="kds-header">
        <div class="kds-logo">
            <i class="fas fa-fire-burner"></i>
            <div>
                <h1>Kitchen Display</h1>
                <small style="opacity: 0.7;">Nhà Hàng LDP</small>
            </div>
        </div>
        
        <div class="station-filter">
            <button class="station-btn @(string.IsNullOrEmpty(Model.CurrentStation) ? "active" : "")" onclick="filterStation('')">Tất cả</button>
            @foreach (var station in Model.Stations)
            {
                <button class="station-btn @(Model.CurrentStation == station.Code ? "active" : "")" 
                        onclick="filterStation('@station.Code')"
                        style="@(Model.CurrentStation == station.Code ? $"background: {station.DisplayColor}" : "")">
                    @station.Name
                    @if (station.PendingTicketCount + station.PreparingTicketCount > 0)
                    {
                        <span class="badge bg-danger ms-1">@(station.PendingTicketCount + station.PreparingTicketCount)</span>
                    }
                </button>
            }
        </div>
        
        <div class="kds-stats">
            <div class="kds-stat stat-pending">
                <div class="kds-stat-value" id="statPending">@Model.Stats.TotalPendingTickets</div>
                <div class="kds-stat-label">Chờ</div>
            </div>
            <div class="kds-stat stat-preparing">
                <div class="kds-stat-value" id="statPreparing">@Model.Stats.TotalPreparingTickets</div>
                <div class="kds-stat-label">Đang làm</div>
            </div>
            <div class="kds-stat stat-ready">
                <div class="kds-stat-value" id="statReady">@Model.Stats.TotalReadyTickets</div>
                <div class="kds-stat-label">Sẵn sàng</div>
            </div>
            <div class="kds-stat stat-overdue">
                <div class="kds-stat-value" id="statOverdue">@Model.Stats.OverdueTickets</div>
                <div class="kds-stat-label">Quá giờ</div>
            </div>
        </div>
        
        <div class="kds-time" id="currentTime">--:--:--</div>
    </div>
    
    <div class="kds-content" id="ticketsContainer">
        @if (Model.Tickets.Any())
        {
            foreach (var ticket in Model.Tickets)
            {
                @Html.Partial("_TicketCard", ticket)
            }
        }
        else
        {
            <div class="no-tickets">
                <i class="fas fa-check-circle"></i>
                <h3>Không có đơn hàng nào</h3>
                <p>Các đơn mới sẽ tự động hiển thị</p>
            </div>
        }
    </div>
    
    <!-- Audio for new orders -->
    <audio id="newOrderSound" preload="auto">
        <source src="@Url.Content("~/Content/sounds/new-order.mp3")" type="audio/mpeg">
    </audio>
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Update time
        function updateTime() {
            var now = new Date();
            document.getElementById('currentTime').textContent = 
                now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        setInterval(updateTime, 1000);
        updateTime();
        
        // Filter by station
        function filterStation(station) {
            window.location.href = '@Url.Action("Display", "Kitchen")' + (station ? '?station=' + station : '');
        }
        
        // Start ticket
        function startTicket(ticketId) {
            $.post('@Url.Action("StartTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) {
                    refreshDisplay();
                }
            });
        }
        
        // Complete item
        function completeItem(itemId) {
            $.post('@Url.Action("CompleteItem", "Kitchen")', { ItemId: itemId, NewStatus: 'Completed' }, function(result) {
                if (result.success) {
                    refreshDisplay();
                }
            });
        }
        
        // Complete ticket
        function completeTicket(ticketId) {
            $.post('@Url.Action("CompleteTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) {
                    refreshDisplay();
                    // Play sound
                    try { document.getElementById('newOrderSound').play(); } catch(e) {}
                }
            });
        }
        
        // Serve ticket
        function serveTicket(ticketId) {
            $.post('@Url.Action("ServeTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) {
                    refreshDisplay();
                }
            });
        }
        
        // Refresh display
        var lastTicketCount = @Model.Tickets.Count;
        function refreshDisplay() {
            $.get('@Url.Action("GetDisplayData", "Kitchen")', { station: '@Model.CurrentStation' }, function(result) {
                if (result.success) {
                    // Update stats
                    $('#statPending').text(result.data.Stats.TotalPendingTickets);
                    $('#statPreparing').text(result.data.Stats.TotalPreparingTickets);
                    $('#statReady').text(result.data.Stats.TotalReadyTickets);
                    $('#statOverdue').text(result.data.Stats.OverdueTickets);
                    
                    // Check for new orders
                    if (result.data.Tickets.length > lastTicketCount) {
                        try { document.getElementById('newOrderSound').play(); } catch(e) {}
                    }
                    lastTicketCount = result.data.Tickets.length;
                    
                    // Refresh page for simplicity
                    location.reload();
                }
            });
        }
        
        // Auto refresh every 10 seconds
        setInterval(refreshDisplay, 10000);
        
        // Update waiting times
        function updateWaitingTimes() {
            $('.ticket-time[data-created]').each(function() {
                var created = new Date($(this).data('created'));
                var now = new Date();
                var minutes = Math.floor((now - created) / 60000);
                $(this).find('.wait-time').text(minutes + ' phút');
            });
        }
        setInterval(updateWaitingTimes, 30000);
    </script>
</body>
</html>
