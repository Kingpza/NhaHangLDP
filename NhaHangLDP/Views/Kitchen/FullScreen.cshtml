@model NhaHangLDP.Models.KitchenDisplayViewModel
@{
    ViewBag.Title = "Kitchen Display - Full Screen";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Display System - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            height: 100%;
            overflow: hidden;
        }
        body {
            background: #0f0f23;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
        }
        .kds-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .kds-header {
            background: linear-gradient(135deg, #1a1a3e 0%, #2d2d5a 100%);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #e94560;
            flex-shrink: 0;
        }
        .kds-logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .kds-logo i {
            font-size: 36px;
            color: #e94560;
        }
        .kds-logo h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }
        .kds-logo small {
            font-size: 12px;
            color: rgba(255,255,255,0.6);
        }
        .kds-stats {
            display: flex;
            gap: 40px;
        }
        .kds-stat {
            text-align: center;
        }
        .kds-stat-value {
            font-size: 48px;
            font-weight: 800;
            line-height: 1;
        }
        .kds-stat-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.7;
            margin-top: 5px;
        }
        .stat-pending .kds-stat-value { color: #fbbf24; }
        .stat-preparing .kds-stat-value { color: #60a5fa; }
        .stat-ready .kds-stat-value { color: #34d399; }
        .stat-overdue .kds-stat-value { color: #f87171; }
        
        .kds-time {
            font-size: 48px;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }
        
        .kds-content {
            flex: 1;
            padding: 25px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 25px;
            overflow-y: auto;
            align-content: start;
        }
        
        .ticket-card {
            background: linear-gradient(145deg, #1e1e3f 0%, #2a2a52 100%);
            border-radius: 20px;
            overflow: hidden;
            border: 3px solid transparent;
            transition: all 0.3s ease;
        }
        .ticket-card.status-pending { border-color: #fbbf24; }
        .ticket-card.status-preparing { border-color: #60a5fa; }
        .ticket-card.status-ready { border-color: #34d399; box-shadow: 0 0 30px rgba(52,211,153,0.3); }
        .ticket-card.overdue { 
            border-color: #f87171;
            animation: overdue-pulse 1s infinite;
        }
        
        @@keyframes overdue-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.4); }
            50% { box-shadow: 0 0 30px 10px rgba(248, 113, 113, 0.2); }
        }
        
        .ticket-header {
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0,0,0,0.2);
        }
        .ticket-table {
            font-size: 42px;
            font-weight: 800;
        }
        .ticket-meta {
            text-align: right;
        }
        .ticket-code {
            background: rgba(255,255,255,0.1);
            padding: 5px 15px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 14px;
        }
        .ticket-time {
            margin-top: 8px;
            font-size: 18px;
            font-weight: 600;
        }
        .ticket-time.overdue { color: #f87171; }
        .ticket-time i { margin-right: 8px; }
        
        .ticket-body {
            padding: 20px 25px;
        }
        
        .ticket-item {
            display: flex;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .ticket-item:last-child { border-bottom: none; }
        
        .item-qty {
            font-size: 32px;
            font-weight: 800;
            width: 60px;
            text-align: center;
            color: #e94560;
        }
        .item-name {
            flex: 1;
            font-size: 20px;
            font-weight: 500;
        }
        .item-notes {
            font-size: 14px;
            color: #fbbf24;
            margin-top: 5px;
        }
        .item-status {
            padding: 8px 15px;
            border-radius: 25px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .item-status.pending { background: rgba(251,191,36,0.2); color: #fbbf24; }
        .item-status.preparing { background: rgba(96,165,250,0.2); color: #60a5fa; }
        .item-status.completed { background: rgba(52,211,153,0.2); color: #34d399; }
        
        .ticket-footer {
            padding: 20px 25px;
            background: rgba(0,0,0,0.3);
            display: flex;
            gap: 15px;
        }
        .ticket-btn {
            flex: 1;
            padding: 18px;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 18px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s;
        }
        .ticket-btn:hover { transform: scale(1.02); }
        .btn-start { background: #60a5fa; color: white; }
        .btn-complete { background: #34d399; color: #0f0f23; }
        .btn-serve { background: #e94560; color: white; }
        
        .priority-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .priority-1 { background: rgba(100,116,139,0.3); color: #94a3b8; }
        .priority-2 { background: rgba(96,165,250,0.3); color: #60a5fa; }
        .priority-3 { background: rgba(251,191,36,0.3); color: #fbbf24; }
        .priority-4 { background: rgba(251,146,60,0.3); color: #fb923c; }
        .priority-5 { background: rgba(248,113,113,0.3); color: #f87171; animation: blink 0.5s infinite; }
        
        @@keyframes blink { 50% { opacity: 0.5; } }
        
        .ticket-progress {
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 3px;
            margin-top: 15px;
            overflow: hidden;
        }
        .ticket-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #34d399 0%, #22d3ee 100%);
            border-radius: 3px;
            transition: width 0.5s ease;
        }
        
        .no-tickets {
            grid-column: 1 / -1;
            text-align: center;
            padding: 100px;
            color: rgba(255,255,255,0.3);
        }
        .no-tickets i { font-size: 100px; margin-bottom: 30px; }
        .no-tickets h2 { font-size: 36px; }
        
        /* Scrollbar */
        .kds-content::-webkit-scrollbar { width: 8px; }
        .kds-content::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        .kds-content::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    </style>
</head>
<body>
    <div class="kds-container">
        <div class="kds-header">
            <div class="kds-logo">
                <i class="fas fa-fire-burner"></i>
                <div>
                    <h1>KITCHEN DISPLAY</h1>
                    <small>Nhà hàng Hỷ Lạc Hotpot</small>
                </div>
            </div>
            
            <div class="kds-stats">
                <div class="kds-stat stat-pending">
                    <div class="kds-stat-value" id="statPending">@Model.Stats.TotalPendingTickets</div>
                    <div class="kds-stat-label">Chờ</div>
                </div>
                <div class="kds-stat stat-preparing">
                    <div class="kds-stat-value" id="statPreparing">@Model.Stats.TotalPreparingTickets</div>
                    <div class="kds-stat-label">Đang làm</div>
                </div>
                <div class="kds-stat stat-ready">
                    <div class="kds-stat-value" id="statReady">@Model.Stats.TotalReadyTickets</div>
                    <div class="kds-stat-label">Sẵn sàng</div>
                </div>
                <div class="kds-stat stat-overdue">
                    <div class="kds-stat-value" id="statOverdue">@Model.Stats.OverdueTickets</div>
                    <div class="kds-stat-label">Quá giờ</div>
                </div>
            </div>
            
            <div class="kds-time" id="currentTime">--:--:--</div>
        </div>
        
        <div class="kds-content" id="ticketsContainer">
            @if (Model.Tickets.Any())
            {
                foreach (var ticket in Model.Tickets)
                {
                    <div class="ticket-card status-@ticket.Status.ToLower() @(ticket.IsOverdue ? "overdue" : "")">
                        <div class="ticket-header">
                            <span class="ticket-table">@ticket.TableNumber</span>
                            <div class="ticket-meta">
                                <span class="ticket-code">@ticket.TicketCode</span>
                                <div class="ticket-time @(ticket.IsOverdue ? "overdue" : "")">
                                    <i class="far fa-clock"></i>@ticket.WaitingMinutes phút
                                    @if (ticket.IsOverdue)
                                    {
                                        <i class="fas fa-exclamation-triangle ms-2"></i>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="ticket-body">
                            @foreach (var item in ticket.Items)
                            {
                                <div class="ticket-item">
                                    <div class="item-qty">@item.Quantity</div>
                                    <div class="flex-grow-1">
                                        <div class="item-name">@item.ItemName</div>
                                        @if (!string.IsNullOrEmpty(item.CustomerNotes))
                                        {
                                            <div class="item-notes">
                                                <i class="fas fa-sticky-note me-1"></i>@item.CustomerNotes
                                            </div>
                                        }
                                    </div>
                                    @if (ticket.Status == "Preparing")
                                    {
                                        <button class="btn @(item.IsCompleted ? "btn-success" : "btn-outline-light")" 
                                                onclick="completeItem(@item.Id)" 
                                                style="width: 50px; height: 50px; border-radius: 50%;"
                                                @(item.IsCompleted ? "disabled" : "")>
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="item-status @item.Status.ToLower()">@item.StatusText</span>
                                    }
                                </div>
                            }
                            
                            @if (ticket.Status == "Preparing")
                            {
                                <div class="ticket-progress">
                                    <div class="ticket-progress-bar" style="width: @ticket.ProgressPercent%"></div>
                                </div>
                            }
                        </div>
                        
                        <div class="ticket-footer">
                            @switch (ticket.Status.ToLower())
                            {
                                case "pending":
                                    <button class="ticket-btn btn-start" onclick="startTicket(@ticket.Id)">
                                        <i class="fas fa-play me-2"></i>Bắt đầu
                                    </button>
                                    break;
                                case "preparing":
                                    <button class="ticket-btn btn-complete" onclick="completeTicket(@ticket.Id)">
                                        <i class="fas fa-check me-2"></i>Hoàn thành
                                    </button>
                                    break;
                                case "ready":
                                    <button class="ticket-btn btn-serve" onclick="serveTicket(@ticket.Id)">
                                        <i class="fas fa-utensils me-2"></i>Đã phục vụ
                                    </button>
                                    break;
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-tickets">
                    <i class="fas fa-check-circle"></i>
                    <h2>Không có đơn hàng</h2>
                    <p>Đơn mới sẽ tự động hiển thị</p>
                </div>
            }
        </div>
    </div>
    
    <audio id="newOrderSound" preload="auto">
        <source src="@Url.Content("~/Content/sounds/new-order.mp3")" type="audio/mpeg">
    </audio>
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function updateTime() {
            var now = new Date();
            document.getElementById('currentTime').textContent = 
                now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        setInterval(updateTime, 1000);
        updateTime();
        
        function startTicket(ticketId) {
            $.post('@Url.Action("StartTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) location.reload();
            });
        }
        
        function completeItem(itemId) {
            $.post('@Url.Action("CompleteItem", "Kitchen")', { ItemId: itemId }, function(result) {
                if (result.success) location.reload();
            });
        }
        
        function completeTicket(ticketId) {
            $.post('@Url.Action("CompleteTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) {
                    try { document.getElementById('newOrderSound').play(); } catch(e) {}
                    location.reload();
                }
            });
        }
        
        function serveTicket(ticketId) {
            $.post('@Url.Action("ServeTicket", "Kitchen")', { ticketId: ticketId }, function(result) {
                if (result.success) location.reload();
            });
        }
        
        // Auto refresh every 10 seconds
        setInterval(function() { location.reload(); }, 10000);
        
        // Request fullscreen on load
        document.addEventListener('click', function() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {});
            }
        }, { once: true });
    </script>
</body>
</html>
