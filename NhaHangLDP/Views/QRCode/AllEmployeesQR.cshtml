@model List<NhaHangLDP.Controllers.EmployeeQRViewModel>
@{
    ViewBag.Title = "QR Code Nhân Viên";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        /* Stats Cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        .stat-card {
            background: #fff;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .stat-icon.blue { background: #dbeafe; color: #2563eb; }
        .stat-icon.green { background: #dcfce7; color: #16a34a; }
        .stat-icon.purple { background: #f3e8ff; color: #9333ea; }
        .stat-info h3 { margin: 0; font-size: 28px; font-weight: 700; color: #1e3a5f; }
        .stat-info p { margin: 0; color: #64748b; font-size: 14px; }

        /* Filter Card */
        .filter-card {
            background: #fff;
            border-radius: 15px;
            padding: 20px 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }

        /* Employee Grid */
        .employee-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }
        .employee-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            border: 1px solid #e2e8f0;
        }
        .employee-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .employee-card-header {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);
            color: white;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .employee-avatar {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 700;
        }
        .employee-info h4 {
            margin: 0 0 5px 0;
            font-size: 16px;
            font-weight: 600;
        }
        .employee-info .emp-code {
            font-size: 12px;
            background: rgba(255,255,255,0.2);
            padding: 4px 12px;
            border-radius: 15px;
            display: inline-block;
        }
        .employee-info .emp-role {
            font-size: 12px;
            opacity: 0.8;
            margin-top: 5px;
        }
        .employee-card-body {
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .employee-card-body img {
            width: 120px;
            height: 120px;
            border-radius: 12px;
            border: 3px solid #1e3a5f;
        }
        .employee-details {
            flex: 1;
            font-size: 13px;
        }
        .employee-details .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px dashed #e2e8f0;
        }
        .employee-details .detail-row:last-child {
            border-bottom: none;
        }
        .employee-details .detail-row span:first-child {
            color: #64748b;
        }
        .employee-details .detail-row span:last-child {
            font-weight: 500;
            color: #1e3a5f;
        }
        .employee-card-footer {
            padding: 15px 20px;
            background: #f8fafc;
            display: flex;
            gap: 10px;
            justify-content: center;
            border-top: 1px solid #e2e8f0;
        }
        .btn-sm-action {
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s;
        }
        .btn-view { background: #dbeafe; color: #2563eb; }
        .btn-view:hover { background: #2563eb; color: #fff; }
        .btn-download { background: #dcfce7; color: #16a34a; }
        .btn-download:hover { background: #16a34a; color: #fff; }

        /* Print Styles */
        .print-all-container { display: none; }
        @@media print {
            body * { visibility: hidden; }
            .print-all-container, .print-all-container * { visibility: visible; }
            .print-all-container {
                display: block !important;
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .id-card {
                width: 85.6mm;
                height: 53.98mm;
                border: 2px solid #1e3a5f;
                border-radius: 10px;
                padding: 15px;
                margin: 10px;
                display: inline-block;
                page-break-inside: avoid;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="fas fa-id-card me-2"></i>QR Code Nhân Viên</h2>
            <p class="mb-0">Quản lý thẻ QR check-in cho nhân viên</p>
        </div>
        <div>
            <a href="@Url.Action("CheckInScanner", "QRCode")" class="btn btn-success me-2">
                <i class="fas fa-camera me-2"></i>Quét Check-in
            </a>
            <button class="btn btn-light" onclick="window.print()">
                <i class="fas fa-print me-2"></i>In tất cả thẻ
            </button>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-info">
            <h3>@Model.Count</h3>
            <p>Tổng nhân viên</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-id-card"></i>
        </div>
        <div class="stat-info">
            <h3>@Model.Count</h3>
            <p>Thẻ QR đã tạo</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-info">
            <h3>@Model.Select(m => m.Employee.Role?.RoleName).Where(r => r != null).Distinct().Count()</h3>
            <p>Chức vụ</p>
        </div>
    </div>
</div>

<!-- Filter Card -->
<div class="filter-card">
    <div class="row align-items-center">
        <div class="col-md-4">
            <label class="form-label">Lọc theo chức vụ</label>
            <select class="form-select" id="roleFilter" onchange="filterByRole(this.value)">
                <option value="">Tất cả chức vụ</option>
                @foreach (var role in Model.Select(m => m.Employee.Role?.RoleName).Where(r => r != null).Distinct())
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Tìm kiếm</label>
            <input type="text" class="form-control" id="searchInput" placeholder="Nhập tên hoặc mã NV..." onkeyup="searchEmployee(this.value)">
        </div>
        <div class="col-md-4 text-end">
            <label class="form-label d-block">&nbsp;</label>
            <span class="text-muted">Hiển thị: <strong id="visibleCount">@Model.Count</strong> nhân viên</span>
        </div>
    </div>
</div>

<!-- Employee Grid -->
<div class="employee-grid" id="employeeGrid">
    @foreach (var item in Model)
    {
        var initials = string.Join("", item.Employee.FullName.Split(' ').Where(s => !string.IsNullOrEmpty(s)).Select(s => s[0]));
        <div class="employee-card" data-role="@item.Employee.Role?.RoleName" data-name="@item.Employee.FullName" data-code="@item.EmployeeCode">
            <div class="employee-card-header">
                <div class="employee-avatar">@initials</div>
                <div class="employee-info">
                    <h4>@item.Employee.FullName</h4>
                    <span class="emp-code">@item.EmployeeCode</span>
                    <div class="emp-role">@item.Employee.Role?.RoleName</div>
                </div>
            </div>
            <div class="employee-card-body">
                <img src="@item.QRCode.DataUrl" alt="QR Code">
                <div class="employee-details">
                    <div class="detail-row">
                        <span>Email:</span>
                        <span>@(item.Employee.Email ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span>SĐT:</span>
                        <span>@(item.Employee.PhoneNumber ?? "N/A")</span>
                    </div>
                    <div class="detail-row">
                        <span>Ngày vào:</span>
                        <span>@item.Employee.HireDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="employee-card-footer">
                <a href="@Url.Action("EmployeeQR", "QRCode", new { employeeId = item.Employee.Id })" class="btn-sm-action btn-view">
                    <i class="fas fa-eye"></i> Xem
                </a>
                <a href="@Url.Action("EmployeeQRImage", "QRCode", new { employeeId = item.Employee.Id })" 
                   class="btn-sm-action btn-download" download="QR_NV_@(item.EmployeeCode).png">
                    <i class="fas fa-download"></i> Tải
                </a>
            </div>
        </div>
    }
</div>

<!-- Print All ID Cards -->
<div class="print-all-container">
    @foreach (var item in Model)
    {
        <div class="id-card" style="font-family: Arial, sans-serif;">
            <div style="display: flex; align-items: center; margin-bottom: 10px;">
                <div style="flex: 1;">
                    <h3 style="margin: 0; font-size: 14px; color: #1e3a5f;">NHÀ HÀNG HỶ LẠC HOTPOT</h3>
                    <p style="margin: 5px 0 0 0; font-size: 10px; color: #666;">Employee ID Card</p>
                </div>
                <img src="@item.QRCode.DataUrl" alt="QR" style="width: 60px; height: 60px;">
            </div>
            <div style="border-top: 1px solid #e0e0e0; padding-top: 10px;">
                <h2 style="margin: 0 0 5px 0; font-size: 16px; color: #333;">@item.Employee.FullName</h2>
                <p style="margin: 0; font-size: 11px; color: #1e3a5f; font-weight: bold;">@item.EmployeeCode</p>
                <p style="margin: 5px 0 0 0; font-size: 10px; color: #666;">@item.Employee.Role?.RoleName</p>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function filterByRole(role) {
            const cards = document.querySelectorAll('.employee-card');
            let visibleCount = 0;
            cards.forEach(card => {
                if (!role || card.dataset.role === role) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            document.getElementById('visibleCount').textContent = visibleCount;
        }

        function searchEmployee(keyword) {
            const cards = document.querySelectorAll('.employee-card');
            keyword = keyword.toLowerCase();
            let visibleCount = 0;
            cards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                const code = card.dataset.code.toLowerCase();
                if (name.includes(keyword) || code.includes(keyword)) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            document.getElementById('visibleCount').textContent = visibleCount;
        }
    </script>
}
