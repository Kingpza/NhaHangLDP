
@{
    ViewBag.Title = "Báo Cáo & Thống Kê";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<style>
    .reports-dashboard {
        padding: 0;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        backdrop-filter: blur(10px);
        text-align: center;
    }

    .reports-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .report-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        backdrop-filter: blur(10px);
        min-height: 200px;
        display: flex;
        flex-direction: column;
    }

        .report-card:hover {
            transform: translateY(-5px);
            border-color: #ffcc00;
            box-shadow: 0 15px 35px rgba(255, 204, 0, 0.3);
        }

    .report-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 1.8rem;
        color: #333;
    }

    .report-card.bill-details .report-icon {
        background: linear-gradient(135deg, #28a745, #20c997);
    }

    .report-card.booking-stats .report-icon {
        background: linear-gradient(135deg, #17a2b8, #6f42c1);
    }

    .report-card.sales-performance .report-icon {
        background: linear-gradient(135deg, #ffc107, #fd7e14);
    }

    .report-card.revenue .report-icon {
        background: linear-gradient(135deg, #dc3545, #e83e8c);
    }

    .report-card.profit .report-icon {
        background: linear-gradient(135deg, #6f42c1, #e83e8c);
    }

    .report-card.dish-ranking .report-icon {
        background: linear-gradient(135deg, #fd7e14, #ffcc00);
    }

    .report-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 10px;
        text-align: center;
    }

    .report-desc {
        color: #adb5bd;
        line-height: 1.5;
        text-align: center;
        font-size: 0.95rem;
        flex: 1;
    }

    .report-features {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .feature-item {
        color: #ffcc00;
        font-size: 0.85rem;
        margin-bottom: 5px;
    }

        .feature-item i {
            margin-right: 8px;
            width: 12px;
        }

    .quick-actions {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .action-btn {
        background: rgba(255, 204, 0, 0.2);
        border: 2px solid rgba(255, 204, 0, 0.5);
        color: #ffcc00;
        border-radius: 8px;
        padding: 10px 20px;
        margin: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        font-weight: 500;
    }

        .action-btn:hover {
            background: #ffcc00;
            color: #333;
            border-color: #ffcc00;
            text-decoration: none;
        }

    .stats-overview {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .stat-box {
        text-align: center;
        padding: 15px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #adb5bd;
    }
</style>

<div class="reports-dashboard">
    <!-- Page Header -->
    <div class="page-header">
        <h2 class="text-warning mb-2">
            <i class="fas fa-chart-line me-3"></i>Báo Cáo & Thống Kê
        </h2>
        <p class="text-light mb-0">Phân tích dữ liệu kinh doanh và theo dõi hiệu suất nhà hàng lẩu</p>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h5 class="text-warning mb-3">
            <i class="fas fa-bolt me-2"></i>Truy cập nhanh
        </h5>
        <a href="@Url.Action("BillDetails", "Reports")" class="action-btn">
            <i class="fas fa-receipt me-1"></i>Báo cáo hôm nay
        </a>
        <a href="@Url.Action("Revenue", "Reports", new { period = "month" })" class="action-btn">
            <i class="fas fa-calendar-alt me-1"></i>Doanh thu tháng
        </a>
        <a href="@Url.Action("DishRanking", "Reports")" class="action-btn">
            <i class="fas fa-trophy me-1"></i>Món bán chạy
        </a>
        <a href="@Url.Action("ProfitByDish", "Reports")" class="action-btn">
            <i class="fas fa-coins me-1"></i>Lợi nhuận
        </a>
    </div>

    <!-- Stats Overview -->
    <div class="stats-overview">
        <h5 class="text-warning mb-3">
            <i class="fas fa-chart-bar me-2"></i>Tổng quan hôm nay
        </h5>
        <div class="stat-row">
            <div class="stat-box">
                <div class="stat-number">44</div>
                <div class="stat-label">Đơn hàng</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">3.2M</div>
                <div class="stat-label">Doanh thu (VNĐ)</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">89%</div>
                <div class="stat-label">Tỷ lệ bàn</div>
            </div>
            <div class="stat-box">
                <div class="stat-number">73K</div>
                <div class="stat-label">Đơn TB (VNĐ)</div>
            </div>
        </div>
    </div>

    <!-- Reports Grid -->
    <div class="reports-grid">
        <!-- Bill Details Report -->
        <div class="report-card bill-details" onclick="navigateToReport('@Url.Action("BillDetails", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div class="report-title">Báo Cáo Chi Tiết Bill</div>
            <div class="report-desc">
                Xem chi tiết từng hóa đơn, thông tin khách hàng, món ăn đã order và phương thức thanh toán
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Lọc theo ngày, trạng thái
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Xuất Excel, PDF
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Tìm kiếm nhanh
                </div>
            </div>
        </div>

        <!-- Booking Statistics -->
        <div class="report-card booking-stats" onclick="navigateToReport('@Url.Action("BookingStats", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="report-title">Thống Kê Đặt Bàn</div>
            <div class="report-desc">
                Phân tích xu hướng đặt bàn theo thời gian, giờ cao điểm và tỷ lệ sử dụng bàn
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Giờ cao điểm
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Tỷ lệ sử dụng bàn
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Biểu đồ trực quan
                </div>
            </div>
        </div>

        <!-- Sales Performance -->
        <div class="report-card sales-performance" onclick="navigateToReport('@Url.Action("SalesPerformance", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="report-title">Hiệu Suất Bán Hàng</div>
            <div class="report-desc">
                Theo dõi hiệu suất bán hàng theo nhân viên, ca làm việc và đánh giá KPI
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Theo dõi KPI
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>So sánh nhân viên
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Xu hướng theo giờ
                </div>
            </div>
        </div>

        <!-- Revenue Report -->
        <div class="report-card revenue" onclick="navigateToReport('@Url.Action("Revenue", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <div class="report-title">Báo Cáo Doanh Thu</div>
            <div class="report-desc">
                Phân tích doanh thu theo ngày, tháng, năm với biểu đồ chi tiết và so sánh kỳ trước
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Theo ngày/tháng/năm
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>So sánh kỳ trước
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Dự báo xu hướng
                </div>
            </div>
        </div>

        <!-- Profit by Dish -->
        <div class="report-card profit" onclick="navigateToReport('@Url.Action("ProfitByDish", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-coins"></i>
            </div>
            <div class="report-title">Lợi Nhuận Theo Món</div>
            <div class="report-desc">
                Tính toán lợi nhuận sau khi trừ chi phí nguyên liệu, xác định món ăn có lãi cao nhất
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Chi phí nguyên liệu
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Tỷ lệ lợi nhuận
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Ranking theo lãi
                </div>
            </div>
        </div>

        <!-- Dish Ranking -->
        <div class="report-card dish-ranking" onclick="navigateToReport('@Url.Action("DishRanking", "Reports")')">
            <div class="report-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="report-title">Món Ăn Bán Chạy</div>
            <div class="report-desc">
                Xếp hạng món ăn theo số lượng bán, doanh thu và đánh giá khách hàng
            </div>
            <div class="report-features">
                <div class="feature-item">
                    <i class="fas fa-check"></i>Top bán chạy
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Món ít bán
                </div>
                <div class="feature-item">
                    <i class="fas fa-check"></i>Đánh giá khách hàng
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>function navigateToReport(url) {
        window.location.href = url;
    }

    // Add some interactive effects
    document.querySelectorAll('.report-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-10px) scale(1.02)';
        });

        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    });</script>
}