@{
    ViewBag.Title = "Báo Cáo Hiệu Suất Bán Hàng";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<style>
    .performance-container {
        padding: 0;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
    }

    .filter-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 204, 0, 0.3);
        color: #fff;
        border-radius: 8px;
        padding: 10px 12px;
    }

    .form-control:focus, .form-select:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #ffcc00;
        color: #fff;
        box-shadow: 0 0 0 0.2rem rgba(255, 204, 0, 0.25);
    }

    .kpi-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .kpi-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 20px;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }

    .kpi-card.revenue::before { background: linear-gradient(135deg, #28a745, #20c997); }
    .kpi-card.orders::before { background: linear-gradient(135deg, #17a2b8, #6f42c1); }
    .kpi-card.avg-order::before { background: linear-gradient(135deg, #ffc107, #fd7e14); }
    .kpi-card.efficiency::before { background: linear-gradient(135deg, #dc3545, #e83e8c); }

    .kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 1.3rem;
        color: #333;
    }

    .kpi-card.revenue .kpi-icon { background: linear-gradient(135deg, #28a745, #20c997); }
    .kpi-card.orders .kpi-icon { background: linear-gradient(135deg, #17a2b8, #6f42c1); }
    .kpi-card.avg-order .kpi-icon { background: linear-gradient(135deg, #ffc107, #fd7e14); }
    .kpi-card.efficiency .kpi-icon { background: linear-gradient(135deg, #dc3545, #e83e8c); }

    .kpi-value {
        font-size: 1.6rem;
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 8px;
    }

    .kpi-label {
        font-size: 0.9rem;
        color: #adb5bd;
        margin-bottom: 8px;
    }

    .kpi-change {
        font-size: 0.8rem;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 12px;
    }

    .change-positive {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
    }

    .change-negative {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
    }

    .performance-charts {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .chart-container {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 25px;
        backdrop-filter: blur(10px);
        min-height: 400px;
    }

    .cashier-ranking {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
    }

    .cashier-list {
        margin-top: 15px;
    }

    .cashier-item {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

    .cashier-rank {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #333;
        margin-right: 15px;
    }

    .cashier-rank.rank-1 { background: linear-gradient(135deg, #FFD700, #FFA500); }
    .cashier-rank.rank-2 { background: linear-gradient(135deg, #C0C0C0, #A8A8A8); }
    .cashier-rank.rank-3 { background: linear-gradient(135deg, #CD7F32, #B8860B); }
    .cashier-rank.rank-other { background: rgba(255, 204, 0, 0.3); color: #ffcc00; }

    .cashier-info {
        flex: 1;
    }

    .cashier-name {
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 3px;
    }

    .cashier-stats {
        color: #adb5bd;
        font-size: 0.9rem;
    }

    .cashier-performance {
        text-align: right;
    }

    .cashier-revenue {
        font-weight: bold;
        color: #28a745;
        margin-bottom: 3px;
    }

    .cashier-orders {
        color: #adb5bd;
        font-size: 0.9rem;
    }

    .hourly-performance {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }

    .hourly-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .hourly-item {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        padding: 12px;
        text-align: center;
        position: relative;
    }

    .hourly-time {
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 8px;
    }

    .hourly-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        margin-bottom: 8px;
        overflow: hidden;
    }

    .hourly-fill {
        height: 100%;
        background: linear-gradient(135deg, #28a745, #20c997);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .hourly-value {
        font-size: 0.8rem;
        color: #adb5bd;
    }

    .btn-filter {
        background: linear-gradient(135deg, #ffcc00, #ff9900);
        border: none;
        color: #333;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-filter:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(255, 204, 0, 0.4);
        color: #333;
    }

    .export-section {
        text-align: right;
        margin-bottom: 15px;
    }

    .btn-export {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 204, 0, 0.5);
        color: #ffcc00;
        padding: 8px 15px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        margin-left: 10px;
        transition: all 0.3s ease;
    }

    .btn-export:hover {
        background: #ffcc00;
        color: #333;
        text-decoration: none;
    }

    .loading {
        text-align: center;
        padding: 40px;
        color: #adb5bd;
    }

    @@media (max-width: 968px) {
        .performance-charts {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="performance-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h4 class="text-warning mb-1">
                    <i class="fas fa-chart-line me-2"></i>Báo Cáo Hiệu Suất Bán Hàng
                </h4>
                <small class="text-muted">Theo dõi hiệu suất bán hàng theo nhân viên và đánh giá KPI</small>
            </div>
            <div class="col-md-4 text-end">
                <a href="@Url.Action("Dashboard", "Reports")" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section">
        <h6 class="text-warning mb-3">
            <i class="fas fa-filter me-2"></i>Bộ lọc thời gian
        </h6>
        <form id="filterForm">
            <div class="filter-row">
                <div>
                    <label class="form-label text-light">Từ ngày:</label>
                    <input type="date" class="form-control" id="fromDate" value="@ViewBag.FromDate">
                </div>
                <div>
                    <label class="form-label text-light">Đến ngày:</label>
                    <input type="date" class="form-control" id="toDate" value="@ViewBag.ToDate">
                </div>
                <div>
                    <label class="form-label text-light">Ca làm việc:</label>
                    <select class="form-select" id="shiftFilter">
                        <option value="all">Tất cả ca</option>
                        <option value="morning">Ca sáng (06:00-14:00)</option>
                        <option value="afternoon">Ca chiều (14:00-22:00)</option>
                        <option value="night">Ca tối (22:00-06:00)</option>
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button type="button" class="btn btn-filter" onclick="loadPerformanceData()">
                        <i class="fas fa-search me-1"></i>Phân tích
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-cards" id="kpiCards">
        <div class="kpi-card revenue">
            <div class="kpi-icon">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="kpi-value" id="totalRevenue">-</div>
            <div class="kpi-label">Tổng doanh thu</div>
            <div class="kpi-change change-positive" id="revenueChange">-</div>
        </div>
        <div class="kpi-card orders">
            <div class="kpi-icon">
                <i class="fas fa-receipt"></i>
            </div>
            <div class="kpi-value" id="totalOrders">-</div>
            <div class="kpi-label">Tổng đơn hàng</div>
            <div class="kpi-change change-positive" id="ordersChange">-</div>
        </div>
        <div class="kpi-card avg-order">
            <div class="kpi-icon">
                <i class="fas fa-calculator"></i>
            </div>
            <div class="kpi-value" id="avgOrderValue">-</div>
            <div class="kpi-label">Giá trị TB/đơn</div>
            <div class="kpi-change change-positive" id="avgChange">-</div>
        </div>
        <div class="kpi-card efficiency">
            <div class="kpi-icon">
                <i class="fas fa-tachometer-alt"></i>
            </div>
            <div class="kpi-value" id="efficiency">-</div>
            <div class="kpi-label">Hiệu suất</div>
            <div class="kpi-change change-positive" id="efficiencyChange">-</div>
        </div>
    </div>

    <!-- Performance Charts -->
    <div class="performance-charts">
        <!-- Daily Performance Chart -->
        <div class="chart-container">
            <div class="export-section">
                <a href="#" class="btn-export" onclick="exportPerformanceChart()">
                    <i class="fas fa-download me-1"></i>Xuất biểu đồ
                </a>
            </div>
            <h6 class="text-warning mb-3">
                <i class="fas fa-chart-area me-2"></i>Hiệu suất theo ngày
            </h6>
            <div id="performanceChart">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                    <p>Đang tải biểu đồ...</p>
                </div>
            </div>
        </div>

        <!-- Top Cashiers -->
        <div class="cashier-ranking">
            <h6 class="text-warning mb-3">
                <i class="fas fa-trophy me-2"></i>Bảng xếp hạng thu ngân
            </h6>
            <div class="cashier-list" id="cashierList">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                    <p>Đang tải dữ liệu...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Hourly Performance -->
    <div class="hourly-performance">
        <h6 class="text-warning mb-3">
            <i class="fas fa-clock me-2"></i>Hiệu suất theo giờ
        </h6>
        <div class="hourly-grid" id="hourlyGrid">
            <div class="loading">
                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                <p>Đang tải dữ liệu...</p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    var performanceChart = null;

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        loadPerformanceData();
    });

    function loadPerformanceData() {
        var fromDate = document.getElementById('fromDate').value;
        var toDate = document.getElementById('toDate').value;

        // Show loading
        showLoading();

        // Make AJAX request
        fetch('@Url.Action("GetSalesPerformanceData", "Reports")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'fromDate=' + fromDate + '&toDate=' + toDate
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                updateKpiCards(data.data);
                renderPerformanceChart(data.data);
                renderCashierRanking(data.data);
                renderHourlyPerformance(data.data);
            } else {
                showError('Lỗi khi tải dữ liệu: ' + data.message);
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            showError('Có lỗi xảy ra khi tải dữ liệu!');
        });
    }

    function showLoading() {
        document.getElementById('performanceChart').innerHTML = getLoadingHTML();
        document.getElementById('cashierList').innerHTML = getLoadingHTML();
        document.getElementById('hourlyGrid').innerHTML = getLoadingHTML();
    }

    function getLoadingHTML() {
        return `
            <div class="loading">
                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                <p>Đang tải dữ liệu...</p>
            </div>
        `;
    }

    function updateKpiCards(data) {
        document.getElementById('totalRevenue').textContent =
            (data.TotalRevenue / 1000000).toFixed(1) + 'M VNĐ';
        document.getElementById('totalOrders').textContent = data.TotalOrders.toLocaleString();
        document.getElementById('avgOrderValue').textContent =
            (data.AverageOrderValue / 1000).toFixed(0) + 'K VNĐ';

        // Calculate efficiency (orders per hour)
        var efficiency = (data.TotalOrders / 8).toFixed(1); // Assuming 8 hour shifts
        document.getElementById('efficiency').textContent = efficiency + '/h';

        // Mock changes
        document.getElementById('revenueChange').innerHTML = '<i class="fas fa-arrow-up"></i> +18.5%';
        document.getElementById('ordersChange').innerHTML = '<i class="fas fa-arrow-up"></i> +12.3%';
        document.getElementById('avgChange').innerHTML = '<i class="fas fa-arrow-up"></i> +5.7%';
        document.getElementById('efficiencyChange').innerHTML = '<i class="fas fa-arrow-up"></i> +8.2%';
    }

    function renderPerformanceChart(data) {
        var ctx = document.createElement('canvas');
        ctx.height = 300;

        document.getElementById('performanceChart').innerHTML = '';
        document.getElementById('performanceChart').appendChild(ctx);

        var labels = data.DailyPerformance.map(function(item) { return item.Date; });
        var revenueData = data.DailyPerformance.map(function(item) { return item.Revenue; });
        var ordersData = data.DailyPerformance.map(function(item) { return item.Orders; });

        // Destroy existing chart
        if (performanceChart) {
            performanceChart.destroy();
        }

        performanceChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (triệu VNĐ)',
                    data: revenueData.map(function(value) { return value / 1000000; }),
                    backgroundColor: 'rgba(40, 167, 69, 0.8)',
                    borderColor: '#28a745',
                    borderWidth: 2,
                    yAxisID: 'y'
                }, {
                    label: 'Số đơn hàng',
                    data: ordersData,
                    type: 'line',
                    borderColor: '#ffcc00',
                    backgroundColor: 'rgba(255, 204, 0, 0.1)',
                    borderWidth: 3,
                    fill: false,
                    tension: 0.4,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            color: '#fff'
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        ticks: {
                            color: '#adb5bd'
                        },
                        grid: {
                            color: 'rgba(255, 255, 255, 0.1)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        ticks: {
                            color: '#adb5bd'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#adb5bd'
                        },
                        grid: {
                            color: 'rgba(255, 255, 255, 0.1)'
                        }
                    }
                }
            }
        });
    }

    function renderCashierRanking(data) {
        // Generate sample cashier data
        var cashiers = [
            { name: 'Thu Ngân A', revenue: data.TotalRevenue * 0.4, orders: data.TotalOrders * 0.35 },
            { name: 'Thu Ngân B', revenue: data.TotalRevenue * 0.3, orders: data.TotalOrders * 0.28 },
            { name: 'Thu Ngân C', revenue: data.TotalRevenue * 0.2, orders: data.TotalOrders * 0.24 },
            { name: 'Thu Ngân D', revenue: data.TotalRevenue * 0.1, orders: data.TotalOrders * 0.13 }
        ];

        var html = '';
        cashiers.forEach(function(cashier, index) {
            var rankClass = index < 3 ? 'rank-' + (index + 1) : 'rank-other';
            var avgOrder = cashier.orders > 0 ? (cashier.revenue / cashier.orders) : 0;

            html += `
                <div class="cashier-item">
                    <div class="cashier-rank ${rankClass}">${index + 1}</div>
                    <div class="cashier-info">
                        <div class="cashier-name">${cashier.name}</div>
                        <div class="cashier-stats">
                            ${Math.round(cashier.orders)} đơn • TB: ${(avgOrder / 1000).toFixed(0)}K/đơn
                        </div>
                    </div>
                    <div class="cashier-performance">
                        <div class="cashier-revenue">${(cashier.revenue / 1000000).toFixed(1)}M VNĐ</div>
                        <div class="cashier-orders">${Math.round(cashier.orders)} đơn hàng</div>
                    </div>
                </div>
            `;
        });

        document.getElementById('cashierList').innerHTML = html;
    }

    function renderHourlyPerformance(data) {
        var html = '';
        var maxRevenue = Math.max(...data.HourlyPerformance.map(function(item) { return item.Revenue; }));

        data.HourlyPerformance.forEach(function(item) {
            var percentage = (item.Revenue / maxRevenue) * 100;

            html += `
                <div class="hourly-item">
                    <div class="hourly-time">${item.Hour}</div>
                    <div class="hourly-bar">
                        <div class="hourly-fill" style="width: ${percentage}%;"></div>
                    </div>
                    <div class="hourly-value">
                        ${(item.Revenue / 1000000).toFixed(1)}M<br>
                        <small>${item.Orders} đơn</small>
                    </div>
                </div>
            `;
        });

        document.getElementById('hourlyGrid').innerHTML = html;
    }

    function exportPerformanceChart() {
        if (performanceChart) {
            var link = document.createElement('a');
            link.download = 'sales-performance-chart.png';
            link.href = performanceChart.toBase64Image();
            link.click();
        }
    }

    function showError(message) {
        var errorHTML = `
            <div class="text-center text-danger p-4">
                <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                <p>${message}</p>
            </div>
        `;

        document.getElementById('performanceChart').innerHTML = errorHTML;
        document.getElementById('cashierList').innerHTML = errorHTML;
        document.getElementById('hourlyGrid').innerHTML = errorHTML;
    }
    </script>
}
