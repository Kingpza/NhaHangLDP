@{
    ViewBag.Title = "Báo Cáo Món Ăn Bán Chạy";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<style>
    .dish-ranking-container {
        padding: 0;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
    }

    .filter-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 204, 0, 0.3);
        color: #fff;
        border-radius: 8px;
        padding: 10px 12px;
    }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: #ffcc00;
            color: #fff;
            box-shadow: 0 0 0 0.2rem rgba(255, 204, 0, 0.25);
        }

    .ranking-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .ranking-tab {
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 204, 0, 0.3);
        color: #adb5bd;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .ranking-tab.active,
        .ranking-tab:hover {
            background: rgba(255, 204, 0, 0.2);
            border-color: #ffcc00;
            color: #ffcc00;
            text-decoration: none;
        }

    .dishes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .dish-card {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        backdrop-filter: blur(10px);
        position: relative;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .dish-card:hover {
            border-color: #ffcc00;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 204, 0, 0.2);
        }

    .dish-rank {
        position: absolute;
        top: -10px;
        left: 20px;
        background: linear-gradient(135deg, #ffcc00, #ff9900);
        color: #333;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }

        .dish-rank.gold {
            background: linear-gradient(135deg, #FFD700, #FFA500);
        }

        .dish-rank.silver {
            background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
        }

        .dish-rank.bronze {
            background: linear-gradient(135deg, #CD7F32, #B8860B);
        }

    .dish-image {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 2rem;
        color: #fff;
    }

        .dish-image.hotpot {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
        }

        .dish-image.meat {
            background: linear-gradient(135deg, #8e44ad, #9b59b6);
        }

        .dish-image.seafood {
            background: linear-gradient(135deg, #3498db, #2980b9);
        }

        .dish-image.vegetable {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
        }

        .dish-image.side {
            background: linear-gradient(135deg, #f39c12, #e67e22);
        }

        .dish-image.drinks {
            background: linear-gradient(135deg, #16a085, #1abc9c);
        }

    .dish-name {
        font-size: 1.2rem;
        font-weight: bold;
        color: #ffcc00;
        text-align: center;
        margin-bottom: 15px;
    }

    .dish-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 15px;
    }

    .stat-item {
        text-align: center;
        padding: 10px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 3px;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #adb5bd;
    }

    .dish-rating {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .rating-stars {
        color: #ffcc00;
    }

    .rating-value {
        font-weight: bold;
        color: #fff;
    }

    .dish-feedback {
        text-align: center;
        font-size: 0.9rem;
        color: #28a745;
        font-weight: 500;
    }

    .summary-section {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        backdrop-filter: blur(10px);
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .summary-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        padding: 15px;
        text-align: center;
    }

    .summary-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 5px;
    }

    .summary-text {
        font-size: 0.9rem;
        color: #adb5bd;
    }

    .export-section {
        text-align: right;
        margin-bottom: 15px;
    }

    .btn-export {
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 204, 0, 0.5);
        color: #ffcc00;
        padding: 8px 15px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        margin-left: 10px;
        transition: all 0.3s ease;
    }

        .btn-export:hover {
            background: #ffcc00;
            color: #333;
            text-decoration: none;
        }

    .btn-filter {
        background: linear-gradient(135deg, #ffcc00, #ff9900);
        border: none;
        color: #333;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-filter:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(255, 204, 0, 0.4);
            color: #333;
        }

    .loading {
        text-align: center;
        padding: 40px;
        color: #adb5bd;
    }

    .no-data {
        text-align: center;
        padding: 40px;
        color: #adb5bd;
    }
</style>

<div class="dish-ranking-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h4 class="text-warning mb-1">
                    <i class="fas fa-trophy me-2"></i>Báo Cáo Món Ăn Bán Chạy
                </h4>
                <small class="text-muted">Xếp hạng món ăn theo số lượng bán và đánh giá khách hàng</small>
            </div>
            <div class="col-md-4 text-end">
                <a href="@Url.Action("Dashboard", "Reports")" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section">
        <h6 class="text-warning mb-3">
            <i class="fas fa-filter me-2"></i>Bộ lọc và sắp xếp
        </h6>

        <div class="ranking-tabs">
            <button class="ranking-tab active" data-sort="best" onclick="setSortType('best')">
                <i class="fas fa-fire me-1"></i>Bán chạy nhất
            </button>
            <button class="ranking-tab" data-sort="worst" onclick="setSortType('worst')">
                <i class="fas fa-exclamation-triangle me-1"></i>Bán ít nhất
            </button>
            <button class="ranking-tab" data-sort="revenue" onclick="setSortType('revenue')">
                <i class="fas fa-dollar-sign me-1"></i>Doanh thu cao
            </button>
            <button class="ranking-tab" data-sort="rating" onclick="setSortType('rating')">
                <i class="fas fa-star me-1"></i>Đánh giá cao
            </button>
        </div>

        <form id="filterForm">
            <div class="filter-row">
                <div>
                    <label class="form-label text-light">Từ ngày:</label>
                    <input type="date" class="form-control" id="fromDate" value="@ViewBag.FromDate">
                </div>
                <div>
                    <label class="form-label text-light">Đến ngày:</label>
                    <input type="date" class="form-control" id="toDate" value="@ViewBag.ToDate">
                </div>
                <div>
                    <label class="form-label text-light">Loại món:</label>
                    <select class="form-select" id="categoryFilter">
                        <option value="all">Tất cả loại</option>
                        <option value="hotpot">Nước Lẩu</option>
                        <option value="meat">Thịt</option>
                        <option value="seafood">Hải Sản</option>
                        <option value="vegetable">Rau & Nấm</option>
                        <option value="side">Món Phụ</option>
                        <option value="drinks">Đồ Uống</option>
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button type="button" class="btn btn-filter" onclick="loadDishRanking()">
                        <i class="fas fa-search me-1"></i>Lọc dữ liệu
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Summary Section -->
    <div class="summary-section" id="summarySection">
        <h6 class="text-warning mb-3">
            <i class="fas fa-chart-bar me-2"></i>Tóm tắt thống kê
        </h6>
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-number" id="totalDishes">-</div>
                <div class="summary-text">Tổng số món</div>
            </div>
            <div class="summary-card">
                <div class="summary-number" id="bestSellerSold">-</div>
                <div class="summary-text">Món bán chạy nhất</div>
            </div>
            <div class="summary-card">
                <div class="summary-number" id="totalQuantitySold">-</div>
                <div class="summary-text">Tổng SL bán</div>
            </div>
            <div class="summary-card">
                <div class="summary-number" id="averageRating">-</div>
                <div class="summary-text">Đánh giá TB</div>
            </div>
        </div>
    </div>

    <!-- Export Section -->
    <div class="export-section">
        <a href="#" class="btn-export" onclick="exportRanking()">
            <i class="fas fa-file-excel me-1"></i>Xuất Excel
        </a>
        <a href="#" class="btn-export" onclick="exportChart()">
            <i class="fas fa-chart-bar me-1"></i>Xuất biểu đồ
        </a>
    </div>

    <!-- Dishes Grid -->
    <div id="dishesContainer">
        <div class="loading">
            <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
            <p>Đang tải dữ liệu...</p>
        </div>
    </div>
</div>

@section scripts {
    <script>
    var currentSortType = '@ViewBag.SortBy';

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        setSortType(currentSortType);
        loadDishRanking();
    });

    function setSortType(sortType) {
        // Update active tab
        document.querySelectorAll('.ranking-tab').forEach(function(tab) {
            tab.classList.remove('active');
        });
        document.querySelector('[data-sort="' + sortType + '"]').classList.add('active');

        currentSortType = sortType;
    }

    function loadDishRanking() {
        var fromDate = document.getElementById('fromDate').value;
        var toDate = document.getElementById('toDate').value;
        var category = document.getElementById('categoryFilter').value;

        // Show loading
        document.getElementById('dishesContainer').innerHTML = `
            <div class="loading">
                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                <p>Đang tải dữ liệu...</p>
            </div>
        `;

        // Make AJAX request
        fetch('@Url.Action("GetDishRankingData", "Reports")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'fromDate=' + fromDate + '&toDate=' + toDate + '&sortBy=' + currentSortType
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                renderDishRanking(data.data, category);
                updateSummary(data.data);
            } else {
                showError('Lỗi khi tải dữ liệu: ' + data.message);
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            showError('Có lỗi xảy ra khi tải dữ liệu!');
        });
    }

    function renderDishRanking(dishes, categoryFilter) {
        var filteredDishes = dishes;

        if (categoryFilter !== 'all') {
            filteredDishes = dishes.filter(function(dish) {
                return getDishCategory(dish.Name) === categoryFilter;
            });
        }

        if (filteredDishes.length === 0) {
            document.getElementById('dishesContainer').innerHTML = `
                <div class="no-data">
                    <i class="fas fa-search fa-3x mb-3"></i>
                    <p>Không tìm thấy dữ liệu phù hợp với bộ lọc</p>
                </div>
            `;
            return;
        }

        var html = '<div class="dishes-grid">';

        filteredDishes.forEach(function(dish, index) {
            var rankClass = '';
            if (index === 0) rankClass = 'gold';
            else if (index === 1) rankClass = 'silver';
            else if (index === 2) rankClass = 'bronze';

            var categoryClass = getDishCategory(dish.Name);
            var categoryIcon = getCategoryIcon(categoryClass);
            var stars = generateStars(dish.AvgRating);

            html += `
                <div class="dish-card">
                    <div class="dish-rank ${rankClass}">${index + 1}</div>

                    <div class="dish-image ${categoryClass}">
                        <i class="${categoryIcon}"></i>
                    </div>

                    <div class="dish-name">${dish.Name}</div>

                    <div class="dish-stats">
                        <div class="stat-item">
                            <div class="stat-value">${dish.SoldQuantity}</div>
                            <div class="stat-label">Đã bán</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${(dish.Revenue / 1000000).toFixed(1)}M</div>
                            <div class="stat-label">Doanh thu</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${dish.OrderCount}</div>
                            <div class="stat-label">Lượt order</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${Math.round(dish.SoldQuantity / dish.OrderCount)}</div>
                            <div class="stat-label">SL/order</div>
                        </div>
                    </div>

                    <div class="dish-rating">
                        <div class="rating-stars">${stars}</div>
                        <div class="rating-value">${dish.AvgRating}</div>
                    </div>

                    <div class="dish-feedback">
                        ${dish.CustomerFeedback}% phản hồi tích cực
                    </div>
                </div>
            `;
        });

        html += '</div>';
        document.getElementById('dishesContainer').innerHTML = html;
    }

    function updateSummary(dishes) {
        var totalDishes = dishes.length;
        var totalQuantity = dishes.reduce(function(sum, dish) { return sum + dish.SoldQuantity; }, 0);
        var bestSeller = dishes.length > 0 ? dishes[0].SoldQuantity : 0;
        var avgRating = dishes.length > 0 ?
            (dishes.reduce(function(sum, dish) { return sum + dish.AvgRating; }, 0) / dishes.length).toFixed(1) : 0;

        document.getElementById('totalDishes').textContent = totalDishes;
        document.getElementById('bestSellerSold').textContent = bestSeller.toLocaleString();
        document.getElementById('totalQuantitySold').textContent = totalQuantity.toLocaleString();
        document.getElementById('averageRating').textContent = avgRating;
    }

    function getDishCategory(dishName) {
        if (dishName.includes('Lẩu')) return 'hotpot';
        if (dishName.includes('Thịt') || dishName.includes('Bò') || dishName.includes('Heo') || dishName.includes('Gà') || dishName.includes('Cừu') || dishName.includes('Chả')) return 'meat';
        if (dishName.includes('Tôm') || dishName.includes('Cua') || dishName.includes('Cá') || dishName.includes('Mực') || dishName.includes('Nghêu') || dishName.includes('Ốc')) return 'seafood';
        if (dishName.includes('Rau') || dishName.includes('Cải') || dishName.includes('Đậu') || dishName.includes('Nấm') || dishName.includes('Bắp')) return 'vegetable';
        if (dishName.includes('Bún') || dishName.includes('Mì') || dishName.includes('Bánh') || dishName.includes('Miến') || dishName.includes('Cơm')) return 'side';
        if (dishName.includes('Trà') || dishName.includes('Nước') || dishName.includes('Bia')) return 'drinks';
        return 'hotpot';
    }

    function getCategoryIcon(category) {
        var icons = {
            'hotpot': 'fas fa-fire',
            'meat': 'fas fa-drumstick-bite',
            'seafood': 'fas fa-fish',
            'vegetable': 'fas fa-leaf',
            'side': 'fas fa-bowl-rice',
            'drinks': 'fas fa-glass-whiskey'
        };
        return icons[category] || 'fas fa-utensils';
    }

    function generateStars(rating) {
        var stars = '';
        var fullStars = Math.floor(rating);
        var hasHalfStar = rating % 1 >= 0.5;

        for (var i = 0; i < fullStars; i++) {
            stars += '<i class="fas fa-star"></i>';
        }

        if (hasHalfStar) {
            stars += '<i class="fas fa-star-half-alt"></i>';
        }

        var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
        for (var i = 0; i < emptyStars; i++) {
            stars += '<i class="far fa-star"></i>';
        }

        return stars;
    }

    function exportRanking() {
        alert('Xuất Excel - Chức năng đang phát triển');
    }

    function exportChart() {
        alert('Xuất biểu đồ - Chức năng đang phát triển');
    }

    function showError(message) {
        document.getElementById('dishesContainer').innerHTML = `
            <div class="text-center text-danger p-4">
                <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                <p>${message}</p>
            </div>
        `;
    }
    </script>
}
