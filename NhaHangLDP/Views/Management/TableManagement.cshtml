@model IEnumerable<NhaHangLDP.Models.RestaurantTable>

@{
    ViewBag.Title = "Quản Lý Bàn";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .table-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .table-item {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .table-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

        .table-item.available {
            border-left: 4px solid #22c55e;
        }

        .table-item.occupied {
            border-left: 4px solid #f59e0b;
        }

        .table-item.reserved {
            border-left: 4px solid var(--primary-blue);
        }

        .table-item.unavailable {
            border-left: 4px solid #ef4444;
        }

        .table-number {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .table-area {
            display: inline-block;
            padding: 4px 12px;
            background: #dbeafe;
            color: var(--primary-blue);
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            margin-top: 5px;
        }

        .table-capacity {
            color: var(--text-gray);
            font-size: 14px;
            margin-top: 10px;
        }

        .table-status {
            position: absolute;
            top: 15px;
            right: 15px;
        }

        .table-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
        }

        .search-filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-chair me-2"></i>Quản Lý Bàn</h1>
            <p>Quản lý và theo dõi trạng thái bàn trong nhà hàng</p>
        </div>
        <a href="@Url.Action("CreateTable")" class="btn btn-light">
            <i class="fas fa-plus me-2"></i>Thêm Bàn Mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-th-large"></i>
            </div>
            <h4>@Model.Count()</h4>
            <p class="mb-0">Tổng Số Bàn</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="fas fa-check-circle"></i>
            </div>
            <h4>@Model.Count(t => t.Status == "Available")</h4>
            <p class="mb-0">Bàn Trống</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                <i class="fas fa-utensils"></i>
            </div>
            <h4>@Model.Count(t => t.Status == "Occupied")</h4>
            <p class="mb-0">Bàn Có Khách</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-calendar-check"></i>
            </div>
            <h4>@Model.Count(t => t.Status == "Reserved")</h4>
            <p class="mb-0">Bàn Đặt Trước</p>
        </div>
    </div>
</div>

<!-- Table Grid View -->
<div class="table-grid">
    @if (Model.Any())
    {
        foreach (var table in Model.OrderBy(t => t.TableArea.Name).ThenBy(t => t.TableNumber))
        {
            var statusClass = table.Status == "Available" ? "available" :
                              table.Status == "Occupied" ? "occupied" :
                              table.Status == "Reserved" ? "reserved" : "unavailable";
            <div class="table-item @statusClass">
                <div class="table-status">
                    @if (table.Status == "Available")
                    {
                        <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i>Trống</span>
                    }
                    else if (table.Status == "Occupied")
                    {
                        <span class="badge badge-warning"><i class="fas fa-utensils me-1"></i>Có Khách</span>
                    }
                    else if (table.Status == "Reserved")
                    {
                        <span class="badge badge-info"><i class="fas fa-calendar-check me-1"></i>Đặt Trước</span>
                    }
                    else
                    {
                        <span class="badge badge-danger"><i class="fas fa-times-circle me-1"></i>Không KD</span>
                    }
                </div>
                <div class="table-number">@table.TableNumber</div>
                <div class="table-area">@table.TableArea.Name</div>
                <div class="table-capacity">
                    <i class="fas fa-users me-1"></i>@table.Capacity người
                </div>
                <div class="table-actions">
                    <a href="@Url.Action("EditTable", new { id = table.Id })" class="btn btn-sm btn-outline-primary flex-fill">
                        <i class="fas fa-edit me-1"></i>Sửa
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger flex-fill"
                            onclick="deleteTable(@table.Id, '@table.TableNumber')">
                        <i class="fas fa-trash me-1"></i>Xóa
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="stat-card text-center py-5">
                <i class="fas fa-chair fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">Chưa có bàn nào được tạo</h5>
                <a href="@Url.Action("CreateTable")" class="btn btn-primary-custom mt-3">
                    <i class="fas fa-plus me-2"></i>Thêm Bàn Đầu Tiên
                </a>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function deleteTable(id, tableName) {
            if (confirm(`Bạn có chắc chắn muốn xóa bàn "${tableName}"?`)) {
                $.ajax({
                    url: '@Url.Action("DeleteTable")',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
}