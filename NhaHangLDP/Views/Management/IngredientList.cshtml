@model List<NhaHangLDP.Models.IngredientWithLatestSupplierViewModel>
@{
    ViewBag.Title = "Danh Sách Nguyên Liệu";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .search-filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .table-card {
            background: var(--bg-white);
            border-radius: 15px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .table-card .card-body {
            padding: 0;
        }

        .summary-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 20px;
            border-top: 1px solid var(--border-color);
            background: var(--bg-light);
        }

        .summary-item {
            text-align: center;
        }

        .summary-item h5 {
            margin: 0;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .summary-item small {
            color: var(--text-gray);
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-list me-2"></i>Danh Sách Nguyên Liệu</h1>
            <p>Quản lý tất cả nguyên liệu trong kho</p>
        </div>
        <div>
            <a href="@Url.Action("CreateIngredient", "Management")" class="btn btn-light me-2">
                <i class="fas fa-plus me-2"></i>Thêm Nguyên Liệu
            </a>
            <a href="@Url.Action("StockInbound", "Management")" class="btn btn-outline-light me-2">
                <i class="fas fa-arrow-down me-2"></i>Nhập Kho
            </a>
            <a href="@Url.Action("StockOutbound", "Management")" class="btn btn-outline-light">
                <i class="fas fa-arrow-up me-2"></i>Xuất Kho
            </a>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="search-filter-card">
    <div class="row align-items-end">
        <div class="col-md-3">
            <label class="form-label">Tìm kiếm</label>
            <input type="text" class="form-control" id="searchInput" placeholder="Tên nguyên liệu...">
        </div>
        <div class="col-md-3">
            <label class="form-label">Nhà cung cấp</label>
            <select class="form-select" id="supplierFilter">
                <option value="">Tất cả nhà cung cấp</option>
                @foreach (var supplier in Model.Select(x => x.LatestSupplier).Where(x => !string.IsNullOrEmpty(x)).Distinct())
                {
                    <option value="@supplier">@supplier</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Trạng thái kho</label>
            <select class="form-select" id="stockFilter">
                <option value="">Tất cả</option>
                <option value="sufficient">Đủ hàng</option>
                <option value="low">Sắp hết</option>
                <option value="out">Hết hàng</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                <i class="fas fa-times me-1"></i>Xóa bộ lọc
            </button>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="stat-card text-center py-5">
        <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Chưa có nguyên liệu nào</h4>
        <p class="text-muted">Bạn cần thêm nguyên liệu để bắt đầu quản lý kho</p>
        <div class="mt-4">
            <a href="@Url.Action("CreateIngredient", "Management")" class="btn btn-primary-custom me-2">
                <i class="fas fa-plus me-2"></i>Thêm Nguyên Liệu Đầu Tiên
            </a>
            <button class="btn btn-outline-custom" onclick="createSampleData()">
                <i class="fas fa-magic me-2"></i>Tạo Dữ Liệu Mẫu
            </button>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-custom table-hover mb-0" id="ingredientsTable">
                <thead>
                    <tr>
                        <th>Tên Nguyên Liệu</th>
                        <th>Đơn Vị</th>
                        <th>Tồn Kho</th>
                        <th>Tối Thiểu</th>
                        <th>Giá Ước Tính</th>
                        <th>Nhà Cung Cấp</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingredient in Model)
                    {
                        var stockStatus = "sufficient";
                        var badgeClass = "badge-success";
                        var statusText = "Đủ hàng";

                        if (ingredient.AvailableStock <= 0)
                        {
                            stockStatus = "out";
                            badgeClass = "badge-danger";
                            statusText = "Hết hàng";
                        }
                        else if (ingredient.LowStockThreshold.HasValue && ingredient.AvailableStock <= ingredient.LowStockThreshold.Value)
                        {
                            stockStatus = "low";
                            badgeClass = "badge-warning";
                            statusText = "Sắp hết";
                        }

                        <tr data-supplier="@(ingredient.LatestSupplier ?? "")" data-stock="@stockStatus" data-name="@ingredient.Name.ToLower()">
                            <td>
                                <strong style="color: var(--primary-dark);">@ingredient.Name</strong>
                                @if (ingredient.AvailableStock <= 0)
                                {
                                    <i class="fas fa-exclamation-triangle text-danger ms-1" title="Hết hàng"></i>
                                }
                                else if (ingredient.LowStockThreshold.HasValue && ingredient.AvailableStock <= ingredient.LowStockThreshold.Value)
                                {
                                    <i class="fas fa-exclamation-triangle text-warning ms-1" title="Sắp hết hàng"></i>
                                }
                            </td>
                            <td>
                                <span class="badge badge-info">@ingredient.Unit</span>
                            </td>
                            <td>
                                <strong class="@(ingredient.AvailableStock <= 0 ? "text-danger" : ingredient.LowStockThreshold.HasValue && ingredient.AvailableStock <= ingredient.LowStockThreshold.Value ? "text-warning" : "")">
                                    @ingredient.AvailableStock.ToString("N2")
                                </strong>
                            </td>
                            <td>
                                @if (ingredient.LowStockThreshold.HasValue)
                                {
                                    @ingredient.LowStockThreshold.Value.ToString("N2")
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                <strong style="color: #16a34a;">@ingredient.EstimatedCost.ToString("N0") VNĐ</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(ingredient.LatestSupplier))
                                {
                                    <div>
                                        <span class="badge badge-info">@ingredient.LatestSupplier</span>
                                        @if (ingredient.LastInboundDate.HasValue)
                                        {
                                            <br><small class="text-muted">Nhập: @ingredient.LastInboundDate.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>
                            <td>
                                <span class="badge @badgeClass">@statusText</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info"
                                            onclick="viewIngredientDetail(@ingredient.Id, '@ingredient.Name')"
                                            title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-primary"
                                            onclick="viewHistory(@ingredient.Id, '@ingredient.Name')"
                                            title="Xem lịch sử">
                                        <i class="fas fa-history"></i>
                                    </button>
                                    <button class="btn btn-outline-danger"
                                            onclick="deleteIngredient(@ingredient.Id, '@ingredient.Name')"
                                            title="Xóa nguyên liệu">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Any())
        {
            <div class="summary-stats">
                <div class="summary-item">
                    <h5>@Model.Count</h5>
                    <small>Tổng nguyên liệu</small>
                </div>
                <div class="summary-item">
                    <h5 style="color: #f59e0b;">@Model.Count(x => x.LowStockThreshold.HasValue && x.AvailableStock <= x.LowStockThreshold.Value && x.AvailableStock > 0)</h5>
                    <small>Sắp hết hàng</small>
                </div>
                <div class="summary-item">
                    <h5 style="color: #ef4444;">@Model.Count(x => x.AvailableStock <= 0)</h5>
                    <small>Hết hàng</small>
                </div>
                <div class="summary-item">
                    <h5 style="color: var(--primary-blue);">@Model.Sum(x => x.AvailableStock * x.EstimatedCost).ToString("N0") VNĐ</h5>
                    <small>Tổng giá trị kho</small>
                </div>
            </div>
        }
    </div>
}

@section scripts {
    <script>
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('supplierFilter').addEventListener('change', filterTable);
        document.getElementById('stockFilter').addEventListener('change', filterTable);

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const supplierFilter = document.getElementById('supplierFilter').value;
            const stockFilter = document.getElementById('stockFilter').value;

            const rows = document.querySelectorAll('#ingredientsTable tbody tr');

            rows.forEach(row => {
                const name = row.getAttribute('data-name');
                const supplier = row.getAttribute('data-supplier');
                const stock = row.getAttribute('data-stock');

                const nameMatch = name.includes(searchTerm);
                const supplierMatch = !supplierFilter || supplier.includes(supplierFilter);
                const stockMatch = !stockFilter || stock === stockFilter;

                row.style.display = (nameMatch && supplierMatch && stockMatch) ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('supplierFilter').value = '';
            document.getElementById('stockFilter').value = '';
            filterTable();
        }

        function viewIngredientDetail(id, name) {
            const modal = new bootstrap.Modal(document.getElementById('ingredientDetailModal'));
            modal.show();

            document.getElementById('editIngredientBtn').href = `@Url.Action("EditIngredient", "Management")?id=${id}`;

            fetch(`@Url.Action("GetIngredientDetail", "Management")?id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('ingredientDetailContent').innerHTML = renderIngredientDetail(data);
                    } else {
                        document.getElementById('ingredientDetailContent').innerHTML = `<div class="text-center text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><p>${data.message}</p></div>`;
                    }
                })
                .catch(() => {
                    document.getElementById('ingredientDetailContent').innerHTML = `<div class="text-center text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><p>Lỗi tải thông tin chi tiết.</p></div>`;
                });
        }

        function renderIngredientDetail(data) {
            const i = data.ingredient;
            return `
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3">Thông Tin Cơ Bản</h6>
                        <table class="table table-borderless table-sm">
                            <tr><td><strong>Tên:</strong></td><td>${i.name}</td></tr>
                            <tr><td><strong>Đơn vị:</strong></td><td><span class="badge badge-info">${i.unit}</span></td></tr>
                            <tr><td><strong>Nhà cung cấp:</strong></td><td>${i.latestSupplier || '<span class="text-muted">Chưa có</span>'}</td></tr>
                            <tr><td><strong>Giá ước tính:</strong></td><td><strong>${parseInt(i.estimatedCost).toLocaleString('vi-VN')} VNĐ</strong></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3">Thông Tin Kho</h6>
                        <table class="table table-borderless table-sm">
                            <tr><td><strong>Tồn kho:</strong></td><td>${parseFloat(i.availableStock).toLocaleString('vi-VN')} ${i.unit}</td></tr>
                            <tr><td><strong>Tối thiểu:</strong></td><td>${i.lowStockThreshold ? parseFloat(i.lowStockThreshold).toLocaleString('vi-VN') + ' ' + i.unit : '<span class="text-muted">Chưa đặt</span>'}</td></tr>
                            <tr><td><strong>Trạng thái:</strong></td><td>${i.statusBadge}</td></tr>
                            <tr><td><strong>Giá trị tồn:</strong></td><td><strong style="color: var(--primary-blue);">${parseInt(i.totalValue).toLocaleString('vi-VN')} VNĐ</strong></td></tr>
                        </table>
                    </div>
                </div>`;
        }

        function viewHistory(id) {
            window.location.href = `@Url.Action("IngredientHistory", "Management")?id=${id}`;
        }

        function deleteIngredient(id, name) {
            if (!confirm(`Bạn có chắc muốn xóa nguyên liệu "${name}" không?`)) return;

            fetch(`@Url.Action("DeleteIngredient", "Management")`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message || "Đã xóa thành công!");
                        location.reload();
                    } else {
                        alert(data.message || "Không thể xóa (có thể đang được sử dụng trong phiếu nhập/xuất).");
                    }
                })
                .catch(() => alert("Lỗi khi xóa nguyên liệu."));
        }

        function createSampleData() {
            if (confirm('Tạo dữ liệu mẫu cho kho?')) {
                fetch('@Url.Action("CreateSampleIngredients", "Management")', { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        alert(data.message);
                        if (data.success) location.reload();
                    })
                    .catch(() => alert('Lỗi tạo dữ liệu mẫu.'));
            }
        }
    </script>
}