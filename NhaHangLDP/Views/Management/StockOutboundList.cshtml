@model NhaHangLDP.Models.StockOutboundListViewModel
@{
    ViewBag.Title = "Danh Sách Phiếu Xuất Kho";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

        .data-card {
            background: var(--bg-white);
            border-radius: 15px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .data-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border-color);
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .data-card .card-header h5 {
            margin: 0;
            font-weight: 600;
            color: var(--primary-dark);
        }

        .outbound-item {
            border-bottom: 1px solid var(--border-color);
            padding: 20px 25px;
            transition: all 0.3s ease;
        }

        .outbound-item:last-child {
            border-bottom: none;
        }

        .outbound-item:hover {
            background: var(--bg-light);
        }

        .outbound-code {
            font-weight: 700;
            color: #f59e0b;
            font-size: 15px;
        }

        .outbound-date {
            color: var(--text-gray);
            font-size: 13px;
        }

        .outbound-meta {
            display: flex;
            gap: 20px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .outbound-meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-gray);
        }

        .outbound-meta-item i {
            color: var(--primary-blue);
            width: 16px;
        }

        .outbound-details {
            background: var(--bg-light);
            border-radius: 10px;
            padding: 15px;
            margin-top: 15px;
        }

        .outbound-details h6 {
            font-size: 13px;
            color: var(--primary-dark);
            margin-bottom: 10px;
            font-weight: 600;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

        .detail-row .ingredient-name {
            font-weight: 600;
            color: var(--primary-dark);
        }

        .detail-row .quantity {
            color: #f59e0b;
            font-weight: 600;
        }

        .total-cost {
            font-size: 18px;
            font-weight: 700;
            color: #f59e0b;
        }

        .reason-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }

        .reason-badge.damage {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .reason-badge.expired {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            background: white;
            color: var(--text-gray);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .action-btn:hover {
            background: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-state i {
            font-size: 60px;
            color: var(--border-color);
            margin-bottom: 20px;
        }

        .empty-state h5 {
            color: var(--text-gray);
            margin-bottom: 10px;
        }

        .empty-state p {
            color: var(--text-gray);
            margin-bottom: 20px;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-arrow-up me-2"></i>Danh Sách Phiếu Xuất Kho</h1>
            <p>Quản lý và theo dõi các phiếu xuất kho</p>
        </div>
        <div>
            <a href="@Url.Action("StockOutbound", "Management")" class="btn btn-light me-2">
                <i class="fas fa-plus-circle me-2"></i>Tạo Phiếu Xuất Mới
            </a>
            <a href="@Url.Action("StockInboundList", "Management")" class="btn btn-outline-light me-2">
                <i class="fas fa-truck-loading me-2"></i>Phiếu Nhập Kho
            </a>
            <a href="@Url.Action("Inventory", "Management")" class="btn btn-outline-light">
                <i class="fas fa-warehouse me-2"></i>Quay Lại Kho
            </a>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                <i class="fas fa-file-alt"></i>
            </div>
            <h4>@Model.OutboundList.Count</h4>
            <p class="mb-0">Tổng số phiếu</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <h4>@Model.OutboundList.Sum(x => x.TotalCost).ToString("N0")</h4>
            <p class="mb-0">Tổng giá trị (VNĐ)</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-boxes"></i>
            </div>
            <h4>@Model.OutboundList.Sum(x => x.ItemCount)</h4>
            <p class="mb-0">Tổng nguyên liệu</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                <i class="fas fa-calendar-day"></i>
            </div>
            <h4>@Model.OutboundList.Count(x => x.OutboundDate.Date == DateTime.Now.Date)</h4>
            <p class="mb-0">Phiếu hôm nay</p>
        </div>
    </div>
</div>

<!-- Data List -->
<div class="data-card">
    <div class="card-header">
        <h5><i class="fas fa-list me-2"></i>Danh Sách Phiếu Xuất (@Model.OutboundList.Count)</h5>
        <button class="btn btn-outline-success btn-sm" onclick="exportToExcel()">
            <i class="fas fa-file-excel me-1"></i>Xuất Excel
        </button>
    </div>

    @if (Model.OutboundList.Any())
    {
        <div class="outbound-list">
            @foreach (var item in Model.OutboundList)
            {
                var reasonClass = "";
                if (item.Purpose != null)
                {
                    if (item.Purpose.ToLower().Contains("hỏng") || item.Purpose.ToLower().Contains("hư"))
                    {
                        reasonClass = "damage";
                    }
                    else if (item.Purpose.ToLower().Contains("hết hạn"))
                    {
                        reasonClass = "expired";
                    }
                }
                
                <div class="outbound-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <span class="outbound-code">@item.OutboundCode</span>
                                <span class="badge badge-success">@item.Status</span>
                                <span class="reason-badge @reasonClass">@item.Purpose</span>
                            </div>
                            <div class="outbound-date">
                                <i class="fas fa-clock me-1"></i>@item.OutboundDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                            <div class="outbound-meta">
                                <div class="outbound-meta-item">
                                    <i class="fas fa-user"></i>
                                    <span>@item.EmployeeName</span>
                                </div>
                            </div>

                            <div class="outbound-details">
                                <h6><i class="fas fa-box-open me-1"></i>Chi tiết xuất kho:</h6>
                                <div class="detail-row">
                                    <span class="ingredient-name">@item.IngredientName</span>
                                    <span class="quantity">@item.Quantity.ToString("N1") @item.Unit</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-end ms-4">
                            <div class="total-cost mb-3">@item.TotalCost.ToString("N0") VNĐ</div>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("StockOutboundDetail", "Management", new { id = item.Id })" class="action-btn" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("StockOutboundDetail", "Management", new { id = item.Id })" class="action-btn" title="In phiếu" target="_blank">
                                    <i class="fas fa-print"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <h5>Chưa có phiếu xuất kho nào</h5>
            <p>Tạo phiếu xuất kho đầu tiên để bắt đầu quản lý</p>
            <a href="@Url.Action("StockOutbound", "Management")" class="btn btn-primary-custom">
                <i class="fas fa-plus-circle me-2"></i>Tạo Phiếu Xuất Mới
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function exportToExcel() {
            alert('Xuất Excel (chức năng đang phát triển)');
        }
    </script>
}