@model NhaHangLDP.Models.Employee

@{
    ViewBag.Title = "Thêm Nhân Viên";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .form-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 30px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .form-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .form-card h5 i {
            color: var(--primary-blue);
        }

        .btn-save {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
        }

        .btn-save:hover {
            background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(34, 197, 94, 0.4);
        }

        .btn-save:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .required::after {
            content: " *";
            color: #ef4444;
        }

        .password-strength {
            margin-top: 8px;
            height: 4px;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .strength-weak { background: #ef4444; width: 33%; }
        .strength-medium { background: #f59e0b; width: 66%; }
        .strength-strong { background: #22c55e; width: 100%; }

        .input-group-text {
            background: var(--bg-light);
            border: 2px solid var(--border-color);
            border-left: none;
        }

        .input-group .form-control {
            border-right: none;
        }

        .input-group .form-control:focus + .input-group-text {
            border-color: var(--primary-blue);
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-user-plus me-2"></i>Thêm Nhân Viên Mới</h1>
            <p>Tạo tài khoản mới cho nhân viên trong hệ thống</p>
        </div>
        <a href="@Url.Action("EmployeeManagement")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Quay Lại
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Có lỗi xảy ra:</strong>
        @Html.ValidationSummary(false, "", new { @class = "mb-0 mt-2" })
    </div>
}

@using (Html.BeginForm("CreateEmployee", "Management", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-lg-6">
            <div class="form-card">
                <h5><i class="fas fa-user me-2"></i>Thông Tin Cá Nhân</h5>

                <div class="mb-4">
                    <label class="form-label required">Họ và Tên</label>
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", placeholder = "Nhập họ và tên đầy đủ", required = "required" })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label">Email</label>
                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", placeholder = "employee@example.com" })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label">Số Điện Thoại</label>
                    @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", placeholder = "0123456789" })
                    @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-0">
                    <label class="form-label required">Vai Trò</label>
                    @Html.DropDownListFor(model => model.RoleId, (SelectList)ViewBag.RoleId, "-- Chọn Vai Trò --", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(model => model.RoleId, "", new { @class = "text-danger small" })
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="form-card">
                <h5><i class="fas fa-lock me-2"></i>Thông Tin Tài Khoản</h5>

                <div class="mb-4">
                    <label class="form-label required">Tên Đăng Nhập</label>
                    @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", placeholder = "Tên đăng nhập (không dấu, không khoảng trống)", required = "required" })
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger small" })
                    <small class="text-muted">Chỉ sử dụng chữ cái, số và dấu gạch dưới</small>
                </div>

                <div class="mb-4">
                    <label class="form-label required">Mật Khẩu</label>
                    <div class="input-group">
                        @Html.PasswordFor(model => model.PasswordHash, new { @class = "form-control", id = "password", placeholder = "Mật khẩu (tối thiểu 6 ký tự)", minlength = "6", required = "required" })
                        <button class="btn btn-outline-secondary input-group-text" type="button" id="togglePassword" style="border-left: 2px solid var(--border-color);">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div id="passwordStrength" class="password-strength"></div>
                    @Html.ValidationMessageFor(model => model.PasswordHash, "", new { @class = "text-danger small" })
                    <small class="text-muted">Tối thiểu 6 ký tự</small>
                </div>

                <div class="mb-4">
                    <label class="form-label required">Xác Nhận Mật Khẩu</label>
                    <div class="input-group">
                        @Html.Password("ConfirmPassword", "", new { @class = "form-control", id = "confirmPassword", placeholder = "Nhập lại mật khẩu", minlength = "6", required = "required" })
                        <button class="btn btn-outline-secondary input-group-text" type="button" id="toggleConfirmPassword" style="border-left: 2px solid var(--border-color);">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <small id="passwordMatchText"></small>
                </div>

                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Lưu ý:</strong> Tài khoản sẽ được tạo tự động với thông tin đăng nhập này.
                </div>
            </div>

            <div class="form-card">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("EmployeeManagement")" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Hủy
                    </a>
                    <button type="submit" class="btn btn-save" id="submitBtn" disabled>
                        <i class="fas fa-user-plus me-2"></i>Thêm Nhân Viên
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        $('#togglePassword').click(function () {
            const password = $('#password');
            const type = password.attr('type') === 'password' ? 'text' : 'password';
            password.attr('type', type);
            $(this).find('i').toggleClass('fa-eye fa-eye-slash');
        });

        $('#toggleConfirmPassword').click(function () {
            const confirmPassword = $('#confirmPassword');
            const type = confirmPassword.attr('type') === 'password' ? 'text' : 'password';
            confirmPassword.attr('type', type);
            $(this).find('i').toggleClass('fa-eye fa-eye-slash');
        });

        $('#password').on('input', function () {
            var password = $(this).val();
            var strength = 0;
            var strengthBar = $('#passwordStrength');

            if (password.length >= 6) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            strengthBar.removeClass('strength-weak strength-medium strength-strong');

            if (strength <= 1) {
                strengthBar.addClass('strength-weak');
            } else if (strength <= 2) {
                strengthBar.addClass('strength-medium');
            } else {
                strengthBar.addClass('strength-strong');
            }
        });

        function validatePasswords() {
            const password = $('#password').val();
            const confirmPassword = $('#confirmPassword').val();
            const matchText = $('#passwordMatchText');
            const submitBtn = $('#submitBtn');

            if (password === '' || confirmPassword === '') {
                matchText.text('').removeClass('text-success text-danger');
                submitBtn.prop('disabled', true);
                return;
            }

            if (password === confirmPassword) {
                matchText.text('✓ Mật khẩu khớp').addClass('text-success').removeClass('text-danger');
                submitBtn.prop('disabled', false);
            } else {
                matchText.text('✗ Mật khẩu không khớp').addClass('text-danger').removeClass('text-success');
                submitBtn.prop('disabled', true);
            }
        }

        $('#password, #confirmPassword').on('input', validatePasswords);

        $('#UserName').on('input', function () {
            var value = $(this).val();
            var cleanValue = value.replace(/[^a-zA-Z0-9_]/g, '');
            $(this).val(cleanValue);
        });

        $('#FullName').on('input', function () {
            var fullName = $(this).val();
            if (fullName && $('#UserName').val() === '') {
                var username = fullName
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/[^a-zA-Z0-9]/g, '')
                    .substring(0, 20);
                $('#UserName').val(username);
            }
        });
    </script>
}