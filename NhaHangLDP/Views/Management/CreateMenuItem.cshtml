@model NhaHangLDP.Models.MenuItemFormViewModel
@{
    ViewBag.Title = (Model != null && Model.IsEdit) ? "Sửa Món Ăn" : "Thêm Món Ăn Mới";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .form-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 30px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .form-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .image-preview-container {
            border: 2px dashed var(--border-color);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            background: var(--bg-light);
        }

        .image-preview-container:hover {
            border-color: var(--primary-blue);
            background: rgba(59, 130, 246, 0.05);
        }

        .image-preview {
            max-width: 200px;
            max-height: 200px;
            border-radius: 15px;
            object-fit: cover;
            box-shadow: var(--shadow-md);
        }

        .upload-icon {
            font-size: 48px;
            color: var(--text-gray);
            margin-bottom: 15px;
        }

        .btn-save {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-save:hover {
            background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(34, 197, 94, 0.4);
        }

        .required-field {
            color: #ef4444;
        }

        .ingredient-table {
            width: 100%;
            border-collapse: collapse;
        }

        .ingredient-table th {
            background: var(--bg-light);
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            color: var(--text-gray);
            font-size: 13px;
            text-transform: uppercase;
        }

        .ingredient-table td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .ingredient-row:hover {
            background: var(--bg-light);
        }

        .btn-remove-ingredient {
            color: #ef4444;
            background: none;
            border: none;
            font-size: 16px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 5px;
            transition: all 0.3s ease;
        }

        .btn-remove-ingredient:hover {
            background: #fee2e2;
        }

        .form-check-input:checked {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

        .form-switch .form-check-input {
            width: 50px;
            height: 26px;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>
                <i class="fas fa-@((Model != null && Model.IsEdit) ? "edit" : "plus") me-2"></i>
                @((Model != null && Model.IsEdit) ? "Sửa" : "Thêm") Món Ăn
            </h1>
            <p>@((Model != null && Model.IsEdit) ? "Cập nhật thông tin món ăn trong thực đơn" : "Thêm món ăn mới vào thực đơn nhà hàng")</p>
        </div>
        <a href="@Url.Action("MenuManagement", "Management")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Quay Lại
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || Model.MenuItem == null)
{
    <div class="alert alert-warning">
        <h5><i class="fas fa-exclamation-triangle me-2"></i>Lỗi Model</h5>
        <p>Có lỗi xảy ra khi tải dữ liệu. Model hoặc MenuItem bị null.</p>
        <a href="@Url.Action("CreateMenuItem", "Management")" class="btn btn-warning">
            <i class="fas fa-refresh me-2"></i>Thử Lại
        </a>
    </div>
}
else
{
    using (Html.BeginForm(Model.IsEdit ? "EditMenuItem" : "CreateMenuItem", "Management", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IsEdit)

        if (Model.IsEdit)
        {
            @Html.HiddenFor(m => m.MenuItem.Id)
        }

        <div class="row">
            <div class="col-lg-8">
                <!-- Basic Info -->
                <div class="form-card">
                    <h5><i class="fas fa-info-circle me-2"></i>Thông Tin Cơ Bản</h5>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label">Tên món ăn <span class="required-field">*</span></label>
                                @Html.TextBoxFor(m => m.MenuItem.Name, new { @class = "form-control", placeholder = "Nhập tên món ăn...", required = "required" })
                                @Html.ValidationMessageFor(m => m.MenuItem.Name, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Danh mục <span class="required-field">*</span></label>
                                @Html.DropDownListFor(m => m.MenuItem.Category,
                                    new SelectList(new[] {
                                        new { Value = "", Text = "-- Chọn danh mục --" },
                                        new { Value = "Nước Lẩu", Text = "Nước Lẩu" },
                                        new { Value = "Thịt", Text = "Thịt" },
                                        new { Value = "Hải Sản", Text = "Hải Sản" },
                                        new { Value = "Rau & Nấm", Text = "Rau & Nấm" },
                                        new { Value = "Món Phụ", Text = "Món Phụ" },
                                        new { Value = "Đồ Uống", Text = "Đồ Uống" }
                                    }, "Value", "Text", Model.MenuItem.Category),
                                    new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.MenuItem.Category, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả món ăn</label>
                        @Html.TextAreaFor(m => m.MenuItem.Description, new { @class = "form-control", rows = 3, placeholder = "Mô tả chi tiết về món ăn..." })
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Giá bán (VNĐ) <span class="required-field">*</span></label>
                                @Html.TextBoxFor(m => m.MenuItem.Price, new { @class = "form-control", type = "number", min = "1000", max = "10000000", step = "1000", placeholder = "50000", required = "required" })
                                @Html.ValidationMessageFor(m => m.MenuItem.Price, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Thời gian chuẩn bị (phút) <span class="required-field">*</span></label>
                                @Html.TextBoxFor(m => m.MenuItem.PreparationTime, new { @class = "form-control", type = "number", min = "1", max = "120", placeholder = "15", required = "required" })
                                @Html.ValidationMessageFor(m => m.MenuItem.PreparationTime, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.MenuItem.IsAvailable, new { @class = "form-check-input" })
                            <label class="form-check-label">Đang bán</label>
                        </div>
                    </div>
                </div>

                <!-- Ingredients -->
                <div class="form-card">
                    <h5><i class="fas fa-carrot me-2"></i>Thành Phần Món Ăn</h5>

                    <div id="ingredient-list-container">
                        <table class="ingredient-table">
                            <thead>
                                <tr>
                                    <th>Nguyên Liệu</th>
                                    <th style="width: 60px;"></th>
                                </tr>
                            </thead>
                            <tbody id="ingredient-list">
                                @if (Model.SelectedIngredients != null)
                                {
                                    for (int i = 0; i < Model.SelectedIngredients.Count; i++)
                                    {
                                        <tr class="ingredient-row">
                                            <td>
                                                @Html.HiddenFor(m => m.SelectedIngredients[i].IngredientId)
                                                @Html.HiddenFor(m => m.SelectedIngredients[i].RequiredQuantity, new { @Value = 0 })
                                                @Html.HiddenFor(m => m.SelectedIngredients[i].Unit, new { @Value = "" })
                                                <strong>@Model.SelectedIngredients[i].IngredientName</strong>
                                            </td>
                                            <td>
                                                <button type="button" class="btn-remove-ingredient" onclick="removeIngredientRow(this)">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <hr class="my-4">

                    <div class="row align-items-end">
                        <div class="col-md-9">
                            <label class="form-label">Chọn Nguyên Liệu</label>
                            <select id="newIngredientId" class="form-select">
                                <option value="">-- Chọn nguyên liệu --</option>
                                @if (Model.AvailableIngredients != null)
                                {
                                    foreach (var ing in Model.AvailableIngredients)
                                    {
                                        <option value="@ing.Id">@ing.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="add-ingredient-btn" class="btn btn-outline-custom w-100">
                                <i class="fas fa-plus me-1"></i>Thêm
                            </button>
                        </div>
                    </div>
                    <small id="ingredient-error" class="text-danger d-none">Vui lòng chọn nguyên liệu.</small>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Image Upload -->
                <div class="form-card">
                    <h5><i class="fas fa-image me-2"></i>Hình Ảnh</h5>

                    <div class="image-preview-container">
                        @if (Model.IsEdit && !string.IsNullOrEmpty(Model.MenuItem.ImageUrl))
                        {
                            <img src="@Url.Content(Model.MenuItem.ImageUrl)" alt="@Model.MenuItem.Name" class="image-preview mb-3" id="currentImage">
                        }
                        else
                        {
                            <div id="uploadPlaceholder">
                                <i class="fas fa-cloud-upload-alt upload-icon"></i>
                                <p class="text-muted mb-0">Kéo thả hoặc click để tải ảnh</p>
                            </div>
                        }
                        <div id="imagePreview" style="display: none;">
                            <img id="preview" src="" alt="Preview" class="image-preview">
                        </div>
                    </div>

                    <input type="file" name="ImageFile" id="ImageFile" class="form-control mt-3" accept="image/*" onchange="previewImage(this)">
                    <small class="text-muted">Hỗ trợ: JPG, PNG, GIF. Tối đa: 5MB</small>
                </div>

                <!-- Actions -->
                <div class="form-card">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-save btn-lg">
                            <i class="fas fa-@(Model.IsEdit ? "save" : "plus") me-2"></i>
                            @(Model.IsEdit ? "Cập Nhật" : "Thêm Món Ăn")
                        </button>
                        <a href="@Url.Action("MenuManagement", "Management")" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Hủy
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('preview').src = e.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                    var placeholder = document.getElementById('uploadPlaceholder');
                    if (placeholder) placeholder.style.display = 'none';
                    var currentImg = document.getElementById('currentImage');
                    if (currentImg) currentImg.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var priceInput = document.querySelector('input[name="MenuItem.Price"]');
            if (priceInput) {
                priceInput.addEventListener('blur', function () {
                    var value = this.value;
                    if (value) {
                        var rounded = Math.round(value / 1000) * 1000;
                        this.value = rounded;
                    }
                });
            }
        });

        // Form validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    var isValid = true;
                    var nameField = form.querySelector('input[name="MenuItem.Name"]');
                    var categoryField = form.querySelector('select[name="MenuItem.Category"]');
                    var priceField = form.querySelector('input[name="MenuItem.Price"]');
                    var timeField = form.querySelector('input[name="MenuItem.PreparationTime"]');

                    if (nameField && !nameField.value.trim()) {
                        isValid = false;
                        nameField.classList.add('is-invalid');
                    } else if (nameField) {
                        nameField.classList.remove('is-invalid');
                    }
                    if (categoryField && !categoryField.value) {
                        isValid = false;
                        categoryField.classList.add('is-invalid');
                    } else if (categoryField) {
                        categoryField.classList.remove('is-invalid');
                    }
                    if (priceField && (!priceField.value || parseFloat(priceField.value) <= 0)) {
                        isValid = false;
                        priceField.classList.add('is-invalid');
                    } else if (priceField) {
                        priceField.classList.remove('is-invalid');
                    }
                    if (timeField && (!timeField.value || parseInt(timeField.value) <= 0)) {
                        isValid = false;
                        timeField.classList.add('is-invalid');
                    } else if (timeField) {
                        timeField.classList.remove('is-invalid');
                    }
                    if (!isValid || !form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        var firstInvalid = form.querySelector('.is-invalid, :invalid');
                        if (firstInvalid) {
                            firstInvalid.focus();
                        }
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        // Ingredient management
        var ingredientRowTemplate = `
            <tr class="ingredient-row">
                <td>
                    <input type="hidden" name="SelectedIngredients[__index__].IngredientId" value="__id__" />
                    <input type="hidden" name="SelectedIngredients[__index__].RequiredQuantity" value="0" />
                    <input type="hidden" name="SelectedIngredients[__index__].Unit" value="" />
                    <strong>__name__</strong>
                </td>
                <td>
                    <button type="button" class="btn-remove-ingredient" onclick="removeIngredientRow(this)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        `;

        document.getElementById('add-ingredient-btn').addEventListener('click', function () {
            var ddl = document.getElementById('newIngredientId');
            var errorMsg = document.getElementById('ingredient-error');

            var selectedId = ddl.value;
            var selectedName = ddl.options[ddl.selectedIndex].text;

            if (!selectedId) {
                errorMsg.classList.remove('d-none');
                return;
            }
            errorMsg.classList.add('d-none');

            var newIndex = document.getElementById('ingredient-list').getElementsByTagName('tr').length;

            var newRow = ingredientRowTemplate
                .replace(/__index__/g, newIndex)
                .replace('__id__', selectedId)
                .replace('__name__', selectedName);

            document.getElementById('ingredient-list').insertAdjacentHTML('beforeend', newRow);

            ddl.selectedIndex = 0;
        });

        function removeIngredientRow(button) {
            button.closest('tr.ingredient-row').remove();
            updateIngredientIndices();
        }

        function updateIngredientIndices() {
            var rows = document.getElementById('ingredient-list').getElementsByTagName('tr');
            for (var i = 0; i < rows.length; i++) {
                var inputs = rows[i].querySelectorAll('input, select');
                inputs.forEach(function (input) {
                    if (input.name) {
                        input.name = input.name.replace(/\[\d+\]/, '[' + i + ']');
                    }
                });
            }
        }
    </script>
}