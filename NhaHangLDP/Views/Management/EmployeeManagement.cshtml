@model List<NhaHangLDP.Models.Employee>

@{
    ViewBag.Title = "Quản lý Nhân viên";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .employee-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            height: 100%;
        }

        .employee-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

        .employee-avatar {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 15px;
        }

        .employee-name {
            font-weight: 600;
            font-size: 16px;
            color: var(--primary-dark);
            margin-bottom: 5px;
        }

        .employee-username {
            color: var(--text-gray);
            font-size: 13px;
            margin-bottom: 15px;
        }

        .employee-info {
            padding: 15px 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 15px;
        }

        .employee-info-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
            font-size: 13px;
            color: var(--text-gray);
        }

        .employee-info-item:last-child {
            margin-bottom: 0;
        }

        .employee-info-item i {
            width: 16px;
            color: var(--primary-blue);
        }

        .role-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .role-admin {
            background: #fee2e2;
            color: #dc2626;
        }

        .role-manager {
            background: #dbeafe;
            color: var(--primary-blue);
        }

        .role-cashier {
            background: #fef3c7;
            color: #d97706;
        }

        .role-staff {
            background: #dcfce7;
            color: #16a34a;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .status-dot.active {
            background: #22c55e;
        }

        .status-dot.inactive {
            background: #ef4444;
        }

        .employee-actions {
            display: flex;
            gap: 10px;
        }

        .search-filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-users me-2"></i>Quản lý Nhân viên</h1>
            <p>Quản lý thông tin và quyền hạn của nhân viên trong hệ thống</p>
        </div>
        <a href="@Url.Action("CreateEmployee", "Management")" class="btn btn-light">
            <i class="fas fa-user-plus me-2"></i>Thêm nhân viên
        </a>
    </div>
</div>

<!-- Statistics -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-users"></i>
            </div>
            <h4>@Model.Count</h4>
            <p class="mb-0">Tổng nhân viên</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="fas fa-user-check"></i>
            </div>
            <h4>@Model.Count(e => e.IsActive)</h4>
            <p class="mb-0">Đang hoạt động</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="fas fa-user-times"></i>
            </div>
            <h4>@Model.Count(e => !e.IsActive)</h4>
            <p class="mb-0">Bị khóa</p>
        </div>
    </div>
</div>

<!-- Search Box -->
<div class="search-filter-card">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border-radius: 10px 0 0 10px;">
                    <i class="fas fa-search text-muted"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0" 
                       placeholder="Tìm kiếm theo tên, tên đăng nhập, email..." 
                       style="border-radius: 0 10px 10px 0;">
            </div>
        </div>
        <div class="col-md-4 text-end">
            <select id="filterRole" class="form-select d-inline-block w-auto">
                <option value="">Tất cả chức vụ</option>
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Cashier">Cashier</option>
                <option value="Staff">Staff</option>
            </select>
        </div>
    </div>
</div>

<!-- Employee Grid -->
<div class="row" id="employeeGrid">
    @if (Model != null && Model.Any())
    {
        foreach (var employee in Model)
        {
            var avatarColors = new[] { "#3b82f6", "#22c55e", "#f59e0b", "#ef4444", "#8b5cf6", "#06b6d4" };
            var colorIndex = employee.Id % avatarColors.Length;
            var avatarColor = avatarColors[colorIndex];
            var initials = !string.IsNullOrEmpty(employee.FullName) 
                ? employee.FullName.Split(' ').Last().Substring(0, 1).ToUpper() 
                : "?";
            
            // Xác định role class
            string roleClass = "role-staff";
            if (employee.Role != null)
            {
                var roleName = employee.Role.RoleName.ToLower();
                if (roleName == "admin")
                {
                    roleClass = "role-admin";
                }
                else if (roleName == "manager")
                {
                    roleClass = "role-manager";
                }
                else if (roleName == "cashier")
                {
                    roleClass = "role-cashier";
                }
            }
            
            <div class="col-md-6 col-lg-4 mb-4 employee-item" 
                 data-name="@employee.FullName?.ToLower()" 
                 data-username="@employee.UserName?.ToLower()" 
                 data-email="@employee.Email?.ToLower()"
                 data-role="@employee.Role?.RoleName">
                <div class="employee-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="employee-avatar" style="background: @avatarColor;">
                            @initials
                        </div>
                        <div class="status-indicator">
                            <span class="status-dot @(employee.IsActive ? "active" : "inactive")"></span>
                            <span>@(employee.IsActive ? "Hoạt động" : "Bị khóa")</span>
                        </div>
                    </div>
                    
                    <div class="employee-name">@employee.FullName</div>
                    <div class="employee-username">@@@employee.UserName</div>
                    
                    @if (employee.Role != null)
                    {
                        <span class="role-badge @roleClass">@employee.Role.RoleName</span>
                    }
                    
                    <div class="employee-info">
                        @if (!string.IsNullOrEmpty(employee.Email))
                        {
                            <div class="employee-info-item">
                                <i class="fas fa-envelope"></i>
                                <span>@employee.Email</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(employee.PhoneNumber))
                        {
                            <div class="employee-info-item">
                                <i class="fas fa-phone"></i>
                                <span>@employee.PhoneNumber</span>
                            </div>
                        }
                        <div class="employee-info-item">
                            <i class="fas fa-id-badge"></i>
                            <span>ID: @employee.Id</span>
                        </div>
                    </div>
                    
                    <div class="employee-actions">
                        <a href="@Url.Action("EditEmployee", "Management", new { id = employee.Id })" 
                           class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="fas fa-edit me-1"></i>Sửa
                        </a>
                        <button type="button" class="btn btn-sm @(employee.IsActive ? "btn-outline-warning" : "btn-outline-success") flex-fill"
                                onclick="toggleEmployeeStatus(@employee.Id)">
                            <i class="fas @(employee.IsActive ? "fa-lock" : "fa-unlock") me-1"></i>
                            @(employee.IsActive ? "Khóa" : "Mở khóa")
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="stat-card text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">Chưa có nhân viên nào trong hệ thống</h5>
                <a href="@Url.Action("CreateEmployee", "Management")" class="btn btn-primary-custom mt-3">
                    <i class="fas fa-user-plus me-2"></i>Thêm nhân viên đầu tiên
                </a>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('keyup', function () {
                filterEmployees();
            });

            // Filter by role
            $('#filterRole').on('change', function () {
                filterEmployees();
            });

            function filterEmployees() {
                var searchValue = $('#searchInput').val().toLowerCase();
                var roleValue = $('#filterRole').val();

                $('.employee-item').each(function () {
                    var name = $(this).data('name') || '';
                    var username = $(this).data('username') || '';
                    var email = $(this).data('email') || '';
                    var role = $(this).data('role') || '';

                    var matchSearch = name.indexOf(searchValue) > -1 || 
                                     username.indexOf(searchValue) > -1 || 
                                     email.indexOf(searchValue) > -1;
                    var matchRole = !roleValue || role === roleValue;

                    $(this).toggle(matchSearch && matchRole);
                });
            }

            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: '@TempData["Success"]',
                    showConfirmButton: false,
                    timer: 3000
                });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: '@TempData["Error"]',
                    showConfirmButton: true
                });
                </text>
            }
        });

        function toggleEmployeeStatus(employeeId) {
            Swal.fire({
                title: 'Xác nhận thay đổi?',
                text: 'Bạn có chắc chắn muốn thay đổi trạng thái của nhân viên này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleEmployeeStatus", "Management")',
                        type: 'POST',
                        data: { id: employeeId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: response.message,
                                    showConfirmButton: false,
                                    timer: 2000
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: response.message
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi!',
                                text: 'Có lỗi xảy ra khi thực hiện thao tác'
                            });
                        }
                    });
                }
            });
        }
    </script>
}