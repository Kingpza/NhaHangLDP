@model NhaHangLDP.Models.InventoryReportViewModel
@{
    ViewBag.Title = "Báo Cáo Kho";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2><i class="fas fa-chart-bar me-2"></i>Báo Cáo Kho Nguyên Liệu</h2>
        <p class="text-light">Phân tích và thống kê tổng quan về kho</p>
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group">
            <button class="btn btn-outline-success btn-sm" onclick="exportReport('excel')">
                <i class="fas fa-file-excel me-1"></i>Xuất Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportReport('pdf')">
                <i class="fas fa-file-pdf me-1"></i>Xuất PDF
            </button>
            <button class="btn btn-outline-info btn-sm" onclick="printReport()">
                <i class="fas fa-print me-1"></i>In Báo Cáo
            </button>
        </div>
        <a href="@Url.Action("Inventory", "Management")" class="btn btn-outline-light ms-2">
            <i class="fas fa-warehouse me-2"></i>Quay Lại Kho
        </a>
    </div>
</div>

<!-- Filter Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="stat-card">
            <h5><i class="fas fa-filter me-2"></i>Bộ Lọc Báo Cáo</h5>
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" class="form-control" id="fromDate" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" class="form-control" id="toDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Danh mục</label>
                    <select class="form-select" id="categoryFilter">
                        <option value="">Tất cả danh mục</option>
                        <option value="Thịt">Thịt</option>
                        <option value="Rau củ">Rau củ</option>
                        <option value="Ngũ cốc">Ngũ cốc</option>
                        <option value="Gia vị">Gia vị</option>
                        <option value="Đồ uống">Đồ uống</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-custom w-100" onclick="updateReport()">
                        <i class="fas fa-refresh me-1"></i>Cập Nhật Báo Cáo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(40, 167, 69, 0.3);">
                <i class="fas fa-boxes"></i>
            </div>
            <h4>@Model.TotalIngredients</h4>
            <p>Tổng Nguyên Liệu</p>
            <small class="text-success">Đang quản lý</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(0, 123, 255, 0.3);">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <h4>@Model.TotalInventoryValue.ToString("N0") VNĐ</h4>
            <p>Tổng Giá Trị Kho</p>
            <small class="text-info">Tài sản hiện tại</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(255, 193, 7, 0.3);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h4>@Model.LowStockCount</h4>
            <p>Nguyên Liệu Thiếu</p>
            <small class="text-warning">Cần nhập thêm</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(220, 53, 69, 0.3);">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <h4>@Model.MonthlyDamageValue.ToString("N0") VNĐ</h4>
            <p>Thiệt Hại Tháng Này</p>
            <small class="text-danger">Tổn thất</small>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="stat-card">
            <h5><i class="fas fa-chart-line me-2"></i>Xu Hướng Giá Trị Kho 30 Ngày Qua</h5>
            <canvas id="inventoryValueChart" width="400" height="200"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <h5><i class="fas fa-chart-pie me-2"></i>Phân Bổ Theo Danh Mục</h5>
            <canvas id="categoryChart" width="200" height="200"></canvas>
        </div>
    </div>
</div>

<!-- Detailed Reports -->
<div class="row">
    <!-- High Value Ingredients -->
    <div class="col-md-6">
        <div class="stat-card">
            <h5><i class="fas fa-chart-bar me-2"></i>Top Nguyên Liệu Có Giá Trị Cao</h5>
            <div class="table-responsive">
                <table class="table table-custom table-sm">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th>Tồn Kho</th>
                            <th>Giá Trị</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HighValueIngredients != null && Model.HighValueIngredients.Any())
                        {
                            foreach (var item in Model.HighValueIngredients.Take(10))
                            {
                                <tr>
                                    <td><strong>@item.IngredientName</strong></td>
                                    <td>@item.AvailableStock.ToString("N1") @item.Unit</td>
                                    <td class="text-success"><strong>@item.TotalValue.ToString("N0") VNĐ</strong></td>
                                    <td>
                                        @switch (item.StockStatus)
                                        {
                                            case "in-stock":
                                                <span class="badge bg-success">Đủ hàng</span>
                                                break;
                                            case "low-stock":
                                                <span class="badge bg-warning">Sắp hết</span>
                                                break;
                                            case "out-of-stock":
                                                <span class="badge bg-danger">Hết hàng</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">N/A</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Chưa có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Alert Ingredients -->
    <div class="col-md-6">
        <div class="stat-card">
            <h5><i class="fas fa-clock me-2"></i>Nguyên Liệu Cần Cảnh Báo</h5>
            <div class="table-responsive">
                <table class="table table-custom table-sm">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th>Tồn Kho</th>
                            <th>Tối Thiểu</th>
                            <th>Mức Độ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AlertIngredients != null && Model.AlertIngredients.Any())
                        {
                            foreach (var item in Model.AlertIngredients.Take(10))
                            {
                                var percentage = item.LowStockThreshold > 0 ? (item.AvailableStock / item.LowStockThreshold) * 100 : 0;
                                <tr>
                                    <td><strong>@item.IngredientName</strong></td>
                                    <td class="text-danger">@item.AvailableStock.ToString("N1") @item.Unit</td>
                                    <td>@item.LowStockThreshold.ToString("N1") @item.Unit</td>
                                    <td>
                                        @if (percentage <= 20)
                                        {
                                            <span class="badge bg-danger">Nguy hiểm</span>
                                        }
                                        else if (percentage <= 50)
                                        {
                                            <span class="badge bg-warning">Cảnh báo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">Chú ý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-success">
                                    <i class="fas fa-check-circle me-2"></i>Tất cả nguyên liệu đều đủ số lượng
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities -->
<div class="row mt-4">
    <!-- Recent Inbounds -->
    <div class="col-md-6">
        <div class="stat-card">
            <h5><i class="fas fa-arrow-up text-success me-2"></i>Hoạt Động Nhập Kho Gần Đây</h5>
            <div class="table-responsive">
                <table class="table table-custom table-sm">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Nhân Viên</th>
                            <th>Nhà CC</th>
                            <th>Giá Trị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentInbounds != null && Model.RecentInbounds.Any())
                        {
                            foreach (var inbound in Model.RecentInbounds.Take(8))
                            {
                                <tr>
                                    <td>
                                        <small>@inbound.InboundDate.ToString("dd/MM")</small><br>
                                        <small class="text-muted">@inbound.InboundDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>@inbound.EmployeeName</td>
                                    <td>
                                        <small>@inbound.SupplierName</small><br>
                                        <small class="text-muted">@inbound.ItemCount mặt hàng</small>
                                    </td>
                                    <td class="text-success">
                                        <strong>@inbound.TotalCost.ToString("N0")</strong>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Chưa có hoạt động nhập kho</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Damages -->
    <div class="col-md-6">
        <div class="stat-card">
            <h5><i class="fas fa-exclamation-triangle text-danger me-2"></i>Báo Cáo Thiệt Hại Gần Đây</h5>
            <div class="table-responsive">
                <table class="table table-custom table-sm">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Nguyên Liệu</th>
                            <th>SL</th>
                            <th>Thiệt Hại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentDamages != null && Model.RecentDamages.Any())
                        {
                            foreach (var damage in Model.RecentDamages.Take(8))
                            {
                                <tr>
                                    <td>
                                        <small>@damage.DamageDate.ToString("dd/MM")</small><br>
                                        <small class="text-muted">@damage.DamageDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <strong>@damage.IngredientName</strong><br>
                                        <small class="text-muted">@damage.Reason</small>
                                    </td>
                                    <td>@damage.Quantity.ToString("N1") @damage.Unit</td>
                                    <td class="text-danger">
                                        <strong>@damage.EstimatedLoss.ToString("N0")</strong>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Chưa có báo cáo thiệt hại</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Report Info -->
<div class="row mt-4">
    <div class="col-12">
        <div class="stat-card text-center">
            <p class="mb-0">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Báo cáo được tạo lúc:</strong> @Model.ReportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")
                <span class="ms-3">
                    <i class="fas fa-user me-2"></i>
                    <strong>Người tạo:</strong> @Session["Username"]
                </span>
            </p>
        </div>
    </div>
</div>

<style>
    .damage-item {
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

        .damage-item:last-child {
            border-bottom: none;
        }

    .recommendation-card {
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        color: white;
        margin-bottom: 15px;
    }

        .recommendation-card i {
            opacity: 0.8;
        }

        .recommendation-card h6 {
            font-weight: bold;
            margin: 10px 0;
        }

        .recommendation-card p {
            font-size: 0.9rem;
            margin-bottom: 15px;
        }
</style>

@section scripts {
    <script>
        // Inventory Value Trend Chart
        const inventoryCtx = document.getElementById('inventoryValueChart').getContext('2d');
        new Chart(inventoryCtx, {
            type: 'line',
            data: {
                labels: ['30 ngày trước', '25 ngày', '20 ngày', '15 ngày', '10 ngày', '5 ngày', 'Hôm nay'],
                datasets: [{
                    label: 'Giá trị kho (VNĐ)',
                    data: [
                        @Model.TotalInventoryValue * 0.85m,
                        @Model.TotalInventoryValue * 0.90m,
                        @Model.TotalInventoryValue * 0.95m,
                        @Model.TotalInventoryValue * 0.92m,
                        @Model.TotalInventoryValue * 0.98m,
                        @Model.TotalInventoryValue * 0.96m,
                        @Model.TotalInventoryValue
                    ],
                    borderColor: '#ffd700',
                    backgroundColor: 'rgba(255, 215, 0, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { labels: { color: '#fff' } }
                },
                scales: {
                    x: { ticks: { color: '#fff' } },
                    y: {
                        ticks: {
                            color: '#fff',
                            callback: function(value) {
                                return (value / 1000000).toFixed(1) + 'M VNĐ';
                            }
                        }
                    }
                }
            }
        });

        // Category Distribution Chart - using real data from high value ingredients
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        
        // Group ingredients by category (simplified categorization)
        const categoryData = {};
        
        @if (Model.HighValueIngredients != null && Model.HighValueIngredients.Any())
        {
            <text>
            // Process each ingredient for categorization
            </text>
            
            foreach (var item in Model.HighValueIngredients)
            {
                <text>
                // Simplified category detection based on ingredient name
                (function() {
                    let category = 'Khác';
                    const name = '@Html.Raw(item.IngredientName.ToLower())';
                    if (name.includes('thịt') || name.includes('bò') || name.includes('heo') || name.includes('gà') || name.includes('tôm') || name.includes('cá')) {
                        category = 'Thịt & Hải sản';
                    } else if (name.includes('cà') || name.includes('hành') || name.includes('rau') || name.includes('tỏi') || name.includes('gừng') || name.includes('ớt')) {
                        category = 'Rau củ quả';
                    } else if (name.includes('gạo') || name.includes('mì') || name.includes('dầu')) {
                        category = 'Ngũ cốc & Dầu';
                    } else if (name.includes('muối') || name.includes('đường') || name.includes('nước mắm')) {
                        category = 'Gia vị';
                    } else if (name.includes('nước') || name.includes('bia')) {
                        category = 'Đồ uống';
                    }
                    
                    if (!categoryData[category]) {
                        categoryData[category] = 0;
                    }
                    categoryData[category] += @item.TotalValue;
                })();
                </text>
            }
        }

        const categoryLabels = Object.keys(categoryData);
        const categoryValues = Object.values(categoryData);
        
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: categoryLabels.length > 0 ? categoryLabels : ['Chưa có dữ liệu'],
                datasets: [{
                    data: categoryValues.length > 0 ? categoryValues : [1],
                    backgroundColor: [
                        '#ff6b6b',
                        '#4ecdc4',
                        '#45b7d1',
                        '#ffd93d',
                        '#6c5ce7',
                        '#95a5a6'
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#fff', font: { size: 10 } }
                    }
                }
            }
        });

        function updateReport() {
            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;
            const category = document.getElementById('categoryFilter').value;

            console.log('Updating report with filters:', { fromDate, toDate, category });
            
            // Show loading state
            const button = event.target;
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang cập nhật...';
            button.disabled = true;

            // Simulate API call - in real implementation, this would be an AJAX call to server
            setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
                
                // For now, just reload the page with parameters (simple implementation)
                const params = new URLSearchParams();
                if (fromDate) params.set('fromDate', fromDate);
                if (toDate) params.set('toDate', toDate);
                if (category) params.set('category', category);
                
                const newUrl = '@Url.Action("InventoryReport", "Management")' + (params.toString() ? '?' + params.toString() : '');
                window.location.href = newUrl;
            }, 1500);
        }

        function exportReport(format) {
            const button = event.target;
            const originalText = button.innerHTML;
            
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang xuất...';
            button.disabled = true;

            setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
                
                if (format === 'pdf') {
                    // Simple PDF export using browser print
                    window.print();
                } else {
                    alert(`Chức năng xuất ${format.toUpperCase()} sẽ được phát triển trong phiên bản tiếp theo`);
                }
            }, 1000);
        }

        function printReport() {
            window.print();
        }

        // Auto-refresh notification after 10 minutes
        setTimeout(function() {
            if (confirm('Dữ liệu có thể đã thay đổi sau 10 phút. Bạn có muốn tải lại báo cáo?')) {
                location.reload();
            }
        }, 600000);

        // Initialize tooltips if Bootstrap is available
        if (typeof bootstrap !== 'undefined') {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }
    </script>
}