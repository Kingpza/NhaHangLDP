@model NhaHangLDP.Models.InventoryReportViewModel
@{
    ViewBag.Title = "Báo Cáo Kho";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .filter-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 20px;
        }

        .chart-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .chart-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* Fix chiều cao chart */
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }

        .chart-container-small {
            position: relative;
            height: 250px;
            width: 100%;
        }

        .data-table-card {
            background: var(--bg-white);
            border-radius: 15px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            margin-bottom: 25px;
        }

        .data-table-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border-color);
            padding: 20px 25px;
        }

        .data-table-card .card-header h5 {
            margin: 0;
            font-weight: 600;
            color: var(--primary-dark);
        }

        .report-info {
            background: var(--bg-light);
            border-radius: 15px;
            padding: 15px 25px;
            text-align: center;
            color: var(--text-gray);
        }

        .export-btn-group .btn {
            border-radius: 20px;
            padding: 6px 15px;
            font-size: 13px;
        }

        /* Fix table không quá dài */
        .table-limited {
            max-height: 400px;
            overflow-y: auto;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-chart-bar me-2"></i>Báo Cáo Kho Nguyên Liệu</h1>
            <p>Phân tích và thống kê tổng quan về kho</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="export-btn-group">
                <a href="@Url.Action("ExportInventoryReport", "Management")" class="btn btn-outline-light btn-sm">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </a>
                <button class="btn btn-outline-light btn-sm" onclick="window.print()">
                    <i class="fas fa-print me-1"></i>In
                </button>
            </div>
            <a href="@Url.Action("Inventory", "Management")" class="btn btn-light">
                <i class="fas fa-warehouse me-2"></i>Quay Lại Kho
            </a>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-card">
    <h5><i class="fas fa-filter me-2"></i>Bộ Lọc Báo Cáo</h5>
    <form method="get" class="row align-items-end">
        <div class="col-md-3">
            <label class="form-label">Từ ngày</label>
            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
        </div>
        <div class="col-md-3">
            <label class="form-label">Đến ngày</label>
            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
        </div>
        <div class="col-md-3">
            <label class="form-label">Khoảng nhanh</label>
            <select class="form-select" id="quickPeriod">
                <option value="">Tùy chọn</option>
                <option value="week">7 ngày qua</option>
                <option value="month">30 ngày qua</option>
                <option value="quarter">90 ngày qua</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary-custom w-100">
                <i class="fas fa-sync-alt me-1"></i>Cập Nhật Báo Cáo
            </button>
        </div>
    </form>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-boxes"></i>
            </div>
            <h4>@Model.TotalIngredients</h4>
            <p class="mb-0">Tổng Nguyên Liệu</p>
            <small class="text-muted">Đang quản lý</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <h4>@Model.TotalInventoryValue.ToString("N0")</h4>
            <p class="mb-0">Tổng Giá Trị (VNĐ)</p>
            <small class="text-success">Tài sản hiện tại</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h4>@Model.LowStockCount</h4>
            <p class="mb-0">Nguyên Liệu Thiếu</p>
            <small class="text-warning">Cần nhập thêm</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="fas fa-times-circle"></i>
            </div>
            <h4>@Model.OutOfStockCount</h4>
            <p class="mb-0">Hết Hàng</p>
            <small class="text-danger">Cần nhập gấp</small>
        </div>
    </div>
</div>

<!-- Inbound/Outbound Summary -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Tổng Nhập Kho (Kỳ Báo Cáo)</h6>
                    <h3 class="text-success mb-0">@Model.TotalInboundValue.ToString("N0") <small>VNĐ</small></h3>
                    <small class="text-muted">@Model.TotalInboundQuantity.ToString("N1") đơn vị</small>
                </div>
                <div class="stat-icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                    <i class="fas fa-arrow-down"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Tổng Xuất/Hỏng (Kỳ Báo Cáo)</h6>
                    <h3 class="text-danger mb-0">@Model.TotalOutboundValue.ToString("N0") <small>VNĐ</small></h3>
                    <small class="text-muted">@Model.TotalOutboundQuantity.ToString("N1") đơn vị</small>
                </div>
                <div class="stat-icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                    <i class="fas fa-arrow-up"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <h5><i class="fas fa-chart-line me-2"></i>Xu Hướng Nhập/Xuất Kho</h5>
            <div class="chart-container">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h5><i class="fas fa-chart-pie me-2"></i>Phân Bổ Theo Danh Mục</h5>
            <div class="chart-container-small">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Top Ingredients -->
<div class="row">
    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-arrow-down me-2" style="color: #22c55e;"></i>Top Nguyên Liệu Nhập Nhiều</h5>
            </div>
            <div class="table-responsive table-limited">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th class="text-end">Số Lượng</th>
                            <th class="text-end">Giá Trị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopInboundIngredients != null && Model.TopInboundIngredients.Any())
                        {
                            foreach (var item in Model.TopInboundIngredients.Take(8))
                            {
                                <tr>
                                    <td><strong style="color: var(--primary-dark);">@item.IngredientName</strong></td>
                                    <td class="text-end">@item.TotalQuantity.ToString("N1") @item.Unit</td>
                                    <td class="text-end text-success"><strong>@item.TotalValue.ToString("N0") VNĐ</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu trong kỳ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-arrow-up me-2" style="color: #ef4444;"></i>Top Nguyên Liệu Xuất/Hỏng</h5>
            </div>
            <div class="table-responsive table-limited">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th class="text-end">Số Lượng</th>
                            <th class="text-end">Giá Trị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopOutboundIngredients != null && Model.TopOutboundIngredients.Any())
                        {
                            foreach (var item in Model.TopOutboundIngredients.Take(8))
                            {
                                <tr>
                                    <td><strong style="color: var(--primary-dark);">@item.IngredientName</strong></td>
                                    <td class="text-end">@item.TotalQuantity.ToString("N1") @item.Unit</td>
                                    <td class="text-end text-danger"><strong>@item.TotalValue.ToString("N0") VNĐ</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu trong kỳ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Category Stats -->
<div class="data-table-card">
    <div class="card-header">
        <h5><i class="fas fa-layer-group me-2"></i>Thống Kê Theo Danh Mục</h5>
    </div>
    <div class="table-responsive table-limited">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>Danh Mục</th>
                    <th class="text-center">Số Mặt Hàng</th>
                    <th class="text-end">Tổng Tồn Kho</th>
                    <th class="text-end">Giá Trị</th>
                    <th class="text-center">Sắp Hết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.CategoryStats != null && Model.CategoryStats.Any())
                {
                    foreach (var cat in Model.CategoryStats)
                    {
                        <tr>
                            <td><strong>@cat.CategoryName</strong></td>
                            <td class="text-center">@cat.ItemCount</td>
                            <td class="text-end">@cat.TotalStock.ToString("N1")</td>
                            <td class="text-end text-success">@cat.TotalValue.ToString("N0") VNĐ</td>
                            <td class="text-center">
                                @if (cat.LowStockCount > 0)
                                {
                                    <span class="badge badge-warning">@cat.LowStockCount</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">0</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu danh mục</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Expiring Items Alert -->
@if (Model.ExpiringItems != null && Model.ExpiringItems.Any())
{
    <div class="data-table-card">
        <div class="card-header" style="background: #fef3c7;">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="text-warning mb-0"><i class="fas fa-clock me-2"></i>Nguyên Liệu Sắp Hết Hạn (@Model.ExpiringItems.Count mặt hàng)</h5>
                <a href="@Url.Action("ExpiringItems", "Management")" class="btn btn-sm btn-outline-warning">Xem tất cả</a>
            </div>
        </div>
        <div class="table-responsive table-limited">
            <table class="table table-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nguyên Liệu</th>
                        <th class="text-center">Số Lô</th>
                        <th class="text-end">Số Lượng</th>
                        <th class="text-center">Ngày Hết Hạn</th>
                        <th class="text-center">Còn Lại</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ExpiringItems.Take(5))
                    {
                        var rowClass = item.DaysUntilExpiry <= 0 ? "table-danger" : item.DaysUntilExpiry <= 3 ? "table-warning" : "";
                        <tr class="@rowClass">
                            <td><strong>@item.IngredientName</strong></td>
                            <td class="text-center">@(item.BatchNumber ?? "N/A")</td>
                            <td class="text-end">@item.Quantity.ToString("N1") @item.Unit</td>
                            <td class="text-center">@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (item.DaysUntilExpiry <= 0)
                                {
                                    <span class="badge badge-danger">Đã hết hạn</span>
                                }
                                else
                                {
                                    <span class="badge @(item.DaysUntilExpiry <= 3 ? "badge-warning" : "badge-info")">@item.DaysUntilExpiry ngày</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Report Info -->
<div class="report-info">
    <p class="mb-0">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Kỳ báo cáo:</strong> @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")
        <span class="ms-3">
            <i class="fas fa-clock me-2"></i>
            <strong>Tạo lúc:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
        </span>
    </p>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Trend Chart với chiều cao cố định
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.DailyTrends?.Select(d => $"'{d.DateText}'") ?? new List<string>()))],
                datasets: [{
                    label: 'Nhập kho',
                    data: [@(string.Join(",", Model.DailyTrends?.Select(d => d.InboundValue) ?? new List<decimal>()))],
                    borderColor: '#22c55e',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    fill: true,
                    tension: 0.4
                }, {
                    label: 'Xuất/Hỏng',
                    data: [@(string.Join(",", Model.DailyTrends?.Select(d => d.OutboundValue) ?? new List<decimal>()))],
                    borderColor: '#ef4444',
                    backgroundColor: 'rgba(239, 68, 68, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) {
                                    return (value / 1000000).toFixed(1) + 'M';
                                } else if (value >= 1000) {
                                    return (value / 1000).toFixed(0) + 'K';
                                }
                                return value;
                            }
                        }
                    }
                }
            }
        });

        // Category Chart với chiều cao cố định
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        const categoryLabels = [@Html.Raw(string.Join(",", Model.CategoryStats?.Select(c => $"'{c.CategoryName}'") ?? new List<string>()))];
        const categoryData = [@(string.Join(",", Model.CategoryStats?.Select(c => c.TotalValue) ?? new List<decimal>()))];
        
        // Chỉ vẽ chart nếu có dữ liệu
        if (categoryLabels.length > 0 && categoryData.some(v => v > 0)) {
            new Chart(categoryCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryData,
                        backgroundColor: ['#3b82f6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 10
                            }
                        }
                    }
                }
            });
        } else {
            // Hiển thị thông báo khi không có dữ liệu
            document.getElementById('categoryChart').parentElement.innerHTML = '<div class="text-center text-muted py-5"><i class="fas fa-chart-pie fa-3x mb-3 opacity-25"></i><p>Chưa có dữ liệu danh mục</p></div>';
        }

        // Quick period filter
        document.getElementById('quickPeriod').addEventListener('change', function() {
            const period = this.value;
            if (!period) return;

            const today = new Date();
            let fromDate;

            switch (period) {
                case 'week':
                    fromDate = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
                    break;
                case 'month':
                    fromDate = new Date(today.getTime() - 30 * 24 * 60 * 60 * 1000);
                    break;
                case 'quarter':
                    fromDate = new Date(today.getTime() - 90 * 24 * 60 * 60 * 1000);
                    break;
            }

            document.querySelector('input[name="fromDate"]').value = fromDate.toISOString().split('T')[0];
            document.querySelector('input[name="toDate"]').value = today.toISOString().split('T')[0];
        });
    </script>
}