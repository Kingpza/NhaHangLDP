@model NhaHangLDP.Models.InventoryReportViewModel
@{
    ViewBag.Title = "Báo Cáo Kho";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .filter-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .filter-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 20px;
        }

        .chart-card {
            background: var(--bg-white);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .chart-card h5 {
            color: var(--primary-dark);
            font-weight: 600;
            margin-bottom: 20px;
        }

        .data-table-card {
            background: var(--bg-white);
            border-radius: 15px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            margin-bottom: 25px;
        }

        .data-table-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border-color);
            padding: 20px 25px;
        }

        .data-table-card .card-header h5 {
            margin: 0;
            font-weight: 600;
            color: var(--primary-dark);
        }

        .report-info {
            background: var(--bg-light);
            border-radius: 15px;
            padding: 15px 25px;
            text-align: center;
            color: var(--text-gray);
        }

        .export-btn-group .btn {
            border-radius: 20px;
            padding: 6px 15px;
            font-size: 13px;
        }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-chart-bar me-2"></i>Báo Cáo Kho Nguyên Liệu</h1>
            <p>Phân tích và thống kê tổng quan về kho</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="export-btn-group">
                <button class="btn btn-outline-light btn-sm" onclick="exportReport('excel')">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </button>
                <button class="btn btn-outline-light btn-sm" onclick="exportReport('pdf')">
                    <i class="fas fa-file-pdf me-1"></i>PDF
                </button>
                <button class="btn btn-outline-light btn-sm" onclick="printReport()">
                    <i class="fas fa-print me-1"></i>In
                </button>
            </div>
            <a href="@Url.Action("Inventory", "Management")" class="btn btn-light">
                <i class="fas fa-warehouse me-2"></i>Quay Lại Kho
            </a>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-card">
    <h5><i class="fas fa-filter me-2"></i>Bộ Lọc Báo Cáo</h5>
    <div class="row align-items-end">
        <div class="col-md-3">
            <label class="form-label">Từ ngày</label>
            <input type="date" class="form-control" id="fromDate" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-3">
            <label class="form-label">Đến ngày</label>
            <input type="date" class="form-control" id="toDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-3">
            <label class="form-label">Danh mục</label>
            <select class="form-select" id="categoryFilter">
                <option value="">Tất cả danh mục</option>
                <option value="Thịt">Thịt</option>
                <option value="Rau củ">Rau củ</option>
                <option value="Ngũ cốc">Ngũ cốc</option>
                <option value="Gia vị">Gia vị</option>
                <option value="Đồ uống">Đồ uống</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary-custom w-100" onclick="updateReport()">
                <i class="fas fa-sync-alt me-1"></i>Cập Nhật Báo Cáo
            </button>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(59, 130, 246, 0.1); color: var(--primary-blue);">
                <i class="fas fa-boxes"></i>
            </div>
            <h4>@Model.TotalIngredients</h4>
            <p class="mb-0">Tổng Nguyên Liệu</p>
            <small class="text-muted">Đang quản lý</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <h4>@Model.TotalInventoryValue.ToString("N0")</h4>
            <p class="mb-0">Tổng Giá Trị (VNĐ)</p>
            <small class="text-success">Tài sản hiện tại</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h4>@Model.LowStockCount</h4>
            <p class="mb-0">Nguyên Liệu Thiếu</p>
            <small class="text-warning">Cần nhập thêm</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                <i class="fas fa-chart-line"></i>
            </div>
            <h4>@Model.MonthlyDamageValue.ToString("N0")</h4>
            <p class="mb-0">Thiệt Hại Tháng (VNĐ)</p>
            <small class="text-danger">Tổn thất</small>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <h5><i class="fas fa-chart-line me-2"></i>Xu Hướng Giá Trị Kho 30 Ngày Qua</h5>
            <canvas id="inventoryValueChart" height="120"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h5><i class="fas fa-chart-pie me-2"></i>Phân Bổ Theo Danh Mục</h5>
            <canvas id="categoryChart" height="200"></canvas>
        </div>
    </div>
</div>

<!-- Detailed Reports -->
<div class="row">
    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-chart-bar me-2"></i>Top Nguyên Liệu Có Giá Trị Cao</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th>Tồn Kho</th>
                            <th>Giá Trị</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HighValueIngredients != null && Model.HighValueIngredients.Any())
                        {
                            foreach (var item in Model.HighValueIngredients.Take(10))
                            {
                                <tr>
                                    <td><strong style="color: var(--primary-dark);">@item.IngredientName</strong></td>
                                    <td>@item.AvailableStock.ToString("N1") @item.Unit</td>
                                    <td style="color: #16a34a;"><strong>@item.TotalValue.ToString("N0") VNĐ</strong></td>
                                    <td>
                                        @if (item.StockStatus == "in-stock")
                                        {
                                            <span class="badge badge-success">Đủ hàng</span>
                                        }
                                        else if (item.StockStatus == "low-stock")
                                        {
                                            <span class="badge badge-warning">Sắp hết</span>
                                        }
                                        else if (item.StockStatus == "out-of-stock")
                                        {
                                            <span class="badge badge-danger">Hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-clock me-2" style="color: #f59e0b;"></i>Nguyên Liệu Cần Cảnh Báo</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nguyên Liệu</th>
                            <th>Tồn Kho</th>
                            <th>Tối Thiểu</th>
                            <th>Mức Độ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AlertIngredients != null && Model.AlertIngredients.Any())
                        {
                            foreach (var item in Model.AlertIngredients.Take(10))
                            {
                                var percentage = item.LowStockThreshold > 0 ? (item.AvailableStock / item.LowStockThreshold) * 100 : 0;
                                <tr>
                                    <td><strong style="color: var(--primary-dark);">@item.IngredientName</strong></td>
                                    <td style="color: #ef4444;">@item.AvailableStock.ToString("N1") @item.Unit</td>
                                    <td>@item.LowStockThreshold.ToString("N1") @item.Unit</td>
                                    <td>
                                        @if (percentage <= 20)
                                        {
                                            <span class="badge badge-danger">Nguy hiểm</span>
                                        }
                                        else if (percentage <= 50)
                                        {
                                            <span class="badge badge-warning">Cảnh báo</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info">Chú ý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4" style="color: #22c55e;">
                                    <i class="fas fa-check-circle me-2"></i>Tất cả nguyên liệu đều đủ số lượng
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities -->
<div class="row">
    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-arrow-up me-2" style="color: #22c55e;"></i>Hoạt Động Nhập Kho Gần Đây</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Nhân Viên</th>
                            <th>Nhà CC</th>
                            <th>Giá Trị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentInbounds != null && Model.RecentInbounds.Any())
                        {
                            foreach (var inbound in Model.RecentInbounds.Take(8))
                            {
                                <tr>
                                    <td>
                                        <small>@inbound.InboundDate.ToString("dd/MM")</small><br>
                                        <small class="text-muted">@inbound.InboundDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>@inbound.EmployeeName</td>
                                    <td>
                                        <small>@inbound.SupplierName</small><br>
                                        <small class="text-muted">@inbound.ItemCount mặt hàng</small>
                                    </td>
                                    <td style="color: #22c55e;"><strong>@inbound.TotalCost.ToString("N0")</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có hoạt động nhập kho</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="data-table-card">
            <div class="card-header">
                <h5><i class="fas fa-exclamation-triangle me-2" style="color: #ef4444;"></i>Báo Cáo Thiệt Hại Gần Đây</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Nguyên Liệu</th>
                            <th>SL</th>
                            <th>Thiệt Hại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentDamages != null && Model.RecentDamages.Any())
                        {
                            foreach (var damage in Model.RecentDamages.Take(8))
                            {
                                <tr>
                                    <td>
                                        <small>@damage.DamageDate.ToString("dd/MM")</small><br>
                                        <small class="text-muted">@damage.DamageDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <strong style="color: var(--primary-dark);">@damage.IngredientName</strong><br>
                                        <small class="text-muted">@damage.Reason</small>
                                    </td>
                                    <td>@damage.Quantity.ToString("N1") @damage.Unit</td>
                                    <td style="color: #ef4444;"><strong>@damage.EstimatedLoss.ToString("N0")</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có báo cáo thiệt hại</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Report Info -->
<div class="report-info">
    <p class="mb-0">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Báo cáo được tạo lúc:</strong> @Model.ReportGeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")
        <span class="ms-3">
            <i class="fas fa-user me-2"></i>
            <strong>Người tạo:</strong> @Session["Username"]
        </span>
    </p>
</div>

@section scripts {
    <script>
        // Inventory Value Trend Chart
        const inventoryCtx = document.getElementById('inventoryValueChart').getContext('2d');
        
        var gradient = inventoryCtx.createLinearGradient(0, 0, 0, 200);
        gradient.addColorStop(0, 'rgba(59, 130, 246, 0.3)');
        gradient.addColorStop(1, 'rgba(59, 130, 246, 0.01)');

        new Chart(inventoryCtx, {
            type: 'line',
            data: {
                labels: ['30 ngày trước', '25 ngày', '20 ngày', '15 ngày', '10 ngày', '5 ngày', 'Hôm nay'],
                datasets: [{
                    label: 'Giá trị kho (VNĐ)',
                    data: [
                        @Model.TotalInventoryValue * 0.85m,
                        @Model.TotalInventoryValue * 0.90m,
                        @Model.TotalInventoryValue * 0.95m,
                        @Model.TotalInventoryValue * 0.92m,
                        @Model.TotalInventoryValue * 0.98m,
                        @Model.TotalInventoryValue * 0.96m,
                        @Model.TotalInventoryValue
                    ],
                    borderColor: '#3b82f6',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#3b82f6',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b' }
                    },
                    y: {
                        grid: { color: 'rgba(0,0,0,0.05)' },
                        ticks: {
                            color: '#64748b',
                            callback: function(value) {
                                return (value / 1000000).toFixed(1) + 'M';
                            }
                        }
                    }
                }
            }
        });

        // Category Distribution Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        const categoryData = {};
        
        @if (Model.HighValueIngredients != null && Model.HighValueIngredients.Any())
        {
            foreach (var item in Model.HighValueIngredients)
            {
                <text>
                (function() {
                    let category = 'Khác';
                    const name = '@Html.Raw(item.IngredientName.ToLower())';
                    if (name.includes('thịt') || name.includes('bò') || name.includes('heo') || name.includes('gà') || name.includes('tôm') || name.includes('cá')) {
                        category = 'Thịt & Hải sản';
                    } else if (name.includes('cà') || name.includes('hành') || name.includes('rau') || name.includes('tỏi') || name.includes('gừng') || name.includes('ớt')) {
                        category = 'Rau củ quả';
                    } else if (name.includes('gạo') || name.includes('mì') || name.includes('dầu')) {
                        category = 'Ngũ cốc & Dầu';
                    } else if (name.includes('muối') || name.includes('đường') || name.includes('nước mắm')) {
                        category = 'Gia vị';
                    } else if (name.includes('nước') || name.includes('bia')) {
                        category = 'Đồ uống';
                    }
                    
                    if (!categoryData[category]) {
                        categoryData[category] = 0;
                    }
                    categoryData[category] += @item.TotalValue;
                })();
                </text>
            }
        }

        const categoryLabels = Object.keys(categoryData);
        const categoryValues = Object.values(categoryData);
        
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: categoryLabels.length > 0 ? categoryLabels : ['Chưa có dữ liệu'],
                datasets: [{
                    data: categoryValues.length > 0 ? categoryValues : [1],
                    backgroundColor: ['#3b82f6', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6', '#64748b']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#64748b', font: { size: 11 }, padding: 15 }
                    }
                }
            }
        });

        function updateReport() {
            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;
            const category = document.getElementById('categoryFilter').value;

            const button = event.target;
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang cập nhật...';
            button.disabled = true;

            setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
                
                const params = new URLSearchParams();
                if (fromDate) params.set('fromDate', fromDate);
                if (toDate) params.set('toDate', toDate);
                if (category) params.set('category', category);
                
                const newUrl = '@Url.Action("InventoryReport", "Management")' + (params.toString() ? '?' + params.toString() : '');
                window.location.href = newUrl;
            }, 1000);
        }

        function exportReport(format) {
            const button = event.target;
            const originalText = button.innerHTML;
            
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            button.disabled = true;

            setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
                
                if (format === 'pdf') {
                    window.print();
                } else {
                    alert(`Chức năng xuất ${format.toUpperCase()} sẽ được phát triển trong phiên bản tiếp theo`);
                }
            }, 1000);
        }

        function printReport() {
            window.print();
        }
    </script>
}