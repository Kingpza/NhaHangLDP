@model NhaHangLDP.Models.StockInboundViewPageModel
@{
    ViewBag.Title = "Chi Tiết Phiếu Nhập Kho";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        :root {
            --primary-blue: #3b82f6;
            --primary-dark: #1e293b;
            --bg-white: #ffffff;
            --bg-light: #f8fafc;
            --border-color: #e2e8f0;
            --text-gray: #64748b;
        }

        .detail-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .invoice-card {
            background: var(--bg-white);
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .invoice-header {
            background: linear-gradient(135deg, var(--primary-dark) 0%, #334155 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .invoice-header .logo {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .invoice-header .logo i {
            color: var(--primary-blue);
        }

        .invoice-header .subtitle {
            font-size: 14px;
            opacity: 0.8;
        }

        .invoice-title {
            background: var(--primary-blue);
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .invoice-body {
            padding: 30px;
        }

        .info-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px dashed var(--border-color);
        }

        .info-block {
            flex: 1;
        }

        .info-block h6 {
            color: var(--primary-blue);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .info-block p {
            color: var(--primary-dark);
            font-size: 14px;
            margin-bottom: 5px;
        }

        .info-block .highlight {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
            border: 1px solid rgba(34, 197, 94, 0.2);
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }

        .items-table th {
            padding: 12px 15px;
            text-align: left;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-gray);
            text-transform: uppercase;
            background: var(--bg-light);
            border-bottom: 2px solid var(--border-color);
        }

        .items-table td {
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
            color: var(--primary-dark);
        }

        .ingredient-name {
            font-weight: 600;
            display: block;
        }

        .total-section {
            background: var(--bg-light);
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 14px;
            color: var(--primary-dark);
        }

        .total-row.grand-total {
            border-top: 2px solid var(--border-color);
            margin-top: 10px;
            padding-top: 15px;
            font-size: 18px;
            font-weight: 700;
        }

        .grand-total .value {
            color: var(--primary-blue);
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
            margin-bottom: 50px;
        }

        .btn-print {
            background: var(--primary-dark);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-print:hover {
            background: #000;
            color: white;
            transform: translateY(-2px);
        }

        .btn-back {
            background: white;
            color: var(--primary-dark);
            border: 1px solid var(--border-color);
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            transition: all 0.2s;
        }

        .btn-back:hover {
            background: var(--bg-light);
            color: var(--primary-dark);
        }

        @@media print {
            .no-print, .action-buttons, .navbar, .management-sidebar {
                display: none !important;
            }
            .detail-container {
                width: 100%;
                max-width: 100%;
                margin: 0;
            }
            .invoice-card {
                border: none;
                box-shadow: none;
            }
        }
    </style>
}

<div class="detail-container">
    <div class="invoice-card">
        <div class="invoice-header">
            <div class="logo">
                <i class="fas fa-utensils me-2"></i>LDP Restaurant
            </div>
            <div class="subtitle">Hệ thống quản lý nhà hàng chuyên nghiệp</div>
        </div>

        <div class="invoice-title">
            <i class="fas fa-file-invoice me-2"></i>Chi Tiết Phiếu Nhập Kho
        </div>

        <div class="invoice-body">
            <div class="info-section">
                <div class="info-block">
                    <h6>Thông tin phiếu</h6>
                    <p><strong>Mã phiếu:</strong> <span class="highlight">@Model.InboundCode</span></p>
                    <p><strong>Ngày nhập:</strong> @Model.InboundDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Trạng thái:</strong> <span class="status-badge">@Model.Status</span></p>
                </div>
                <div class="info-block text-end">
                    <h6>Thông tin liên quan</h6>
                    <p><strong>Nhân viên lập:</strong> @Model.EmployeeName</p>
                    <p><strong>Nhà cung cấp:</strong> @Model.SupplierName</p>
                </div>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Nguyên liệu</th>
                        <th style="text-align: right;">Số lượng</th>
                        <th style="text-align: right;">Đơn giá</th>
                        <th style="text-align: right;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        decimal totalValue = 0;
                    }
                    @foreach (var item in Model.Details)
                    {
                        var lineTotal = item.Quantity * item.UnitPrice;
                        totalValue += lineTotal;
                        <tr>
                            <td>@index</td>
                            <td>
                                <span class="ingredient-name">@item.IngredientName</span>
                                @if (!string.IsNullOrEmpty(item.BatchNumber))
                                {
                                    <small class="text-muted">Lô: @item.BatchNumber</small>
                                }
                            </td>
                            <td style="text-align: right;">@item.Quantity.ToString("N1") @item.Unit</td>
                            <td style="text-align: right;">@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td style="text-align: right; font-weight: 600;">@lineTotal.ToString("N0") VNĐ</td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>

            <div class="total-section">
                <div class="total-row">
                    <span>Số loại nguyên liệu:</span>
                    <span>@Model.Details.Count</span>
                </div>
                <div class="total-row grand-total">
                    <span>TỔNG GIÁ TRỊ PHIẾU:</span>
                    <span class="value">@totalValue.ToString("N0") VNĐ</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="notes-section mt-4 p-3 bg-light border-start border-primary border-4 rounded">
                    <h6 class="text-muted small fw-bold text-uppercase">Ghi chú:</h6>
                    <p class="mb-0">@Model.Notes</p>
                </div>
            }
        </div>

        <div class="invoice-footer text-center p-3 bg-light border-top">
            <p class="mb-0 small text-muted">Phiếu được xuất từ hệ thống quản lý LDP Restaurant</p>
            <p class="mb-0 small text-muted">Thời gian in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>
    </div>

    <div class="action-buttons no-print">
        <a href="@Url.Action("StockInboundList", "Management")" class="btn-back">
            <i class="fas fa-chevron-left me-2"></i>Danh sách phiếu
        </a>
        <button onclick="window.print()" class="btn-print">
            <i class="fas fa-print me-2"></i>In phiếu nhập
        </button>
    </div>
</div>