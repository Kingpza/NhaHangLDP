@model List<NhaHangLDP.Models.MenuItem>

@{
    ViewBag.Title = "Thực đơn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Thực Đơn Món Ăn - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/chatbot.css")" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                },
            },
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f0f2f5;
        }

        ::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #007bff;
        }

        .toast-notification {
            position: fixed;
            bottom: 100px;
            right: 20px;
            padding: 16px 24px;
            background: #28a745;
            color: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            z-index: 9999;
            animation: slideIn 0.3s ease-out;
        }
        @@keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body class="bg-background font-display text-text-primary overflow-hidden h-screen flex">
    <aside class="hidden lg:flex w-72 flex-col justify-between border-r border-border-light bg-sidebar-surface h-full flex-shrink-0 overflow-hidden">
        <div class="flex flex-col gap-6 p-6 overflow-y-auto flex-1">
            <div class="flex items-center gap-4">
                <div class="bg-center bg-no-repeat bg-cover rounded-full h-12 w-12 border-2 border-primary" data-alt="Restaurant logo" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBhlwmgWUTs_tC-ub-_7eDlJ_CQEEM2OG7Y-GBDJ_kirlRItyl3N2IJZYAaTPWiD_8hh5uwPDpkNIMTm2rnscn89-b3gz8iD5JKzAHHPl2vAPRYdRUTQN0LzqHi4Hl5d2ijdpj-DonhwCCg8fVGjB-HR-4SIL_SfUUo1A8oNjIlnx0P3dXd9uULNJqOy7WR0mixqB_s9LbasqJCFaILO1aaHm7lbjtMQsAGX-Qnfqi_ClMXYdv47OXuNRqBwJYSQvS_7DHF6QaT5_A");'>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-text-primary text-lg font-bold leading-tight">NHÀ HÀNG LDP</h1>
                    <p class="text-text-secondary text-xs font-medium">Fine Dining</p>
                </div>
            </div>
            <nav class="flex flex-col gap-2 mt-4">
                <a class="flex items-center gap-4 px-4 py-3 rounded-full bg-primary/20 border border-primary/10" href="#all">
                    <span class="material-symbols-outlined text-primary">restaurant_menu</span>
                    <p class="text-text-primary text-sm font-bold">Toàn bộ thực đơn</p>
                </a>
                @{
                    var categories = Model.Select(m => m.Category).Distinct().OrderBy(c => c).ToList();
                    var categoryIcons = new Dictionary<string, string> {
                        { "Món Khai Vị", "soup_kitchen" },
                        { "Món Chính", "restaurant" },
                        { "Tráng Miệng", "icecream" },
                        { "Đồ Uống", "local_bar" }
                    };
                }
                @foreach (var category in categories)
                {
                    var icon = categoryIcons.ContainsKey(category) ? categoryIcons[category] : "restaurant";
                    var categoryId = category.Replace(" ", "-").ToLower();
                    <a class="flex items-center gap-4 px-4 py-3 rounded-full hover:bg-hover-light transition-colors group" href="#@categoryId">
                        <span class="material-symbols-outlined text-text-secondary group-hover:text-primary">@icon</span>
                        <p class="text-text-secondary group-hover:text-text-primary text-sm font-medium">@category</p>
                    </a>
                }
            </nav>
        </div>
        <div class="p-6 flex flex-col gap-4 flex-shrink-0 border-t border-border-light">
            @if (Session["CustomerId"] != null)
            {
                <!-- User Account Section -->
                <div class="bg-white rounded-2xl p-4 flex items-center gap-3 border border-border-light shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                        <span class="text-lg font-bold text-primary">@Session["CustomerName"].ToString().Substring(0, 1).ToUpper()</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-text-primary text-sm truncate">@Session["CustomerName"]</p>
                        <a href="@Url.Action("Profile", "CustomerAccount")" class="text-xs text-primary hover:underline">Xem tài khoản</a>
                    </div>
                </div>
            }
            else
            {
                <!-- Login Prompt -->
                <a href="@Url.Action("Login", "CustomerAccount")" class="bg-white rounded-2xl p-4 flex items-center gap-3 border border-border-light shadow-sm hover:border-primary transition-colors group">
                    <div class="bg-primary/20 p-2 rounded-full group-hover:bg-primary transition-colors">
                        <span class="material-symbols-outlined text-primary group-hover:text-white">login</span>
                    </div>
                    <div>
                        <p class="font-semibold text-text-primary text-sm">Đăng nhập</p>
                        <p class="text-xs text-text-secondary">Để nhận ưu đãi đặc biệt</p>
                    </div>
                </a>
            }
            
            <div class="bg-sidebar-surface rounded-2xl p-4 flex flex-col items-center gap-3 text-center border border-border-light shadow-sm">
                <div class="bg-primary/20 p-3 rounded-full">
                    <span class="material-symbols-outlined text-primary">local_offer</span>
                </div>
                <div>
                    <h3 class="font-bold text-text-primary text-sm">Giảm 20% hôm nay</h3>
                    <p class="text-xs text-text-secondary mt-1">Cho đơn hàng trên 2tr</p>
                </div>
            </div>
        </div>
    </aside>
    
    <main class="flex-1 flex flex-col h-full min-w-0 bg-background relative">
        <header class="sticky top-0 z-20 flex items-center justify-between border-b border-border-light bg-background/80 backdrop-blur-md px-6 py-4 lg:px-10">
            <button class="lg:hidden text-text-primary mr-4">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <div class="flex-1 max-w-xl">
                <div class="flex w-full items-center rounded-full bg-sidebar-surface h-12 px-4 transition-all focus-within:ring-2 focus-within:ring-primary/50 border border-border-light">
                    <span class="material-symbols-outlined text-text-secondary">search</span>
                    <input class="w-full bg-transparent border-none text-text-primary placeholder-text-secondary focus:ring-0 ml-2" placeholder="Tìm món ăn, đồ uống..." type="text" id="searchInput" />
                </div>
            </div>
            <div class="flex items-center gap-4 ml-6">
                <div class="hidden md:flex items-center gap-6 mr-4">
                    <a class="text-text-primary text-sm font-medium hover:text-primary transition-colors" href="@Url.Action("Menu", "Public")">Trang chủ</a>
                    <a class="text-text-secondary text-sm font-medium hover:text-primary transition-colors" href="@Url.Action("Index", "Reservation")">Đặt bàn</a>
                    <a class="text-text-secondary text-sm font-medium hover:text-primary transition-colors" href="@Url.Action("TrackOrder", "Checkout")">Tra cứu đơn</a>
                </div>
                
                @if (Session["CustomerId"] != null)
                {
                    <!-- User logged in -->
                    <div class="relative group">
                        <button class="flex items-center gap-2 h-10 px-4 rounded-full bg-sidebar-surface hover:bg-hover-light transition-colors border border-border-light">
                            <span class="material-symbols-outlined text-text-primary" style="font-size: 20px;">account_circle</span>
                            <span class="hidden sm:inline text-sm font-medium text-text-primary">@Session["CustomerName"]</span>
                            <span class="material-symbols-outlined text-text-secondary text-sm">expand_more</span>
                        </button>
                        <!-- Dropdown -->
                        <div class="absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl shadow-lg border border-border-light opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
                            <div class="p-4 border-b border-border-light">
                                <p class="font-semibold text-text-primary">@Session["CustomerName"]</p>
                                <p class="text-xs text-text-secondary">@Session["CustomerEmail"]</p>
                            </div>
                            <div class="py-2">
                                <a href="@Url.Action("Profile", "CustomerAccount")" class="flex items-center gap-3 px-4 py-2 hover:bg-hover-light transition-colors">
                                    <span class="material-symbols-outlined text-text-secondary">person</span>
                                    <span class="text-sm">Tài khoản</span>
                                </a>
                                <a href="@Url.Action("Orders", "CustomerAccount")" class="flex items-center gap-3 px-4 py-2 hover:bg-hover-light transition-colors">
                                    <span class="material-symbols-outlined text-text-secondary">receipt_long</span>
                                    <span class="text-sm">Đơn hàng</span>
                                </a>
                                <a href="@Url.Action("Wishlist", "CustomerAccount")" class="flex items-center gap-3 px-4 py-2 hover:bg-hover-light transition-colors">
                                    <span class="material-symbols-outlined text-text-secondary">favorite</span>
                                    <span class="text-sm">Yêu thích</span>
                                </a>
                            </div>
                            <div class="border-t border-border-light py-2">
                                <a href="@Url.Action("Logout", "CustomerAccount")" class="flex items-center gap-3 px-4 py-2 hover:bg-red-50 text-red-500 transition-colors">
                                    <span class="material-symbols-outlined">logout</span>
                                    <span class="text-sm">Đăng xuất</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- User not logged in -->
                    <a href="@Url.Action("Login", "CustomerAccount")" class="hidden sm:flex items-center gap-2 h-10 px-4 rounded-full bg-sidebar-surface hover:bg-hover-light transition-colors border border-border-light">
                        <span class="material-symbols-outlined text-text-secondary" style="font-size: 20px;">login</span>
                        <span class="text-sm font-medium text-text-primary">Đăng nhập</span>
                    </a>
                }
                
                <a href="@Url.Action("Index", "Cart")" class="flex items-center gap-2 h-10 px-4 bg-primary rounded-full text-white hover:bg-[#0056b3] transition-colors font-bold text-sm shadow-[0_0_15px_rgba(0,123,255,0.3)] relative">
                    <span class="material-symbols-outlined" style="font-size: 20px;">shopping_cart</span>
                    <span class="hidden sm:inline">Giỏ hàng</span>
                    <span id="cartBadge" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">0</span>
                </a>
            </div>
        </header>
        
        <div class="flex-1 overflow-y-auto scroll-smooth pb-20">
            <div class="max-w-[1200px] mx-auto p-6 lg:p-10 flex flex-col gap-12">
                @if (Model != null && Model.Any())
                {
                    var featuredItem = Model.FirstOrDefault(m => m.IsFeatured);
                    if (featuredItem != null)
                    {
                        string heroImageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(featuredItem.ImageUrl) ? "default-food.jpg" : featuredItem.ImageUrl));
                        
                        <section class="rounded-[2rem] overflow-hidden relative min-h-[400px] flex items-end p-8 md:p-12 group">
                            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style='background-image: url("@heroImageUrl");'>
                            </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                            <div class="relative z-10 max-w-2xl flex flex-col items-start gap-4">
                                <span class="px-3 py-1 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-full">Món Ngon Hôm Nay</span>
                                <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
                                    @featuredItem.Name
                                </h2>
                                <p class="text-gray-100 text-lg max-w-lg mb-2">
                                    @featuredItem.Description
                                </p>
                                <p class="text-2xl font-bold text-white mb-2">@featuredItem.Price.ToString("N0")đ</p>
                                <div class="flex gap-3">
                                    <button onclick="addToCart(@featuredItem.Id)" class="flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-full font-bold text-base hover:bg-[#0056b3] transition-colors">
                                        <span class="material-symbols-outlined">add_shopping_cart</span>
                                        Thêm vào giỏ
                                    </button>
                                    <a href="@Url.Action("Detail", "Public", new { id = featuredItem.Id })" class="flex items-center gap-2 bg-white text-text-primary px-6 py-3 rounded-full font-bold text-base hover:bg-gray-100 transition-colors">
                                        <span>Xem chi tiết</span>
                                        <span class="material-symbols-outlined">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </section>
                    }

                    var wishlistIds = ViewBag.WishlistIds as List<int> ?? new List<int>();
                    
                    foreach (var category in categories)
                    {
                        var categoryId = category.Replace(" ", "-").ToLower();
                        var categoryItems = Model.Where(m => m.Category == category).ToList();
                        
                        if (categoryItems.Any())
                        {
                            var categoryIcon = categoryIcons.ContainsKey(category) ? categoryIcons[category] : "restaurant";
                            
                            <section id="@categoryId">
                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-primary text-3xl">@categoryIcon</span>
                                        <h2 class="text-2xl font-bold text-text-primary">@category</h2>
                                    </div>
                                    <span class="text-text-secondary text-sm">@categoryItems.Count món</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    @foreach (var item in categoryItems)
                                    {
                                        string imageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(item.ImageUrl) ? "default-food.jpg" : item.ImageUrl));
                                        string formattedPrice = item.Price.ToString("N0") + "đ";
                                        bool isInWishlist = wishlistIds.Contains(item.Id);
                                        
                                        <div class="menu-item-card group bg-sidebar-surface rounded-[2rem] p-4 hover:shadow-lg transition-all duration-300 border border-border-light hover:border-primary/50" data-name="@item.Name.ToLower()" data-desc="@(item.Description?.ToLower() ?? "")" data-item-id="@item.Id">
                                            <div class="aspect-[4/3] rounded-[1.5rem] bg-cover bg-center mb-4 overflow-hidden relative" style='background-image: url("@imageUrl");'>
                                                <button onclick="toggleWishlist(@item.Id, this)" class="wishlist-btn absolute top-4 right-4 bg-black/30 backdrop-blur-sm p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-primary @(isInWishlist ? "text-red-500" : "text-white")">
                                                    <span class="material-symbols-outlined text-xl">@(isInWishlist ? "favorite" : "favorite_border")</span>
                                                </button>
                                                @if (!item.IsAvailable)
                                                {
                                                    <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                                                        <span class="bg-red-500 text-white px-4 py-2 rounded-full font-bold">Hết món</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="px-2">
                                                <div class="flex justify-between items-start mb-2">
                                                    <h3 class="text-xl font-bold text-text-primary group-hover:text-primary transition-colors">@item.Name</h3>
                                                    <span class="text-primary font-bold text-lg whitespace-nowrap ml-2">@formattedPrice</span>
                                                </div>
                                                <p class="text-text-secondary text-sm mb-4 line-clamp-2">@(item.Description ?? "Món ăn ngon đặc biệt")</p>
                                                <div class="flex gap-2">
                                                    @if (item.IsAvailable)
                                                    {
                                                        <button onclick="addToCart(@item.Id)" class="flex-1 h-10 rounded-full bg-primary text-white font-bold text-sm transition-all flex items-center justify-center gap-2 hover:bg-[#0056b3]">
                                                            <span class="material-symbols-outlined text-lg">add_shopping_cart</span>
                                                            Thêm
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button disabled class="flex-1 h-10 rounded-full bg-gray-300 text-gray-500 font-bold text-sm flex items-center justify-center gap-2 cursor-not-allowed">
                                                            <span class="material-symbols-outlined text-lg">block</span>
                                                            Hết món
                                                        </button>
                                                    }
                                                    <a href="@Url.Action("Detail", "Public", new { id = item.Id })" class="h-10 w-10 rounded-full border border-border-light hover:bg-primary hover:text-white hover:border-primary text-text-primary transition-all flex items-center justify-center">
                                                        <span class="material-symbols-outlined text-lg">visibility</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    }
                }
                else
                {
                    <div class="text-center p-20">
                        <span class="material-symbols-outlined text-6xl text-text-secondary mb-4">restaurant_menu</span>
                        <p class="text-center text-text-secondary text-xl">Chưa có món ăn nào để hiển thị.</p>
                    </div>
                }
            </div>
            <footer class="border-t border-border-light py-8 text-center text-text-secondary text-sm">
                <p>© 2024 Nhà Hàng LDP. All rights reserved.</p>
            </footer>
        </div>
    </main>

    <!-- Toast Notification Container -->
    <div id="toastContainer"></div>

    <!-- Chatbot Toggle Button -->
    <button class="chatbot-toggle">
        <i class="fas fa-comment-dots"></i>
        <span class="chatbot-badge">1</span>
    </button>

    <!-- Chatbot Container -->
    <div class="chatbot-container">
        <div class="chatbot-header">
            <div class="chatbot-header-info">
                <div class="chatbot-title">
                    <h4>Trợ lý ảo LDP</h4>
                    <div class="chatbot-status">
                        <span class="status-dot"></span>
                        <span>Đang online</span>
                    </div>
                </div>
            </div>
            <button class="chatbot-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="chatbot-messages"></div>
        <div class="chatbot-input">
            <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn của bạn..." autocomplete="off">
            <button class="chatbot-send">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="@Url.Content("~/Scripts/chatbot.js")"></script>
    <script>
        // Load cart count on page load
        $(document).ready(function() {
            updateCartBadge();
        });

        // Add to cart function
        function addToCart(menuItemId) {
            $.post('@Url.Action("AddToCart", "Cart")', { menuItemId: menuItemId, quantity: 1 })
                .done(function(response) {
                    if (response.success) {
                        showToast(response.message);
                        updateCartBadge();
                    } else {
                        showToast(response.message, 'error');
                    }
                })
                .fail(function() {
                    showToast('Có lỗi xảy ra!', 'error');
                });
        }

        // Update cart badge
        function updateCartBadge() {
            $.get('@Url.Action("GetCartCount", "Cart")')
                .done(function(response) {
                    var badge = $('#cartBadge');
                    badge.text(response.count);
                    if (response.count > 0) {
                        badge.show();
                    } else {
                        badge.hide();
                    }
                });
        }

        // Toggle wishlist
        function toggleWishlist(itemId, btn) {
            $.post('@Url.Action("ToggleWishlist", "CustomerAccount")', { menuItemId: itemId })
                .done(function(response) {
                    if (response.success) {
                        var icon = $(btn).find('.material-symbols-outlined');
                        if (response.added) {
                            icon.text('favorite');
                            $(btn).addClass('text-red-500').removeClass('text-white');
                        } else {
                            icon.text('favorite_border');
                            $(btn).addClass('text-white').removeClass('text-red-500');
                        }
                        showToast(response.message);
                    } else if (response.needLogin) {
                        showToast('Vui lòng đăng nhập để sử dụng tính năng này!', 'error');
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Login", "CustomerAccount")';
                        }, 1500);
                    } else {
                        showToast(response.message || 'Có lỗi xảy ra', 'error');
                    }
                })
                .fail(function() {
                    showToast('Có lỗi xảy ra!', 'error');
                });
        }

        // Show toast notification
        function showToast(message, type = 'success') {
            var bgColor = type === 'success' ? '#28a745' : '#dc3545';
            var toast = $('<div class="toast-notification" style="background:' + bgColor + '">' + 
                          '<span class="material-symbols-outlined" style="vertical-align:middle;margin-right:8px;">' + 
                          (type === 'success' ? 'check_circle' : 'error') + '</span>' + message + '</div>');
            $('#toastContainer').append(toast);
            setTimeout(function() {
                toast.fadeOut(300, function() { $(this).remove(); });
            }, 3000);
        }

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const menuItems = document.querySelectorAll('.menu-item-card');
            
            menuItems.forEach(function(item) {
                const itemName = item.dataset.name;
                const itemDesc = item.dataset.desc;
                
                if (itemName.includes(searchTerm) || itemDesc.includes(searchTerm)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        });

        // Smooth scroll for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>
