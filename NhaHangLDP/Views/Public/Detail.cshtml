@model NhaHangLDP.Models.MenuItemDetailViewModel

@{
    ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section styles {
    <style>
        .detail-image {
            width: 100%;
            height: auto;
            object-fit: cover;
            border-radius: 10px;
            border: 3px solid var(--food-card-border);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .detail-content h1 {
            font-family: 'Playfair Display', serif;
            color: var(--header-orange);
        }

        .detail-price {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--price-bg);
        }

        .detail-section-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: var(--text-dark);
            margin-top: 1.5rem;
            padding-bottom: 0.25rem;
            border-bottom: 2px solid var(--header-light-orange);
            display: inline-block;
        }

        .detail-content .lead {
            font-size: 1.1rem;
            color: #3F2C1B;
            opacity: 0.9;
        }

        .detail-content .list-group-item {
            background-color: transparent !important;
            border: none !important;
            padding-left: 0;
            color: var(--text-dark);
        }

        .detail-content .text-muted {
            color: var(--text-dark) !important;
            opacity: 0.7;
        }

        .btn-back {
            background-color: var(--header-orange);
            color: var(--text-light);
            font-weight: 500;
            border: none;
            padding: 0.6rem 1.2rem;
            transition: background-color 0.2s ease;
            text-decoration: none;
            border-radius: 5px;
        }

            .btn-back:hover {
                background-color: var(--header-light-orange);
                color: var(--text-light);
            }
    </style>
}

<div class="row">
    <div class="col-md-6 mb-3 d-flex align-items-center">
        @{
            string imageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(Model.ImageUrl) ? "default-food.jpg" : Model.ImageUrl));
        }
        <img src="@imageUrl" class="detail-image" alt="@Model.Name">
    </div>

    <div class="col-md-6 detail-content">

        <h1>@Model.Name</h1>

        <h3 class="detail-price">@string.Format("{0:N0} VNĐ", Model.Price)</h3>

        <hr />

        <h5 class="detail-section-title"><i class="fa-solid fa-carrot"></i> Thành phần chính:</h5>
        @if (Model.Ingredients != null && Model.Ingredients.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var ing in Model.Ingredients)
                {
                    <li class="list-group-item">
                        <strong>@ing.IngredientName</strong>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted"><i>(Không có thông tin nguyên liệu)</i></p>
        }

        <hr />

        <h5 class="detail-section-title"><i class="fa-solid fa-circle-info"></i> Mô tả chi tiết:</h5>
        <p class="lead" style="white-space: pre-line;">@Model.Description</p>

        <hr />

        @Html.ActionLink("Quay lại Thực đơn", "Menu", "Public", null, new { @class = "btn btn-back" })
    </div>
</div>