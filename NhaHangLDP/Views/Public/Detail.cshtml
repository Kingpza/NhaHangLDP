@model NhaHangLDP.Models.MenuItemDetailViewModel

@{
    ViewBag.Title = Model.Name;
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@Model.Name - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/chatbot.css")" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                },
            },
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f0f2f5;
        }
        ::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #007bff;
        }
        .ingredient-badge {
            animation: slideInLeft 0.5s ease-out;
        }
        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
    </style>
</head>
<body class="bg-background font-display text-text-primary min-h-screen">
    
    <!-- Header -->
    <header class="sticky top-0 z-20 border-b border-border-light bg-background/95 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="@Url.Action("Menu", "Public")" class="flex items-center gap-3 group">
                <div class="h-10 w-10 rounded-full bg-primary flex items-center justify-center group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-white">arrow_back</span>
                </div>
                <span class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors">Quay lại thực đơn</span>
            </a>
            <div class="flex items-center gap-3">
                <button class="h-10 w-10 rounded-full bg-sidebar-surface flex items-center justify-center hover:bg-hover-light transition-colors border border-border-light">
                    <span class="material-symbols-outlined text-text-primary">favorite_border</span>
                </button>
                <button class="h-10 w-10 rounded-full bg-sidebar-surface flex items-center justify-center hover:bg-hover-light transition-colors border border-border-light">
                    <span class="material-symbols-outlined text-text-primary">share</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            
            <!-- Image Section -->
            <div class="space-y-6">
                @{
                    string imageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(Model.ImageUrl) ? "default-food.jpg" : Model.ImageUrl));
                }
                <div class="relative aspect-square rounded-[2rem] overflow-hidden bg-sidebar-surface shadow-xl border-4 border-white">
                    <img src="@imageUrl" 
                         alt="@Model.Name" 
                         class="w-full h-full object-cover hover:scale-110 transition-transform duration-700"
                         onerror="this.src='@Url.Content("~/images/menu/default-food.jpg")'" />
                    <div class="absolute top-6 left-6">
                        <span class="px-4 py-2 bg-primary/90 backdrop-blur-sm text-white text-sm font-bold rounded-full shadow-lg">
                            <i class="fas fa-star mr-1"></i> Món đặc biệt
                        </span>
                    </div>
                </div>

                <!-- Quick Info Cards -->
                <div class="grid grid-cols-3 gap-4">
                    <div class="bg-sidebar-surface rounded-2xl p-4 text-center border border-border-light">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2">schedule</span>
                        <p class="text-xs text-text-secondary">Thời gian</p>
                        <p class="font-bold text-text-primary">15-20 phút</p>
                    </div>
                    <div class="bg-sidebar-surface rounded-2xl p-4 text-center border border-border-light">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2">restaurant</span>
                        <p class="text-xs text-text-secondary">Khẩu phần</p>
                        <p class="font-bold text-text-primary">1-2 người</p>
                    </div>
                    <div class="bg-sidebar-surface rounded-2xl p-4 text-center border border-border-light">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2">local_fire_department</span>
                        <p class="text-xs text-text-secondary">Calories</p>
                        <p class="font-bold text-text-primary">~450 kcal</p>
                    </div>
                </div>
            </div>

            <!-- Details Section -->
            <div class="space-y-8">
                <!-- Title & Price -->
                <div class="space-y-4">
                    <div class="flex items-start justify-between gap-4">
                        <h1 class="text-4xl md:text-5xl font-black text-text-primary leading-tight">
                            @Model.Name
                        </h1>
                        <div class="flex flex-col items-end">
                            <span class="text-xs text-text-secondary uppercase tracking-wider">Giá</span>
                            <span class="text-4xl font-black text-primary">
                                @string.Format("{0:N0}₫", Model.Price)
                            </span>
                        </div>
                    </div>
                    
                    <!-- Rating & Reviews -->
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-1">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="fas fa-star text-yellow-400 text-sm"></i>
                            }
                        </div>
                        <span class="text-sm text-text-secondary">4.8 (124 đánh giá)</span>
                    </div>
                </div>

                <hr class="border-border-light" />

                <!-- Description -->
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary text-2xl">description</span>
                        <h2 class="text-2xl font-bold text-text-primary">Mô tả món ăn</h2>
                    </div>
                    <p class="text-text-secondary leading-relaxed text-lg">
                        @(string.IsNullOrEmpty(Model.Description) ? "Món ăn đặc sắc được chế biến từ nguyên liệu tươi ngon, đảm bảo vệ sinh an toàn thực phẩm." : Model.Description)
                    </p>
                </div>

                <hr class="border-border-light" />

                <!-- Ingredients -->
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary text-2xl">nutrition</span>
                        <h2 class="text-2xl font-bold text-text-primary">Nguyên liệu chính</h2>
                    </div>
                    
                    @if (Model.Ingredients != null && Model.Ingredients.Any())
                    {
                        <div class="flex flex-wrap gap-3">
                            @foreach (var ing in Model.Ingredients)
                            {
                                <span class="ingredient-badge px-4 py-2 bg-primary/10 text-primary rounded-full font-semibold text-sm border-2 border-primary/20 hover:bg-primary hover:text-white transition-all cursor-default">
                                    <i class="fas fa-leaf mr-2"></i>@ing.IngredientName
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-sidebar-surface rounded-2xl p-6 text-center border border-border-light">
                            <span class="material-symbols-outlined text-text-secondary text-5xl mb-3">local_dining</span>
                            <p class="text-text-secondary italic">Thông tin nguyên liệu đang được cập nhật</p>
                        </div>
                    }
                </div>

                <hr class="border-border-light" />

                <!-- Action Buttons -->
                <div class="flex gap-4">
                    <button id="addToCartBtn" onclick="addToCart(@Model.Id)" class="flex-1 h-14 bg-primary rounded-full text-white font-bold text-lg hover:bg-[#0056b3] transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-3">
                        <span class="material-symbols-outlined">shopping_cart</span>
                        Thêm vào giỏ hàng
                    </button>
                    <button id="wishlistBtn" onclick="toggleWishlist(@Model.Id, this)" class="h-14 w-14 bg-sidebar-surface rounded-full flex items-center justify-center hover:bg-primary hover:text-white transition-all border border-border-light group">
                        <span class="material-symbols-outlined wishlist-icon">favorite_border</span>
                    </button>
                </div>

                <!-- Additional Info -->
                <div class="bg-gradient-to-r from-primary/10 to-primary/5 rounded-2xl p-6 border-l-4 border-primary">
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-primary text-3xl">info</span>
                        <div>
                            <h3 class="font-bold text-text-primary mb-2">Lưu ý</h3>
                            <ul class="text-sm text-text-secondary space-y-1">
                                <li>• Món ăn được chế biến theo yêu cầu</li>
                                <li>• Có thể điều chỉnh độ cay, ngọt theo khẩu vị</li>
                                <li>• Liên hệ nhân viên để biết thêm chi tiết</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Items Section -->
        <div class="mt-16">
            <div class="flex items-center gap-3 mb-8">
                <span class="material-symbols-outlined text-primary text-3xl">restaurant_menu</span>
                <h2 class="text-3xl font-bold text-text-primary">Món ăn liên quan</h2>
            </div>
            
            @if (Model.RelatedItems != null && Model.RelatedItems.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    @foreach (var item in Model.RelatedItems)
                    {
                        string relatedImageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(item.ImageUrl) ? "default-food.jpg" : item.ImageUrl));
                        string formattedPrice = string.Format("{0:N0}₫", item.Price);
                        
                        <a href="@Url.Action("Detail", "Public", new { id = item.Id })" class="group bg-sidebar-surface rounded-[2rem] overflow-hidden hover:shadow-xl transition-all duration-300 border border-border-light hover:border-primary/50">
                            <div class="aspect-[4/3] bg-cover bg-center overflow-hidden relative" style='background-image: url("@relatedImageUrl");'>
                                <img src="@relatedImageUrl" 
                                     alt="@item.Name" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                     onerror="this.src='@Url.Content("~/images/menu/default-food.jpg")'" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                            <div class="p-4">
                                <h3 class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors mb-2 line-clamp-1">
                                    @item.Name
                                </h3>
                                <p class="text-text-secondary text-sm mb-3 line-clamp-2">
                                    @(string.IsNullOrEmpty(item.Description) ? "Món ăn ngon đặc biệt" : item.Description)
                                </p>
                                <div class="flex items-center justify-between">
                                    <span class="text-primary font-bold text-xl">@formattedPrice</span>
                                    <span class="flex items-center gap-1 text-yellow-400 text-sm">
                                        <i class="fas fa-star"></i>
                                        <span class="text-text-secondary">@item.Rating.ToString("0.0")</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="bg-sidebar-surface/50 rounded-2xl p-8 text-center border border-border-light">
                    <span class="material-symbols-outlined text-text-secondary text-6xl mb-3">explore</span>
                    <p class="text-text-secondary">Khám phá thêm nhiều món ngon khác trong thực đơn của chúng tôi</p>
                    <a href="@Url.Action("Menu", "Public")" class="inline-block mt-4 px-6 py-3 bg-primary text-white rounded-full font-bold hover:bg-[#0056b3] transition-all">
                        Xem thực đơn đầy đủ
                    </a>
                </div>
            }
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-border-light mt-16 py-8 text-center text-text-secondary bg-sidebar-surface/30">
        <p class="text-sm">© 2024 Nhà Hàng LDP. All rights reserved.</p>
    </footer>

    <!-- Chatbot Toggle Button -->
    <button class="chatbot-toggle">
        <i class="fas fa-comment-dots"></i>
        <span class="chatbot-badge">1</span>
    </button>

    <!-- Chatbot Container -->
    <div class="chatbot-container">
        <div class="chatbot-header">
            <div class="chatbot-header-info">
                <div class="chatbot-title">
                    <h4>Trợ lý ảo LDP</h4>
                    <div class="chatbot-status">
                        <span class="status-dot"></span>
                        <span>Đang online</span>
                    </div>
                </div>
            </div>
            <button class="chatbot-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="chatbot-messages"></div>
        <div class="chatbot-input">
            <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn của bạn..." autocomplete="off">
            <button class="chatbot-send">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-50"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="@Url.Content("~/Scripts/chatbot.js")"></script>
    <script>
        // Add to cart function
        function addToCart(menuItemId) {
            var btn = $('#addToCartBtn');
            var originalHtml = btn.html();
            btn.prop('disabled', true).html('<span class="material-symbols-outlined animate-spin">progress_activity</span> Đang thêm...');
            
            $.post('@Url.Action("AddToCart", "Cart")', { menuItemId: menuItemId, quantity: 1 })
                .done(function(response) {
                    btn.prop('disabled', false).html(originalHtml);
                    if (response.success) {
                        showToast(response.message, 'success');
                    } else {
                        showToast(response.message, 'error');
                    }
                })
                .fail(function() {
                    btn.prop('disabled', false).html(originalHtml);
                    showToast('Có lỗi xảy ra!', 'error');
                });
        }

        // Toggle wishlist
        function toggleWishlist(itemId, btn) {
            $.post('@Url.Action("ToggleWishlist", "CustomerAccount")', { menuItemId: itemId })
                .done(function(response) {
                    if (response.success) {
                        var icon = $(btn).find('.wishlist-icon');
                        if (response.added) {
                            icon.text('favorite');
                            icon.css('color', '#e74c3c');
                            $(btn).addClass('bg-red-50');
                        } else {
                            icon.text('favorite_border');
                            icon.css('color', '');
                            $(btn).removeClass('bg-red-50');
                        }
                        showToast(response.message);
                    } else if (response.needLogin) {
                        showToast('Vui lòng đăng nhập để sử dụng tính năng này!', 'error');
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Login", "CustomerAccount")';
                        }, 1500);
                    } else {
                        showToast(response.message, 'error');
                    }
                });
        }

        // Show toast notification
        function showToast(message, type) {
            type = type || 'success';
            var bgColor = type === 'success' ? '#28a745' : '#dc3545';
            var icon = type === 'success' ? 'check_circle' : 'error';
            var toast = $('<div style="background:' + bgColor + ';color:white;padding:14px 24px;border-radius:12px;margin-bottom:10px;box-shadow:0 4px 20px rgba(0,0,0,0.2);display:flex;align-items:center;gap:10px;">' +
                          '<span class="material-symbols-outlined">' + icon + '</span>' + message + '</div>');
            $('#toastContainer').append(toast);
            setTimeout(function() { toast.fadeOut(300, function() { $(this).remove(); }); }, 3000);
        }

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Image zoom on hover
        const img = document.querySelector('main img');
        if (img) {
            img.addEventListener('click', function() {
                this.classList.toggle('scale-150');
            });
        }
    </script>
</body>
</html>