@model NhaHangLDP.Models.CartViewModel
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Giỏ hàng - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        "primary-dark": "#0056b3",
                        background: "#f8f9fa",
                        surface: "#ffffff",
                        "text-primary": "#212529",
                        "text-secondary": "#6c757d",
                        border: "#e0e0e0",
                        success: "#28a745",
                        danger: "#dc3545",
                        warning: "#ffc107"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .quantity-input::-webkit-inner-spin-button,
        .quantity-input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .quantity-input {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="bg-background font-display text-text-primary min-h-screen">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-surface shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <a href="@Url.Action("Menu", "Public")" class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">arrow_back</span>
                    <span class="font-semibold">Tiếp tục mua sắm</span>
                </a>
                <h1 class="text-xl font-bold">
                    <span class="material-symbols-outlined text-primary align-middle">shopping_cart</span>
                    Giỏ hàng
                </h1>
                <div class="w-32"></div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="grid lg:grid-cols-3 gap-8">
                <!-- Cart Items -->
                <div class="lg:col-span-2">
                    <div class="bg-surface rounded-2xl shadow-sm overflow-hidden">
                        <div class="p-6 border-b border-border">
                            <div class="flex items-center justify-between">
                                <h2 class="text-lg font-bold">
                                    <span class="text-primary">@Model.TotalItems</span> món trong giỏ
                                </h2>
                                <button onclick="clearCart()" class="text-text-secondary hover:text-danger text-sm flex items-center gap-1">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                    Xóa tất cả
                                </button>
                            </div>
                        </div>

                        <div id="cartItems" class="divide-y divide-border">
                            @foreach (var item in Model.Items)
                            {
                                var imageUrl = Url.Content("~/images/menu/" + (string.IsNullOrEmpty(item.ImageUrl) ? "default-food.jpg" : item.ImageUrl));
                                <div class="p-6 flex gap-4 cart-item" data-item-id="@item.Id">
                                    <div class="w-24 h-24 rounded-xl bg-cover bg-center flex-shrink-0" 
                                         style='background-image: url("@imageUrl")'></div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex justify-between items-start">
                                            <div>
                                                <h3 class="font-semibold text-text-primary">@item.Name</h3>
                                                <p class="text-sm text-text-secondary">@item.Category</p>
                                            </div>
                                            <button onclick="removeItem(@item.Id)" class="text-text-secondary hover:text-danger p-1">
                                                <span class="material-symbols-outlined">close</span>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                        {
                                            <p class="text-sm text-text-secondary mt-1 italic">
                                                <span class="material-symbols-outlined text-sm align-middle">note</span>
                                                @item.SpecialInstructions
                                            </p>
                                        }
                                        <div class="flex items-center justify-between mt-4">
                                            <div class="flex items-center border border-border rounded-full quantity-control">
                                                <button class="btn-decrease w-10 h-10 flex items-center justify-center hover:bg-gray-100 rounded-l-full"
                                                        data-item-id="@item.Id" data-quantity="@(item.Quantity - 1)">
                                                    <span class="material-symbols-outlined">remove</span>
                                                </button>
                                                <input type="number" value="@item.Quantity" min="1" 
                                                       data-item-id="@item.Id"
                                                       class="w-12 text-center border-0 focus:ring-0 quantity-input" />
                                                <button class="btn-increase w-10 h-10 flex items-center justify-center hover:bg-gray-100 rounded-r-full"
                                                        data-item-id="@item.Id" data-quantity="@(item.Quantity + 1)">
                                                    <span class="material-symbols-outlined">add</span>
                                                </button>
                                            </div>
                                            <div class="text-right">
                                                <p class="font-bold text-primary text-lg item-subtotal">
                                                    @item.Subtotal.ToString("N0")đ
                                                </p>
                                                <p class="text-sm text-text-secondary unit-price" data-unit-price="@item.UnitPrice">
                                                    @item.UnitPrice.ToString("N0")đ/món
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="lg:col-span-1">
                    <div class="bg-surface rounded-2xl shadow-sm p-6 sticky top-24">
                        <h2 class="text-lg font-bold mb-6">Tóm tắt đơn hàng</h2>

                        <!-- Voucher -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium mb-2">Mã giảm giá</label>
                            <div class="flex gap-2">
                                <input type="text" id="voucherInput" placeholder="Nhập mã..." 
                                       value="@Model.VoucherCode"
                                       class="flex-1 px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary" />
                                @if (string.IsNullOrEmpty(Model.VoucherCode))
                                {
                                    <button onclick="applyVoucher()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark font-medium">
                                        Áp dụng
                                    </button>
                                }
                                else
                                {
                                    <button onclick="removeVoucher()" class="px-4 py-2 bg-danger text-white rounded-lg hover:bg-red-600 font-medium">
                                        Xóa
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.VoucherCode))
                            {
                                <p class="text-sm text-success mt-2 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">check_circle</span>
                                    Đã áp dụng mã @Model.VoucherCode
                                </p>
                            }
                        </div>

                        <!-- Price Breakdown -->
                        <div class="space-y-3 border-t border-border pt-4">
                            <div class="flex justify-between text-text-secondary">
                                <span>Tạm tính</span>
                                <span id="subtotal">@Model.SubTotal.ToString("N0")đ</span>
                            </div>

                            @if (Model.Discount > 0)
                            {
                                <div class="flex justify-between text-success">
                                    <span>Giảm giá</span>
                                    <span id="discount">-@Model.Discount.ToString("N0")đ</span>
                                </div>
                            }
                            <div class="flex justify-between text-lg font-bold pt-3 border-t border-border">
                                <span>Tổng cộng</span>
                                <span id="totalAmount" class="text-primary">
                                    @{
                                        var cartTotal = Model.SubTotal - Model.Discount;
                                        if (cartTotal < 0) { cartTotal = 0; }
                                    }
                                    @cartTotal.ToString("N0")đ
                                </span>
                            </div>
                        </div>

                        <!-- Checkout Button -->
                        @if (Session["CustomerId"] != null)
                        {
                            <button type="button" id="btnCheckout1"
                               class="mt-6 w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark transition-colors flex items-center justify-center gap-2 shadow-lg shadow-primary/30">
                                <span class="material-symbols-outlined">shopping_cart_checkout</span>
                                <span>Đặt hàng ngay</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                               onclick="showLoginRequired()"
                               class="mt-6 w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark transition-colors flex items-center justify-center gap-2 shadow-lg shadow-primary/30">
                                <span class="material-symbols-outlined">shopping_cart_checkout</span>
                                Đặt hàng ngay
                            </button>
                            <p class="text-xs text-warning text-center mt-3 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-sm">info</span>
                                Vui lòng đăng nhập để đặt hàng
                            </p>
                        }

                        <p class="text-xs text-text-secondary text-center mt-4">
                            <span class="material-symbols-outlined text-sm align-middle">lock</span>
                            Thanh toán an toàn & bảo mật
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty Cart -->
            <div class="text-center py-20">
                <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gray-100 mb-6">
                    <span class="material-symbols-outlined text-5xl text-text-secondary">shopping_cart</span>
                </div>
                <h2 class="text-2xl font-bold mb-2">Giỏ hàng trống</h2>
                <p class="text-text-secondary mb-8">Bạn chưa có món nào trong giỏ hàng</p>
                <a href="@Url.Action("Menu", "Public")" 
                   class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white rounded-full font-bold hover:bg-primary-dark transition-colors">
                    <span class="material-symbols-outlined">restaurant_menu</span>
                    Xem thực đơn
                </a>
            </div>
        }
    </main>

    <!-- Suggested Items -->
    @if (Model.Items != null && Model.Items.Any())
    {
        <section class="max-w-7xl mx-auto px-4 py-8">
            <h2 class="text-xl font-bold mb-6">Có thể bạn cũng thích</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="suggestedItems">
                <!-- Will be loaded via AJAX -->
            </div>
        </section>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Set checkout URL from server
        var checkoutUrl = '@Url.Action("Index", "Checkout")';
        console.log('Checkout URL:', checkoutUrl);

        // Show login required dialog
        function showLoginRequired() {
            Swal.fire({
                title: 'Vui lòng đăng nhập',
                html: 'Bạn cần đăng nhập để tiếp tục đặt hàng.<br>Bạn đã có tài khoản chưa?',
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-sign-in-alt"></i> Đăng nhập',
                cancelButtonText: '<i class="fas fa-user-plus"></i> Đăng ký',
                confirmButtonColor: '#007bff',
                cancelButtonColor: '#28a745',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Login", "CustomerAccount", new { returnUrl = Url.Action("Index", "Checkout") })';
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    window.location.href = '@Url.Action("Register", "CustomerAccount")';
                }
            });
        }

        // Update quantity
        function updateQuantity(itemId, quantity) {
            quantity = parseInt(quantity);
            if (isNaN(quantity) || quantity < 0) return;

            var $cartItem = $(`.cart-item[data-item-id="${itemId}"]`);
            var $quantityInput = $cartItem.find('.quantity-input');
            var unitPrice = parseFloat($cartItem.find('.unit-price').data('unit-price'));
            
            // Cập nhật UI ngay lập tức
            if (quantity > 0) {
                $quantityInput.val(quantity);
                var newSubtotal = unitPrice * quantity;
                $cartItem.find('.item-subtotal').text(formatPrice(newSubtotal));
            }

            $.post('@Url.Action("UpdateQuantity", "Cart")', { itemId: itemId, quantity: quantity })
                .done(function(response) {
                    if (response.success) {
                        if (quantity === 0) {
                            $cartItem.fadeOut(300, function() {
                                $(this).remove();
                                updateCartSummary(response.cart);
                                checkEmptyCart();
                            });
                        } else {
                            updateCartSummary(response.cart);
                            updateCartItemUI(itemId, response.cart);
                        }
                    }
                });
        }

        // Cập nhật UI của một item trong giỏ hàng
        function updateCartItemUI(itemId, cart) {
            if (!cart.Items) return;
            
            var item = cart.Items.find(i => i.Id === itemId);
            if (item) {
                var $cartItem = $(`.cart-item[data-item-id="${itemId}"]`);
                $cartItem.find('.quantity-input').val(item.Quantity);
                $cartItem.find('.item-subtotal').text(formatPrice(item.Subtotal));
                
                // Cập nhật data-quantity cho các nút +/-
                $cartItem.find('.btn-decrease').data('quantity', item.Quantity - 1);
                $cartItem.find('.btn-increase').data('quantity', item.Quantity + 1);
            }
            
            // Cập nhật số lượng trong header
            $('h2 .text-primary').first().text(cart.TotalItems);
        }

        // Remove item
        function removeItem(itemId) {
            Swal.fire({
                title: 'Xóa món này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("RemoveItem", "Cart")', { itemId: itemId })
                        .done(function(response) {
                            if (response.success) {
                                $(`.cart-item[data-item-id="${itemId}"]`).fadeOut(300, function() {
                                    $(this).remove();
                                    updateCartSummary(response.cart);
                                    checkEmptyCart();
                                });
                            }
                        });
                }
            });
        }

        // Clear cart
        function clearCart() {
            Swal.fire({
                title: 'Xóa toàn bộ giỏ hàng?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa tất cả',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("ClearCart", "Cart")')
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            }
                        });
                }
            });
        }

        // Apply voucher
        function applyVoucher() {
            var code = $('#voucherInput').val().trim();
            if (!code) {
                Swal.fire('Lỗi', 'Vui lòng nhập mã giảm giá!', 'error');
                return;
            }

            $.post('@Url.Action("ApplyVoucher", "Cart")', { voucherCode: code })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire('Thành công!', response.message, 'success')
                            .then(() => location.reload());
                    } else {
                        Swal.fire('Không áp dụng được', response.message, 'error');
                    }
                });
        }

        // Remove voucher
        function removeVoucher() {
            $.post('@Url.Action("RemoveVoucher", "Cart")')
                .done(function(response) {
                    if (response.success) {
                        location.reload();
                    }
                });
        }

        // Update cart summary
        function updateCartSummary(cart) {
            $('#subtotal').text(formatPrice(cart.SubTotal));
            var total = cart.SubTotal - (cart.Discount || 0);
            if (total < 0) total = 0;
            $('#totalAmount').text(formatPrice(total));
            $('h2 .text-primary').first().text(cart.TotalItems);
        }

        // Format price
        function formatPrice(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + 'đ';
        }

        // Check empty cart
        function checkEmptyCart() {
            if ($('.cart-item').length === 0) {
                location.reload();
            }
        }

        // Thêm món vào giỏ từ gợi ý
        function addToCart(menuItemId) {
            $.post('@Url.Action("AddToCart", "Cart")', { menuItemId: menuItemId, quantity: 1 })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Đã thêm!',
                            text: response.message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                });
        }

        // Load suggested items
        function loadSuggestedItems() {
            $.get('@Url.Action("GetSuggestedItems", "Cart")')
                .done(function(response) {
                    if (response.success && response.items && response.items.length > 0) {
                        var html = '';
                        response.items.forEach(function(item) {
                            var imageUrl = '@Url.Content("~/images/menu/")' + (item.imageUrl || 'default-food.jpg');
                            html += `
                                <div class="bg-surface rounded-xl shadow-sm overflow-hidden">
                                    <div class="h-32 bg-cover bg-center" style="background-image: url('${imageUrl}')"></div>
                                    <div class="p-3">
                                        <h4 class="font-semibold text-sm truncate">${item.name}</h4>
                                        <p class="text-xs text-text-secondary">${item.category || ''}</p>
                                        <div class="flex items-center justify-between mt-2">
                                            <span class="text-primary font-bold">${formatPrice(item.price)}</span>
                                            <button onclick="addToCart(${item.id})" 
                                                    class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center hover:bg-primary-dark">
                                                <span class="material-symbols-outlined text-lg">add</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                        $('#suggestedItems').html(html);
                    }
                });
        }

        // Document ready
        $(document).ready(function() {
            // Load suggested items
            loadSuggestedItems();

            // Event delegation cho nút giảm số lượng
            $(document).on('click', '.btn-decrease', function() {
                var itemId = $(this).data('item-id');
                var currentQty = parseInt($(this).closest('.quantity-control').find('.quantity-input').val());
                updateQuantity(itemId, currentQty - 1);
            });

            // Event delegation cho nút tăng số lượng
            $(document).on('click', '.btn-increase', function() {
                var itemId = $(this).data('item-id');
                var currentQty = parseInt($(this).closest('.quantity-control').find('.quantity-input').val());
                updateQuantity(itemId, currentQty + 1);
            });

            // Event cho input số lượng
            $(document).on('change', '.quantity-input', function() {
                var itemId = $(this).data('item-id');
                var quantity = parseInt($(this).val());
                if (quantity >= 0) {
                    updateQuantity(itemId, quantity);
                }
            });

            // Enter key for voucher
            $('#voucherInput').keypress(function(e) {
                if (e.which === 13) {
                    applyVoucher();
                }
            });

            // Checkout button - redirect to checkout page
            $('#btnCheckout1').on('click', function(e) {
                console.log('Button clicked, redirecting to:', checkoutUrl);
                window.location.href = checkoutUrl;
            });
        });
    </script>
</body>
</html>
