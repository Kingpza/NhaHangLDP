@model List<NhaHangLDP.Controllers.AccountManagementViewModel>
@{
    ViewBag.Title = "Quản Lý Tài Khoản & Phân Quyền";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    var permissionModel = ViewBag.PermissionModel as NhaHangLDP.Models.PermissionManagementViewModel;
}

@section styles {
    <style>
        .account-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-admin { background: #fee2e2; color: #dc2626; }
        .badge-manager { background: #dbeafe; color: #2563eb; }
        .badge-cashier { background: #dcfce7; color: #16a34a; }
        .badge-chef { background: #fef3c7; color: #d97706; }
        .badge-staff { background: #f3e8ff; color: #9333ea; }
        .badge-delivery { background: #fce7f3; color: #db2777; }
        .badge-customer { background: #f0f9ff; color: #0284c7; }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 22px;
        }
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc;
            transition: 0.3s;
            border-radius: 22px;
        }
        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }
        input:checked + .toggle-slider {
            background-color: #3b82f6;
        }
        input:checked + .toggle-slider:before {
            transform: translateX(18px);
        }

        .main-tab-nav .nav-link {
            border-radius: 10px;
            padding: 12px 24px;
            font-weight: 600;
            margin-right: 8px;
            transition: all 0.3s ease;
        }

        .main-tab-nav .nav-link.active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: #fff !important;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }
    </style>
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">
                        <i class="fas fa-users-cog me-2" style="color: var(--primary-blue);"></i>Quản Lý Tài Khoản & Phân Quyền
                    </h4>
                    <p class="text-muted mb-0" style="font-size: 14px;">Quản lý tài khoản và phân quyền người dùng trong hệ thống</p>
                </div>
                <a href="@Url.Action("Create")" class="btn btn-primary-custom">
                    <i class="fas fa-plus-circle me-2"></i>Tạo Tài Khoản Mới
                </a>
            </div>
        </div>
    </div>

    <!-- Main Tabs -->
    <ul class="nav nav-tabs main-tab-nav mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="accounts-tab" data-bs-toggle="tab" data-bs-target="#accounts" type="button" role="tab">
                <i class="fas fa-users me-2"></i>Tài khoản
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="permissions-tab" data-bs-toggle="tab" data-bs-target="#permissions" type="button" role="tab">
                <i class="fas fa-shield-alt me-2"></i>Phân quyền
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Accounts Tab -->
        <div class="tab-pane fade show active" id="accounts" role="tabpanel">
            @Html.Partial("_AccountsTab", Model)
        </div>

        <!-- Permissions Tab -->
        <div class="tab-pane fade" id="permissions" role="tabpanel">
            @if (permissionModel != null)
            {
                @Html.Partial("_PermissionsTab", permissionModel)
            }
        </div>
    </div>
</div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon me-3" style="background: rgba(59, 130, 246, 0.1);">
                        <i class="fas fa-users" style="color: #3b82f6;"></i>
                    </div>
                    <div>
                        <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.Count</h3>
                        <p class="text-muted mb-0" style="font-size: 14px;">Tổng tài khoản</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon me-3" style="background: rgba(34, 197, 94, 0.1);">
                        <i class="fas fa-check-circle" style="color: #22c55e;"></i>
                    </div>
                    <div>
                        <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.Count(a => a.IsActive)</h3>
                        <p class="text-muted mb-0" style="font-size: 14px;">Đang hoạt động</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon me-3" style="background: rgba(239, 68, 68, 0.1);">
                        <i class="fas fa-ban" style="color: #ef4444;"></i>
                    </div>
                    <div>
                        <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.Count(a => !a.IsActive)</h3>
                        <p class="text-muted mb-0" style="font-size: 14px;">Bị khóa</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon me-3" style="background: rgba(245, 158, 11, 0.1);">
                        <i class="fas fa-user-tag" style="color: #f59e0b;"></i>
                    </div>
                    <div>
                        <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@ViewBag.Roles.Count</h3>
                        <p class="text-muted mb-0" style="font-size: 14px;">Vai trò</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter and Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm tên, username, email...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="roleFilter" class="form-select">
                        <option value="">Tất cả vai trò</option>
                        @foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role.RoleName">@role.RoleName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Bị khóa</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button onclick="clearFilters()" class="btn btn-outline-custom w-100">
                        <i class="fas fa-redo me-1"></i>Làm mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section scripts {
    <script>
        // ==================== ACCOUNTS TAB ====================
        // Search functionality
        $('#searchInput').on('keyup', function() {
            filterTable();
        });

        $('#roleFilter, #statusFilter').on('change', function() {
            filterTable();
        });

        function filterTable() {
            var searchText = $('#searchInput').val().toLowerCase();
            var roleFilter = $('#roleFilter').val().toLowerCase();
            var statusFilter = $('#statusFilter').val();

            $('#accountsTable tbody tr').each(function() {
                var $row = $(this);
                var text = $row.text().toLowerCase();
                var role = $row.data('role').toLowerCase();
                var status = $row.data('status');

                var matchSearch = text.indexOf(searchText) > -1;
                var matchRole = !roleFilter || role === roleFilter;
                var matchStatus = !statusFilter || status === statusFilter;

                if (matchSearch && matchRole && matchStatus) {
                    $row.show();
                } else {
                    $row.hide();
                }
            });
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#roleFilter').val('');
            $('#statusFilter').val('');
            filterTable();
        }

        function updateRole(accountId, roleId) {
            $.post('@Url.Action("UpdateRole")', { accountId: accountId, roleId: roleId }, function(response) {
                if (response.success) {
                    Swal.fire('Thành công!', response.message, 'success');
                    var $row = $('tr[data-account-id="' + accountId + '"]');
                    $row.attr('data-role', response.roleName);
                } else {
                    Swal.fire('Lỗi!', response.message, 'error');
                }
            });
        }

        function toggleStatus(accountId) {
            Swal.fire({
                title: 'Xác nhận',
                text: 'Bạn có chắc muốn thay đổi trạng thái tài khoản này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("ToggleStatus")', { accountId: accountId }, function(response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    });
                }
            });
        }

        function resetPassword(accountId) {
            Swal.fire({
                title: 'Đặt lại mật khẩu',
                input: 'password',
                inputLabel: 'Nhập mật khẩu mới (tối thiểu 6 ký tự)',
                inputPlaceholder: 'Mật khẩu mới',
                showCancelButton: true,
                confirmButtonText: 'Đặt lại',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => {
                    if (!value || value.length < 6) {
                        return 'Mật khẩu phải có ít nhất 6 ký tự!';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("ResetPassword")', { accountId: accountId, newPassword: result.value }, function(response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success');
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    });
                }
            });
        }

        function deleteAccount(accountId) {
            Swal.fire({
                title: 'Xác nhận xóa',
                text: 'Bạn có chắc muốn xóa tài khoản này? Hành động này không thể hoàn tác!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc2626'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { accountId: accountId }, function(response) {
                        if (response.success) {
                            Swal.fire('Đã xóa!', response.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    });
                }
            });
        }

        // ==================== PERMISSIONS TAB ====================
        function saveAllPermissions(roleId) {
            var permissions = [];
            var checkboxes = document.querySelectorAll('#role-content-' + roleId + ' .perm-checkbox');
            var permMap = {};

            checkboxes.forEach(function(cb) {
                var key = cb.dataset.controller + '|' + cb.dataset.action;
                if (!permMap[key]) {
                    permMap[key] = {
                        RoleId: parseInt(cb.dataset.role),
                        Controller: cb.dataset.controller,
                        ActionName: cb.dataset.action,
                        CanView: false,
                        CanAdd: false,
                        CanEdit: false,
                        CanDelete: false,
                        Description: ''
                    };
                }
                if (cb.dataset.type === 'view') permMap[key].CanView = cb.checked;
                if (cb.dataset.type === 'add') permMap[key].CanAdd = cb.checked;
                if (cb.dataset.type === 'edit') permMap[key].CanEdit = cb.checked;
                if (cb.dataset.type === 'delete') permMap[key].CanDelete = cb.checked;
            });

            for (var key in permMap) {
                permissions.push(permMap[key]);
            }

            $.ajax({
                url: '@Url.Action("BulkUpdatePermissions", "AccountManagement")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ roleId: roleId, permissions: permissions }),
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: response.message,
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi', 'Có lỗi xảy ra khi lưu quyền!', 'error');
                }
            });
        }
    </script>
}
