@{
    ViewBag.Title = "Thực Đơn - Bán Hàng";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<style>
    .menu-container {
        padding: 0;
        height: calc(100vh - 140px);
        overflow: hidden;
    }

    .menu-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        height: 100%;
        gap: 20px;
    }

    /* Menu Section */
    .menu-section {
        background: white;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
    }

    .menu-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
        background: linear-gradient(135deg, #f8fafc 0%, #fff 100%);
    }

    .menu-header h4 {
        color: #1e293b;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-header h4 i {
        color: #f59e0b;
    }

    .menu-header small {
        color: #64748b;
        font-size: 0.875rem;
    }

    .menu-categories {
        display: flex;
        gap: 8px;
        padding: 16px 24px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        flex-shrink: 0;
    }

    .category-btn {
        padding: 10px 20px;
        border-radius: 25px;
        background: white;
        border: 2px solid #e2e8f0;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.875rem;
    }

    .category-btn:hover {
        border-color: #6366f1;
        color: #6366f1;
    }

    .category-btn.active {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border-color: #6366f1;
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .menu-items-wrapper {
        flex: 1;
        overflow-y: auto;
        padding: 20px 24px;
    }

    .menu-items {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }

    .menu-item {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid #f1f5f9;
        position: relative;
    }

    .menu-item:hover {
        border-color: #6366f1;
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(99, 102, 241, 0.15);
    }

    .menu-item-image {
        width: 100%;
        height: 140px;
        object-fit: cover;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    }

    .menu-item-placeholder {
        width: 100%;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
    }

    .menu-item-content {
        padding: 16px;
    }

    .menu-item-name {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 6px;
        font-size: 0.95rem;
        line-height: 1.3;
    }

    .menu-item-desc {
        color: #64748b;
        font-size: 0.8rem;
        margin-bottom: 10px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .menu-item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .menu-item-price {
        font-weight: 700;
        color: #6366f1;
        font-size: 1rem;
    }

    .menu-item-add {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        border: none;
        color: white;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .menu-item-add:hover {
        transform: scale(1.15);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.4);
    }

    /* Order Section */
    .order-section {
        background: white;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
    }

    .order-header {
        padding: 20px;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        flex-shrink: 0;
    }

    .order-header h5 {
        color: white;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-selector {
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        flex-shrink: 0;
    }

    .table-selector label {
        display: block;
        color: #475569;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    .table-selector select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 500;
        color: #1e293b;
        background: white;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .table-selector select:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }

    .order-items-wrapper {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
        min-height: 150px;
    }

    .order-items-wrapper::-webkit-scrollbar {
        width: 6px;
    }

    .order-items-wrapper::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }

    .order-items-wrapper::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    .empty-order {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }

    .empty-order i {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .order-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f8fafc;
        border-radius: 12px;
        margin-bottom: 10px;
        border: 1px solid #e2e8f0;
    }

    .order-item-info {
        flex: 1;
        min-width: 0;
    }

    .order-item-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .order-item-price {
        color: #64748b;
        font-size: 0.8rem;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        background: white;
        border-radius: 8px;
        padding: 4px;
        border: 1px solid #e2e8f0;
    }

    .quantity-btn {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: none;
        background: #6366f1;
        color: white;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .quantity-btn:hover {
        background: #4f46e5;
    }

    .quantity-display {
        min-width: 24px;
        text-align: center;
        font-weight: 600;
        color: #1e293b;
    }

    .remove-item {
        background: #fee2e2;
        color: #ef4444;
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .remove-item:hover {
        background: #ef4444;
        color: white;
    }

    .customer-note {
        padding: 16px 20px;
        border-top: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

    .customer-note label {
        display: block;
        color: #475569;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    .customer-note textarea {
        width: 100%;
        padding: 12px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.875rem;
        color: #1e293b;
        resize: none;
        height: 60px;
    }

    .customer-note textarea:focus {
        outline: none;
        border-color: #6366f1;
    }

    .order-summary {
        padding: 16px 20px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 0.9rem;
    }

    .summary-total {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.1rem;
        border-top: 2px solid #e2e8f0;
        padding-top: 12px;
        margin-top: 8px;
    }

    .summary-total span:last-child {
        color: #22c55e;
    }

    .order-actions {
        padding: 20px;
        display: flex;
        gap: 12px;
        background: white;
        border-top: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

    .btn-custom {
        flex: 1;
        padding: 14px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-order {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
    }

    .btn-order:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
    }

    .btn-clear {
        background: #fee2e2;
        color: #ef4444;
    }

    .btn-clear:hover {
        background: #ef4444;
        color: white;
    }

    /* Icon Backgrounds */
    .hotpot-icon { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
    .meat-icon { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); }
    .seafood-icon { background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); }
    .vegetable-icon { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); }
    .side-icon { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .drink-icon { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); }

    /* Responsive */
    @@media (max-width: 1024px) {
        .menu-layout {
            grid-template-columns: 1fr;
            grid-template-rows: 1fr auto;
            height: auto;
            min-height: calc(100vh - 140px);
        }

        .menu-section {
            height: 60vh;
        }

        .order-section {
            height: auto;
            max-height: 50vh;
        }
    }

    @@media (max-width: 768px) {
        .menu-items {
            grid-template-columns: repeat(2, 1fr);
        }

        .menu-layout {
            gap: 12px;
        }
    }
</style>

<div class="menu-container">
    <div class="menu-layout">
        <!-- Menu Section -->
        <div class="menu-section">
            <div class="menu-header">
                <div>
                    <h4>
                        <i class="fas fa-fire"></i>Thực Đơn
                    </h4>
                    <small>Chọn món cho bàn @(ViewBag.TableId ?? "...")</small>
                </div>
                <a href="@Url.Action("Orders", "Cashier")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>

            <div class="menu-categories">
                <button class="category-btn active" onclick="filterCategory('all')">
                    <i class="fas fa-th-large me-1"></i>Tất Cả
                </button>
                <button class="category-btn" onclick="filterCategory('hotpot')">
                    <i class="fas fa-fire me-1"></i>Nước Lẩu
                </button>
                <button class="category-btn" onclick="filterCategory('meat')">
                    <i class="fas fa-drumstick-bite me-1"></i>Thịt
                </button>
                <button class="category-btn" onclick="filterCategory('seafood')">
                    <i class="fas fa-fish me-1"></i>Hải Sản
                </button>
                <button class="category-btn" onclick="filterCategory('vegetable')">
                    <i class="fas fa-leaf me-1"></i>Rau & Nấm
                </button>
                <button class="category-btn" onclick="filterCategory('side')">
                    <i class="fas fa-bowl-rice me-1"></i>Món Phụ
                </button>
                <button class="category-btn" onclick="filterCategory('drinks')">
                    <i class="fas fa-glass-whiskey me-1"></i>Đồ Uống
                </button>
            </div>

            <div class="menu-items-wrapper">
                <div class="menu-items" id="menuItems">
                    <div class="text-center p-4">
                        <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                        <p>Đang tải menu...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Section -->
        <div class="order-section">
            <div class="order-header">
                <h5>
                    <i class="fas fa-shopping-cart"></i>Đơn Hàng
                </h5>
            </div>

            <div class="table-selector">
                <label>
                    <i class="fas fa-table me-1"></i>Chọn Bàn
                </label>
                <select id="tableSelect">
                    <option value="">-- Chọn bàn --</option>
                </select>
            </div>

            <div class="order-items-wrapper">
                <div id="orderItems">
                    <div class="empty-order">
                        <i class="fas fa-shopping-basket"></i>
                        <p>Chưa có món nào được chọn</p>
                    </div>
                </div>
            </div>

            <div class="customer-note">
                <label>
                    <i class="fas fa-sticky-note me-1"></i>Ghi chú
                </label>
                <textarea id="customerNote" placeholder="Ghi chú đặc biệt (độ cay, không hành...)"></textarea>
            </div>

            <div class="order-summary" id="orderSummary" style="display: none;">
                <div class="summary-row">
                    <span>Tạm tính:</span>
                    <span id="subtotal">0 VNĐ</span>
                </div>
                <div class="summary-row">
                    <span>Thuế VAT (10%):</span>
                    <span id="taxAmount">0 VNĐ</span>
                </div>
                <div class="summary-row summary-total">
                    <span>Tổng cộng:</span>
                    <span id="totalAmount">0 VNĐ</span>
                </div>
            </div>

            <div class="order-actions">
                <button class="btn-custom btn-clear" onclick="clearOrder()">
                    <i class="fas fa-trash"></i>Xóa
                </button>
                <button class="btn-custom btn-order" onclick="submitOrder()">
                    <i class="fas fa-check"></i>Đặt Món
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    // Global variables
    var currentOrder = [];
    var currentCategory = 'all';
    var menuData = [];
    var tablesData = [];

    // Load tables from Database
    function loadTablesFromDatabase() {
        fetch('@Url.Action("GetTablesData", "Cashier")', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success && data.tables) {
                tablesData = data.tables;
                renderTableOptions();
            } else {
                showToast('Không thể tải danh sách bàn', 'error');
            }
        })
        .catch(function(error) {
            showToast('Lỗi kết nối khi tải danh sách bàn!', 'error');
        });
    }

    function renderTableOptions() {
        var select = document.getElementById('tableSelect');
        select.innerHTML = '<option value="">-- Chọn bàn --</option>';

        var tablesByArea = {};
        tablesData.forEach(function(table) {
            if (!tablesByArea[table.areaName]) {
                tablesByArea[table.areaName] = [];
            }
            tablesByArea[table.areaName].push(table);
        });

        for (var areaName in tablesByArea) {
            var optgroup = document.createElement('optgroup');
            optgroup.label = areaName;

            tablesByArea[areaName].forEach(function(table) {
                var option = document.createElement('option');
                option.value = table.id;
                option.textContent = 'Bàn ' + table.tableNumber + ' - ' + table.statusText;
                optgroup.appendChild(option);
            });

            select.appendChild(optgroup);
        }
    }

    function loadMenuFromDatabase() {
        var container = document.getElementById('menuItems');
        container.innerHTML = '<div class="text-center p-4"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i><p>Đang tải menu...</p></div>';

        fetch('@Url.Action("GetMenuItems", "Cashier")', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success && data.items) {
                menuData = data.items.map(function(item) {
                    return {
                        id: item.id,
                        name: item.name,
                        category: item.category.toLowerCase().replace(/\s+/g, ''),
                        price: item.price,
                        description: item.description || '',
                        image: item.imageUrl,
                        preparationTime: item.preparationTime,
                        isAvailable: item.isAvailable
                    };
                });
                renderMenuItems();
            } else {
                showError('Không thể tải menu');
            }
        })
        .catch(function(error) {
            showError('Lỗi kết nối khi tải menu');
        });
    }

    function showError(message) {
        var container = document.getElementById('menuItems');
        container.innerHTML = '<div class="text-center text-danger p-4"><i class="fas fa-exclamation-triangle fa-2x mb-3"></i><p>' + message + '</p><button class="btn btn-primary mt-2" onclick="loadMenuFromDatabase()">Thử lại</button></div>';
    }

    window.addEventListener('load', function() {
        var tableId = @(ViewBag.TableId ?? "null");
        loadTablesFromDatabase();
        loadMenuFromDatabase();
        renderOrderItems();

        if (tableId) {
            setTimeout(function() {
                var select = document.getElementById('tableSelect');
                if (select) select.value = tableId;
            }, 500);
        }
    });

    function getIconClass(category) {
        var iconClasses = {
            'nướclẩu': 'hotpot-icon', 'hotpot': 'hotpot-icon',
            'meat': 'meat-icon', 'thịt': 'meat-icon',
            'seafood': 'seafood-icon', 'hảisản': 'seafood-icon',
            'vegetable': 'vegetable-icon', 'rau&nấm': 'vegetable-icon', 'rau': 'vegetable-icon',
            'side': 'side-icon', 'sideorders': 'side-icon',
            'drinks': 'drink-icon', 'đồuống': 'drink-icon'
        };
        return iconClasses[category] || 'hotpot-icon';
    }

    function getIcon(category) {
        var icons = {
            'nướclẩu': 'fas fa-fire', 'hotpot': 'fas fa-fire',
            'meat': 'fas fa-drumstick-bite', 'thịt': 'fas fa-drumstick-bite',
            'seafood': 'fas fa-fish', 'hảisản': 'fas fa-fish',
            'vegetable': 'fas fa-leaf', 'rau&nấm': 'fas fa-leaf', 'rau': 'fas fa-leaf',
            'side': 'fas fa-bowl-rice', 'sideorders': 'fas fa-bowl-rice',
            'drinks': 'fas fa-glass-whiskey', 'đồuống': 'fas fa-glass-whiskey'
        };
        return icons[category] || 'fas fa-utensils';
    }

    function matchesCategory(itemCategory, filterCategory) {
        var categoryMap = {
            'hotpot': ['nướclẩu', 'hotpot'],
            'meat': ['thịt', 'meat'],
            'seafood': ['hảisản', 'seafood'],
            'vegetable': ['rau&nấm', 'rau', 'vegetable'],
            'side': ['sideorders', 'side', 'phụ'],
            'drinks': ['đồuống', 'drinks']
        };

        if (categoryMap[filterCategory]) {
            return categoryMap[filterCategory].some(function(cat) {
                return itemCategory.toLowerCase().includes(cat.toLowerCase());
            });
        }
        return itemCategory.toLowerCase() === filterCategory.toLowerCase();
    }

    function renderMenuItems() {
        var container = document.getElementById('menuItems');
        var items = currentCategory === 'all'
            ? menuData.filter(function(item) { return item.isAvailable; })
            : menuData.filter(function(item) {
                return item.isAvailable && matchesCategory(item.category, currentCategory);
            });

        if (items.length === 0) {
            container.innerHTML = '<div class="text-center text-muted p-4"><i class="fas fa-utensils fa-2x mb-3"></i><p>Không có món ăn nào trong danh mục này</p></div>';
            return;
        }

        var html = '';
        items.forEach(function(item) {
            var iconClass = getIconClass(item.category);
            var icon = getIcon(item.category);

            html += '<div class="menu-item" onclick="addToOrder(' + item.id + ')">';
            if (item.image) {
                var imagePath = '../images/menu/' + item.image;
                html += '<img src="' + imagePath + '" alt="' + item.name + '" class="menu-item-image" onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'flex\';" />';
                html += '<div class="menu-item-placeholder ' + iconClass + '" style="display: none;"><i class="' + icon + '"></i></div>';
            } else {
                html += '<div class="menu-item-placeholder ' + iconClass + '"><i class="' + icon + '"></i></div>';
            }
            html += '<div class="menu-item-content">';
            html += '<div class="menu-item-name">' + item.name + '</div>';
            html += '<div class="menu-item-desc">' + item.description + '</div>';
            html += '<div class="menu-item-footer">';
            html += '<div class="menu-item-price">' + item.price.toLocaleString() + ' VNĐ</div>';
            html += '<button class="menu-item-add" onclick="event.stopPropagation(); addToOrder(' + item.id + ')"><i class="fas fa-plus"></i></button>';
            html += '</div></div></div>';
        });

        container.innerHTML = html;
    }

    function filterCategory(category) {
        document.querySelectorAll('.category-btn').forEach(function(btn) {
            btn.classList.remove('active');
        });
        event.target.closest('.category-btn').classList.add('active');
        currentCategory = category;
        renderMenuItems();
    }

    function addToOrder(itemId) {
        var menuItem = menuData.find(function(item) { return item.id === itemId; });
        if (!menuItem) return;

        var existingItem = currentOrder.find(function(item) { return item.id === itemId; });
        if (existingItem) {
            existingItem.quantity++;
        } else {
            currentOrder.push({ id: itemId, name: menuItem.name, price: menuItem.price, quantity: 1 });
        }

        renderOrderItems();
        updateOrderSummary();
        showToast('Đã thêm ' + menuItem.name);
    }

    function renderOrderItems() {
        var container = document.getElementById('orderItems');
        if (currentOrder.length === 0) {
            container.innerHTML = '<div class="empty-order"><i class="fas fa-shopping-basket"></i><p>Chưa có món nào được chọn</p></div>';
            return;
        }

        var html = '';
        currentOrder.forEach(function(item) {
            html += '<div class="order-item">';
            html += '<div class="order-item-info"><div class="order-item-name">' + item.name + '</div>';
            html += '<div class="order-item-price">' + item.price.toLocaleString() + ' VNĐ</div></div>';
            html += '<div class="quantity-controls">';
            html += '<button class="quantity-btn" onclick="changeQuantity(' + item.id + ', -1)">-</button>';
            html += '<span class="quantity-display">' + item.quantity + '</span>';
            html += '<button class="quantity-btn" onclick="changeQuantity(' + item.id + ', 1)">+</button></div>';
            html += '<button class="remove-item" onclick="removeFromOrder(' + item.id + ')"><i class="fas fa-trash"></i></button>';
            html += '</div>';
        });
        container.innerHTML = html;
    }

    function changeQuantity(itemId, change) {
        var item = currentOrder.find(function(i) { return i.id === itemId; });
        if (item) {
            item.quantity += change;
            if (item.quantity <= 0) {
                removeFromOrder(itemId);
            } else {
                renderOrderItems();
                updateOrderSummary();
            }
        }
    }

    function removeFromOrder(itemId) {
        currentOrder = currentOrder.filter(function(item) { return item.id !== itemId; });
        renderOrderItems();
        updateOrderSummary();
    }

    function updateOrderSummary() {
        var summaryContainer = document.getElementById('orderSummary');
        if (currentOrder.length === 0) {
            summaryContainer.style.display = 'none';
            return;
        }
        summaryContainer.style.display = 'block';

        var subtotal = currentOrder.reduce(function(sum, item) { return sum + (item.price * item.quantity); }, 0);
        var tax = Math.round(subtotal * 0.1);
        var total = subtotal + tax;

        document.getElementById('subtotal').textContent = subtotal.toLocaleString() + ' VNĐ';
        document.getElementById('taxAmount').textContent = tax.toLocaleString() + ' VNĐ';
        document.getElementById('totalAmount').textContent = total.toLocaleString() + ' VNĐ';
    }

    function clearOrder() {
        if (currentOrder.length === 0) return;
        if (confirm('Bạn có chắc muốn xóa toàn bộ đơn hàng?')) {
            currentOrder = [];
            renderOrderItems();
            updateOrderSummary();
            showToast('Đã xóa đơn hàng');
        }
    }

    function submitOrder() {
        var tableId = document.getElementById('tableSelect').value;
        var customerNote = document.getElementById('customerNote').value;

        if (!tableId) {
            showToast('Vui lòng chọn số bàn!', 'error');
            return;
        }
        if (currentOrder.length === 0) {
            showToast('Vui lòng chọn ít nhất một món!', 'error');
            return;
        }

        var submitBtn = document.querySelector('.btn-order');
        var originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang xử lý...';

        var formData = new FormData();
        formData.append('tableId', tableId);
        formData.append('orderItems', JSON.stringify(currentOrder));
        formData.append('customerNote', customerNote || '');

        fetch('@Url.Action("CreateOrder", "Cashier")', { method: 'POST', body: formData })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                showToast('Đơn hàng đã được tạo thành công!', 'success');
                currentOrder = [];
                renderOrderItems();
                updateOrderSummary();
                document.getElementById('customerNote').value = '';
                setTimeout(function() { window.location.href = '@Url.Action("Orders", "Cashier")'; }, 1500);
            } else {
                showToast('Lỗi: ' + data.message, 'error');
            }
        })
        .catch(function(error) { showToast('Có lỗi xảy ra khi tạo đơn hàng!', 'error'); })
        .finally(function() { submitBtn.disabled = false; submitBtn.innerHTML = originalText; });
    }

    function showToast(message, type) {
        type = type || 'info';
        var colors = { 'success': '#22c55e', 'error': '#ef4444', 'warning': '#f59e0b', 'info': '#6366f1' };
        var toast = document.createElement('div');
        toast.style.cssText = 'position: fixed; top: 80px; right: 20px; padding: 16px 24px; border-radius: 12px; color: white; font-weight: 600; z-index: 9999; opacity: 0; transition: opacity 0.3s ease; max-width: 320px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);';
        toast.style.backgroundColor = colors[type];
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '1'; }, 100);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { if (toast.parentNode) document.body.removeChild(toast); }, 300); }, 3000);
    }
    </script>
}