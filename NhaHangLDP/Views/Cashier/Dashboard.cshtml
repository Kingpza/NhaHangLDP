@model NhaHangLDP.Models.CashierDashboardViewModel
@{
    ViewBag.Title = "POS - Dashboard";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<!-- Shift Info Bar -->
<div class="shift-info-bar">
    <div class="shift-info-left">
        <div class="shift-info-item">
            <i class="fas fa-play-circle"></i>
            <span>Ca làm việc đang hoạt động</span>
        </div>
        <div class="shift-info-item">
            <i class="fas fa-clock"></i>
            <span>Bắt đầu: <strong id="shiftStartTime">@(Model.ShiftStartTime?.ToString("HH:mm") ?? "--:--")</strong></span>
        </div>
        <div class="shift-info-item">
            <i class="fas fa-hourglass-half"></i>
            <span>Thời gian: <strong id="workingTime">00:00:00</strong></span>
        </div>
        <div class="shift-info-item">
            <i class="fas fa-user"></i>
            <span>@(Model.ActiveShift?.Employee?.FullName ?? "Thu Ngân")</span>
        </div>
    </div>
    <div class="shift-actions">
        <button class="btn-shift" onclick="openAddEmployeeModal()">
            <i class="fas fa-user-plus"></i> Thêm NV
        </button>
        <button class="btn-shift" onclick="showPrintInvoiceOptions()">
            <i class="fas fa-print"></i> In Hóa Đơn
        </button>
        <button class="btn-shift danger" onclick="closeShift()">
            <i class="fas fa-stop"></i> Đóng Ca
        </button>
    </div>
</div>

<!-- Main Content -->
<div class="pos-content">
    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card primary">
                <div class="stat-card-icon">
                    <i class="fas fa-receipt"></i>
                </div>
                <div class="stat-card-value" id="todayOrders">@Model.TotalOrdersToday</div>
                <div class="stat-card-label">Đơn hàng hôm nay</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card success">
                <div class="stat-card-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div class="stat-card-value" id="todayRevenue">@Model.TodayRevenueDisplay</div>
                <div class="stat-card-label">Doanh thu</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card warning">
                <div class="stat-card-icon">
                    <i class="fas fa-chair"></i>
                </div>
                <div class="stat-card-value" id="activeTables">@Model.TableUsageDisplay</div>
                <div class="stat-card-label">Bàn đang sử dụng</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="stat-card info">
                <div class="stat-card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-card-value" id="pendingOrders">@Model.PendingOrderCount</div>
                <div class="stat-card-label">Đơn chờ xử lý</div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="pos-card mb-4">
        <div class="pos-card-header">
            <div class="pos-card-title">
                <i class="fas fa-bolt"></i>
                Thao tác nhanh
            </div>
        </div>
        <div class="pos-card-body">
            <div class="quick-action-grid">
                <a href="@Url.Action("Orders", "Cashier")" class="quick-action-card orders">
                    <div class="quick-action-icon">
                        <i class="fas fa-clipboard-list"></i>
                    </div>
                    <div class="quick-action-title">Đơn Hàng</div>
                    <div class="quick-action-desc">
                        Quản lý và xử lý đơn hàng
                        @if (Model.ActiveOrderCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@Model.ActiveOrderCount</span>
                        }
                    </div>
                </a>

                <a href="@Url.Action("TableArea", "Cashier")" class="quick-action-card tables">
                    <div class="quick-action-icon">
                        <i class="fas fa-border-all"></i>
                    </div>
                    <div class="quick-action-title">Khu Vực Bàn</div>
                    <div class="quick-action-desc">
                        Xem tình trạng bàn
                        @if (Model.OccupiedTables > 0)
                        {
                            <span class="badge bg-info ms-1">@Model.OccupiedTables</span>
                        }
                    </div>
                </a>

                <a href="@Url.Action("Menu", "Cashier")" class="quick-action-card sales">
                    <div class="quick-action-icon">
                        <i class="fas fa-cash-register"></i>
                    </div>
                    <div class="quick-action-title">Bán Hàng</div>
                    <div class="quick-action-desc">Tạo đơn và thanh toán</div>
                </a>

                <a href="@Url.Action("OnlineOrders", "Cashier")" class="quick-action-card online">
                    <div class="quick-action-icon">
                        <i class="fas fa-shopping-bag"></i>
                    </div>
                    <div class="quick-action-title">Đơn Online</div>
                    <div class="quick-action-desc">Xử lý đơn hàng online</div>
                </a>

                <a href="@Url.Action("Reservations", "Cashier")" class="quick-action-card reservations">
                    <div class="quick-action-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="quick-action-title">Đặt Bàn</div>
                    <div class="quick-action-desc">
                        Duyệt đơn đặt bàn
                        <span class="badge bg-warning text-dark ms-1" id="pendingReservationsBadge" style="display:none;">0</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Activity Section -->
    <div class="row">
        <div class="col-lg-8">
            <div class="pos-card">
                <div class="pos-card-header">
                    <div class="pos-card-title">
                        <i class="fas fa-history"></i>
                        Hoạt động gần đây
                    </div>
                </div>
                <div class="pos-card-body">
                    <div id="recentActivities">
                        <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="fas fa-play text-success"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">Ca làm việc được mở</div>
                                <small class="text-muted">@(Model.ShiftStartTime?.ToString("HH:mm dd/MM/yyyy") ?? "Vừa xong")</small>
                            </div>
                        </div>
                        @if (Model.TotalOrdersToday > 0)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                    <i class="fas fa-receipt text-primary"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Đã xử lý @Model.TotalOrdersToday đơn hàng</div>
                                    <small class="text-muted">Trong ca làm việc này</small>
                                </div>
                            </div>
                        }
                        @if (Model.TodayRevenue > 0)
                        {
                            <div class="d-flex align-items-center gap-3 p-3">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                    <i class="fas fa-coins text-warning"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Doanh thu: @Model.TodayRevenueDisplay</div>
                                    <small class="text-muted">Tính đến thời điểm hiện tại</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="pos-card">
                <div class="pos-card-header">
                    <div class="pos-card-title">
                        <i class="fas fa-chart-pie"></i>
                        Tổng quan
                    </div>
                </div>
                <div class="pos-card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted">Bàn trống</span>
                        <span class="fw-bold text-success">@Model.AvailableTables</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted">Bàn có khách</span>
                        <span class="fw-bold text-warning">@Model.OccupiedTables</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted">Bàn đã đặt</span>
                        <span class="fw-bold text-info">@Model.ReservedTables</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Tổng số bàn</span>
                        <span class="fw-bold">@Model.TotalTables</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Print Invoice Modal -->
<div class="modal fade" id="printInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-print me-2 text-primary"></i>Chọn loại in
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-grid gap-3">
                    <button type="button" class="btn btn-outline-primary p-3 text-start" onclick="printRecentInvoice()">
                        <i class="fas fa-receipt fa-lg me-3"></i>
                        <span>
                            <strong class="d-block">In Hóa Đơn Gần Nhất</strong>
                            <small class="text-muted">In lại hóa đơn vừa thanh toán</small>
                        </span>
                    </button>
                    <button type="button" class="btn btn-outline-info p-3 text-start" onclick="selectOrderForPrint()">
                        <i class="fas fa-search fa-lg me-3"></i>
                        <span>
                            <strong class="d-block">Chọn Đơn Hàng</strong>
                            <small class="text-muted">Tìm và chọn đơn hàng cụ thể</small>
                        </span>
                    </button>
                    <button type="button" class="btn btn-outline-success p-3 text-start" onclick="printShiftReport()">
                        <i class="fas fa-file-alt fa-lg me-3"></i>
                        <span>
                            <strong class="d-block">In Báo Cáo Ca</strong>
                            <small class="text-muted">In báo cáo doanh thu ca hiện tại</small>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Employee Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-user-plus me-2 text-success"></i>Thêm Nhân Viên Vào Ca
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="list-group" id="addEmployeeList">
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
                        <p class="mt-2 text-muted">Đang tải...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="confirmAddEmployeeBtn" onclick="executeAddEmployee()" disabled>
                    Xác nhận Thêm
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <style>
        .quick-action-card.reservations .quick-action-icon { 
            background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); 
        }
    </style>
    <script>
        let selectedAddEmployee = { id: null, name: null };
        let addEmployeeModalInstance = null;

        document.addEventListener('DOMContentLoaded', function() {
            addEmployeeModalInstance = new bootstrap.Modal(document.getElementById('addEmployeeModal'));
            updateWorkingTime();
            setInterval(updateWorkingTime, 1000);
            loadPendingReservations();
        });

        @{
            var shiftStartTimeJs = Model.ShiftStartTime.HasValue
                ? "new Date('" + Model.ShiftStartTime.Value.ToString("yyyy-MM-ddTHH:mm:ss") + "')"
                : "new Date()";
        }
        let shiftStartTime = @Html.Raw(shiftStartTimeJs);

        function updateWorkingTime() {
            const now = new Date();
            const diff = now - shiftStartTime;
            const hours = Math.floor(diff / 3600000);
            const minutes = Math.floor((diff % 3600000) / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);
            document.getElementById('workingTime').textContent =
                `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function loadPendingReservations() {
            fetch('@Url.Action("GetReservationsData", "Cashier")?status=Pending')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.counts) {
                        var pending = data.counts.pending || 0;
                        var badge = document.getElementById('pendingReservationsBadge');
                        if (pending > 0) {
                            badge.textContent = pending;
                            badge.style.display = 'inline';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                })
                .catch(() => {});
        }

        function showPrintInvoiceOptions() {
            new bootstrap.Modal(document.getElementById('printInvoiceModal')).show();
        }

        function printRecentInvoice() {
            bootstrap.Modal.getInstance(document.getElementById('printInvoiceModal')).hide();
            showLoading('Đang tìm hóa đơn...');
            
            fetch('@Url.Action("GetLastPaidOrder", "Cashier")')
                .then(r => r.json())
                .then(data => {
                    closeLoading();
                    if (data.success && data.orderId) {
                        window.open('@Url.Action("PrintBill", "Cashier")?orderId=' + data.orderId, '_blank');
                    } else {
                        showError('Không tìm thấy', data.message || 'Không có hóa đơn nào.');
                    }
                })
                .catch(() => {
                    closeLoading();
                    showError('Lỗi', 'Không thể kết nối đến máy chủ.');
                });
        }

        function selectOrderForPrint() {
            bootstrap.Modal.getInstance(document.getElementById('printInvoiceModal')).hide();
            window.location.href = '@Url.Action("ShiftDetails", "Cashier")';
        }

        function printShiftReport() {
            bootstrap.Modal.getInstance(document.getElementById('printInvoiceModal')).hide();
            window.open('@Url.Action("PrintShiftRevenueReport", "Cashier")?shiftId=@(Model.ActiveShift?.Id ?? 0)', '_blank');
        }

        function closeShift() {
            Swal.fire({
                title: 'Đóng ca làm việc?',
                text: 'Hệ thống sẽ tạo báo cáo doanh thu sau khi đóng ca.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đóng ca',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#ef4444'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading('Đang đóng ca...');
                    
                    fetch('@Url.Action("CloseShift", "Cashier")', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(r => r.json())
                    .then(data => {
                        closeLoading();
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đóng ca thành công!',
                                text: 'Đang mở báo cáo...',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                window.open(data.printUrl, '_blank');
                                window.location.href = '@Url.Action("OpenShift", "Cashier")';
                            });
                        } else {
                            showError('Lỗi', data.message);
                        }
                    })
                    .catch(() => {
                        closeLoading();
                        showError('Lỗi', 'Không thể kết nối đến máy chủ.');
                    });
                }
            });
        }

        async function openAddEmployeeModal() {
            addEmployeeModalInstance.show();
            document.getElementById('addEmployeeList').innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i></div>';
            document.getElementById('confirmAddEmployeeBtn').disabled = true;
            selectedAddEmployee = { id: null, name: null };

            try {
                const response = await fetch('@Url.Action("GetAvailableEmployees", "Cashier")');
                const employees = await response.json();
                
                const listElement = document.getElementById('addEmployeeList');
                listElement.innerHTML = '';

                if (employees.length === 0) {
                    listElement.innerHTML = '<div class="p-3 text-muted text-center">Không có nhân viên khả dụng</div>';
                    return;
                }

                employees.forEach(emp => {
                    const item = document.createElement('a');
                    item.href = '#';
                    item.className = 'list-group-item list-group-item-action';
                    item.innerHTML = `<i class="fas fa-user me-2"></i> ${emp.fullName}`;
                    item.onclick = (e) => {
                        e.preventDefault();
                        document.querySelectorAll('#addEmployeeList .list-group-item').forEach(i => i.classList.remove('active'));
                        item.classList.add('active');
                        selectedAddEmployee = { id: emp.id, name: emp.fullName };
                        document.getElementById('confirmAddEmployeeBtn').disabled = false;
                    };
                    listElement.appendChild(item);
                });
            } catch (error) {
                document.getElementById('addEmployeeList').innerHTML = '<div class="p-3 text-danger text-center">Lỗi tải danh sách</div>';
            }
        }

        function executeAddEmployee() {
            if (!selectedAddEmployee.id) return;

            const shiftId = @(Model.ActiveShift?.Id ?? 0);
            showLoading('Đang thêm nhân viên...');

            fetch(`@Url.Action("AddSupportEmployee", "Cashier")?shiftId=${shiftId}&employeeId=${selectedAddEmployee.id}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(data => {
                closeLoading();
                if (data.success) {
                    showSuccess('Thành công', `Đã thêm ${selectedAddEmployee.name} vào ca.`);
                    addEmployeeModalInstance.hide();
                } else {
                    showError('Lỗi', data.message);
                }
            })
            .catch(() => {
                closeLoading();
                showError('Lỗi', 'Không thể kết nối đến máy chủ.');
            });
        }

        // Auto refresh stats
        setInterval(function() {
            fetch('@Url.Action("GetDashboardStats", "Cashier")')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const stats = data.data;
                        document.getElementById('todayOrders').textContent = stats.TotalOrdersToday;
                        document.getElementById('todayRevenue').textContent = stats.TodayRevenue.toLocaleString() + ' VNĐ';
                        document.getElementById('activeTables').textContent = stats.OccupiedTables + '/' + stats.TotalTables;
                        document.getElementById('pendingOrders').textContent = stats.PendingOrderCount;
                    }
                });
            loadPendingReservations();
        }, 30000);
    </script>
}
