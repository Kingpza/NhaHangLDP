@model NhaHangLDP.Models.ShiftDetailsViewModel
@{
    ViewBag.Title = "Chi Tiết Ca Làm Việc";
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
}

<style>
    .shift-container {
        padding: 0;
    }

    /* Header */
    .page-header {
        background: white;
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header-info h4 {
        color: #1e293b;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 4px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-header-info h4 i { color: #6366f1; }
    .page-header-info small { color: #64748b; font-size: 0.875rem; }

    /* Info Cards Row */
    .info-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
    }

    .info-card.shift-info {
        border-left: 4px solid #22c55e;
    }

    .info-card.revenue-info {
        border-left: 4px solid #6366f1;
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

    .info-card-header i {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .shift-info .info-card-header i {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }

    .revenue-info .info-card-header i {
        background: rgba(99, 102, 241, 0.1);
        color: #6366f1;
    }

    .info-card-header h6 {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .info-label {
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 500;
    }

    .info-value {
        font-size: 0.95rem;
        color: #1e293b;
        font-weight: 600;
    }

    .badge-staff {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        margin-right: 8px;
        margin-bottom: 8px;
    }

    .badge-staff.primary {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
    }

    .badge-status {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-status.active {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }

    .badge-status.closed {
        background: rgba(100, 116, 139, 0.1);
        color: #64748b;
    }

    /* Summary Cards */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        position: relative;
        overflow: hidden;
    }

    .summary-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
    }

    .summary-card.orders::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .summary-card.revenue::before { background: linear-gradient(90deg, #22c55e, #16a34a); }
    .summary-card.avg::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .summary-card.completed::before { background: linear-gradient(90deg, #0ea5e9, #0284c7); }

    .summary-value {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .summary-card.orders .summary-value { color: #6366f1; }
    .summary-card.revenue .summary-value { color: #22c55e; }
    .summary-card.avg .summary-value { color: #f59e0b; }
    .summary-card.completed .summary-value { color: #0ea5e9; }

    .summary-label {
        font-size: 0.875rem;
        color: #64748b;
        font-weight: 500;
    }

    /* Filter Section */
    .filter-card {
        background: white;
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
    }

    .filter-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .filter-tab {
        padding: 10px 20px;
        border-radius: 25px;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.875rem;
    }

    .filter-tab:hover { border-color: #6366f1; color: #6366f1; }

    .filter-tab.active {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border-color: #6366f1;
        color: white;
    }

    .filter-inputs {
        display: none;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
    }

    .filter-inputs.show { display: grid; }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    .form-group input, .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.875rem;
        color: #1e293b;
        background: white;
    }

    .form-group input:focus, .form-group select:focus {
        outline: none;
        border-color: #6366f1;
    }

    .btn-filter {
        padding: 12px 24px;
        border-radius: 10px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border: none;
        color: white;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .btn-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }

    /* Orders Table */
    .orders-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

    .orders-table th {
        background: #f8fafc;
        padding: 16px;
        text-align: left;
        font-weight: 600;
        color: #475569;
        font-size: 0.875rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .orders-table td {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        font-size: 0.9rem;
    }

    .orders-table tr:hover {
        background: #f8fafc;
    }

    .order-id { font-weight: 700; color: #6366f1; }
    .order-amount { font-weight: 700; color: #22c55e; }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-completed { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
    .status-pending { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .status-cancelled { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

    .action-btns {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .btn-icon.view { background: rgba(14, 165, 233, 0.1); color: #0ea5e9; }
    .btn-icon.print { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
    .btn-icon:hover { transform: scale(1.1); }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #94a3b8;
    }

    .empty-state i { font-size: 3rem; margin-bottom: 16px; opacity: 0.5; }

    /* Pagination */
    .pagination-bar {
        display: flex;
        justify-content: center;
        padding: 20px;
        gap: 8px;
    }

    .page-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        background: white;
        color: #64748b;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .page-btn:hover, .page-btn.active {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border-color: #6366f1;
        color: white;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .info-row { grid-template-columns: 1fr; }
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 768px) {
        .summary-grid { grid-template-columns: 1fr; }
        .orders-table { display: block; overflow-x: auto; }
    }
</style>

<div class="shift-container">
    <div class="page-header">
        <div class="page-header-info">
            <h4><i class="fas fa-list-alt"></i>Chi Tiết Ca Làm Việc</h4>
            <small>Xem lịch sử hóa đơn và thống kê ca làm việc</small>
        </div>
        <a href="@Url.Action("Dashboard", "Cashier")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @if (Model?.ShiftInfo != null)
    {
        <div class="info-row">
            <div class="info-card shift-info">
                <div class="info-card-header">
                    <i class="fas fa-user-clock"></i>
                    <h6>Thông tin ca làm việc</h6>
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Thu ngân chính</span>
                        <span class="badge-staff primary">
                            <i class="fas fa-star"></i>@(Model.ShiftInfo.Employee?.FullName ?? "N/A")
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Trạng thái</span>
                        <span class="badge-status @(Model.ShiftInfo.Status == "Active" ? "active" : "closed")">
                            @(Model.ShiftInfo.Status == "Active" ? "Đang hoạt động" : "Đã đóng")
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Bắt đầu</span>
                        <span class="info-value">@Model.ShiftInfo.StartTime.ToString("HH:mm dd/MM/yyyy")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Thời gian làm việc</span>
                        <span class="info-value">@Model.WorkingTimeDisplay</span>
                    </div>
                    @if (Model.ShiftInfo.ShiftSupportStaff != null && Model.ShiftInfo.ShiftSupportStaff.Any())
                    {
                        <div class="info-item" style="grid-column: 1 / -1;">
                            <span class="info-label">Nhân viên hỗ trợ</span>
                            <div>
                                @foreach (var staff in Model.ShiftInfo.ShiftSupportStaff)
                                {
                                    <span class="badge-staff"><i class="fas fa-user"></i>@staff.Employee.FullName</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="info-card revenue-info">
                <div class="info-card-header">
                    <i class="fas fa-money-bill-wave"></i>
                    <h6>Thống kê doanh thu</h6>
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Tiền mặt đầu ca</span>
                        <span class="info-value">@Model.ShiftInfo.InitialCash.ToString("#,##0") VNĐ</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Tổng doanh thu</span>
                        <span class="info-value" style="color: #22c55e;">@Model.TotalRevenue.ToString("#,##0") VNĐ</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Tổng đơn hàng</span>
                        <span class="info-value">@Model.TotalOrders đơn</span>
                    </div>
                    @if (Model.ShiftInfo.EndTime.HasValue)
                    {
                        <div class="info-item">
                            <span class="info-label">Kết thúc</span>
                            <span class="info-value">@Model.ShiftInfo.EndTime.Value.ToString("HH:mm dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="summary-grid">
        <div class="summary-card orders">
            <div class="summary-value" id="totalOrders">@(Model?.TotalOrders ?? 0)</div>
            <div class="summary-label">Tổng đơn hàng</div>
        </div>
        <div class="summary-card revenue">
            <div class="summary-value" id="totalRevenue">@(Model?.TotalRevenue.ToString("#,##0") ?? "0")</div>
            <div class="summary-label">Doanh thu (VNĐ)</div>
        </div>
        <div class="summary-card avg">
            <div class="summary-value" id="avgOrderValue">@(Model?.TotalOrders > 0 ? (Model.TotalRevenue / Model.TotalOrders).ToString("#,##0") : "0")</div>
            <div class="summary-label">TB/Đơn (VNĐ)</div>
        </div>
        <div class="summary-card completed">
            <div class="summary-value" id="completedOrders">@(Model?.Orders?.Count(o => o.Status == "completed") ?? 0)</div>
            <div class="summary-label">Hoàn thành</div>
        </div>
    </div>

    <div class="filter-card">
        <div class="filter-tabs">
            <button class="filter-tab active" data-period="today" onclick="selectPeriod('today')">Hôm nay</button>
            <button class="filter-tab" data-period="month" onclick="selectPeriod('month')">Tháng này</button>
            <button class="filter-tab" data-period="custom" onclick="selectPeriod('custom')">Tùy chọn</button>
        </div>
        <div class="filter-inputs" id="customDateFilter">
            <div class="form-group">
                <label>Từ ngày</label>
                <input type="date" id="fromDate">
            </div>
            <div class="form-group">
                <label>Đến ngày</label>
                <input type="date" id="toDate">
            </div>
            <div class="form-group">
                <label>Tìm kiếm</label>
                <input type="text" id="searchInput" placeholder="Mã đơn, bàn...">
            </div>
            <button class="btn-filter" onclick="loadShiftData()">
                <i class="fas fa-search"></i>Lọc
            </button>
        </div>
    </div>

    <div class="orders-card">
        <div id="ordersTableContainer">
            @if (Model?.Orders != null && Model.Orders.Any())
            {
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Mã hóa đơn</th>
                            <th>Ngày giờ</th>
                            <th>Bàn</th>
                            <th>Số món</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="order-id">@order.OrderId</td>
                                <td><strong>@(order.BillId?.ToString() ?? "-")</strong></td>
                                <td>@order.Date @order.Time</td>
                                <td>@order.TableNumber</td>
                                <td>@order.ItemCount món</td>
                                <td class="order-amount">@order.TotalAmount.ToString("#,##0") VNđ</td>
                                <td><span class="status-badge status-@order.Status">@order.StatusDisplay</span></td>
                                <td>
                                    <div class="action-btns">
                                        <button class="btn-icon view" onclick="viewOrderDetail(@order.Id)" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn-icon print" onclick="reprintOrder('@order.OrderId')" title="In hóa đơn">
                                            <i class="fas fa-print"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-file-invoice"></i>
                    <h5>Không có đơn hàng nào</h5>
                    <p>Chưa có đơn hàng nào trong ca làm việc này.</p>
                </div>
            }
        </div>
        <div class="pagination-bar" id="paginationContainer" style="display: none;">
            <div id="pagination"></div>
        </div>
    </div>
</div>

<!-- Order Detail Modal -->
<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="orderDetailContent"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" onclick="reprintInvoice()">
                    <i class="fas fa-print me-1"></i>In hóa đơn
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    var ordersFromModel = [];
    @if (Model?.Orders != null)
    {
        <text>
        ordersFromModel = [
        @foreach (var order in Model.Orders)
        {
            <text>{ id: @order.Id, orderId: '@order.OrderId', billId: @(order.BillId.HasValue ? order.BillId.Value.ToString() : "null"), tableNumber: '@order.TableNumber', date: '@order.Date', time: '@order.Time', status: '@order.Status', statusDisplay: '@order.StatusDisplay', totalAmount: @order.TotalAmount, paymentMethod: '@order.PaymentMethod', itemCount: @order.ItemCount, cashierName: '@order.CashierName', items: [@foreach (var item in order.Items) {<text>{ name: '@Html.Raw(item.Name.Replace("'", "\\'"))', quantity: @item.Quantity, price: @item.Price, total: @item.Total },</text>}] },</text>
        }
        ];
        </text>
    }

    var currentPeriod = 'today';
    var currentPage = 1;
    var currentOrderId = null;

    document.addEventListener('DOMContentLoaded', function() {
        setDefaultDates();
    });

    function setDefaultDates() {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById('fromDate').value = today;
        document.getElementById('toDate').value = today;
    }

    function selectPeriod(period) {
        currentPeriod = period;
        document.querySelectorAll('.filter-tab').forEach(tab => tab.classList.remove('active'));
        document.querySelector(`[data-period="${period}"]`).classList.add('active');
        document.getElementById('customDateFilter').classList.toggle('show', period === 'custom');
        if (period !== 'custom') loadShiftData();
    }

    function loadShiftData() {
        var today = new Date();
        var fromDate, toDate;

        if (currentPeriod === 'today') {
            fromDate = toDate = today.toISOString().split('T')[0];
        } else if (currentPeriod === 'month') {
            fromDate = new Date(today.getFullYear(), today.getMonth(), 1).toISOString().split('T')[0];
            toDate = today.toISOString().split('T')[0];
        } else {
            fromDate = document.getElementById('fromDate').value;
            toDate = document.getElementById('toDate').value;
        }

        var search = document.getElementById('searchInput').value;

        document.getElementById('ordersTableContainer').innerHTML = '<div class="text-center p-4"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i><p>Đang tải...</p></div>';

        fetch('@Url.Action("GetShiftOrdersData", "Cashier")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: `fromDate=${fromDate}&toDate=${toDate}&search=${search}&page=${currentPage}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                renderOrdersTable(data.orders);
                updateSummaryCards(data.summary);
            }
        });
    }

    function renderOrdersTable(orders) {
        if (!orders || orders.length === 0) {
            document.getElementById('ordersTableContainer').innerHTML = '<div class="empty-state"><i class="fas fa-file-invoice"></i><h5>Không có đơn hàng</h5></div>';
            return;
        }

        var html = '<table class="orders-table"><thead><tr><th>Mã đơn</th><th>Mã hóa đơn</th><th>Ngày giờ</th><th>Bàn</th><th>Số món</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>';
        orders.forEach(function(order) {
            html += `<tr><td class="order-id">${order.OrderId}</td><td><strong>${order.BillId || '-'}</strong></td><td>${order.Date} ${order.Time}</td><td>${order.Table}</td><td>${order.ItemCount} món</td><td class="order-amount">${order.Total.toLocaleString()} VNĐ</td><td><span class="status-badge status-${order.Status}">${getStatusText(order.Status)}</span></td><td><div class="action-btns"><button class="btn-icon view" onclick="viewOrderDetail('${order.OrderId}')"><i class="fas fa-eye"></i></button><button class="btn-icon print" onclick="reprintOrder('${order.OrderId}')"><i class="fas fa-print"></i></button></div></td></tr>`;
        });
        html += '</tbody></table>';
        document.getElementById('ordersTableContainer').innerHTML = html;
    }

    function updateSummaryCards(summary) {
        if (summary) {
            document.getElementById('totalOrders').textContent = summary.TotalOrders.toLocaleString();
            document.getElementById('totalRevenue').textContent = summary.TotalRevenue.toLocaleString();
            document.getElementById('avgOrderValue').textContent = Math.round(summary.AvgOrderValue).toLocaleString();
            document.getElementById('completedOrders').textContent = summary.CompletedOrders.toLocaleString();
        }
    }

    function getStatusText(status) {
        return { 'completed': 'Hoàn thành', 'pending': 'Đang xử lý', 'cancelled': 'Đã hủy' }[status] || status;
    }

    function viewOrderDetail(orderId) {
        currentOrderId = orderId;
        var order = ordersFromModel.find(o => o.id == orderId || o.orderId == orderId);

        if (order) {
            var subtotal = order.items.reduce((sum, item) => sum + item.total, 0);
            var vat = Math.round(subtotal * 0.1);

            var html = `<div class="row"><div class="col-md-6"><h6 class="text-primary"><i class="fas fa-info-circle me-1"></i>Thông tin đơn</h6><p><strong>Mã đơn:</strong> ${order.orderId}</p><p><strong>Bàn:</strong> ${order.tableNumber}</p><p><strong>Thời gian:</strong> ${order.date} ${order.time}</p></div><div class="col-md-6"><h6 class="text-primary"><i class="fas fa-money-bill me-1"></i>Thanh toán</h6><p><strong>Tạm tính:</strong> ${subtotal.toLocaleString()} VNĐ</p><p><strong>VAT:</strong> ${vat.toLocaleString()} VNĐ</p><p><strong>Tổng:</strong> <span class="text-success fw-bold">${order.totalAmount.toLocaleString()} VNĐ</span></p></div></div><hr><h6 class="text-primary"><i class="fas fa-utensils me-1"></i>Chi tiết món</h6><table class="table table-striped"><thead><tr><th>Món</th><th>SL</th><th>Giá</th><th>Thành tiền</th></tr></thead><tbody>`;
            order.items.forEach(item => { html += `<tr><td>${item.name}</td><td>${item.quantity}</td><td>${item.price.toLocaleString()}</td><td>${item.total.toLocaleString()}</td></tr>`; });
            html += '</tbody></table>';
            document.getElementById('orderDetailContent').innerHTML = html;
            new bootstrap.Modal(document.getElementById('orderDetailModal')).show();
        } else {
            fetch('@Url.Action("GetOrderDetail", "Cashier")?orderId=' + orderId, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    var o = data.order;
                    var html = `<div class="row"><div class="col-md-6"><h6 class="text-primary">Thông tin đơn</h6><p><strong>Mã đơn:</strong> ${o.OrderId}</p><p><strong>Bàn:</strong> ${o.Table}</p><p><strong>Thời gian:</strong> ${o.Date} ${o.Time}</p></div><div class="col-md-6"><h6 class="text-primary">Thanh toán</h6><p><strong>Tổng:</strong> <span class="text-success fw-bold">${o.Total.toLocaleString()} VNĐ</span></p></div></div>`;
                    document.getElementById('orderDetailContent').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('orderDetailModal')).show();
                }
            });
        }
    }

    function reprintOrder(orderId) { window.open('@Url.Action("PrintBill", "Cashier")?orderId=' + orderId, '_blank'); }
    function reprintInvoice() { if (currentOrderId) reprintOrder(currentOrderId); }
    </script>
}