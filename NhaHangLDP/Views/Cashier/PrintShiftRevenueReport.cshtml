@model NhaHangLDP.Models.ShiftRevenueReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo Cáo Doanh Thu Ca - @Model.ShiftId</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            color: #333;
            background: #fff;
            padding: 20px;
        }

        .report-container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 30px;
            border: 1px solid #ddd;
        }

        .report-header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
        }

        .restaurant-name {
            font-size: 24px;
            font-weight: bold;
            color: #dc7633;
            margin-bottom: 10px;
        }

        .restaurant-info {
            font-size: 12px;
            color: #666;
            margin-bottom: 5px;
        }

        .report-title {
            font-size: 20px;
            font-weight: bold;
            margin-top: 20px;
            color: #333;
        }

        .shift-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

            .shift-info table {
                width: 100%;
                border-collapse: collapse;
            }

            .shift-info td {
                padding: 8px;
                border-bottom: 1px solid #ddd;
            }

                .shift-info td:first-child {
                    font-weight: bold;
                    width: 150px;
                }

        .support-staff-badge {
            display: inline-block;
            background: #f0f0f0;
            color: #333;
            padding: 3px 10px;
            border-radius: 5px;
            margin: 2px;
            font-size: 13px;
            border: 1px solid #ccc;
        }

        .revenue-summary {
            margin-bottom: 30px;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .summary-item {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            text-align: center;
            border: 1px solid #e9ecef;
        }

        .summary-value {
            font-size: 18px;
            font-weight: bold;
            color: #dc7633;
            margin-bottom: 5px;
        }

        .summary-label {
            font-size: 12px;
            color: #666;
        }

        .payment-methods {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            padding: 8px 12px;
            text-align: left;
            border: 1px solid #ddd;
        }

        th {
            background: #f8f9fa;
            font-weight: bold;
            color: #333;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .currency {
            font-weight: bold;
            color: #dc7633;
        }

        .report-footer {
            margin-top: 40px;
            text-align: center;
            border-top: 1px solid #ddd;
            padding-top: 20px;
            font-size: 12px;
            color: #666;
        }

        .signature-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            margin-top: 40px;
            text-align: center;
        }

        .signature-box {
            border-top: 1px solid #ddd;
            padding-top: 10px;
            margin-top: 60px;
        }


        .report-container {
            border: none;
            padding: 20px;
            box-shadow: none;
        }

        .no-print {
            display: none;
        }

        .print-controls {
            display: none;
        }

        .print-controls {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border: 1px solid #ddd;
        }

        .print-button {
            background: #dc7633;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 10px;
            transition: background-color 0.3s;
        }

            .print-button:hover {
                background: #c0623b;
            }

        .close-button {
            background: #6c757d;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s;
        }

            .close-button:hover {
                background: #5a6268;
            }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            display: none;
        }

        .loading-content {
            text-align: center;
            color: #dc7633;
        }

        .spinner {
            font-size: 2rem;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .print-status {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #28a745;
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            z-index: 1000;
            display: none;
        }
    </style>
</head>
<body>
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-content">
            <div class="spinner">
                <i class="fas fa-spinner fa-spin"></i>
            </div>
            <div style="margin-top: 10px;">
                <strong>Đang chuẩn bị báo cáo...</strong>
            </div>
        </div>
    </div>

    <div class="print-controls no-print">
        <button class="print-button" onclick="printReport()">
            <i class="fas fa-print"></i> In Báo Cáo
        </button>
        <button class="close-button" onclick="closeWindow()">
            <i class="fas fa-times"></i> Đóng
        </button>
    </div>

    <div class="print-status" id="printStatus">
        <i class="fas fa-check-circle"></i> Đã gửi lệnh in thành công!
    </div>

    <div class="report-container">
        <div class="report-header">
            <div class="restaurant-name">@Model.RestaurantName</div>
            <div class="restaurant-info">Địa chỉ: @Model.RestaurantAddress</div>
            <div class="restaurant-info">Điện thoại: @Model.RestaurantPhone</div>
            <div class="restaurant-info">Mã số thuế: @Model.RestaurantTaxCode</div>
            <div class="report-title">BÁO CÁO DOANH THU CA LÀM VIỆC</div>
        </div>

        <div class="shift-info">
            <table>
                <tr>
                    <td>Mã ca:</td>
                    <td><strong>@Model.ShiftId</strong></td>
                    <td>Thu ngân:</td>
                    <td><strong>@Model.CashierName</strong></td>
                </tr>
                <tr>
                    <td>Nhân viên thêm vào ca:</td>
                    <td colspan="3">
                        @if (Model.SupportStaffNames != null && Model.SupportStaffNames.Any())
                        {
                            foreach (var name in Model.SupportStaffNames)
                            {
                                <span class="support-staff-badge">@name</span>
                            }
                        }
                        else
                        {
                            <span style="color: #666;">Không có</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>Giờ bắt đầu:</td>
                    <td>@Model.ShiftStartTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>Giờ kết thúc:</td>
                    <td>@Model.ShiftEndTime.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
                <tr>
                    <td>Thời gian làm việc:</td>
                    <td colspan="3">@((Model.ShiftEndTime - Model.ShiftStartTime).Hours) giờ @((Model.ShiftEndTime - Model.ShiftStartTime).Minutes) phút</td>
                </tr>
            </table>
        </div>

        <div class="revenue-summary">
            <div class="section-title">TỔNG KẾT DOANH THU</div>
            <div class="summary-grid">
                <div class="summary-item">
                    <div class="summary-value">@Model.TotalOrders</div>
                    <div class="summary-label">Tổng đơn hàng</div>
                </div>
                <div class="summary-item">
                    <div class="summary-value">@Model.CompletedOrders</div>
                    <div class="summary-label">Đơn hoàn thành</div>
                </div>
                <div class="summary-item">
                    <div class="summary-value">@Model.CancelledOrders</div>
                    <div class="summary-label">Đơn đã hủy</div>
                </div>
                <div class="summary-item">
                    <div class="summary-value currency">@Model.TotalRevenue.ToString("N0") VNĐ</div>
                    <div class="summary-label">Tổng doanh thu</div>
                </div>
            </div>
        </div>

        <div class="payment-methods">
            <div class="section-title">CHI TIẾT PHƯƠNG THỨC THANH TOÁN</div>
            <table>
                <thead>
                    <tr>
                        <th>Phương thức</th>
                        <th class="text-center">Số đơn</th>
                        <th class="text-right">Tỷ lệ (%)</th>
                        <th class="text-right">Tổng tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var method in Model.PaymentMethods)
                    {
                        <tr>
                            <td>@method.MethodName</td>
                            <td class="text-center">@method.OrderCount</td>
                            <td class="text-right">@method.Percentage.ToString("0.00")%</td>
                            <td class="text-right currency">@method.TotalAmount.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: #f8f9fa; font-weight: bold;">
                        <td>Tổng cộng</td>
                        <td class="text-center">@Model.TotalOrders</td>
                        <td class="text-right">100%</td>
                        <td class="text-right currency">@Model.TotalRevenue.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (Model.TopOrders != null && Model.TopOrders.Any())
        {
            <div class="top-orders">
                <div class="section-title">CÁC ĐƠN HÀNG TIÊU BIỂU</div>
                <table>
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Bàn</th>
                            <th>Thời gian</th>
                            <th>Phương thức</th>
                            <th class="text-right">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.TopOrders.Take(10))
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>@order.TableName</td>
                                <td>@order.OrderTime.ToString("HH:mm")</td>
                                <td>@order.PaymentMethod</td>
                                <td class="text-right currency">@order.TotalAmount.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="cash-summary">
            <div class="section-title">TÌNH HÌNH TIỀN MẶT</div>
            <table style="width: 50%;">
                <tr>
                    <td style="font-weight: bold;">Tiền mặt đầu ca:</td>
                    <td class="text-right currency">@Model.OpeningAmount.ToString("N0") VNĐ</td>
                </tr>
                <tr>
                    <td style="font-weight: bold;">Doanh thu tiền mặt:</td>
                    <td class="text-right currency">@((Model.CashInHand - Model.OpeningAmount).ToString("N0")) VNĐ</td>
                </tr>
                <tr style="background: #f8f9fa; font-weight: bold;">
                    <td>Tổng tiền mặt cuối ca:</td>
                    <td class="text-right currency">@Model.CashInHand.ToString("N0") VNĐ</td>
                </tr>
            </table>
        </div>

        <div class="signature-section">
            <div>
                <div style="font-weight: bold;">Thu ngân</div>
                <div class="signature-box">@Model.CashierName</div>
            </div>
            <div>
                <div style="font-weight: bold;">Quản lý ca</div>
                <div class="signature-box">Ký tên</div>
            </div>
        </div>

        <div class="report-footer">
            <p>Báo cáo được tạo tự động bởi hệ thống POS</p>
            <p>Thời gian in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
            <p>Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi!</p>
        </div>
    </div>

    <script>
        let printExecuted = false;

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingOverlay').style.display = 'flex';

            setTimeout(function () {
                document.getElementById('loadingOverlay').style.display = 'none';

                setTimeout(function () {
                    if (!printExecuted) {
                        printReport();
                    }
                }, 500);
            }, 1000);
        });

        function printReport() {
            if (printExecuted) return;

            printExecuted = true;

            const status = document.getElementById('printStatus');
            status.style.display = 'block';

            window.print();

            setTimeout(function () {
                status.style.display = 'none';
            }, 3000);
        }

        function closeWindow() {
            if (window.confirm('Bạn có chắc muốn đóng cửa sổ báo cáo?')) {
                window.close();
            }
        }

        window.onafterprint = function () {
            console.log('Print job completed');
        };

        document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                printReport();
            }
            else if (e.key === 'Escape') {
                closeWindow();
            }
        });
    </script>
</body>
</html>