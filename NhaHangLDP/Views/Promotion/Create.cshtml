@model NhaHangLDP.Models.PromotionFormViewModel
@{
    ViewBag.Title = Model.IsEdit ? "Sửa Khuyến Mãi" : "Tạo Khuyến Mãi Mới";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .form-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            padding: 30px;
            margin-bottom: 20px;
        }
        .form-card h5 {
            color: #1e3a5f;
            font-weight: 600;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f0f0f0;
        }
        .form-card h5 i {
            color: #3b82f6;
            margin-right: 10px;
        }
        .preview-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 25px;
            color: white;
            position: sticky;
            top: 100px;
        }
        .preview-code {
            background: rgba(255,255,255,0.2);
            padding: 10px 20px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 20px;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 15px;
        }
        .preview-discount {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .preview-meta {
            opacity: 0.9;
            font-size: 14px;
        }
        .discount-type-btn {
            padding: 15px 25px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
            flex: 1;
            text-align: center;
        }
        .discount-type-btn:hover {
            border-color: #3b82f6;
        }
        .discount-type-btn.active {
            border-color: #3b82f6;
            background: #dbeafe;
        }
        .discount-type-btn i {
            font-size: 24px;
            display: block;
            margin-bottom: 8px;
            color: #3b82f6;
        }
        .day-checkbox {
            display: inline-flex;
            align-items: center;
            padding: 8px 15px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            margin: 5px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .day-checkbox:hover {
            border-color: #3b82f6;
        }
        .day-checkbox input {
            margin-right: 8px;
        }
        .day-checkbox.checked {
            background: #dbeafe;
            border-color: #3b82f6;
        }
    </style>
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="fas fa-@(Model.IsEdit ? "edit" : "plus") me-2"></i>@ViewBag.Title</h2>
            <p>@(Model.IsEdit ? "Chỉnh sửa thông tin khuyến mãi" : "Tạo chương trình khuyến mãi mới")</p>
        </div>
        <a href="@Url.Action("Index", "Promotion")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>
</div>

<form method="post" action="@(Model.IsEdit ? Url.Action("Edit", "Promotion") : Url.Action("Create", "Promotion"))">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    
    <div class="row">
        <div class="col-lg-8">
            <!-- Basic Info -->
            <div class="form-card">
                <h5><i class="fas fa-info-circle"></i>Thông Tin Cơ Bản</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Mã Khuyến Mãi <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control text-uppercase", placeholder = "VD: SUMMER20", maxlength = 20, required = "required" })
                            @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label">Tên Khuyến Mãi <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "VD: Giảm giá mùa hè", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Mô Tả</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Mô tả chi tiết chương trình khuyến mãi..." })
                        </div>
                    </div>
                </div>
            </div>

            <!-- Discount Settings -->
            <div class="form-card">
                <h5><i class="fas fa-percentage"></i>Cài Đặt Giảm Giá</h5>
                
                <label class="form-label mb-3">Loại Giảm Giá</label>
                <div class="d-flex gap-3 mb-4">
                    <label class="discount-type-btn @(Model.DiscountType == "Percentage" ? "active" : "")" id="btnPercentage">
                        <input type="radio" name="DiscountType" value="Percentage" @(Model.DiscountType == "Percentage" ? "checked" : "") style="display:none;">
                        <i class="fas fa-percent"></i>
                        Phần trăm
                    </label>
                    <label class="discount-type-btn @(Model.DiscountType == "Fixed" ? "active" : "")" id="btnFixed">
                        <input type="radio" name="DiscountType" value="Fixed" @(Model.DiscountType == "Fixed" ? "checked" : "") style="display:none;">
                        <i class="fas fa-money-bill-wave"></i>
                        Số tiền cố định
                    </label>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Giá Trị Giảm <span class="text-danger">*</span></label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.DiscountValue, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
                                <span class="input-group-text" id="discountUnit">%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Giảm Tối Đa</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.MaxDiscountAmount, new { @class = "form-control", type = "number", min = "0" })
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <small class="text-muted">Để trống nếu không giới hạn</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Đơn Hàng Tối Thiểu</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.MinOrderValue, new { @class = "form-control", type = "number", min = "0" })
                                <span class="input-group-text">VNĐ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Time Settings -->
            <div class="form-card">
                <h5><i class="fas fa-clock"></i>Thời Gian Áp Dụng</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Ngày Kết Thúc <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="enableHappyHour" @(Model.HappyHourStart.HasValue ? "checked" : "")>
                            <label class="form-check-label" for="enableHappyHour">
                                <strong>Bật Happy Hour</strong> - Chỉ áp dụng trong khung giờ nhất định
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6 happy-hour-fields" style="display: @(Model.HappyHourStart.HasValue ? "block" : "none")">
                        <div class="mb-3">
                            <label class="form-label">Giờ Bắt Đầu</label>
                            @Html.TextBoxFor(m => m.HappyHourStart, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                        </div>
                    </div>
                    <div class="col-md-6 happy-hour-fields" style="display: @(Model.HappyHourStart.HasValue ? "block" : "none")">
                        <div class="mb-3">
                            <label class="form-label">Giờ Kết Thúc</label>
                            @Html.TextBoxFor(m => m.HappyHourEnd, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label">Áp Dụng Các Ngày</label>
                    <div class="d-flex flex-wrap">
                        @{
                            var days = new[] {
                                new { Value = "Monday", Text = "T2" },
                                new { Value = "Tuesday", Text = "T3" },
                                new { Value = "Wednesday", Text = "T4" },
                                new { Value = "Thursday", Text = "T5" },
                                new { Value = "Friday", Text = "T6" },
                                new { Value = "Saturday", Text = "T7" },
                                new { Value = "Sunday", Text = "CN" }
                            };
                            var selectedDays = Model.ApplicableDays?.Split(',') ?? new string[0];
                        }
                        @foreach (var day in days)
                        {
                            var isChecked = selectedDays.Contains(day.Value);
                            <label class="day-checkbox @(isChecked ? "checked" : "")">
                                <input type="checkbox" name="ApplicableDays" value="@day.Value" @(isChecked ? "checked" : "")>
                                @day.Text
                            </label>
                        }
                    </div>
                    <small class="text-muted">Không chọn = áp dụng tất cả các ngày</small>
                </div>
            </div>

            <!-- Usage Limits -->
            <div class="form-card">
                <h5><i class="fas fa-user-shield"></i>Giới Hạn Sử Dụng</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Số Lượt Sử Dụng Tối Đa</label>
                            @Html.TextBoxFor(m => m.MaxUsageCount, new { @class = "form-control", type = "number", min = "0" })
                            <small class="text-muted">Để trống nếu không giới hạn</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Số Lượt / Khách Hàng</label>
                            @Html.TextBoxFor(m => m.MaxUsagePerCustomer, new { @class = "form-control", type = "number", min = "0" })
                            <small class="text-muted">Để trống nếu không giới hạn</small>
                        </div>
                    </div>
                </div>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsNewCustomerOnly, new { @class = "form-check-input" })
                    <label class="form-check-label">Chỉ áp dụng cho khách hàng mới</label>
                </div>
            </div>

            <!-- Status -->
            <div class="form-card">
                <h5><i class="fas fa-toggle-on"></i>Trạng Thái</h5>
                <div class="form-check form-switch">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", style = "width: 50px; height: 25px;" })
                    <label class="form-check-label ms-2">
                        <strong id="statusText">@(Model.IsActive ? "Đang kích hoạt" : "Tạm dừng")</strong>
                    </label>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Preview -->
            <div class="preview-card">
                <h6 class="text-white-50 mb-3">XEM TRƯỚC</h6>
                <div class="preview-code" id="previewCode">@(string.IsNullOrEmpty(Model.Code) ? "CODE" : Model.Code)</div>
                <div class="preview-discount" id="previewDiscount">
                    @(Model.DiscountType == "Percentage" ? $"Giảm {Model.DiscountValue}%" : $"Giảm {Model.DiscountValue:N0}đ")
                </div>
                <p class="preview-meta" id="previewName">@(string.IsNullOrEmpty(Model.Name) ? "Tên khuyến mãi" : Model.Name)</p>
                <hr style="border-color: rgba(255,255,255,0.2);">
                <p class="preview-meta mb-2">
                    <i class="far fa-calendar me-2"></i>
                    <span id="previewDate">@Model.StartDate.ToString("dd/MM") - @Model.EndDate.ToString("dd/MM/yyyy")</span>
                </p>
                @if (Model.MinOrderValue > 0)
                {
                    <p class="preview-meta">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Đơn tối thiểu: <span id="previewMin">@Model.MinOrderValue.ToString("N0")</span>đ
                    </p>
                }
            </div>

            <!-- Submit Buttons -->
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-2"></i>@(Model.IsEdit ? "Cập Nhật" : "Tạo Khuyến Mãi")
                </button>
                <a href="@Url.Action("Index", "Promotion")" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-2"></i>Hủy Bỏ
                </a>
            </div>
        </div>
    </div>
</form>

@section scripts {
    <script>
        $(document).ready(function() {
            // Discount type toggle
            $('.discount-type-btn').click(function() {
                $('.discount-type-btn').removeClass('active');
                $(this).addClass('active');
                updateDiscountUnit();
                updatePreview();
            });

            function updateDiscountUnit() {
                var type = $('input[name="DiscountType"]:checked').val();
                $('#discountUnit').text(type === 'Percentage' ? '%' : 'VNĐ');
            }

            // Happy hour toggle
            $('#enableHappyHour').change(function() {
                $('.happy-hour-fields').toggle(this.checked);
            });

            // Day checkbox styling
            $('.day-checkbox input').change(function() {
                $(this).parent().toggleClass('checked', this.checked);
            });

            // Status text
            $('#IsActive').change(function() {
                $('#statusText').text(this.checked ? 'Đang kích hoạt' : 'Tạm dừng');
            });

            // Live preview
            $('#Code').on('input', function() {
                $('#previewCode').text($(this).val().toUpperCase() || 'CODE');
            });

            $('#Name').on('input', function() {
                $('#previewName').text($(this).val() || 'Tên khuyến mãi');
            });

            $('#DiscountValue, input[name="DiscountType"]').on('input change', updatePreview);

            function updatePreview() {
                var type = $('input[name="DiscountType"]:checked').val();
                var value = $('#DiscountValue').val() || 0;
                var text = type === 'Percentage' ? 'Giảm ' + value + '%' : 'Giảm ' + Number(value).toLocaleString() + 'đ';
                $('#previewDiscount').text(text);
            }

            $('#StartDate, #EndDate').on('change', function() {
                var start = new Date($('#StartDate').val());
                var end = new Date($('#EndDate').val());
                if (start && end) {
                    $('#previewDate').text(
                        start.toLocaleDateString('vi-VN', {day:'2-digit', month:'2-digit'}) + ' - ' +
                        end.toLocaleDateString('vi-VN', {day:'2-digit', month:'2-digit', year:'numeric'})
                    );
                }
            });

            // Collect days for form submission
            $('form').submit(function() {
                var days = [];
                $('input[name="ApplicableDays"]:checked').each(function() {
                    days.push($(this).val());
                });
                // Update hidden field or use the checkboxes directly
            });
        });
    </script>
}
