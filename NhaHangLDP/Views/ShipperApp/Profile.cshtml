@model NhaHangLDP.Models.Shipper
@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#667eea" />
    <title>@ViewBag.Title - Shipper App</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                }
            }
        }
    </script>
    <style>
        .hero-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .form-input { transition: all 0.3s ease; }
        .form-input:focus { border-color: #667eea; box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1); }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 20px); }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen pb-24">

    <!-- Header -->
    <header class="hero-gradient text-white">
        <div class="px-4 py-4 flex items-center gap-4">
            <a href="@Url.Action("Dashboard")" class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/30 transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="flex-1">
                <h1 class="text-xl font-bold">Thông tin cá nhân</h1>
            </div>
        </div>
        
        <!-- Profile Avatar -->
        <div class="pb-10 text-center">
            <div class="w-28 h-28 bg-white/20 rounded-[2rem] flex items-center justify-center mx-auto mb-4 text-5xl font-black backdrop-blur-sm">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <h2 class="text-2xl font-black">@Model.FullName</h2>
            <p class="text-white/80">@Model.Phone</p>
            <div class="flex items-center justify-center gap-3 mt-3">
                <div class="flex items-center gap-1 px-3 py-1 bg-white/20 rounded-full text-sm">
                    <span class="material-symbols-outlined text-yellow-300">star</span>
                    <span class="font-bold">@Model.Rating.ToString("F1")</span>
                </div>
                <span class="text-white/60">|</span>
                <span class="px-3 py-1 bg-white/20 rounded-full text-sm">@Model.TotalDeliveries đơn</span>
            </div>
        </div>
    </header>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="mx-4 mt-4 bg-green-50 border-2 border-green-200 text-green-700 px-5 py-4 rounded-[1rem] flex items-center gap-3">
            <span class="material-symbols-outlined text-green-500">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mx-4 mt-4 bg-red-50 border-2 border-red-200 text-red-700 px-5 py-4 rounded-[1rem] flex items-center gap-3">
            <span class="material-symbols-outlined text-red-500">error</span>
            @TempData["Error"]
        </div>
    }

    <!-- Stats -->
    <section class="px-4 py-4 -mt-6">
        <div class="bg-white rounded-[2rem] p-6 shadow-lg border border-border-light">
            <div class="grid grid-cols-2 gap-4">
                <div class="text-center p-4 bg-green-50 rounded-[1.5rem] border border-green-100">
                    <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2">
                        <span class="material-symbols-outlined text-green-600 text-2xl">local_shipping</span>
                    </div>
                    <h3 class="text-2xl font-black text-green-600">@Model.TotalDeliveries</h3>
                    <p class="text-sm text-text-secondary">Tổng đơn giao</p>
                </div>
                <div class="text-center p-4 bg-blue-50 rounded-[1.5rem] border border-blue-100">
                    <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-2">
                        <span class="material-symbols-outlined text-blue-600 text-2xl">payments</span>
                    </div>
                    <h3 class="text-xl font-black text-blue-600">@Model.TotalEarnings.ToString("N0")đ</h3>
                    <p class="text-sm text-text-secondary">Tổng thu nhập</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Profile Form -->
    <section class="px-4 py-2">
        <div class="bg-white rounded-[2rem] shadow-lg overflow-hidden border border-border-light">
            <div class="p-5 border-b border-border-light bg-sidebar-surface">
                <h3 class="font-bold text-text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit</span>
                    Cập nhật thông tin
                </h3>
            </div>
            @using (Html.BeginForm("UpdateProfile", "ShipperApp", FormMethod.Post, new { @class = "p-5 space-y-4" }))
            {
                @Html.AntiForgeryToken()
                
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-primary text-lg">person</span>
                        Họ tên
                    </label>
                    <input type="text" name="fullName" value="@Model.FullName" required
                           class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none" />
                </div>
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-primary text-lg">mail</span>
                        Email
                    </label>
                    <input type="email" name="email" value="@Model.Email"
                           class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none" />
                </div>
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-primary text-lg">two_wheeler</span>
                        Loại xe
                    </label>
                    <select name="vehicleType" class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none bg-white">
                        <option value="Xe máy" @(Model.VehicleType == "Xe máy" ? "selected" : "")>Xe máy</option>
                        <option value="Xe đạp điện" @(Model.VehicleType == "Xe đạp điện" ? "selected" : "")>Xe đạp điện</option>
                        <option value="Ô tô" @(Model.VehicleType == "Ô tô" ? "selected" : "")>Ô tô</option>
                    </select>
                </div>
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-primary text-lg">directions_car</span>
                        Biển số xe
                    </label>
                    <input type="text" name="licensePlate" value="@Model.LicensePlate"
                           class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none" />
                </div>
                <button type="submit" class="w-full py-4 hero-gradient text-white rounded-full font-bold text-lg flex items-center justify-center gap-2 shadow-lg hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined">save</span>
                    Lưu thay đổi
                </button>
            }
        </div>
    </section>

    <!-- Change Password -->
    <section class="px-4 py-4">
        <div class="bg-white rounded-[2rem] shadow-lg overflow-hidden border border-border-light">
            <div class="p-5 border-b border-border-light bg-sidebar-surface">
                <h3 class="font-bold text-text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">lock</span>
                    Đổi mật khẩu
                </h3>
            </div>
            <div class="p-5 space-y-4">
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-text-secondary text-lg">key</span>
                        Mật khẩu hiện tại
                    </label>
                    <input type="password" id="currentPassword"
                           class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none" />
                </div>
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-text-secondary text-lg">lock_reset</span>
                        Mật khẩu mới
                    </label>
                    <input type="password" id="newPassword"
                           class="form-input w-full px-5 py-4 rounded-full border-2 border-border-light focus:outline-none" />
                </div>
                <button onclick="changePassword()" class="w-full py-4 bg-blue-500 text-white rounded-full font-bold text-lg flex items-center justify-center gap-2 shadow-lg hover:bg-blue-600 transition-all">
                    <span class="material-symbols-outlined">key</span>
                    Đổi mật khẩu
                </button>
            </div>
        </div>
    </section>

    <!-- Logout -->
    <section class="px-4 py-4">
        <a href="@Url.Action("Logout")" class="block w-full py-4 bg-red-500 text-white text-center rounded-full font-bold text-lg shadow-lg hover:bg-red-600 transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">logout</span>
            Đăng xuất
        </a>
    </section>

    <!-- Back to Restaurant -->
    <section class="px-4 pb-4">
        <a href="@Url.Action("Index", "Home")" class="block w-full py-4 bg-sidebar-surface text-text-secondary text-center rounded-full font-bold border-2 border-border-light hover:bg-border-light transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">restaurant</span>
            Về trang chủ Nhà hàng
        </a>
    </section>

    <!-- Bottom Navigation -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-border-light safe-bottom z-50 shadow-lg">
        <div class="flex justify-around py-3">
            <a href="@Url.Action("Dashboard")" class="flex flex-col items-center py-2 px-4 text-text-secondary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-2xl">home</span>
                <span class="text-xs">Trang chủ</span>
            </a>
            <a href="@Url.Action("NewOrders")" class="flex flex-col items-center py-2 px-4 text-text-secondary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-2xl">list_alt</span>
                <span class="text-xs">Đơn mới</span>
            </a>
            <a href="@Url.Action("History")" class="flex flex-col items-center py-2 px-4 text-text-secondary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-2xl">history</span>
                <span class="text-xs">Lịch sử</span>
            </a>
            <a href="@Url.Action("Earnings")" class="flex flex-col items-center py-2 px-4 text-text-secondary hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-2xl">payments</span>
                <span class="text-xs">Thu nhập</span>
            </a>
            <a href="@Url.Action("Profile")" class="flex flex-col items-center py-2 px-4 text-primary">
                <span class="material-symbols-outlined text-2xl">person</span>
                <span class="text-xs font-bold">Cá nhân</span>
            </a>
        </div>
    </nav>

    <script>
        function changePassword() {
            var currentPwd = document.getElementById('currentPassword').value;
            var newPwd = document.getElementById('newPassword').value;
            
            if (!currentPwd || !newPwd) {
                alert('Vui lòng nhập đầy đủ thông tin');
                return;
            }
            
            fetch('@Url.Action("ChangePassword")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'currentPassword=' + encodeURIComponent(currentPwd) + '&newPassword=' + encodeURIComponent(newPwd)
            })
            .then(r => r.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    document.getElementById('currentPassword').value = '';
                    document.getElementById('newPassword').value = '';
                }
            });
        }
    </script>
</body>
</html>
