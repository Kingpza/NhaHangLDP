@model NhaHangLDP.Models.EmployeeStatsViewModel
@{
    ViewBag.Title = "Thống kê nhân viên";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .employee-stats-page {
            padding: 20px 0;
        }

        .employee-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 25px;
        }

        .employee-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .employee-avatar {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
        }

        .employee-details h2 {
            margin: 0 0 5px 0;
        }

        .employee-details p {
            margin: 0;
            opacity: 0.9;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stats-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .stats-card h4 {
            margin: 0 0 20px 0;
            font-size: 1rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f3f4;
        }

        .stat-item:last-child {
            border-bottom: none;
        }

        .stat-item .label {
            color: #6c757d;
        }

        .stat-item .value {
            font-weight: 600;
            color: #212529;
        }

        .contract-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
        }

        .contract-info h5 {
            margin: 0 0 15px 0;
        }
    </style>
}

<div class="employee-stats-page">
    <!-- Back button -->
    <div class="mb-4">
        <a href="@Url.Action("Dashboard", "HR")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại Dashboard
        </a>
    </div>

    <!-- Employee Header -->
    <div class="employee-header">
        <div class="employee-info">
            <div class="employee-avatar">
                @(Model.Employee?.FullName?.Substring(0, 1).ToUpper() ?? "?")
            </div>
            <div class="employee-details">
                <h2>@Model.Employee?.FullName</h2>
                <p><i class="fas fa-user-tag me-2"></i>@Model.Employee?.Role?.RoleName</p>
                <p><i class="fas fa-calendar me-2"></i>Vào làm: @Model.Employee?.HireDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <!-- Attendance Stats -->
        <div class="stats-card">
            <h4><i class="fas fa-clock me-2"></i>Chấm công tháng này</h4>
            @if (Model.AttendanceStats != null)
            {
                <div class="stat-item">
                    <span class="label">Ngày có mặt</span>
                    <span class="value text-success">@Model.AttendanceStats.PresentDays ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Đi trễ</span>
                    <span class="value text-warning">@Model.AttendanceStats.LateDays lần</span>
                </div>
                <div class="stat-item">
                    <span class="label">Vắng mặt</span>
                    <span class="value text-danger">@Model.AttendanceStats.AbsentDays ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Tổng giờ làm</span>
                    <span class="value">@Model.AttendanceStats.TotalWorkHours.ToString("N1") giờ</span>
                </div>
                <div class="stat-item">
                    <span class="label">Tỷ lệ chuyên cần</span>
                    <span class="value text-primary">@Model.AttendanceStats.AttendanceRate.ToString("N1")%</span>
                </div>
            }
            else
            {
                <p class="text-muted">Chưa có dữ liệu</p>
            }
        </div>

        <!-- Leave Stats -->
        <div class="stats-card">
            <h4><i class="fas fa-calendar-minus me-2"></i>Nghỉ phép năm @DateTime.Now.Year</h4>
            @if (Model.LeaveStats != null)
            {
                <div class="stat-item">
                    <span class="label">Tổng phép năm</span>
                    <span class="value">@Model.LeaveStats.TotalAnnualLeave ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Đã sử dụng</span>
                    <span class="value text-warning">@Model.LeaveStats.UsedAnnualLeave ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Còn lại</span>
                    <span class="value text-success">@Model.LeaveStats.RemainingAnnualLeave ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Nghỉ ốm</span>
                    <span class="value">@Model.LeaveStats.SickLeaveUsed ngày</span>
                </div>
                <div class="stat-item">
                    <span class="label">Nghỉ không lương</span>
                    <span class="value">@Model.LeaveStats.UnpaidLeaveUsed ngày</span>
                </div>
            }
            else
            {
                <p class="text-muted">Chưa có dữ liệu</p>
            }
        </div>

        <!-- Contract Info -->
        <div class="stats-card">
            <h4><i class="fas fa-file-contract me-2"></i>Hợp đồng hiện tại</h4>
            @if (Model.CurrentContract != null)
            {
                <div class="stat-item">
                    <span class="label">Loại hợp đồng</span>
                    <span class="value">@Model.CurrentContract.ContractType</span>
                </div>
                <div class="stat-item">
                    <span class="label">Ngày bắt đầu</span>
                    <span class="value">@Model.CurrentContract.StartDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="stat-item">
                    <span class="label">Lương cơ bản</span>
                    <span class="value">@Model.CurrentContract.BaseSalary.ToString("N0")đ</span>
                </div>
                <div class="stat-item">
                    <span class="label">Phụ cấp</span>
                    <span class="value">@((Model.CurrentContract.Allowance ?? 0).ToString("N0"))đ</span>
                </div>
                <div class="stat-item">
                    <span class="label">Trạng thái</span>
                    <span class="value text-success">@Model.CurrentContract.Status</span>
                </div>
            }
            else
            {
                <p class="text-muted">Chưa có hợp đồng</p>
            }
        </div>
    </div>
</div>
