@model NhaHangLDP.Models.EmployeeContract
@{
    ViewBag.Title = "Tạo hợp đồng";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .contract-form-page {
            padding: 20px 0;
            max-width: 800px;
            margin: 0 auto;
        }

        .form-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #495057;
        }

        .form-control, .form-select {
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            padding-top: 20px;
        }

        .salary-preview {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            margin-top: 20px;
        }

        .salary-preview .total {
            font-size: 2rem;
            font-weight: 700;
        }
    </style>
}

<div class="contract-form-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-file-signature me-2"></i>Tạo hợp đồng mới</h2>
            <p class="text-muted mb-0">Tạo hợp đồng lao động cho nhân viên</p>
        </div>
        <a href="@Url.Action("Contracts")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @using (Html.BeginForm("CreateContract", "HR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-section">
            <h4 class="section-title"><i class="fas fa-user me-2"></i>Thông tin cơ bản</h4>

            <div class="form-group">
                <label>Nhân viên</label>
                @Html.DropDownListFor(m => m.EmployeeId, (SelectList)ViewBag.Employees,
                    "-- Chọn nhân viên --", new { @class = "form-select", required = "required" })
            </div>

            <div class="form-group">
                <label>Loại hợp đồng</label>
                @Html.DropDownListFor(m => m.ContractType, (List<SelectListItem>)ViewBag.ContractTypes,
                    "-- Chọn loại --", new { @class = "form-select", required = "required" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ngày bắt đầu</label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date", required = "required" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ngày kết thúc (tùy chọn)</label>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4 class="section-title"><i class="fas fa-money-bill me-2"></i>Thông tin lương</h4>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Lương cơ bản (VNĐ)</label>
                        @Html.TextBoxFor(m => m.BaseSalary, new { @class = "form-control", type = "number",
                            placeholder = "VD: 10000000", required = "required", id = "baseSalary" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Phụ cấp (VNĐ)</label>
                        @Html.TextBoxFor(m => m.Allowance, new { @class = "form-control", type = "number",
                            placeholder = "VD: 500000", id = "allowance" })
                    </div>
                </div>
            </div>

            <div class="salary-preview">
                <div class="small opacity-75">Tổng thu nhập hàng tháng</div>
                <div class="total" id="totalSalary">0 VNĐ</div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-group">
                <label>Ghi chú</label>
                @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 3,
                    placeholder = "Ghi chú thêm về hợp đồng..." })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Contracts")" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-times me-1"></i>Hủy
                </a>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-1"></i>Tạo hợp đồng
                </button>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function updateTotalSalary() {
            var baseSalary = parseFloat($('#baseSalary').val()) || 0;
            var allowance = parseFloat($('#allowance').val()) || 0;
            var total = baseSalary + allowance;
            $('#totalSalary').text(total.toLocaleString('vi-VN') + ' VNĐ');
        }

        $('#baseSalary, #allowance').on('input', updateTotalSalary);
        updateTotalSalary();
    </script>
}
