@{
    ViewBag.Title = "Quản lý nghỉ phép";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    var pendingRequests = ViewBag.PendingRequests as List<NhaHangLDP.Models.LeaveRequestItem> ?? new List<NhaHangLDP.Models.LeaveRequestItem>();
    var employees = ViewBag.Employees as List<NhaHangLDP.Data.Entities.Employee> ?? new List<NhaHangLDP.Data.Entities.Employee>();
}

@section styles {
    <style>
        .leave-page {
            padding: 20px 0;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .leave-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .stat-card .icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 1.5rem;
        }

        .stat-card.pending .icon { background: #fff3cd; color: #856404; }
        .stat-card.approved .icon { background: #d4edda; color: #155724; }
        .stat-card.rejected .icon { background: #f8d7da; color: #721c24; }

        .stat-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: #212529;
        }

        .stat-card .label {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .leave-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

        .leave-request-card {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }

        .leave-request-card:hover {
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .leave-request-card.pending {
            border-left: 4px solid #f39c12;
        }

        .leave-request-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .employee-info h5 {
            margin: 0 0 5px 0;
            font-weight: 600;
        }

        .employee-info p {
            margin: 0;
            color: #6c757d;
            font-size: 0.9rem;
        }

        .leave-type-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .leave-type-badge.annual { background: #d4edda; color: #155724; }
        .leave-type-badge.sick { background: #fff3cd; color: #856404; }
        .leave-type-badge.unpaid { background: #e2e3e5; color: #383d41; }
        .leave-type-badge.personal { background: #d1ecf1; color: #0c5460; }

        .leave-details {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 15px;
        }

        .leave-detail-item {
            text-align: center;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .leave-detail-item .value {
            font-weight: 600;
            color: #212529;
        }

        .leave-detail-item .label {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .leave-reason {
            background: #f8f9fa;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-size: 0.9rem;
            color: #495057;
        }

        .leave-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-badge.success { background: #d4edda; color: #155724; }
        .status-badge.warning { background: #fff3cd; color: #856404; }
        .status-badge.danger { background: #f8d7da; color: #721c24; }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #6c757d;
        }

        .empty-state i {
            font-size: 3rem;
            opacity: 0.3;
            margin-bottom: 15px;
        }
    </style>
}

<div class="leave-page">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="mb-1"><i class="fas fa-calendar-minus me-2"></i>Quản lý nghỉ phép</h2>
            <p class="text-muted mb-0">Xử lý đơn xin nghỉ phép của nhân viên</p>
        </div>
        <a href="@Url.Action("CreateLeaveRequest")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Tạo đơn mới
        </a>
    </div>

    <!-- Stats -->
    <div class="leave-stats">
        <div class="stat-card pending">
            <div class="icon"><i class="fas fa-clock"></i></div>
            <div class="value">@pendingRequests.Count</div>
            <div class="label">Chờ duyệt</div>
        </div>
        <div class="stat-card approved">
            <div class="icon"><i class="fas fa-check-circle"></i></div>
            <div class="value">0</div>
            <div class="label">Đã duyệt tháng này</div>
        </div>
        <div class="stat-card rejected">
            <div class="icon"><i class="fas fa-times-circle"></i></div>
            <div class="value">0</div>
            <div class="label">Đã từ chối</div>
        </div>
    </div>

    <!-- Pending Requests -->
    <div class="leave-section">
        <div class="section-header">
            <h4><i class="fas fa-hourglass-half me-2"></i>Đơn chờ duyệt</h4>
        </div>

        @if (pendingRequests.Any())
        {
            foreach (var request in pendingRequests)
            {
                var leaveTypeClass = request.LeaveType.ToLower();
                var leaveTypeName = request.LeaveType == "Annual" ? "Nghỉ phép năm" :
                                   (request.LeaveType == "Sick" ? "Nghỉ ốm" :
                                   (request.LeaveType == "Unpaid" ? "Nghỉ không lương" : "Việc riêng"));

                <div class="leave-request-card pending">
                    <div class="leave-request-header">
                        <div class="employee-info">
                            <h5>@request.EmployeeName</h5>
                            <p><i class="fas fa-calendar-plus me-1"></i>Ngày tạo: @DateTime.Now.ToString("dd/MM/yyyy")</p>
                        </div>
                        <span class="leave-type-badge @leaveTypeClass">@leaveTypeName</span>
                    </div>

                    <div class="leave-details">
                        <div class="leave-detail-item">
                            <div class="value">@request.StartDate.ToString("dd/MM/yyyy")</div>
                            <div class="label">Từ ngày</div>
                        </div>
                        <div class="leave-detail-item">
                            <div class="value">@request.EndDate.ToString("dd/MM/yyyy")</div>
                            <div class="label">Đến ngày</div>
                        </div>
                        <div class="leave-detail-item">
                            <div class="value">@request.Days ngày</div>
                            <div class="label">Tổng ngày nghỉ</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(request.Reason))
                    {
                        <div class="leave-reason">
                            <i class="fas fa-quote-left me-2 text-muted"></i>@request.Reason
                        </div>
                    }

                    <div class="leave-actions">
                        <button class="btn btn-success" onclick="approveLeave(@request.Id)">
                            <i class="fas fa-check me-1"></i>Phê duyệt
                        </button>
                        <button class="btn btn-danger" onclick="rejectLeave(@request.Id)">
                            <i class="fas fa-times me-1"></i>Từ chối
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h5>Không có đơn chờ duyệt</h5>
                <p>Tất cả đơn xin nghỉ đã được xử lý</p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function approveLeave(requestId) {
            Swal.fire({
                title: 'Phê duyệt đơn nghỉ?',
                text: 'Bạn có chắc muốn phê duyệt đơn này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Phê duyệt',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#2ecc71'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("ApproveLeaveRequest", "HR")', { requestId: requestId }, function (response) {
                        if (response.Success) {
                            showSuccess('Thành công', response.Message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showError('Lỗi', response.Message);
                        }
                    });
                }
            });
        }

        function rejectLeave(requestId) {
            Swal.fire({
                title: 'Từ chối đơn nghỉ?',
                input: 'textarea',
                inputLabel: 'Lý do từ chối',
                inputPlaceholder: 'Nhập lý do từ chối...',
                showCancelButton: true,
                confirmButtonText: 'Từ chối',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#e74c3c'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("RejectLeaveRequest", "HR")', {
                        requestId: requestId,
                        reason: result.value
                    }, function (response) {
                        if (response.Success) {
                            showSuccess('Thành công', response.Message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showError('Lỗi', response.Message);
                        }
                    });
                }
            });
        }
    </script>
}
