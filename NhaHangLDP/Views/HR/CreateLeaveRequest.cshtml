@model NhaHangLDP.Models.LeaveRequest
@{
    ViewBag.Title = "Tạo đơn xin nghỉ";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    var balance = ViewBag.CurrentBalance as NhaHangLDP.Models.LeaveBalanceStats;
}

@section styles {
    <style>
        .leave-form-page {
            padding: 20px 0;
            max-width: 800px;
            margin: 0 auto;
        }

        .form-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #495057;
        }

        .form-control, .form-select {
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .balance-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .balance-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .balance-item {
            text-align: center;
        }

        .balance-item .value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .balance-item .label {
            font-size: 0.8rem;
            opacity: 0.9;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            padding-top: 20px;
        }
    </style>
}

<div class="leave-form-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-calendar-plus me-2"></i>Tạo đơn xin nghỉ</h2>
            <p class="text-muted mb-0">Điền thông tin đơn xin nghỉ phép</p>
        </div>
        <a href="@Url.Action("LeaveManagement")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @if (balance != null)
    {
        <div class="balance-info">
            <h5 class="mb-3"><i class="fas fa-info-circle me-2"></i>Số ngày nghỉ còn lại</h5>
            <div class="balance-grid">
                <div class="balance-item">
                    <div class="value">@balance.RemainingAnnualLeave</div>
                    <div class="label">Phép năm còn lại</div>
                </div>
                <div class="balance-item">
                    <div class="value">@balance.UsedAnnualLeave</div>
                    <div class="label">Đã sử dụng</div>
                </div>
                <div class="balance-item">
                    <div class="value">@balance.TotalAnnualLeave</div>
                    <div class="label">Tổng phép năm</div>
                </div>
            </div>
        </div>
    }

    @using (Html.BeginForm("CreateLeaveRequest", "HR", FormMethod.Post, new { @class = "leave-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EmployeeId)

        <div class="form-section">
            <h4 class="section-title"><i class="fas fa-edit me-2"></i>Thông tin đơn nghỉ</h4>

            <div class="form-group">
                <label><i class="fas fa-tag me-2"></i>Loại nghỉ phép</label>
                @Html.DropDownListFor(m => m.LeaveType, (List<SelectListItem>)ViewBag.LeaveTypes,
                    "-- Chọn loại nghỉ --", new { @class = "form-select", required = "required" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-calendar me-2"></i>Từ ngày</label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date", required = "required" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-calendar me-2"></i>Đến ngày</label>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date", required = "required" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label><i class="fas fa-comment me-2"></i>Lý do xin nghỉ</label>
                @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 4,
                    placeholder = "Nhập lý do xin nghỉ...", required = "required" })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("LeaveManagement")" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-times me-1"></i>Hủy
                </a>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-paper-plane me-1"></i>Gửi đơn
                </button>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        // Validate date range
        $('form').submit(function (e) {
            var startDate = new Date($('#StartDate').val());
            var endDate = new Date($('#EndDate').val());

            if (endDate < startDate) {
                e.preventDefault();
                showError('Lỗi', 'Ngày kết thúc phải sau ngày bắt đầu!');
                return false;
            }
        });
    </script>
}
