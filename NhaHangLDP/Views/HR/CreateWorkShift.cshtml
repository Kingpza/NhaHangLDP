@model NhaHangLDP.Models.WorkShift
@{
    ViewBag.Title = "Tạo ca làm việc";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .shift-form-page {
            padding: 20px 0;
            max-width: 600px;
            margin: 0 auto;
        }

        .form-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #495057;
        }

        .form-control {
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            padding-top: 20px;
        }

        .hours-preview {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            margin-top: 20px;
        }

        .hours-preview .value {
            font-size: 2.5rem;
            font-weight: 700;
        }

        .hours-preview .label {
            opacity: 0.9;
        }
    </style>
}

<div class="shift-form-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-clock me-2"></i>Tạo ca làm việc</h2>
            <p class="text-muted mb-0">Thêm ca làm việc mới</p>
        </div>
        <a href="@Url.Action("WorkShifts")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @using (Html.BeginForm("CreateWorkShift", "HR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-section">
            <h4 class="section-title"><i class="fas fa-edit me-2"></i>Thông tin ca làm việc</h4>

            <div class="form-group">
                <label><i class="fas fa-tag me-2"></i>Tên ca</label>
                @Html.TextBoxFor(m => m.ShiftName, new { @class = "form-control",
                    placeholder = "VD: Ca sáng, Ca chiều...", required = "required" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-play me-2"></i>Giờ bắt đầu</label>
                        <input type="time" name="StartTime" id="startTime" class="form-control" value="08:00" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-stop me-2"></i>Giờ kết thúc</label>
                        <input type="time" name="EndTime" id="endTime" class="form-control" value="17:00" required>
                    </div>
                </div>
            </div>

            <div class="hours-preview">
                <div class="value" id="workHoursPreview">9</div>
                <div class="label">giờ làm việc</div>
            </div>

            <div class="form-group mt-3">
                <label><i class="fas fa-comment me-2"></i>Mô tả</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3,
                    placeholder = "Mô tả ca làm việc..." })
            </div>

            <div class="form-actions">
                <a href="@Url.Action("WorkShifts")" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-times me-1"></i>Hủy
                </a>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-1"></i>Tạo ca
                </button>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function calculateWorkHours() {
            var start = $('#startTime').val();
            var end = $('#endTime').val();

            if (start && end) {
                var startParts = start.split(':');
                var endParts = end.split(':');

                var startMinutes = parseInt(startParts[0]) * 60 + parseInt(startParts[1]);
                var endMinutes = parseInt(endParts[0]) * 60 + parseInt(endParts[1]);

                var diff = endMinutes - startMinutes;
                if (diff < 0) diff += 24 * 60; // Next day

                var hours = (diff / 60).toFixed(1);
                $('#workHoursPreview').text(hours);
            }
        }

        $('#startTime, #endTime').on('change', calculateWorkHours);
        calculateWorkHours();
    </script>
}
