@model List<NhaHangLDP.Models.QROrderViewModel>
@{
    ViewBag.Title = "Theo Dõi Đơn Hàng";
    Layout = null;
    var tableId = ViewBag.TableId;
    var token = ViewBag.Token;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f5f7fa; }
        .track-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .back-btn {
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .order-card {
            background: white;
            border-radius: 15px;
            margin: 15px;
            overflow: hidden;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        }
        .order-status-bar {
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .status-submitted { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
        .status-confirmed { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; }
        .status-preparing { background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); color: white; }
        .status-ready { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color: white; }
        .status-completed { background: linear-gradient(135deg, #64748b 0%, #475569 100%); color: white; }
        
        .order-code {
            font-family: monospace;
            font-size: 14px;
            opacity: 0.9;
        }
        .order-status-text {
            font-weight: 700;
            font-size: 16px;
        }
        .order-items {
            padding: 20px;
        }
        .order-item {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .order-item:last-child { border-bottom: none; }
        .item-qty {
            width: 35px;
            height: 35px;
            background: #f0f0f0;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #e94560;
            margin-right: 12px;
        }
        .item-info { flex: 1; }
        .item-name { font-weight: 600; color: #1e3a5f; }
        .item-status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        .item-status.pending { background: #fef3c7; color: #d97706; }
        .item-status.preparing { background: #ede9fe; color: #7c3aed; }
        .item-status.ready { background: #dcfce7; color: #16a34a; }
        .item-status.served { background: #e2e8f0; color: #64748b; }
        
        .order-timeline {
            padding: 20px;
            background: #f8fafc;
        }
        .timeline-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .timeline-item:last-child { margin-bottom: 0; }
        .timeline-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #cbd5e1;
            margin-right: 12px;
            margin-top: 4px;
            flex-shrink: 0;
        }
        .timeline-dot.active { background: #22c55e; }
        .timeline-dot.current { background: #3b82f6; animation: pulse 1.5s infinite; }
        .timeline-content .time {
            font-size: 12px;
            color: #64748b;
        }
        .timeline-content .text {
            font-weight: 500;
            color: #1e3a5f;
        }
        
        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.2); opacity: 0.7; }
        }
        
        .order-total {
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 2px solid #f0f0f0;
        }
        .total-label { font-weight: 600; color: #64748b; }
        .total-value { font-size: 20px; font-weight: 700; color: #e94560; }
        
        .no-orders {
            text-align: center;
            padding: 60px 20px;
        }
        .no-orders i {
            font-size: 60px;
            color: #cbd5e1;
            margin-bottom: 20px;
        }
        
        .refresh-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #667eea;
            color: white;
            border: none;
            box-shadow: 0 4px 15px rgba(102,126,234,0.4);
            font-size: 18px;
        }
    </style>
</head>
<body>
    <div class="track-header">
        <a href="@Url.Action("Menu", "QROrder", new { tableId = tableId, token = token })" class="back-btn mb-2">
            <i class="fas fa-arrow-left"></i> Quay lại menu
        </a>
        <h4 class="mb-0"><i class="fas fa-receipt me-2"></i>Đơn hàng của bạn</h4>
    </div>
    
    @if (Model != null && Model.Any())
    {
        foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-status-bar status-@order.Status.ToLower()">
                    <div>
                        <div class="order-code">@order.QROrderCode</div>
                        <div class="order-status-text">@order.StatusText</div>
                    </div>
                    <div class="text-end">
                        @if (order.Status == "Preparing")
                        {
                            <i class="fas fa-spinner fa-spin me-1"></i>
                        }
                        else if (order.Status == "Ready")
                        {
                            <i class="fas fa-bell me-1"></i>
                        }
                    </div>
                </div>
                
                <div class="order-items">
                    @foreach (var item in order.Items)
                    {
                        <div class="order-item">
                            <div class="item-qty">@item.Quantity</div>
                            <div class="item-info">
                                <div class="item-name">@item.MenuItemName</div>
                                @if (!string.IsNullOrEmpty(item.ItemNotes))
                                {
                                    <small class="text-muted">@item.ItemNotes</small>
                                }
                            </div>
                            <span class="item-status @item.ItemStatus.ToLower()">@item.StatusText</span>
                        </div>
                    }
                </div>
                
                <div class="order-timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot active"></div>
                        <div class="timeline-content">
                            <div class="text">Đã tạo đơn</div>
                            <div class="time">@order.CreatedTime.ToString("HH:mm")</div>
                        </div>
                    </div>
                    
                    @if (order.SubmittedTime.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot @(order.Status == "Submitted" ? "current" : "active")"></div>
                            <div class="timeline-content">
                                <div class="text">Đã gửi đơn</div>
                                <div class="time">@order.SubmittedTime.Value.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                    
                    @if (order.ConfirmedTime.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot @(order.Status == "Confirmed" || order.Status == "Preparing" ? "current" : "active")"></div>
                            <div class="timeline-content">
                                <div class="text">Nhà hàng xác nhận</div>
                                <div class="time">@order.ConfirmedTime.Value.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                    
                    @if (order.Status == "Ready" || order.Status == "Completed")
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot @(order.Status == "Ready" ? "current" : "active")"></div>
                            <div class="timeline-content">
                                <div class="text">Món ăn đã sẵn sàng</div>
                                <div class="time">@(order.CompletedTime?.ToString("HH:mm") ?? "Đang chờ")</div>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="order-total">
                    <span class="total-label">Tổng cộng</span>
                    <span class="total-value">@order.SubTotal.ToString("N0")đ</span>
                </div>
            </div>
        }
    }
    else
    {
        <div class="no-orders">
            <i class="fas fa-receipt"></i>
            <h5>Chưa có đơn hàng</h5>
            <p class="text-muted">Bạn chưa đặt món nào</p>
            <a href="@Url.Action("Menu", "QROrder", new { tableId = tableId, token = token })" class="btn btn-primary mt-3">
                <i class="fas fa-utensils me-2"></i>Xem menu
            </a>
        </div>
    }
    
    <button class="refresh-btn" onclick="location.reload()">
        <i class="fas fa-sync-alt"></i>
    </button>
    
    <script>
        // Auto refresh every 15 seconds
        setTimeout(function() { location.reload(); }, 15000);
    </script>
</body>
</html>
