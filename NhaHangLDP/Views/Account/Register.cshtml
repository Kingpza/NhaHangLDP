@model NhaHangLDP.Models.Account

@{
    ViewBag.Title = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản lý nhà hàng</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 12s ease infinite;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', sans-serif;
        }

        @@keyframes gradientBG {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .auth-box {
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 12px 35px rgba(0,0,0,.3);
            padding: 35px;
            backdrop-filter: blur(10px);
            animation: fadeIn 0.9s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .logo-container {
            text-align: center;
            margin-bottom: 20px;
        }

            .logo-container img {
                width: 90px;
                height: 90px;
                object-fit: contain;
                animation: floatLogo 3s ease-in-out infinite;
            }

        @@keyframes floatLogo {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .logo-container h1 {
            margin-top: 10px;
            font-size: 1.5rem;
            font-weight: bold;
            color: #2c3e50;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
            font-weight: bold;
        }

        .form-control, .form-select {
            border-radius: 30px;
            padding: 12px 20px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #23a6d5;
                box-shadow: 0 0 12px rgba(35,166,213,0.5);
                transform: scale(1.02);
            }

        .btn-gradient {
            background: linear-gradient(45deg, #ff512f, #dd2476, #2575fc);
            background-size: 200% 200%;
            border: none;
            border-radius: 30px;
            color: #fff;
            font-weight: bold;
            padding: 12px;
            transition: all 0.4s ease;
            animation: gradientMove 5s ease infinite;
        }

        @@keyframes gradientMove {
            0% {
                background-position: left top;
            }

            50% {
                background-position: right bottom;
            }

            100% {
                background-position: left top;
            }
        }

        .btn-gradient:hover {
            transform: scale(1.07);
            box-shadow: 0 6px 15px rgba(0,0,0,0.3);
        }

        .link-switch {
            text-align: center;
            margin-top: 15px;
            font-size: 0.9rem;
        }

            .link-switch a {
                font-weight: bold;
                text-decoration: none;
                color: #2575fc;
                transition: color 0.3s ease;
            }

                .link-switch a:hover {
                    color: #ff512f;
                }

        .text-danger {
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .alert {
            border-radius: 15px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="auth-box">
        <!-- Logo + Tên nhà hàng -->
        <div class="logo-container">
            <img src="~/images/logo.jpg" alt="Logo Nhà Hàng" />
            <h1>LDP Restaurant</h1>
        </div>

        <h2>Tạo tài khoản</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Họ và tên", required = "required" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Tên đăng nhập", required = "required" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email (tùy chọn)" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Số điện thoại (tùy chọn)" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.DropDownListFor(m => m.RoleId, (SelectList)ViewBag.RoleId, "-- Chọn vị trí --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.RoleId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control", placeholder = "Mật khẩu", required = "required", minlength = "6" })
                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Password("ConfirmPassword", "", new { @class = "form-control", placeholder = "Nhập lại mật khẩu", required = "required", minlength = "6" })
                <div class="text-danger" id="passwordMatchError"></div>
            </div>

            <button type="submit" class="btn btn-gradient w-100" id="registerBtn">
                <i class="fas fa-user-plus"></i> Đăng ký
            </button>

            <div class="link-switch">
                Đã có tài khoản?
                @Html.ActionLink("Đăng nhập ngay", "Login", "Account")
            </div>
        }
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Form validation
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        // Password confirmation validation
        function validatePasswords() {
            const password = $('#PasswordHash').val();
            const confirmPassword = $('#ConfirmPassword').val();
            const errorDiv = $('#passwordMatchError');
            const submitBtn = $('#registerBtn');

            if (password === '' || confirmPassword === '') {
                errorDiv.text('');
                return;
            }

            if (password === confirmPassword) {
                errorDiv.text('').removeClass('text-danger').addClass('text-success');
                submitBtn.prop('disabled', false);
            } else {
                errorDiv.text('Mật khẩu không khớp').removeClass('text-success').addClass('text-danger');
                submitBtn.prop('disabled', true);
            }
        }

        $('#PasswordHash, #ConfirmPassword').on('input', validatePasswords);

        // Username validation (remove special characters)
        $('#Username').on('input', function () {
            var value = $(this).val();
            var cleanValue = value.replace(/[^a-zA-Z0-9_]/g, '');
            $(this).val(cleanValue);
        });
    </script>
</body>
</html>
