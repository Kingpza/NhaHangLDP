@model NhaHangLDP.Models.ReservationFormModel
@{
    ViewBag.Title = "Đặt bàn";
    Layout = null;
    var timeSlots = ViewBag.TimeSlots as List<string> ?? new List<string>();
    
    // Kiểm tra đăng nhập - hỗ trợ cả nhân viên và khách hàng
    var isLoggedIn = Session["Username"] != null || Session["CustomerId"] != null;
    var displayName = Session["FullName"]?.ToString() ?? Session["CustomerName"]?.ToString() ?? Session["Username"]?.ToString() ?? "User";
    var userRole = Session["Role"]?.ToString() ?? Session["UserRole"]?.ToString();
    var isEmployee = Session["Username"] != null && (userRole == "Admin" || userRole == "Manager" || userRole == "Cashier" || userRole == "Staff");
    var isCustomer = Session["CustomerId"] != null;
    
    // Lấy thông tin khách hàng để tự động điền
    var customerName = Session["CustomerName"]?.ToString() ?? Session["FullName"]?.ToString() ?? "";
    var customerEmail = Session["CustomerEmail"]?.ToString() ?? "";
    var customerPhone = Session["CustomerPhone"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đặt bàn - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Bootstrap CSS for dropdown -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        "primary-dark": "#0056b3",
                        success: "#28a745",
                        warning: "#ffc107",
                        danger: "#dc3545",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"}
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f0f2f5;
        }
        ::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #007bff;
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fadeInUp {
            animation: fadeInUp 0.8s ease-out forwards;
        }
        
        .hero-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .form-card {
            transition: all 0.3s ease;
        }
        
        .form-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .party-size-btn {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .party-size-btn:hover {
            transform: scale(1.05);
        }

        .party-size-btn.selected {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
        }

        .swal2-popup {
            font-family: 'Manrope', sans-serif !important;
            border-radius: 2rem !important;
        }

        .swal2-title {
            font-weight: 800 !important;
            color: #212529 !important;
        }

        .swal2-confirm {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            border-radius: 9999px !important;
            padding: 12px 30px !important;
            font-weight: 600 !important;
        }

        /* User Menu Styles */
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 16px;
            border: 2px solid white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        .user-menu-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 16px;
            background: white;
            border-radius: 9999px;
            border: 2px solid #007bff;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .user-menu-btn:hover {
            background: #f0f4f8;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.2);
        }

        .user-info {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .user-name {
            font-weight: 700;
            color: #212529;
            font-size: 14px;
            line-height: 1.2;
        }

        .user-role {
            font-size: 12px;
            color: #6c757d;
            line-height: 1.2;
        }

        .dropdown-menu {
            border-radius: 1rem;
            border: 1px solid #e0e0e0;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            margin-top: 8px !important;
        }

        .dropdown-item {
            padding: 12px 20px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dropdown-item:hover {
            background: #f0f4f8;
            color: #007bff;
        }

        .dropdown-item i {
            width: 20px;
            text-align: center;
        }

        .dropdown-divider {
            margin: 8px 0;
        }

        .auto-fill-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 600;
            margin-left: 8px;
        }
    </style>
</head>
<body class="bg-gray-50 font-display min-h-screen">
    
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-background/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-2xl">restaurant</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-black text-text-primary">NHÀ HÀNG LDP</h1>
                        <p class="text-xs text-text-secondary">Fine Dining Experience</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Home")" class="text-text-primary hover:text-primary transition-colors">Trang chủ</a>
                    <a href="@Url.Action("Menu", "Public")" class="text-text-primary hover:text-primary transition-colors">Thực đơn</a>
                    <a href="@Url.Action("Index", "Reservation")" class="text-primary font-semibold border-b-2 border-primary pb-1">Đặt bàn</a>
                    <a href="@Url.Action("Index", "Home")#contact" class="text-text-primary hover:text-primary transition-colors">Liên hệ</a>
                </div>
                <div class="flex items-center gap-3">
                    @if (isLoggedIn)
                    {
                        <!-- User Menu Dropdown -->
                        <div class="dropdown">
                            <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    @{
                                        var initial = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "U";
                                    }
                                    @initial
                                </div>
                                <div class="user-info hidden sm:flex">
                                    <span class="user-name">@displayName</span>
                                    <span class="user-role">
                                        @{
                                            var roleText = "Khách hàng";
                                            if (userRole == "Admin" || userRole == "Manager")
                                            {
                                                roleText = "Quản lý";
                                            }
                                            else if (userRole == "Cashier")
                                            {
                                                roleText = "Thu ngân";
                                            }
                                            else if (userRole == "Staff")
                                            {
                                                roleText = "Nhân viên";
                                            }
                                        }
                                        @roleText
                                    </span>
                                </div>
                                <i class="fas fa-chevron-down text-primary text-sm"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (isEmployee)
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Dashboard", "Management")">
                                            <i class="fas fa-tachometer-alt text-primary"></i>
                                            Dashboard
                                        </a>
                                    </li>
                                }
                                @if (isCustomer)
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Profile", "CustomerAccount")">
                                            <i class="fas fa-user-circle text-info"></i>
                                            Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Orders", "CustomerAccount")">
                                            <i class="fas fa-shopping-bag text-warning"></i>
                                            Đơn hàng của tôi
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @if (isCustomer)
                                    {
                                        <a class="dropdown-item text-danger" href="@Url.Action("Logout", "CustomerAccount")">
                                            <i class="fas fa-sign-out-alt"></i>
                                            Đăng xuất
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="dropdown-item text-danger" href="@Url.Action("LogOut", "Account")">
                                            <i class="fas fa-sign-out-alt"></i>
                                            Đăng xuất
                                        </a>
                                    }
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "CustomerAccount")" class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold">
                            <span class="material-symbols-outlined text-lg">login</span>
                            Đăng nhập
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 hero-gradient"></div>
        <div class="absolute inset-0 bg-cover bg-center opacity-20" style='background-image: url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200")'></div>
        <div class="absolute inset-0 bg-black/30"></div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
            <div class="animate-fadeInUp">
                <span class="inline-block px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm font-bold rounded-full mb-6">
                    🍽️ Đặt bàn trước - Nhận ngay ưu đãi
                </span>
                <h1 class="text-5xl md:text-7xl font-black text-white mb-6 leading-tight">
                    Đặt Bàn Ngay<br/>
                    <span class="text-yellow-300">Trải Nghiệm Tuyệt Vời</span>
                </h1>
                <p class="text-xl md:text-2xl text-white/90 mb-12 max-w-3xl mx-auto">
                    Đảm bảo chỗ ngồi tốt nhất cho bữa ăn đặc biệt của bạn tại Nhà Hàng LDP
                </p>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
            <span class="material-symbols-outlined text-white text-4xl">expand_more</span>
        </div>
    </section>

    <!-- Booking Form Section -->
    <section class="py-20 bg-sidebar-surface">
        <div class="max-w-4xl mx-auto px-6 -mt-32 relative z-10">
            <div class="form-card bg-white rounded-[2rem] p-8 md:p-12 shadow-xl border border-border-light">
                <form id="reservationForm">
                    @Html.AntiForgeryToken()

                    <!-- Customer Info -->
                    <div class="mb-8">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">1</span>
                            Thông tin liên hệ
                            @if (isLoggedIn && !string.IsNullOrEmpty(customerName))
                            {
                                <span class="auto-fill-badge">
                                    <i class="fas fa-check-circle"></i>
                                    Tự động điền
                                </span>
                            }
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="CustomerName" required
                                       value="@customerName"
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors @(isLoggedIn && !string.IsNullOrEmpty(customerName) ? "bg-green-50 border-green-300" : "")"
                                       placeholder="Nguyễn Văn A" />
                            </div>
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" name="CustomerPhone" required pattern="[0-9]{10}"
                                       value="@customerPhone"
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors @(isLoggedIn && !string.IsNullOrEmpty(customerPhone) ? "bg-green-50 border-green-300" : "")"
                                       placeholder="0901234567" />
                            </div>
                        </div>
                        <div class="mt-6">
                            <label class="block text-text-primary font-semibold mb-2">Email (tùy chọn)</label>
                            <input type="email" name="CustomerEmail"
                                   value="@customerEmail"
                                   class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors @(isLoggedIn && !string.IsNullOrEmpty(customerEmail) ? "bg-green-50 border-green-300" : "")"
                                   placeholder="email@example.com" />
                        </div>
                        @if (!isLoggedIn)
                        {
                            <div class="mt-4 p-4 bg-blue-50 rounded-xl border border-blue-200">
                                <p class="text-sm text-blue-700 flex items-center gap-2">
                                    <i class="fas fa-info-circle"></i>
                                    <span><a href="@Url.Action("Login", "CustomerAccount")" class="font-bold underline hover:text-blue-900">Đăng nhập</a> để tự động điền thông tin và quản lý đặt bàn dễ dàng hơn!</span>
                                </p>
                            </div>
                        }
                    </div>

                    <!-- Reservation Details -->
                    <div class="mb-8">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">2</span>
                            Chọn thời gian và số người
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Ngày đặt bàn <span class="text-danger">*</span></label>
                                <input type="date" name="ReservationDate" id="reservationDate" required
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@Model.ReservationDate.ToString("yyyy-MM-dd")"
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors" />
                            </div>
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Giờ đặt bàn <span class="text-danger">*</span></label>
                                <select name="ReservationTime" id="reservationTime" required
                                        class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors">
                                    <option value="">-- Chọn giờ --</option>
                                    @foreach (var slot in timeSlots)
                                    {
                                        <option value="@slot">@slot</option>
                                    }
                                </select>
                            </div>
                        </div>
                        
                        <div class="mt-6">
                            <label class="block text-text-primary font-semibold mb-3">Số lượng khách <span class="text-danger">*</span></label>
                            <div class="grid grid-cols-4 md:grid-cols-10 gap-3">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                            onclick="selectPartySize(@i)" data-size="@i">@i</button>
                                }
                            </div>
                            <input type="hidden" name="NumberOfGuests" id="numberOfGuests" required />
                        </div>

                        <!-- Availability Status -->
                        <div id="availabilityStatus" class="mt-6 hidden">
                            <div class="flex items-center gap-2 p-4 rounded-xl">
                                <span class="material-symbols-outlined text-2xl"></span>
                                <span class="font-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Table Selection -->
                    <div class="mb-8" id="tableSelectionSection" style="display: none;">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">3</span>
                            Chọn bàn
                        </h3>
                        <p class="text-text-secondary mb-4">Chọn bàn bạn muốn hoặc để trống để hệ thống tự động sắp xếp</p>
                        
                        <div id="tableLoadingIndicator" class="text-center py-8 hidden">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-primary border-t-transparent"></div>
                            <p class="mt-2 text-text-secondary">Đang tải danh sách bàn...</p>
                        </div>
                        
                        <div id="tableGrid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
                            <!-- Tables will be loaded here via AJAX -->
                        </div>
                        
                        <input type="hidden" name="selectedTableId" id="selectedTableId" value="" />
                        
                        <div class="mt-4 flex items-center gap-4 text-sm">
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-green-100 border-2 border-green-500"></div>
                                <span class="text-text-secondary">Trống</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-gray-200 border-2 border-gray-400"></div>
                                <span class="text-text-secondary">Đã đặt</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded bg-primary border-2 border-primary"></div>
                                <span class="text-text-secondary">Đang chọn</span>
                            </div>
                        </div>
                    </div>

                    <!-- Table Preference -->
                    <div class="mb-8">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">4</span>
                            Khu vực ưa thích
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <label class="cursor-pointer">
                                <input type="radio" name="TablePreference" value="" class="sr-only peer" checked />
                                <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                    <span class="material-symbols-outlined text-2xl text-gray-400 mb-1">check_box_outline_blank</span>
                                    <p class="text-sm font-medium">Không ưu tiên</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="TablePreference" value="Window" class="sr-only peer" />
                                <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                    <span class="material-symbols-outlined text-2xl text-primary mb-1">window</span>
                                    <p class="text-sm font-medium">Cạnh cửa sổ</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="TablePreference" value="VIP" class="sr-only peer" />
                                <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                    <span class="material-symbols-outlined text-2xl text-warning mb-1">star</span>
                                    <p class="text-sm font-medium">Phòng VIP</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="TablePreference" value="Outdoor" class="sr-only peer" />
                                <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                    <span class="material-symbols-outlined text-2xl text-success mb-1">park</span>
                                    <p class="text-sm font-medium">Ngoài trời</p>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Special Requests -->
                    <div class="mb-8">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">5</span>
                            Yêu cầu đặc biệt
                        </h3>
                        <textarea name="SpecialRequests" rows="4"
                                  class="w-full px-6 py-4 rounded-[1.5rem] border-2 border-border-light focus:border-primary focus:outline-none transition-colors resize-none"
                                  placeholder="Ví dụ: Sinh nhật, kỷ niệm, cần ghế trẻ em, dị ứng thực phẩm..."></textarea>
                    </div>

                    <!-- Submit -->
                    <button type="submit" id="submitBtn"
                            class="w-full py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-primary-dark transition-all shadow-lg flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        <span class="material-symbols-outlined">check_circle</span>
                        Xác nhận đặt bàn
                    </button>

                    <p class="text-center text-gray-500 text-sm mt-4">
                        Bạn sẽ nhận được xác nhận qua SMS/Email trong vòng 15 phút
                    </p>
                </form>
            </div>
        </div>
    </section>

    <!-- Restaurant Info -->
    <section class="py-12 bg-sidebar-surface">
