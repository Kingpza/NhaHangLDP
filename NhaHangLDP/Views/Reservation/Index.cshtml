    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS for dropdown -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let selectedPartySize = 0;
        let selectedTableId = null;

        // Select party size
        function selectPartySize(size) {
            selectedPartySize = size;
            document.getElementById('numberOfGuests').value = size;
            
            // Update UI
            document.querySelectorAll('.party-size-btn').forEach(btn => {
                btn.classList.remove('selected');
            });
            event.target.classList.add('selected');
            
            // Check availability if date and time are selected
            checkAvailability();
        }

        // Check availability when date/time/guests change
        $('#reservationDate, #reservationTime').change(function() {
            checkAvailability();
        });

        function checkAvailability() {
            var date = $('#reservationDate').val();
            var time = $('#reservationTime').val();
            var guests = selectedPartySize;

            if (!date || !time || !guests) {
                $('#tableSelectionSection').hide();
                return;
            }

            var status = $('#availabilityStatus');
            status.removeClass('hidden');

            $.post('@Url.Action("CheckAvailability", "Reservation")', {
                date: date,
                time: time,
                guests: guests
            }).done(function(response) {
                var statusDiv = status.find('div');
                var icon = status.find('.material-symbols-outlined');
                var text = status.find('span:last');

                if (response.available) {
                    statusDiv.removeClass('bg-red-50 text-red-600').addClass('bg-green-50 text-green-600');
                    icon.text('check_circle');
                    text.text(response.message || 'Còn bàn trống');
                    $('#submitBtn').prop('disabled', false);
                    
                    // Load available tables
                    loadTables();
                } else {
                    statusDiv.removeClass('bg-green-50 text-green-600').addClass('bg-red-50 text-red-600');
                    icon.text('error');
                    text.text(response.message || 'Không còn bàn trống');
                    $('#submitBtn').prop('disabled', true);
                    $('#tableSelectionSection').hide();
                }
            });
        }

        // Load tables for selection
        function loadTables() {
            var date = $('#reservationDate').val();
            var time = $('#reservationTime').val();
            var guests = selectedPartySize;

            if (!date || !time || !guests) return;

            $('#tableSelectionSection').show();
            $('#tableLoadingIndicator').removeClass('hidden');
            $('#tableGrid').empty();
            selectedTableId = null;
            $('#selectedTableId').val('');

            $.post('@Url.Action("GetAvailableTables", "Reservation")', {
                date: date,
                time: time,
                guests: guests
            }).done(function(response) {
                $('#tableLoadingIndicator').addClass('hidden');

                if (response.success && response.tables && response.tables.length > 0) {
                    response.tables.forEach(function(table) {
                        var isAvailable = table.isAvailable == 1;
                        var statusClass = isAvailable 
                            ? 'bg-green-50 border-green-300 hover:border-green-500 cursor-pointer' 
                            : 'bg-gray-100 border-gray-300 opacity-60 cursor-not-allowed';
                        var iconColor = isAvailable ? 'text-green-600' : 'text-gray-400';
                        var clickHandler = isAvailable ? `onclick="selectTable(${table.id}, this)"` : '';
                        
                        var tableHtml = `
                            <div class="table-card border-2 rounded-xl p-4 flex flex-col items-center justify-center text-center transition-all ${statusClass}" 
                                 data-table-id="${table.id}" ${clickHandler}>
                                <span class="material-symbols-outlined text-3xl mb-2 ${iconColor}">table_restaurant</span>
                                <span class="font-bold text-lg">Bàn ${table.tableNumber}</span>
                                <span class="text-sm text-gray-500">${table.capacity} chỗ</span>
                                <span class="text-xs mt-1 ${isAvailable ? 'text-green-600' : 'text-red-500'}">
                                    ${isAvailable ? '✓ Còn trống' : '✗ Đã đặt'}
                                </span>
                                <span class="text-xs text-gray-400 mt-1">${table.areaName}</span>
                            </div>
                        `;
                        $('#tableGrid').append(tableHtml);
                    });
                } else {
                    $('#tableGrid').html('<p class="col-span-full text-center text-gray-500 py-4">Không tìm thấy bàn phù hợp</p>');
                }
            }).fail(function() {
                $('#tableLoadingIndicator').addClass('hidden');
                $('#tableGrid').html('<p class="col-span-full text-center text-red-500 py-4">Lỗi tải danh sách bàn</p>');
            });
        }

        // Select table
        function selectTable(tableId, element) {
            // Deselect all tables
            $('.table-card').removeClass('border-primary bg-primary/10').addClass('border-green-300 bg-green-50');
            
            // If clicking on the same table, deselect it
            if (selectedTableId === tableId) {
                selectedTableId = null;
                $('#selectedTableId').val('');
                return;
            }
            
            // Mark this table as selected
            selectedTableId = tableId;
            $('#selectedTableId').val(tableId);
            $(element).removeClass('border-green-300 bg-green-50').addClass('border-primary bg-primary/10');
        }

        // Form submit
        $('#reservationForm').submit(function(e) {
            e.preventDefault();

            // Validate
            if (selectedPartySize === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng chọn số lượng khách!',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#667eea'
                });
                return;
            }

            var btn = $('#submitBtn');
            var originalHtml = btn.html();
            
            Swal.fire({
                title: 'Đang xử lý đặt bàn...',
                html: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.post('@Url.Action("Book", "Reservation")', $(this).serialize())
                .done(function(response) {
                    Swal.close();
                    
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Đặt bàn thành công!',
                            html: `
                                <p class="mb-4">Cảm ơn bạn đã đặt bàn tại Nhà Hàng LDP</p>
                                <div class="bg-gray-100 rounded-xl p-4">
                                    <p class="text-sm text-gray-500 mb-1">Mã đặt bàn của bạn:</p>
                                    <p class="text-2xl font-bold text-primary">` + response.reservationCode + `</p>
                                </div>
                                <p class="mt-4 text-sm text-gray-600">Vui lòng lưu lại mã này!</p>
                            `,
                            confirmButtonText: 'Xem chi tiết',
                            confirmButtonColor: '#667eea',
                            showCancelButton: true,
                            cancelButtonText: 'Về trang chủ',
                            cancelButtonColor: '#6c757d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = response.redirectUrl;
                            } else {
                                window.location.href = '@Url.Action("Index", "Home")';
                            }
                        });
                    } else {
                        btn.prop('disabled', false).html(originalHtml);
                        Swal.fire({
                            icon: 'error',
                            title: 'Có lỗi xảy ra',
                            text: response.message || 'Vui lòng thử lại!',
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#667eea'
                        });
                    }
                })
                .fail(function() {
                    Swal.close();
                    btn.prop('disabled', false).html(originalHtml);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối',
                        text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                });
        });

        // Welcome message
        window.addEventListener('load', function() {
            Swal.fire({
                title: 'Chào mừng đến với LDP!',
                text: 'Hãy điền thông tin để đặt bàn cho bữa ăn tuyệt vời của bạn',
                icon: 'info',
                confirmButtonText: 'Bắt đầu đặt bàn',
                confirmButtonColor: '#667eea',
                timer: 3000,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
        });
    </script>
</body>
</html>
