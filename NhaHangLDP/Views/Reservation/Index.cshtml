                    <p class="text-gray-600">10:00 - 22:00</p>
                    <p class="text-gray-500 text-sm">Tất cả các ngày trong tuần</p>
                </div>
                <div class="bg-white rounded-[2rem] p-8 text-center shadow-lg">
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-primary text-3xl">location_on</span>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Địa chỉ</h3>
                    <p class="text-gray-600">123 Nguyễn Văn Linh</p>
                    <p class="text-gray-500 text-sm">Quận 7, TP. HCM</p>
                </div>
                <div class="bg-white rounded-[2rem] p-8 text-center shadow-lg">
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-primary text-3xl">call</span>
                    </div>
                    <h3 class="font-bold text-xl mb-2">Hotline</h3>
                    <p class="text-gray-600">1900 1234</p>
