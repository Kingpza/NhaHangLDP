@model NhaHangLDP.Models.ReservationFormModel
@{
    ViewBag.Title = "Đặt bàn";
    Layout = null;
    var timeSlots = ViewBag.TimeSlots as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đặt bàn - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        "primary-dark": "#0056b3",
                        success: "#28a745",
                        warning: "#ffc107",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen">
    <!-- Hero Section -->
    <div class="relative h-80 bg-cover bg-center" style='background-image: url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200")'>
        <div class="absolute inset-0 bg-black/50"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-white text-center px-4">
            <a href="@Url.Action("Menu", "Public")" class="absolute top-6 left-6 flex items-center gap-2 text-white/80 hover:text-white">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại thực đơn
            </a>
            <span class="material-symbols-outlined text-5xl mb-4">table_restaurant</span>
            <h1 class="text-4xl md:text-5xl font-bold mb-2">Đặt bàn trực tuyến</h1>
            <p class="text-lg text-white/80">Đặt bàn nhanh chóng, dễ dàng</p>
        </div>
    </div>

    <!-- Booking Form -->
    <div class="max-w-4xl mx-auto px-4 -mt-16 relative z-10 pb-12">
        <div class="bg-white rounded-3xl shadow-xl p-8">
            <form id="reservationForm">
                @Html.AntiForgeryToken()

                <!-- Customer Info -->
                <div class="mb-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">person</span>
                        Thông tin liên hệ
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Họ tên <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary"
                                   placeholder="Nhập họ tên" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="CustomerPhone" required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary"
                                   placeholder="0901234567" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium mb-2">Email (để nhận xác nhận)</label>
                            <input type="email" name="CustomerEmail"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary"
                                   placeholder="example@email.com" />
                        </div>
                    </div>
                </div>

                <!-- Reservation Details -->
                <div class="mb-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">calendar_month</span>
                        Chi tiết đặt bàn
                    </h2>
                    <div class="grid md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Ngày <span class="text-danger">*</span></label>
                            <input type="date" name="ReservationDate" id="reservationDate" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   value="@Model.ReservationDate.ToString("yyyy-MM-dd")"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Giờ <span class="text-danger">*</span></label>
                            <select name="ReservationTime" id="reservationTime" required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary">
                                <option value="">Chọn giờ</option>
                                @foreach (var slot in timeSlots)
                                {
                                    <option value="@slot">@slot</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Số khách <span class="text-danger">*</span></label>
                            <select name="NumberOfGuests" id="numberOfGuests" required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary">
                                @for (int i = 1; i <= 20; i++)
                                {
                                    <option value="@i" @(i == 2 ? "selected" : "")>@i người</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Availability Status -->
                    <div id="availabilityStatus" class="mt-4 hidden">
                        <div class="flex items-center gap-2 p-3 rounded-lg">
                            <span class="material-symbols-outlined"></span>
                            <span></span>
                        </div>
                    </div>
                </div>

                <!-- Table Preference -->
                <div class="mb-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">table_restaurant</span>
                        Khu vực ưa thích
                    </h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="TablePreference" value="" class="sr-only peer" checked />
                            <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                <span class="material-symbols-outlined text-2xl text-gray-400 mb-1">check_box_outline_blank</span>
                                <p class="text-sm font-medium">Không ưu tiên</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="TablePreference" value="Window" class="sr-only peer" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                <span class="material-symbols-outlined text-2xl text-primary mb-1">window</span>
                                <p class="text-sm font-medium">Cạnh cửa sổ</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="TablePreference" value="VIP" class="sr-only peer" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                <span class="material-symbols-outlined text-2xl text-warning mb-1">star</span>
                                <p class="text-sm font-medium">Phòng VIP</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="TablePreference" value="Outdoor" class="sr-only peer" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all hover:border-primary/50">
                                <span class="material-symbols-outlined text-2xl text-success mb-1">park</span>
                                <p class="text-sm font-medium">Ngoài trời</p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Special Requests -->
                <div class="mb-8">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">note</span>
                        Yêu cầu đặc biệt
                    </h2>
                    <textarea name="SpecialRequests" rows="3"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary"
                              placeholder="Ví dụ: sinh nhật, kỷ niệm, cần ghế trẻ em, dị ứng thực phẩm..."></textarea>
                </div>

                <!-- Submit -->
                <button type="submit" id="submitBtn"
                        class="w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-primary-dark transition-colors flex items-center justify-center gap-2 shadow-lg shadow-primary/30 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span class="material-symbols-outlined">event_available</span>
                    Đặt bàn ngay
                </button>

                <p class="text-center text-gray-500 text-sm mt-4">
                    Bạn sẽ nhận được xác nhận qua SMS/Email trong vòng 15 phút
                </p>
            </form>
        </div>

        <!-- Restaurant Info -->
        <div class="mt-8 grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
                <span class="material-symbols-outlined text-3xl text-primary mb-2">schedule</span>
                <h3 class="font-bold mb-1">Giờ mở cửa</h3>
                <p class="text-gray-600 text-sm">10:00 - 22:00</p>
                <p class="text-gray-500 text-xs">Tất cả các ngày trong tuần</p>
            </div>
            <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
                <span class="material-symbols-outlined text-3xl text-primary mb-2">location_on</span>
                <h3 class="font-bold mb-1">Địa chỉ</h3>
                <p class="text-gray-600 text-sm">123 Nguyễn Văn Linh</p>
                <p class="text-gray-500 text-xs">Quận 7, TP. HCM</p>
            </div>
            <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
                <span class="material-symbols-outlined text-3xl text-primary mb-2">call</span>
                <h3 class="font-bold mb-1">Hotline</h3>
                <p class="text-gray-600 text-sm">1900 1234</p>
                <p class="text-gray-500 text-xs">Hỗ trợ 24/7</p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Check availability when date/time/guests change
        $('#reservationDate, #reservationTime, #numberOfGuests').change(function() {
            checkAvailability();
        });

        function checkAvailability() {
            var date = $('#reservationDate').val();
            var time = $('#reservationTime').val();
            var guests = $('#numberOfGuests').val();

            if (!date || !time || !guests) return;

            var status = $('#availabilityStatus');
            status.removeClass('hidden');

            $.post('@Url.Action("CheckAvailability", "Reservation")', {
                date: date,
                time: time,
                guests: guests
            }).done(function(response) {
                var statusDiv = status.find('div');
                var icon = status.find('.material-symbols-outlined');
                var text = status.find('span:last');

                if (response.available) {
                    statusDiv.removeClass('bg-red-50 text-red-600').addClass('bg-green-50 text-green-600');
                    icon.text('check_circle');
                    text.text(response.message);
                    $('#submitBtn').prop('disabled', false);
                } else {
                    statusDiv.removeClass('bg-green-50 text-green-600').addClass('bg-red-50 text-red-600');
                    icon.text('error');
                    text.text(response.message);
                    $('#submitBtn').prop('disabled', true);
                }
            });
        }

        // Form submit
        $('#reservationForm').submit(function(e) {
            e.preventDefault();

            var btn = $('#submitBtn');
            var originalHtml = btn.html();
            btn.prop('disabled', true).html('<span class="material-symbols-outlined animate-spin">progress_activity</span> Đang xử lý...');

            $.post('@Url.Action("Book", "Reservation")', $(this).serialize())
                .done(function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Đặt bàn thành công!',
                            html: 'Mã đặt bàn: <strong>' + response.reservationCode + '</strong><br>Vui lòng lưu lại mã này!',
                            confirmButtonText: 'Xem chi tiết',
                            confirmButtonColor: '#007bff'
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        btn.prop('disabled', false).html(originalHtml);
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                })
                .fail(function() {
                    btn.prop('disabled', false).html(originalHtml);
                    Swal.fire('Lỗi', 'Có lỗi xảy ra, vui lòng thử lại!', 'error');
                });
        });
    </script>
</body>
</html>
