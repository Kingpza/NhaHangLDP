@model NhaHangLDP.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Quên mật khẩu - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        success: "#28a745",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <a href="@Url.Action("Login")" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary mb-6">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại đăng nhập
            </a>
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
                <span class="material-symbols-outlined text-3xl text-primary">lock_reset</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-800">Quên mật khẩu?</h2>
            <p class="text-gray-600 mt-2">Nhập email để nhận hướng dẫn đặt lại mật khẩu</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm flex items-start gap-2">
                <span class="material-symbols-outlined">check_circle</span>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
                @Html.ValidationSummary(true)
            </div>
        }

        <div class="bg-white rounded-2xl shadow-lg p-8">
            @using (Html.BeginForm("ForgotPassword", "CustomerAccount", FormMethod.Post, new { @class = "space-y-6" }))
            {
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email đăng ký</label>
                    @Html.TextBoxFor(m => m.Email, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "example@email.com",
                        type = "email"
                    })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <button type="submit" class="w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-blue-600 transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">send</span>
                    Gửi yêu cầu
                </button>
            }
        </div>

        <div class="text-center mt-8">
            <p class="text-gray-600">
                Nhớ mật khẩu?
                <a href="@Url.Action("Login")" class="text-primary font-semibold hover:underline">Đăng nhập</a>
            </p>
        </div>
    </div>
</body>
</html>
