@model NhaHangLDP.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng nhập - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen flex">
    <!-- Left - Image -->
    <div class="hidden lg:block lg:w-1/2 bg-cover bg-center relative" 
         style='background-image: url("https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1200")'>
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="absolute inset-0 flex flex-col justify-center items-center text-white p-12">
            <span class="material-symbols-outlined text-6xl mb-4">restaurant</span>
            <h1 class="text-4xl font-bold mb-2">NHÀ HÀNG LDP</h1>
            <p class="text-xl text-white/80">Trải nghiệm ẩm thực tuyệt vời</p>
        </div>
    </div>

    <!-- Right - Form -->
    <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
        <div class="max-w-md w-full">
            <div class="text-center mb-8">
                <a href="@Url.Action("Menu", "Public")" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary mb-6">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Quay lại trang chủ
                </a>
                <h2 class="text-3xl font-bold text-gray-800">Đăng nhập</h2>
                <p class="text-gray-600 mt-2">Chào mừng bạn trở lại!</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
                    @Html.ValidationSummary(true)
                </div>
            }

            @using (Html.BeginForm("Login", "CustomerAccount", FormMethod.Post, new { @class = "space-y-6" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email hoặc Số điện thoại</label>
                    @Html.TextBoxFor(m => m.EmailOrPhone, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "example@email.com hoặc 0901234567"
                    })
                    @Html.ValidationMessageFor(m => m.EmailOrPhone, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                    @Html.PasswordFor(m => m.Password, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "Nhập mật khẩu"
                    })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "w-4 h-4 text-primary rounded" })
                        <span class="text-sm text-gray-600">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="@Url.Action("ForgotPassword")" class="text-sm text-primary hover:underline">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-blue-600 transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">login</span>
                    Đăng nhập
                </button>
            }

            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-4 bg-gray-50 text-gray-500">Hoặc đăng nhập với</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <button type="button" class="flex items-center justify-center gap-2 py-3 border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors">
                    <img src="https://www.google.com/favicon.ico" alt="Google" class="w-5 h-5" />
                    <span class="font-medium">Google</span>
                </button>
                <button type="button" class="flex items-center justify-center gap-2 py-3 border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors">
                    <img src="https://www.facebook.com/favicon.ico" alt="Facebook" class="w-5 h-5" />
                    <span class="font-medium">Facebook</span>
                </button>
            </div>

            <p class="text-center mt-8 text-gray-600">
                Chưa có tài khoản?
                <a href="@Url.Action("Register")" class="text-primary font-semibold hover:underline">Đăng ký ngay</a>
            </p>
        </div>
    </div>
</body>
</html>
