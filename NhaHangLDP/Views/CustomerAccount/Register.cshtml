@model NhaHangLDP.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng ký - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen flex">
    <!-- Left - Image -->
    <div class="hidden lg:block lg:w-1/2 bg-cover bg-center relative" 
         style='background-image: url("https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1200")'>
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="absolute inset-0 flex flex-col justify-center items-center text-white p-12">
            <span class="material-symbols-outlined text-6xl mb-4">restaurant</span>
            <h1 class="text-4xl font-bold mb-2">NHÀ HÀNG HỶ LẠC HOTPOT</h1>
            <p class="text-xl text-white/80 mb-8">Gia nhập cộng đồng ẩm thực</p>
            <div class="space-y-4 text-center">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-success">check_circle</span>
                    <span>Tích điểm với mỗi đơn hàng</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-success">check_circle</span>
                    <span>Ưu đãi sinh nhật đặc biệt</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-success">check_circle</span>
                    <span>Nhận thông báo khuyến mãi</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right - Form -->
    <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
        <div class="max-w-md w-full">
            <div class="text-center mb-8">
                <a href="@Url.Action("Menu", "Public")" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary mb-6">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Quay lại trang chủ
                </a>
                <h2 class="text-3xl font-bold text-gray-800">Tạo tài khoản</h2>
                <p class="text-gray-600 mt-2">Đăng ký để nhận nhiều ưu đãi!</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
                    @Html.ValidationSummary(true)
                </div>
            }

            @using (Html.BeginForm("Register", "CustomerAccount", FormMethod.Post, new { @class = "space-y-5" }))
            {
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Họ và tên</label>
                    @Html.TextBoxFor(m => m.FullName, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "Nguyễn Văn A"
                    })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    @Html.TextBoxFor(m => m.Email, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "example@email.com",
                        type = "email"
                    })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "0901234567",
                        type = "tel"
                    })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                    @Html.PasswordFor(m => m.Password, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "Tối thiểu 6 ký tự"
                    })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Xác nhận mật khẩu</label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new {
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary",
                        placeholder = "Nhập lại mật khẩu"
                    })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger text-sm mt-1" })
                </div>

                <label class="flex items-start gap-3 cursor-pointer">
                    @Html.CheckBoxFor(m => m.AgreeTerms, new { @class = "w-4 h-4 text-primary rounded mt-1" })
                    <span class="text-sm text-gray-600">
                        Tôi đồng ý với 
                        <a href="#" class="text-primary hover:underline">Điều khoản dịch vụ</a> và 
                        <a href="#" class="text-primary hover:underline">Chính sách bảo mật</a>
                    </span>
                </label>

                <button type="submit" class="w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-blue-600 transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">person_add</span>
                    Đăng ký
                </button>
            }

            <p class="text-center mt-8 text-gray-600">
                Đã có tài khoản?
                <a href="@Url.Action("Login")" class="text-primary font-semibold hover:underline">Đăng nhập</a>
            </p>
        </div>
    </div>
</body>
</html>
