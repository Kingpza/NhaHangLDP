@{
    ViewBag.Title = "Tra cứu đơn hàng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Tra cứu đơn hàng - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <a href="@Url.Action("Menu", "Public")" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary mb-4">
                <span class="material-symbols-outlined">arrow_back</span>
                Về trang chủ
            </a>
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4">
                <span class="material-symbols-outlined text-3xl text-primary">local_shipping</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Tra cứu đơn hàng</h1>
            <p class="text-gray-500 mt-2">Nhập thông tin để theo dõi đơn hàng của bạn</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm flex items-center gap-2">
                <span class="material-symbols-outlined">error</span>
                @TempData["Error"]
            </div>
        }

        @using (Html.BeginForm("SearchOrder", "Checkout", FormMethod.Post, new { @class = "bg-white rounded-2xl shadow-lg p-6" }))
        {
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <span class="material-symbols-outlined text-sm align-middle mr-1">receipt</span>
                        Mã đơn hàng
                    </label>
                    <input type="text" name="orderCode" required
                           placeholder="VD: DH241201XXXX"
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary uppercase" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <span class="material-symbols-outlined text-sm align-middle mr-1">phone</span>
                        Số điện thoại đặt hàng
                    </label>
                    <input type="tel" name="phone" required
                           placeholder="0901234567"
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary/50 focus:border-primary" />
                </div>
                <button type="submit" 
                        class="w-full py-4 bg-primary text-white rounded-xl font-bold text-lg hover:bg-blue-600 transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">search</span>
                    Tra cứu
                </button>
            </div>
        }

        <div class="mt-8 text-center">
            <p class="text-gray-500 text-sm">
                Cần hỗ trợ? Liên hệ hotline: <a href="tel:19001234" class="text-primary font-semibold">1900 1234</a>
            </p>
        </div>
    </div>
</body>
</html>
