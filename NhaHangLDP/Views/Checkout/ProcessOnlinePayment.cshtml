@model NhaHangLDP.Models.OrderConfirmationViewModel
@{
    ViewBag.Title = "Thanh toán trực tuyến";
    Layout = null;
    var paymentMethod = ViewBag.PaymentMethod as string ?? "VNPay";
    var orderCode = ViewBag.OrderCode as string;
    var totalAmount = (decimal)(ViewBag.TotalAmount ?? 0m);
    var paymentName = paymentMethod == "MoMo" ? "Ví MoMo" : "VNPay";
    var paymentColor = paymentMethod == "MoMo" ? "#ae2070" : "#0066cc";
    var paymentLogo = paymentMethod == "MoMo"
        ? "https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png"
        : "https://vnpay.vn/s1/statics.vnpay.vn/2023/6/0oxhzjmxbksr1686814746087.png";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Thanh toán @paymentName - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#007bff",
                        success: "#28a745",
                        warning: "#ffc107",
                        danger: "#dc3545"
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen">
    <header class="bg-white shadow-sm">
        <div class="max-w-xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="@Url.Action("Menu", "Public")" class="flex items-center gap-2 text-gray-600 hover:text-primary">
                <span class="material-symbols-outlined">arrow_back</span>
                <span>Trang chủ</span>
            </a>
            <h1 class="text-lg font-bold">Thanh toán</h1>
            <div class="w-20"></div>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-8">
        <!-- Payment Countdown Alert -->
        <div id="countdownAlert" class="bg-orange-50 border-2 border-orange-200 rounded-xl p-4 mb-6 flex items-start gap-3">
            <span class="material-symbols-outlined text-orange-500 text-2xl">timer</span>
            <div class="flex-1">
                <p class="font-semibold text-orange-800 mb-1">Thời gian thanh toán còn lại</p>
                <div id="countdownTimer" class="text-2xl font-bold text-orange-600">59:59</div>
                <p class="text-sm text-orange-700 mt-1">Đơn hàng sẽ tự động hủy nếu không thanh toán trong thời gian này</p>
            </div>
        </div>

        <!-- Payment Info -->
        <div class="bg-white rounded-2xl shadow-sm p-6 mb-6 text-center">
            <img src="@paymentLogo" alt="@paymentName" class="h-16 mx-auto mb-4" />
            <h2 class="text-xl font-bold mb-2">Thanh toán qua @paymentName</h2>
            <p class="text-gray-500 text-sm mb-4">
                <span class="bg-warning/20 text-warning px-2 py-1 rounded-full text-xs font-semibold">Sandbox Mode</span>
            </p>
            <div class="bg-gray-50 rounded-xl p-4 mb-4">
                <p class="text-sm text-gray-500">Mã đơn hàng</p>
                <p class="text-lg font-bold text-primary">@orderCode</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 mb-6">
                <p class="text-sm text-gray-500">Số tiền thanh toán</p>
                <p class="text-3xl font-bold" style="color: @paymentColor">@totalAmount.ToString("N0")đ</p>
            </div>

            <!-- Order Items Summary -->
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="border-t border-gray-100 pt-4 mb-6">
                    <h3 class="text-sm font-semibold text-gray-600 mb-3 text-left">Chi tiết đơn hàng</h3>
                    <div class="space-y-2">
                        @foreach (var item in Model.Items)
                        {
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">@item.Name x@(item.Quantity)</span>
                                <span class="font-medium">@item.Subtotal.ToString("N0")đ</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Sandbox Payment Button -->
            <div class="space-y-3">
                <p class="text-sm text-gray-500">
                    Bạn sẽ được chuyển đến cổng thanh toán @paymentName (Sandbox) để hoàn tất thanh toán.
                </p>
                <button id="payNowBtn" onclick="processPayment()"
                        class="w-full py-4 text-white rounded-xl font-bold text-lg hover:opacity-90 transition-colors flex items-center justify-center gap-2 shadow-lg"
                        style="background-color: @paymentColor">
                    <span class="material-symbols-outlined">payment</span>
                    Thanh toán @totalAmount.ToString("N0")đ
                </button>
                <a href="@Url.Action("TrackOrder", new { code = orderCode })"
                   class="block w-full py-3 border-2 border-gray-300 text-gray-600 rounded-xl font-semibold text-center hover:bg-gray-100 transition-colors">
                    Thanh toán sau
                </a>
            </div>
        </div>
    </main>

    @Html.AntiForgeryToken()
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var safeOrderCode = @Html.Raw(Json.Encode(orderCode));
        var paymentMethod = @Html.Raw(Json.Encode(paymentMethod));
        var paymentTimeLimit = 60 * 60 * 1000; // 1 hour in milliseconds
        var countdownInterval;
        var cancelOrderTimeout;

        // Start countdown timer
        function startPaymentTimer() {
            var endTime = new Date().getTime() + paymentTimeLimit;

            countdownInterval = setInterval(function() {
                var now = new Date().getTime();
                var distance = endTime - now;

                if (distance < 0) {
                    clearInterval(countdownInterval);
                    handlePaymentTimeout();
                    return;
                }

                var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                // Display countdown timer
                var timerDisplay = (minutes < 10 ? '0' : '') + minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
                $('#countdownTimer').text(timerDisplay);

                // Change color when time is running out (less than 5 minutes)
                if (distance < 5 * 60 * 1000) {
                    $('#countdownAlert').removeClass('bg-orange-50 border-orange-200').addClass('bg-red-50 border-red-200');
                    $('#countdownTimer').removeClass('text-orange-600').addClass('text-red-600');
                    $('#countdownAlert .material-symbols-outlined').removeClass('text-orange-500').addClass('text-red-500');
                    $('#countdownAlert .text-orange-800').removeClass('text-orange-800').addClass('text-red-800');
                    $('#countdownAlert .text-orange-700').removeClass('text-orange-700').addClass('text-red-700');
                }
            }, 1000);

            // Set timeout to cancel order after 1 hour
            cancelOrderTimeout = setTimeout(function() {
                handlePaymentTimeout();
            }, paymentTimeLimit);
        }

        function handlePaymentTimeout() {
            clearInterval(countdownInterval);
            clearTimeout(cancelOrderTimeout);

            // Cancel the order via AJAX
            $.ajax({
                url: '@Url.Action("CancelUnpaidOrder", "Checkout")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    orderCode: safeOrderCode
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Đã hủy đơn hàng',
                            text: 'Đơn hàng đã bị hủy do quá thời gian thanh toán (1 giờ).',
                            confirmButtonText: 'Về trang chủ',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then(function() {
                            window.location.href = '@Url.Action("Menu", "Public")';
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không thể hủy đơn hàng. Vui lòng liên hệ hỗ trợ.'
                    });
                }
            });
        }

        function processPayment() {
            // Clear timers when user proceeds to payment
            clearInterval(countdownInterval);
            clearTimeout(cancelOrderTimeout);

            var btn = document.getElementById('payNowBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Đang chuyển đến cổng thanh toán...';

            // Redirect to actual sandbox payment gateway
            var paymentUrl;
            if (paymentMethod === 'MoMo') {
                paymentUrl = '@Url.Action("CreateMoMoPayment", "Checkout")' + '?orderCode=' + encodeURIComponent(safeOrderCode);
            } else {
                paymentUrl = '@Url.Action("CreateVNPayPayment", "Checkout")' + '?orderCode=' + encodeURIComponent(safeOrderCode);
            }
            window.location.href = paymentUrl;
        }

        // Start the timer when page loads
        $(document).ready(function() {
            startPaymentTimer();
        });
    </script>
</body>
</html>
