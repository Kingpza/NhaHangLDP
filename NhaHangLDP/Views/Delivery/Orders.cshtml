@model NhaHangLDP.Models.DeliveryOrderListViewModel
@{
    ViewBag.Title = "Danh Sách Đơn Giao Hàng";
    Layout = null;

    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    
    Func<string, string> GetStatusClass = (status) => {
        switch (status) {
            case "Pending": return "bg-gray-500";
            case "Confirmed": return "bg-blue-500";
            case "Preparing": return "bg-yellow-500";
            case "Ready": return "bg-indigo-500";
            case "Delivering": return "bg-purple-500";
            case "Completed": return "bg-green-500";
            case "Cancelled": return "bg-red-500";
            default: return "bg-gray-500";
        }
    };
    
    Func<string, string> GetStatusText = (status) => {
        switch (status) {
            case "Pending": return "Chờ xác nhận";
            case "Confirmed": return "Đã xác nhận";
            case "Preparing": return "Đang chuẩn bị";
            case "Ready": return "Sẵn sàng giao";
            case "Delivering": return "Đang giao";
            case "Completed": return "Hoàn thành";
            case "Cancelled": return "Đã hủy";
            default: return status;
        }
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: { "display": ["Manrope", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f0f2f5; }
        ::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 4px; }
        .order-row { transition: all 0.2s ease; }
        .order-row:hover { background: #f8f9ff; transform: scale(1.005); }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-white/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Index", "Delivery")" class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-2xl">local_shipping</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-text-primary">GIAO HÀNG</h1>
                            <p class="text-xs text-text-secondary">Delivery Management</p>
                        </div>
                    </a>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Dashboard</a>
                    <a href="@Url.Action("Management", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Quản lý giao hàng</a>
                    <a href="@Url.Action("Orders", "Delivery")" class="text-primary font-semibold border-b-2 border-primary pb-1">Đơn hàng</a>
                    <a href="@Url.Action("Shippers", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Shipper</a>
                    <a href="@Url.Action("Tracking", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Theo dõi</a>
                    <a href="@Url.Action("FeeSettings", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Cài đặt phí</a>
                    <a href="@Url.Action("Statistics", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Thống kê</a>
                </div>
                <a href="@Url.Action("Dashboard", "Management")" class="flex items-center gap-2 px-6 py-2 bg-primary rounded-full text-white hover:bg-blue-700 transition-all font-bold shadow-lg">
                    <span class="material-symbols-outlined text-lg">dashboard</span>
                    Quản lý
                </a>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-primary to-purple-600 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <h1 class="text-3xl md:text-4xl font-black text-white mb-2">
                <span class="material-symbols-outlined text-4xl align-middle mr-2">list_alt</span>
                Đơn Hàng Giao Hàng
            </h1>
            <p class="text-white/80">Quản lý và theo dõi tất cả đơn hàng giao hàng</p>
        </div>
    </section>

    <!-- Status Filters -->
    <section class="bg-white border-b border-border-light py-4 sticky top-[73px] z-40">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-wrap gap-3">
                @{
                    var statuses = new[] {
                        new { Key = "all", Label = "Tất cả", Icon = "list", Color = "gray" },
                        new { Key = "Pending", Label = "Chờ xác nhận", Icon = "hourglass_top", Color = "gray" },
                        new { Key = "Confirmed", Label = "Đã xác nhận", Icon = "check_circle", Color = "blue" },
                        new { Key = "Preparing", Label = "Đang chuẩn bị", Icon = "restaurant", Color = "yellow" },
                        new { Key = "Ready", Label = "Sẵn sàng giao", Icon = "inventory_2", Color = "indigo" },
                        new { Key = "Delivering", Label = "Đang giao", Icon = "two_wheeler", Color = "purple" },
                        new { Key = "Completed", Label = "Hoàn thành", Icon = "task_alt", Color = "green" },
                        new { Key = "Cancelled", Label = "Đã hủy", Icon = "cancel", Color = "red" }
                    };
                }
                @foreach (var s in statuses)
                {
                    var isActive = Model.SelectedStatus == s.Key;
                    var count = statusCounts.ContainsKey(s.Key) ? statusCounts[s.Key] : 0;
                    var activeClass = isActive ? $"bg-{s.Color}-500 text-white shadow-lg" : $"bg-{s.Color}-100 text-{s.Color}-700 hover:bg-{s.Color}-200";
                    
                    <a href="@Url.Action("Orders", "Delivery", new { status = s.Key })" 
                       class="relative flex items-center gap-2 px-4 py-2 rounded-full font-semibold text-sm transition-all @(isActive ? "bg-primary text-white shadow-lg" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                        <span class="material-symbols-outlined text-lg">@s.Icon</span>
                        @s.Label
                        <span class="px-2 py-0.5 rounded-full text-xs font-bold @(isActive ? "bg-white/20" : "bg-white")">@count</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Orders Table -->
    <section class="py-8">
        <div class="max-w-7xl mx-auto px-6">
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-sidebar-surface border-b border-border-light">
                                <tr>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Mã đơn</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Khách hàng</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Địa chỉ</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Tổng tiền</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Shipper</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Trạng thái</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-text-secondary">Thời gian</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-text-secondary">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-light">
                                @foreach (var order in Model.Orders)
                                {
                                    var statusClass = GetStatusClass(order.Status);
                                    var statusText = GetStatusText(order.Status);
                                    
                                    <tr class="order-row">
                                        <td class="px-6 py-4">
                                            <a href="@Url.Action("OrderDetail", "Delivery", new { id = order.OrderId })" class="font-bold text-primary hover:underline text-lg">
                                                #@order.OrderCode
                                            </a>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="font-semibold text-text-primary">@order.CustomerName</div>
                                            <div class="text-sm text-text-secondary flex items-center gap-1">
                                                <span class="material-symbols-outlined text-sm">call</span>
                                                @order.CustomerPhone
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="max-w-xs truncate text-sm" title="@order.DeliveryAddress">
                                                @order.DeliveryAddress
                                            </div>
                                            <div class="text-xs text-text-secondary">@order.District</div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="font-bold text-green-600">@order.TotalAmount.ToString("N0")đ</div>
                                            @if (order.DeliveryFee > 0)
                                            {
                                                <div class="text-xs text-text-secondary">Ship: @order.DeliveryFee.ToString("N0")đ</div>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (!string.IsNullOrEmpty(order.ShipperName))
                                            {
                                                <div class="flex items-center gap-2">
                                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-purple-500 flex items-center justify-center text-white text-xs font-bold">
                                                        @order.ShipperName.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div>
                                                        <div class="font-semibold text-sm">@order.ShipperName</div>
                                                        <div class="text-xs text-text-secondary">@order.ShipperPhone</div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-text-secondary text-sm flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-lg">person_off</span>
                                                    Chưa gán
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block px-3 py-1 rounded-full text-white text-xs font-semibold @statusClass">
                                                @statusText
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm">
                                            <div class="font-semibold">@order.OrderDate.ToString("HH:mm")</div>
                                            <div class="text-text-secondary text-xs">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="@Url.Action("OrderDetail", "Delivery", new { id = order.OrderId })" 
                                                   class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" title="Chi tiết">
                                                    <span class="material-symbols-outlined text-lg">visibility</span>
                                                </a>
                                                @if (order.Status == "Pending")
                                                {
                                                    <button onclick="confirmOrder(@order.OrderId)" 
                                                            class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 hover:bg-blue-500 hover:text-white transition-all" title="Xác nhận">
                                                        <span class="material-symbols-outlined text-lg">check</span>
                                                    </button>
                                                }
                                                @if (order.Status == "Ready" || order.Status == "Confirmed")
                                                {
                                                    <button onclick="showAssignModal(@order.OrderId)" 
                                                            class="w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-green-600 hover:bg-green-500 hover:text-white transition-all" title="Gán shipper">
                                                        <span class="material-symbols-outlined text-lg">person_add</span>
                                                    </button>
                                                }
                                                @if (order.Status != "Completed" && order.Status != "Cancelled" && order.Status != "Delivering")
                                                {
                                                    <button onclick="showCancelModal(@order.OrderId)" 
                                                            class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-red-600 hover:bg-red-500 hover:text-white transition-all" title="Hủy">
                                                        <span class="material-symbols-outlined text-lg">close</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-16">
                        <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="material-symbols-outlined text-gray-400 text-5xl">inbox</span>
                        </div>
                        <h3 class="text-xl font-bold text-text-secondary mb-2">Không có đơn hàng nào</h3>
                        <p class="text-text-secondary">Chưa có đơn hàng với trạng thái này</p>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalCount > Model.PageSize)
            {
                var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                <div class="flex justify-center mt-8 gap-2">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var isCurrentPage = i == Model.PageNumber;
                        <a href="@Url.Action("Orders", "Delivery", new { status = Model.SelectedStatus, page = i })" 
                           class="w-10 h-10 rounded-full flex items-center justify-center font-semibold transition-all @(isCurrentPage ? "bg-primary text-white shadow-lg" : "bg-white text-text-primary hover:bg-primary/10")">
                            @i
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Assign Shipper Modal -->
    <div id="assignShipperModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
            <div class="bg-gradient-to-r from-primary to-purple-600 p-6 text-white">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined">person_add</span>
                    Gán Shipper
                </h3>
            </div>
            <div class="p-6">
                <input type="hidden" id="assignOrderId">
                <div id="shipperList" class="space-y-3 max-h-80 overflow-y-auto">
                    <p class="text-center text-text-secondary py-8">
                        <span class="material-symbols-outlined animate-spin">progress_activity</span>
                        Đang tải...
                    </p>
                </div>
            </div>
            <div class="p-6 border-t border-border-light flex gap-3">
                <button onclick="closeAssignModal()" class="flex-1 py-3 rounded-full border-2 border-gray-300 text-text-secondary font-semibold hover:bg-gray-100 transition-all">
                    Đóng
                </button>
                <button onclick="autoAssign()" class="flex-1 py-3 rounded-full bg-primary text-white font-semibold hover:bg-blue-700 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">auto_fix_high</span>
                    Tự động gán
                </button>
            </div>
        </div>
    </div>

    <!-- Cancel Modal -->
    <div id="cancelOrderModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
            <div class="bg-gradient-to-r from-red-500 to-red-600 p-6 text-white">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined">warning</span>
                    Hủy Đơn Hàng
                </h3>
            </div>
            <div class="p-6">
                <input type="hidden" id="cancelOrderId">
                <label class="block text-sm font-semibold text-text-primary mb-2">Lý do hủy đơn:</label>
                <textarea id="cancelReason" rows="4" class="w-full px-4 py-3 rounded-2xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors resize-none" placeholder="Nhập lý do hủy đơn..."></textarea>
            </div>
            <div class="p-6 border-t border-border-light flex gap-3">
                <button onclick="closeCancelModal()" class="flex-1 py-3 rounded-full border-2 border-gray-300 text-text-secondary font-semibold hover:bg-gray-100 transition-all">
                    Đóng
                </button>
                <button onclick="cancelOrder()" class="flex-1 py-3 rounded-full bg-red-500 text-white font-semibold hover:bg-red-600 transition-all">
                    Xác nhận hủy
                </button>
            </div>
        </div>
    </div>

    <script>
        function confirmOrder(orderId) {
            if (!confirm('Xác nhận đơn hàng này?')) return;
            postAction('@Url.Action("ConfirmOrder", "Delivery")', { orderId: orderId });
        }

        function showAssignModal(orderId) {
            document.getElementById('assignOrderId').value = orderId;
            document.getElementById('assignShipperModal').classList.remove('hidden');
            document.getElementById('assignShipperModal').classList.add('flex');
            loadShippers();
        }

        function closeAssignModal() {
            document.getElementById('assignShipperModal').classList.add('hidden');
            document.getElementById('assignShipperModal').classList.remove('flex');
        }

        function loadShippers() {
            fetch('@Url.Action("GetAvailableShippers", "Delivery")')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.shippers.length > 0) {
                        let html = '';
                        data.shippers.forEach(s => {
                            html += `
                                <button onclick="assignShipper(${s.Id})" class="w-full flex items-center gap-4 p-4 rounded-2xl bg-sidebar-surface hover:bg-primary/10 transition-all text-left">
                                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-purple-500 flex items-center justify-center text-white font-bold">
                                        ${s.FullName.charAt(0)}
                                    </div>
                                    <div class="flex-1">
                                        <div class="font-bold text-text-primary">${s.FullName}</div>
                                        <div class="text-sm text-text-secondary">${s.Phone} | ${s.VehicleType || 'Xe máy'}</div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-yellow-500 font-bold">★ ${s.Rating.toFixed(1)}</div>
                                        <div class="text-xs text-text-secondary">${s.TotalDeliveries} đơn</div>
                                    </div>
                                </button>
                            `;
                        });
                        document.getElementById('shipperList').innerHTML = html;
                    } else {
                        document.getElementById('shipperList').innerHTML = '<p class="text-center text-text-secondary py-8">Không có shipper khả dụng</p>';
                    }
                });
        }

        function assignShipper(shipperId) {
            var orderId = document.getElementById('assignOrderId').value;
            postAction('@Url.Action("AssignShipper", "Delivery")', { orderId: orderId, shipperId: shipperId });
        }

        function autoAssign() {
            var orderId = document.getElementById('assignOrderId').value;
            postAction('@Url.Action("AutoAssign", "Delivery")', { orderId: orderId });
        }

        function showCancelModal(orderId) {
            document.getElementById('cancelOrderId').value = orderId;
            document.getElementById('cancelReason').value = '';
            document.getElementById('cancelOrderModal').classList.remove('hidden');
            document.getElementById('cancelOrderModal').classList.add('flex');
        }

        function closeCancelModal() {
            document.getElementById('cancelOrderModal').classList.add('hidden');
            document.getElementById('cancelOrderModal').classList.remove('flex');
        }

        function cancelOrder() {
            var orderId = document.getElementById('cancelOrderId').value;
            var reason = document.getElementById('cancelReason').value;
            if (!reason.trim()) {
                alert('Vui lòng nhập lý do hủy đơn');
                return;
            }
            postAction('@Url.Action("CancelOrder", "Delivery")', { orderId: orderId, reason: reason });
        }

        function postAction(url, data) {
            var body = Object.keys(data).map(k => k + '=' + encodeURIComponent(data[k])).join('&');
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            })
            .then(r => r.json())
            .then(res => {
                alert(res.message || res.Message);
                if (res.success || res.Success) location.reload();
            })
            .catch(err => alert('Có lỗi xảy ra'));
        }
    </script>
</body>
</html>
