@model NhaHangLDP.Models.DeliveryDashboardViewModel
@{
    ViewBag.Title = "Quản Lý Giao Hàng";
    Layout = null;
    
    // Helper functions for status
    Func<string, string> GetStatusClass = (status) => {
        switch (status) {
            case "Pending": return "bg-gray-500";
            case "Confirmed": return "bg-blue-500";
            case "Preparing": return "bg-yellow-500";
            case "Ready": return "bg-indigo-500";
            case "Delivering": return "bg-purple-500";
            case "Completed": return "bg-green-500";
            case "Cancelled": return "bg-red-500";
            default: return "bg-gray-500";
        }
    };
    
    Func<string, string> GetStatusText = (status) => {
        switch (status) {
            case "Pending": return "Chờ xác nhận";
            case "Confirmed": return "Đã xác nhận";
            case "Preparing": return "Đang chuẩn bị";
            case "Ready": return "Sẵn sàng giao";
            case "Delivering": return "Đang giao";
            case "Completed": return "Hoàn thành";
            case "Cancelled": return "Đã hủy";
            default: return status;
        }
    };
    
    Func<string, string> GetShipperDotClass = (status) => {
        switch (status) {
            case "Available": return "bg-green-500";
            case "Busy": return "bg-yellow-500";
            default: return "bg-gray-400";
        }
    };
    
    Func<string, string> GetShipperStatusText = (status) => {
        switch (status) {
            case "Available": return "Sẵn sàng";
            case "Busy": return "Đang giao";
            default: return "Offline";
        }
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f0f2f5; }
        ::-webkit-scrollbar-thumb { background: #ced4da; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #007bff; }
        
        .hero-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .stat-card { transition: all 0.3s ease; }
        .stat-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .order-card { transition: all 0.3s ease; }
        .order-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        
        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }
        
        .shipper-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 18px;
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-dot { animation: pulse-dot 2s infinite; }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-white/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Index", "Home")" class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-2xl">local_shipping</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-text-primary">GIAO HÀNG</h1>
                            <p class="text-xs text-text-secondary">Delivery Management</p>
                        </div>
                    </a>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Delivery")" class="text-primary font-semibold border-b-2 border-primary pb-1">Dashboard</a>
                    <a href="@Url.Action("Management", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Quản lý giao hàng</a>
                    <a href="@Url.Action("Orders", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Đơn hàng</a>
                    <a href="@Url.Action("Shippers", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Shipper</a>
                    <a href="@Url.Action("Tracking", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Theo dõi</a>
                    <a href="@Url.Action("FeeSettings", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Cài đặt phí</a>
                    <a href="@Url.Action("Statistics", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Thống kê</a>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="refreshDashboard()" class="flex items-center gap-2 px-4 py-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold">
                        <span class="material-symbols-outlined text-lg">refresh</span>
                        Làm mới
                    </button>
                    <a href="@Url.Action("Dashboard", "Management")" class="flex items-center gap-2 px-6 py-2 bg-primary rounded-full text-white hover:bg-blue-700 transition-all font-bold shadow-lg">
                        <span class="material-symbols-outlined text-lg">dashboard</span>
                        Quản lý
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative py-16 overflow-hidden">
        <div class="absolute inset-0 hero-gradient"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-6">
            <div class="text-center mb-8">
                <h1 class="text-4xl md:text-5xl font-black text-white mb-4">
                    Dashboard <span class="text-yellow-300">Giao Hàng</span>
                </h1>
                <p class="text-xl text-white/90">
                    Theo dõi và quản lý đơn giao hàng realtime
                </p>
                <p class="text-white/70 mt-2">
                    <span class="material-symbols-outlined text-sm align-middle">schedule</span>
                    Cập nhật lúc: <span id="lastUpdate">@DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy")</span>
                </p>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="stat-card bg-white rounded-3xl p-6 text-center shadow-xl">
                    <div class="w-16 h-16 bg-yellow-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-yellow-600 text-3xl">hourglass_top</span>
                    </div>
                    <h3 class="text-4xl font-black text-yellow-600 mb-1" id="pendingCount">@Model.PendingOrders</h3>
                    <p class="text-text-secondary font-semibold">Chờ giao hàng</p>
                </div>
                <div class="stat-card bg-white rounded-3xl p-6 text-center shadow-xl">
                    <div class="w-16 h-16 bg-purple-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-purple-600 text-3xl">two_wheeler</span>
                    </div>
                    <h3 class="text-4xl font-black text-purple-600 mb-1" id="deliveringCount">@Model.DeliveringOrders</h3>
                    <p class="text-text-secondary font-semibold">Đang giao</p>
                </div>
                <div class="stat-card bg-white rounded-3xl p-6 text-center shadow-xl">
                    <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-green-600 text-3xl">check_circle</span>
                    </div>
                    <h3 class="text-4xl font-black text-green-600 mb-1" id="completedCount">@Model.CompletedOrdersToday</h3>
                    <p class="text-text-secondary font-semibold">Hoàn thành hôm nay</p>
                </div>
                <div class="stat-card bg-white rounded-3xl p-6 text-center shadow-xl">
                    <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-blue-600 text-3xl">payments</span>
                    </div>
                    <h3 class="text-3xl font-black text-blue-600 mb-1" id="revenueToday">@Model.TodayRevenue.ToString("N0")đ</h3>
                    <p class="text-text-secondary font-semibold">Doanh thu giao hàng</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Actions -->
    <section class="py-8 bg-white border-y border-border-light">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-wrap justify-center gap-4">
                <a href="@Url.Action("Orders", "Delivery")" class="group flex items-center gap-3 px-6 py-3 bg-primary/10 rounded-full hover:bg-primary hover:text-white transition-all font-semibold text-primary">
                    <span class="material-symbols-outlined">list_alt</span>
                    Danh Sách Đơn
                </a>
                <a href="@Url.Action("Orders", "Delivery", new { status = "Ready" })" class="group flex items-center gap-3 px-6 py-3 bg-yellow-100 rounded-full hover:bg-yellow-500 hover:text-white transition-all font-semibold text-yellow-700">
                    <span class="material-symbols-outlined">inventory_2</span>
                    Đơn Chờ Giao (@Model.PendingOrders)
                </a>
                <a href="@Url.Action("Shippers", "Delivery")" class="group flex items-center gap-3 px-6 py-3 bg-green-100 rounded-full hover:bg-green-500 hover:text-white transition-all font-semibold text-green-700">
                    <span class="material-symbols-outlined">groups</span>
                    Quản Lý Shipper
                </a>
                <a href="@Url.Action("Tracking", "Delivery")" class="group flex items-center gap-3 px-6 py-3 bg-indigo-100 rounded-full hover:bg-indigo-500 hover:text-white transition-all font-semibold text-indigo-700">
                    <span class="material-symbols-outlined">map</span>
                    Theo Dõi Real-time
                </a>
                <a href="@Url.Action("Zones", "Delivery")" class="group flex items-center gap-3 px-6 py-3 bg-gray-100 rounded-full hover:bg-gray-600 hover:text-white transition-all font-semibold text-gray-700">
                    <span class="material-symbols-outlined">location_on</span>
                    Khu Vực Giao Hàng
                </a>
                <a href="@Url.Action("Statistics", "Delivery")" class="group flex items-center gap-3 px-6 py-3 bg-purple-100 rounded-full hover:bg-purple-500 hover:text-white transition-all font-semibold text-purple-700">
                    <span class="material-symbols-outlined">analytics</span>
                    Thống Kê
                </a>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Recent Orders -->
                <div class="lg:col-span-2">
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="p-6 border-b border-border-light flex justify-between items-center">
                            <div>
                                <h2 class="text-2xl font-bold text-text-primary flex items-center gap-3">
                                    <span class="material-symbols-outlined text-primary">receipt_long</span>
                                    Đơn Hàng Gần Đây
                                </h2>
                                <p class="text-text-secondary text-sm mt-1">Các đơn giao hàng mới nhất</p>
                            </div>
                            <a href="@Url.Action("Orders", "Delivery")" class="flex items-center gap-2 px-4 py-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold text-sm">
                                Xem tất cả
                                <span class="material-symbols-outlined text-lg">arrow_forward</span>
                            </a>
                        </div>
                        <div class="p-6 space-y-4" id="recentOrdersContainer">
                            @if (Model.RecentDeliveries != null && Model.RecentDeliveries.Any())
                            {
                                foreach (var order in Model.RecentDeliveries.Take(5))
                                {
                                    var statusClass = GetStatusClass(order.Status);
                                    var statusText = GetStatusText(order.Status);
                                    <div class="order-card bg-sidebar-surface rounded-2xl p-5 border border-border-light">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                                                    <span class="material-symbols-outlined text-primary">shopping_bag</span>
                                                </div>
                                                <div>
                                                    <span class="font-bold text-primary text-lg">#@order.OrderCode</span>
                                                    <p class="text-text-secondary text-sm">@order.OrderDate.ToString("HH:mm dd/MM/yyyy")</p>
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <span class="inline-block px-4 py-1 rounded-full text-white text-sm font-semibold @statusClass">
                                                    @statusText
                                                </span>
                                                <p class="text-green-600 font-bold text-lg mt-1">@order.TotalAmount.ToString("N0")đ</p>
                                            </div>
                                        </div>
                                        <div class="space-y-2 text-sm">
                                            <div class="flex items-center gap-2 text-text-secondary">
                                                <span class="material-symbols-outlined text-lg">person</span>
                                                <span class="font-medium text-text-primary">@order.CustomerName</span>
                                                <span>-</span>
                                                <span>@order.CustomerPhone</span>
                                            </div>
                                            <div class="flex items-start gap-2 text-text-secondary">
                                                <span class="material-symbols-outlined text-lg text-red-500">location_on</span>
                                                <span>@order.DeliveryAddress</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(order.ShipperName))
                                            {
                                                <div class="flex items-center gap-2 text-text-secondary">
                                                    <span class="material-symbols-outlined text-lg text-purple-500">two_wheeler</span>
                                                    <span class="font-medium text-purple-600">@order.ShipperName</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex gap-2 mt-4 pt-4 border-t border-border-light">
                                            <a href="@Url.Action("OrderDetail", "Delivery", new { id = order.OrderId })" class="flex-1 flex items-center justify-center gap-2 px-4 py-2 rounded-xl border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold text-sm">
                                                <span class="material-symbols-outlined text-lg">visibility</span>
                                                Chi tiết
                                            </a>
                                            @if (order.Status == "Ready" || order.Status == "Confirmed")
                                            {
                                                <button onclick="autoAssignShipper(@order.OrderId)" class="flex-1 flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-green-500 text-white hover:bg-green-600 transition-all font-semibold text-sm">
                                                    <span class="material-symbols-outlined text-lg">person_add</span>
                                                    Gán Shipper
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-12">
                                    <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <span class="material-symbols-outlined text-gray-400 text-5xl">inbox</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-text-secondary mb-2">Chưa có đơn hàng</h3>
                                    <p class="text-text-secondary">Đơn giao hàng sẽ hiển thị ở đây</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Sidebar -->
                <div class="space-y-6">
                    <!-- Shipper Status -->
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="p-6 border-b border-border-light flex justify-between items-center">
                            <div>
                                <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
                                    <span class="material-symbols-outlined text-green-500">groups</span>
                                    Trạng Thái Shipper
                                </h2>
                            </div>
                            <a href="@Url.Action("Shippers", "Delivery")" class="text-primary hover:underline text-sm font-semibold">
                                Quản lý →
                            </a>
                        </div>
                        
                        <!-- Shipper Stats Summary -->
                        <div class="p-4 bg-sidebar-surface border-b border-border-light">
                            <div class="grid grid-cols-3 gap-4 text-center">
                                <div>
                                    <div class="flex items-center justify-center gap-1 mb-1">
                                        <span class="status-dot bg-green-500 animate-pulse-dot"></span>
                                        <span class="font-black text-2xl text-green-600">@Model.AvailableShippers</span>
                                    </div>
                                    <p class="text-xs text-text-secondary">Sẵn sàng</p>
                                </div>
                                <div>
                                    <div class="flex items-center justify-center gap-1 mb-1">
                                        <span class="status-dot bg-yellow-500"></span>
                                        <span class="font-black text-2xl text-yellow-600">@Model.BusyShippers</span>
                                    </div>
                                    <p class="text-xs text-text-secondary">Đang giao</p>
                                </div>
                                <div>
                                    <div class="flex items-center justify-center gap-1 mb-1">
                                        <span class="status-dot bg-gray-400"></span>
                                        <span class="font-black text-2xl text-gray-500">@(Model.TotalShippers - Model.AvailableShippers - Model.BusyShippers)</span>
                                    </div>
                                    <p class="text-xs text-text-secondary">Offline</p>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 space-y-3 max-h-80 overflow-y-auto">
                            @if (Model.ShipperStatuses != null && Model.ShipperStatuses.Any())
                            {
                                foreach (var shipper in Model.ShipperStatuses.Take(6))
                                {
                                    var dotClass = GetShipperDotClass(shipper.Status);
                                    var shipperStatusText = GetShipperStatusText(shipper.Status);
                                    <div class="flex items-center gap-3 p-3 rounded-xl bg-sidebar-surface hover:bg-hover-light transition-colors">
                                        <div class="shipper-avatar">
                                            @shipper.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-bold text-text-primary truncate">@shipper.FullName</p>
                                            <div class="flex items-center gap-2 text-sm text-text-secondary">
                                                <span class="status-dot @dotClass @(shipper.Status == "Available" ? "animate-pulse-dot" : "")"></span>
                                                <span>@shipperStatusText</span>
                                                <span class="text-yellow-500">★ @shipper.Rating.ToString("F1")</span>
                                            </div>
                                        </div>
                                        <a href="tel:@shipper.Phone" class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                                            <span class="material-symbols-outlined text-lg">call</span>
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-8">
                                    <span class="material-symbols-outlined text-gray-400 text-4xl">person_off</span>
                                    <p class="text-text-secondary mt-2">Chưa có shipper</p>
                                    <a href="@Url.Action("CreateShipper", "Delivery")" class="inline-flex items-center gap-2 mt-3 px-4 py-2 bg-primary text-white rounded-full text-sm font-semibold hover:bg-blue-700 transition-colors">
                                        <span class="material-symbols-outlined text-lg">add</span>
                                        Thêm Shipper
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Today Stats -->
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="p-6 border-b border-border-light">
                            <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-indigo-500">insights</span>
                                Thống Kê Hôm Nay
                            </h2>
                        </div>
                        <div class="p-6 space-y-4">
                            <div class="flex justify-between items-center">
                                <span class="text-text-secondary">Phí giao hàng thu được:</span>
                                <span class="font-bold text-green-600">@Model.TodayDeliveryFees.ToString("N0")đ</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-text-secondary">Đơn thất bại:</span>
                                <span class="font-bold text-red-500">@Model.FailedOrdersToday</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-text-secondary">Tỷ lệ thành công:</span>
                                @{
                                    var total = Model.CompletedOrdersToday + Model.FailedOrdersToday;
                                    var rate = total > 0 ? (Model.CompletedOrdersToday * 100.0 / total) : 100;
                                }
                                <span class="font-bold text-primary">@rate.ToString("F1")%</span>
                            </div>
                            <div class="pt-4 border-t border-border-light">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm text-text-secondary">Tiến độ hoàn thành</span>
                                    <span class="text-sm font-bold text-primary">@rate.ToString("F0")%</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-3">
                                    <div class="bg-gradient-to-r from-primary to-purple-500 h-3 rounded-full transition-all" style="width: @rate%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-text-primary text-white py-8">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl">local_shipping</span>
                    </div>
                    <div>
                        <h3 class="font-bold">Hệ Thống Giao Hàng</h3>
                        <p class="text-xs text-white/70">Nhà hàng Hỷ Lạc Hotpot</p>
                    </div>
                </div>
                <p class="text-white/70 text-sm">© 2024 Nhà hàng Hỷ Lạc Hotpot. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Auto refresh dashboard every 30 seconds
        setInterval(refreshDashboard, 30000);

        function refreshDashboard() {
            fetch('@Url.Action("GetDashboardData", "Delivery")')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('pendingCount').textContent = data.data.PendingOrders;
                        document.getElementById('deliveringCount').textContent = data.data.DeliveringOrders;
                        document.getElementById('completedCount').textContent = data.data.CompletedOrdersToday;
                        document.getElementById('revenueToday').textContent = formatCurrency(data.data.TodayRevenue);
                        document.getElementById('lastUpdate').textContent = new Date().toLocaleString('vi-VN');
                    }
                })
                .catch(err => console.error('Error refreshing dashboard:', err));
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
        }

        function autoAssignShipper(orderId) {
            if (!confirm('Tự động gán shipper cho đơn hàng này?')) return;

            fetch('@Url.Action("AutoAssign", "Delivery")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'orderId=' + orderId
            })
            .then(response => response.json())
            .then(data => {
                if (data.Success) {
                    alert('Đã gán shipper: ' + data.ShipperName);
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.Message);
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Có lỗi xảy ra');
            });
        }
    </script>
</body>
</html>
