@model NhaHangLDP.Models.ShopEmployeeDeliveryDashboardViewModel
@{
    ViewBag.Title = "Đơn Hàng Đang Giao - Nhân Viên";
    Layout = null;
    Func<string, string> GetStatusClass = (status) => {
        switch (status) {
            case "Assigned": return "bg-blue-500";
            case "Accepted": return "bg-indigo-500";
            case "PickedUp": return "bg-purple-500";
            case "Delivering": return "bg-orange-500";
            case "Completed": return "bg-green-500";
            case "Cancelled": return "bg-red-500";
            default: return "bg-gray-500";
        }
    };
    Func<string, string> GetStatusText = (status) => {
        switch (status) {
            case "Assigned": return "Đã gán";
            case "Accepted": return "Đã nhận";
            case "PickedUp": return "Đã lấy hàng";
            case "Delivering": return "Đang giao";
            case "Completed": return "Hoàn thành";
            case "Cancelled": return "Đã hủy";
            default: return status;
        }
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: {
                colors: { "primary": "#007bff", "text-primary": "#212529" },
                fontFamily: { "display": ["Manrope", "sans-serif"] }
            }}
        }
    </script>
</head>
<body class="bg-gray-50 font-display min-h-screen">
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Index", "Delivery")" class="text-gray-600 hover:text-primary"><i class="fas fa-arrow-left"></i></a>
                <h1 class="text-2xl font-bold">Đơn Hàng Đang Giao</h1>
            </div>
            <button onclick="location.reload()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-600"><i class="fas fa-sync-alt mr-2"></i>Làm mới</button>
        </div>
    </header>
    <main class="container mx-auto px-6 py-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl p-6 shadow-sm border"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center"><i class="fas fa-shipping-fast text-blue-600 text-xl"></i></div><div><p class="text-gray-500 text-sm">Đơn hôm nay</p><p class="text-2xl font-bold">@Model.TodayOrderCount</p></div></div></div>
            <div class="bg-white rounded-xl p-6 shadow-sm border"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center"><i class="fas fa-check text-green-600 text-xl"></i></div><div><p class="text-gray-500 text-sm">Đã hoàn thành</p><p class="text-2xl font-bold">@Model.TodayCompletedCount</p></div></div></div>
            <div class="bg-white rounded-xl p-6 shadow-sm border"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center"><i class="fas fa-coins text-yellow-600 text-xl"></i></div><div><p class="text-gray-500 text-sm">Phí ship thu được</p><p class="text-2xl font-bold">@Model.TodayTotalDeliveryFees.ToString("N0")đ</p></div></div></div>
        </div>
        <h2 class="text-xl font-bold mb-4"><i class="fas fa-motorcycle mr-2 text-primary"></i>Đơn đang giao (@(Model.ActiveOrders?.Count ?? 0))</h2>
        @if(Model.ActiveOrders != null && Model.ActiveOrders.Any()) {
            <div class="space-y-4">
            @foreach(var order in Model.ActiveOrders) {
                <div class="bg-white rounded-xl p-5 shadow-sm border hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div><h4 class="font-bold text-lg">#@order.OrderCode</h4><p class="text-gray-500 text-sm">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p></div>
                        <span class="px-3 py-1 rounded-full text-white text-sm @GetStatusClass(order.Status)">@GetStatusText(order.Status)</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div><p class="text-sm text-gray-500">Khách hàng</p><p class="font-medium">@order.CustomerName</p><p class="text-sm text-gray-600">@order.CustomerPhone</p></div>
                        <div><p class="text-sm text-gray-500">Địa chỉ giao</p><p class="font-medium text-sm">@order.DeliveryAddress</p></div>
                    </div>
                    <div class="flex justify-between items-center pt-4 border-t">
                        <div><span class="text-xl font-bold text-primary">@order.TotalAmount.ToString("N0")đ</span><span class="text-sm text-gray-500 ml-2">Phí ship: @order.DeliveryFee.ToString("N0")đ</span></div>
                        <div class="flex gap-2">
                            <button onclick="updateStatus(@order.AssignmentId, 'PickedUp')" class="px-3 py-2 bg-purple-500 text-white rounded-lg text-sm hover:bg-purple-600"><i class="fas fa-box mr-1"></i>Đã lấy hàng</button>
                            <button onclick="updateStatus(@order.AssignmentId, 'Delivered')" class="px-3 py-2 bg-green-500 text-white rounded-lg text-sm hover:bg-green-600"><i class="fas fa-check mr-1"></i>Đã giao</button>
                        </div>
                    </div>
                </div>
            }
            </div>
        } else {
            <div class="bg-white rounded-xl p-12 text-center text-gray-500"><i class="fas fa-inbox text-6xl mb-4"></i><p>Không có đơn hàng đang giao</p></div>
        }
        @if(Model.CompletedTodayOrders != null && Model.CompletedTodayOrders.Any()) {
            <h2 class="text-xl font-bold mt-8 mb-4"><i class="fas fa-check-circle mr-2 text-green-500"></i>Đã hoàn thành hôm nay (@Model.CompletedTodayOrders.Count)</h2>
            <div class="space-y-3">
            @foreach(var order in Model.CompletedTodayOrders) {
                <div class="bg-green-50 rounded-xl p-4 border border-green-200">
                    <div class="flex justify-between items-center">
                        <div><span class="font-bold">#@order.OrderCode</span><span class="text-sm text-gray-500 ml-3">@order.CustomerName</span></div>
                        <div><span class="font-bold text-green-600">@order.TotalAmount.ToString("N0")đ</span><span class="px-2 py-1 bg-green-500 text-white rounded-full text-xs ml-2">Hoàn thành</span></div>
                    </div>
                </div>
            }
            </div>
        }
    </main>
    <script>
        function updateStatus(assignmentId, status) {
            var msg = status === 'PickedUp' ? 'Xác nhận đã lấy hàng?' : 'Xác nhận đã giao thành công?';
            if (!confirm(msg)) return;
            fetch('@Url.Action("UpdateDeliveryStatus", "Delivery")', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ AssignmentId: assignmentId, Status: status })
            }).then(function(r) { return r.json(); })
            .then(function(d) { if (d.success) { alert('Cập nhật thành công!'); location.reload(); } else { alert(d.message || 'Có lỗi xảy ra'); } });
        }
        setInterval(function() { location.reload(); }, 60000);
    </script>
</body>
</html>