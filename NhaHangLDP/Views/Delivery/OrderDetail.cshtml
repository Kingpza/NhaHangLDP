@model NhaHangLDP.Models.DeliveryOrderDetailViewModel
@{
    ViewBag.Title = "Chi Tiết Đơn Giao Hàng";
    Layout = null;
    var availableShippers = ViewBag.AvailableShippers as List<NhaHangLDP.Data.Entities.Shipper> ?? new List<NhaHangLDP.Data.Entities.Shipper>();
    
    Func<string, string> GetStatusClass = (status) => {
        switch (status) {
            case "Pending": return "bg-gray-500";
            case "Confirmed": return "bg-blue-500";
            case "Preparing": return "bg-yellow-500";
            case "Ready": return "bg-indigo-500";
            case "Delivering": return "bg-purple-500";
            case "Completed": return "bg-green-500";
            case "Cancelled": return "bg-red-500";
            default: return "bg-gray-500";
        }
    };
    
    Func<string, string> GetStatusText = (status) => {
        switch (status) {
            case "Pending": return "Chờ xác nhận";
            case "Confirmed": return "Đã xác nhận";
            case "Preparing": return "Đang chuẩn bị";
            case "Ready": return "Sẵn sàng giao";
            case "Delivering": return "Đang giao";
            case "Completed": return "Hoàn thành";
            case "Cancelled": return "Đã hủy";
            default: return status;
        }
    };
    
    Func<string, string> GetAssignmentStatusText = (status) => {
        switch (status) {
            case "Assigned": return "Đã gán";
            case "Accepted": return "Đã nhận";
            case "PickedUp": return "Đã lấy hàng";
            case "Delivering": return "Đang giao";
            case "Delivered": return "Đã giao";
            default: return status;
        }
    };
    
    var statusClass = GetStatusClass(Model.Order.Status);
    var statusText = GetStatusText(Model.Order.Status);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0"
                    },
                    fontFamily: { "display": ["Manrope", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        .timeline::before {
            content: '';
            position: absolute;
            left: 23px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: #e0e0e0;
        }
        .timeline-step { position: relative; padding-left: 60px; padding-bottom: 24px; }
        .timeline-step:last-child { padding-bottom: 0; }
        .timeline-step .step-icon {
            position: absolute;
            left: 8px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e0e0e0;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }
        .timeline-step.completed .step-icon { background: #22c55e; color: white; }
        .timeline-step.current .step-icon { background: #007bff; color: white; animation: pulse 2s infinite; }
        @@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(0,123,255,0.4); } 70% { box-shadow: 0 0 0 12px rgba(0,123,255,0); } }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-white/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Orders", "Delivery")" class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-2xl">receipt_long</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-text-primary">#@Model.Order.OrderCode</h1>
                            <p class="text-xs text-text-secondary">Chi tiết đơn hàng</p>
                        </div>
                    </a>
                </div>
                <div class="flex items-center gap-3">
                    <span class="px-4 py-2 rounded-full text-white font-semibold @statusClass">@statusText</span>
                    <a href="@Url.Action("Orders", "Delivery")" class="flex items-center gap-2 px-4 py-2 rounded-full border-2 border-gray-300 text-text-secondary hover:bg-gray-100 transition-all font-semibold">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Quay lại
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <section class="py-8">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Left Column -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Customer & Address Info -->
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="bg-gradient-to-r from-primary to-purple-600 p-6 text-white">
                            <h2 class="text-xl font-bold flex items-center gap-2">
                                <span class="material-symbols-outlined">info</span>
                                Thông Tin Đơn Hàng
                            </h2>
                        </div>
                        <div class="p-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h3 class="text-sm font-bold text-text-secondary mb-3 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary">person</span>
                                        KHÁCH HÀNG
                                    </h3>
                                    <p class="text-xl font-bold text-text-primary mb-2">@Model.Order.CustomerName</p>
                                    <p class="flex items-center gap-2 text-text-secondary mb-1">
                                        <span class="material-symbols-outlined text-green-500">call</span>
                                        @Model.Order.CustomerPhone
                                    </p>
                                    @if (!string.IsNullOrEmpty(Model.Order.CustomerEmail))
                                    {
                                        <p class="flex items-center gap-2 text-text-secondary">
                                            <span class="material-symbols-outlined text-blue-500">mail</span>
                                            @Model.Order.CustomerEmail
                                        </p>
                                    }
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-text-secondary mb-3 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-red-500">location_on</span>
                                        ĐỊA CHỈ GIAO HÀNG
                                    </h3>
                                    <p class="text-text-primary mb-1">@Model.Order.DeliveryAddress</p>
                                    <p class="text-text-secondary text-sm">
                                        @(Model.Order.Ward ?? ""), @(Model.Order.District ?? ""), @(Model.Order.City ?? "")
                                    </p>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.Order.Note))
                            {
                                <div class="mt-6 p-4 bg-yellow-50 rounded-2xl border border-yellow-200">
                                    <span class="material-symbols-outlined text-yellow-600 align-middle">sticky_note_2</span>
                                    <strong class="text-yellow-800">Ghi chú:</strong>
                                    <span class="text-yellow-700">@Model.Order.Note</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="p-6 border-b border-border-light">
                            <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary">restaurant</span>
                                Món Đã Đặt
                            </h2>
                        </div>
                        <div class="p-6 space-y-4">
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    <div class="flex justify-between items-center py-4 border-b border-border-light last:border-b-0">
                                        <div class="flex items-center gap-4">
                                            <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                                                <span class="material-symbols-outlined text-primary">lunch_dining</span>
                                            </div>
                                            <div>
                                                <p class="font-bold text-text-primary">@item.ItemName</p>
                                                <p class="text-sm text-text-secondary">@item.UnitPrice.ToString("N0")đ x @item.Quantity</p>
                                                @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                                {
                                                    <p class="text-xs text-blue-500 mt-1">
                                                        <span class="material-symbols-outlined text-xs align-middle">chat</span>
                                                        @item.SpecialInstructions
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                        <div class="font-bold text-lg text-text-primary">@item.Subtotal.ToString("N0")đ</div>
                                    </div>
                                }
                            }
                            
                            <!-- Summary -->
                            <div class="bg-sidebar-surface rounded-2xl p-4 mt-4 space-y-3">
                                <div class="flex justify-between text-text-secondary">
                                    <span>Tạm tính:</span>
                                    <span>@Model.Order.SubTotal.ToString("N0")đ</span>
                                </div>
                                <div class="flex justify-between text-text-secondary">
                                    <span>Phí giao hàng:</span>
                                    <span>@Model.Order.DeliveryFee.ToString("N0")đ</span>
                                </div>
                                @if (Model.Order.Discount > 0)
                                {
                                    <div class="flex justify-between text-green-600">
                                        <span>Giảm giá:</span>
                                        <span>-@Model.Order.Discount.ToString("N0")đ</span>
                                    </div>
                                }
                                <div class="flex justify-between text-xl font-bold pt-3 border-t border-border-light">
                                    <span>Tổng cộng:</span>
                                    <span class="text-green-600">@Model.Order.TotalAmount.ToString("N0")đ</span>
                                </div>
                            </div>
                            
                            <!-- Payment Info -->
                            <div class="flex items-center gap-3 p-4 bg-blue-50 rounded-2xl border border-blue-200">
                                <span class="material-symbols-outlined text-blue-600 text-2xl">payments</span>
                                <div>
                                    <span class="font-bold text-blue-800">@Model.Order.PaymentMethod</span>
                                    <span class="ml-2 px-2 py-1 rounded-full text-xs font-semibold @(Model.Order.PaymentStatus == "Paid" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">
                                        @(Model.Order.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="bg-white rounded-3xl shadow-xl p-6">
                        <h2 class="text-xl font-bold text-text-primary mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">settings</span>
                            Thao Tác
                        </h2>
                        <div class="flex flex-wrap gap-3">
                            @if (Model.Order.Status == "Pending")
                            {
                                <button onclick="confirmOrder()" class="flex items-center gap-2 px-6 py-3 bg-blue-500 text-white rounded-full font-semibold hover:bg-blue-600 transition-all">
                                    <span class="material-symbols-outlined">check</span>
                                    Xác nhận đơn
                                </button>
                            }
                            @if (Model.Order.Status == "Confirmed")
                            {
                                <button onclick="startPreparing()" class="flex items-center gap-2 px-6 py-3 bg-yellow-500 text-white rounded-full font-semibold hover:bg-yellow-600 transition-all">
                                    <span class="material-symbols-outlined">restaurant</span>
                                    Bắt đầu chuẩn bị
                                </button>
                            }
                            @if (Model.Order.Status == "Preparing")
                            {
                                <button onclick="markReady()" class="flex items-center gap-2 px-6 py-3 bg-indigo-500 text-white rounded-full font-semibold hover:bg-indigo-600 transition-all">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                    Sẵn sàng giao
                                </button>
                            }
                            @if ((Model.Order.Status == "Ready" || Model.Order.Status == "Confirmed") && Model.Assignment == null)
                            {
                                <button onclick="showAssignModal()" class="flex items-center gap-2 px-6 py-3 bg-green-500 text-white rounded-full font-semibold hover:bg-green-600 transition-all">
                                    <span class="material-symbols-outlined">person_add</span>
                                    Gán Shipper
                                </button>
                            }
                            @if (Model.Order.Status != "Completed" && Model.Order.Status != "Cancelled" && Model.Order.Status != "Delivering")
                            {
                                <button onclick="cancelOrder()" class="flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-full font-semibold hover:bg-red-600 transition-all">
                                    <span class="material-symbols-outlined">close</span>
                                    Hủy đơn
                                </button>
                            }
                            <button onclick="window.print()" class="flex items-center gap-2 px-6 py-3 border-2 border-gray-300 text-text-secondary rounded-full font-semibold hover:bg-gray-100 transition-all">
                                <span class="material-symbols-outlined">print</span>
                                In đơn
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="space-y-6">
                    <!-- Shipper Info -->
                    @if (Model.Shipper != null)
                    {
                        <div class="bg-gradient-to-br from-green-500 to-teal-500 rounded-3xl shadow-xl p-6 text-white">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center text-2xl font-bold">
                                    @Model.Shipper.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold">@Model.Shipper.FullName</h3>
                                    <p class="text-white/80">Shipper</p>
                                </div>
                            </div>
                            <div class="space-y-2 text-sm">
                                <p class="flex items-center gap-2">
                                    <span class="material-symbols-outlined">call</span>
                                    @Model.Shipper.Phone
                                </p>
                                <p class="flex items-center gap-2">
                                    <span class="material-symbols-outlined">two_wheeler</span>
                                    @(Model.Shipper.VehicleType ?? "Xe máy")
                                </p>
                                <p class="flex items-center gap-2">
                                    <span class="material-symbols-outlined">star</span>
                                    @Model.Shipper.Rating.ToString("F1")
                                </p>
                            </div>
                            @if (Model.Assignment != null)
                            {
                                <div class="mt-4 pt-4 border-t border-white/20 space-y-2">
                                    <div class="flex justify-between">
                                        <span>Trạng thái:</span>
                                        <strong>@GetAssignmentStatusText(Model.Assignment.Status)</strong>
                                    </div>
                                    if (Model.Assignment.EstimatedArrival.HasValue)
                                    {
                                        <div class="flex justify-between">
                                            <span>Dự kiến giao:</span>
                                            <strong>@Model.Assignment.EstimatedArrival.Value.ToString("HH:mm")</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (Model.Order.Status == "Ready" || Model.Order.Status == "Confirmed")
                    {
                        <div class="bg-white rounded-3xl shadow-xl p-6 text-center border-2 border-dashed border-yellow-400">
                            <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <span class="material-symbols-outlined text-yellow-600 text-3xl">hourglass_top</span>
                            </div>
                            <h3 class="text-lg font-bold text-text-primary mb-2">Chưa có shipper</h3>
                            <p class="text-text-secondary text-sm mb-4">Gán shipper để bắt đầu giao hàng</p>
                            <button onclick="showAssignModal()" class="w-full py-3 bg-green-500 text-white rounded-full font-bold hover:bg-green-600 transition-all">
                                <span class="material-symbols-outlined align-middle mr-2">person_add</span>
                                Gán Shipper
                            </button>
                        </div>
                    }

                    <!-- Timeline -->
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="p-6 border-b border-border-light">
                            <h2 class="text-lg font-bold text-text-primary flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary">history</span>
                                Lịch Sử Đơn Hàng
                            </h2>
                        </div>
                        <div class="p-6">
                            <div class="timeline relative">
                                @foreach (var step in Model.TrackingSteps)
                                {
                                    var stepClass = step.IsCompleted ? "completed" : (step.IsCurrent ? "current" : "");
                                    <div class="timeline-step @stepClass">
                                        <div class="step-icon">
                                            <span class="material-symbols-outlined text-lg">@step.Icon</span>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-text-primary @(step.IsCompleted || step.IsCurrent ? "" : "text-text-secondary")">
                                                @step.Title
                                            </h4>
                                            <p class="text-sm text-text-secondary">@step.Description</p>
                                            @if (step.Time.HasValue)
                                            {
                                                <p class="text-xs text-primary mt-1">
                                                    <span class="material-symbols-outlined text-xs align-middle">schedule</span>
                                                    @step.Time.Value.ToString("HH:mm dd/MM/yyyy")
                                                </p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Time Info -->
                    <div class="bg-white rounded-3xl shadow-xl p-6">
                        <h2 class="text-lg font-bold text-text-primary mb-4 flex items-center gap-2">
                            <span class="material-symbols-outlined text-indigo-500">schedule</span>
                            Thời Gian
                        </h2>
                        <div class="space-y-3">
                            <div class="flex justify-between">
                                <span class="text-text-secondary">Đặt hàng:</span>
                                <strong>@Model.Order.OrderDate.ToString("HH:mm dd/MM")</strong>
                            </div>
                            @if (Model.Order.EstimatedDeliveryTime.HasValue)
                            {
                                <div class="flex justify-between">
                                    <span class="text-text-secondary">Dự kiến giao:</span>
                                    <strong class="text-primary">@Model.Order.EstimatedDeliveryTime.Value.ToString("HH:mm dd/MM")</strong>
                                </div>
                            }
                            @if (Model.Order.CompletedDate.HasValue)
                            {
                                <div class="flex justify-between">
                                    <span class="text-text-secondary">Hoàn thành:</span>
                                    <strong class="text-green-600">@Model.Order.CompletedDate.Value.ToString("HH:mm dd/MM")</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Assign Shipper Modal -->
    <div id="assignModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
            <div class="bg-gradient-to-r from-green-500 to-teal-500 p-6 text-white">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined">person_add</span>
                    Gán Shipper
                </h3>
            </div>
            <div class="p-6 space-y-3 max-h-80 overflow-y-auto">
                @if (availableShippers.Any())
                {
                    foreach (var shipper in availableShippers)
                    {
                        <button onclick="assignShipper(@shipper.Id)" class="w-full flex items-center gap-4 p-4 rounded-2xl bg-sidebar-surface hover:bg-green-50 transition-all text-left">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-purple-500 flex items-center justify-center text-white font-bold">
                                @shipper.FullName.Substring(0, 1)
                            </div>
                            <div class="flex-1">
                                <div class="font-bold text-text-primary">@shipper.FullName</div>
                                <div class="text-sm text-text-secondary">@shipper.Phone | @(shipper.VehicleType ?? "Xe máy")</div>
                            </div>
                            <div class="text-right">
                                <div class="text-yellow-500 font-bold">★ @shipper.Rating.ToString("F1")</div>
                                <div class="text-xs text-text-secondary">@shipper.TotalDeliveries đơn</div>
                            </div>
                        </button>
                    }
                }
                else
                {
                    <p class="text-center text-text-secondary py-8">Không có shipper khả dụng</p>
                }
            </div>
            <div class="p-6 border-t border-border-light flex gap-3">
                <button onclick="closeAssignModal()" class="flex-1 py-3 rounded-full border-2 border-gray-300 text-text-secondary font-semibold hover:bg-gray-100 transition-all">
                    Đóng
                </button>
                <button onclick="autoAssign()" class="flex-1 py-3 rounded-full bg-primary text-white font-semibold hover:bg-blue-700 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">auto_fix_high</span>
                    Tự động
                </button>
            </div>
        </div>
    </div>

    <script>
        var orderId = @Model.Order.Id;

        function confirmOrder() {
            if (!confirm('Xác nhận đơn hàng này?')) return;
            postAction('@Url.Action("ConfirmOrder", "Delivery")', { orderId: orderId });
        }

        function startPreparing() {
            if (!confirm('Bắt đầu chuẩn bị?')) return;
            postAction('@Url.Action("StartPreparing", "Delivery")', { orderId: orderId });
        }

        function markReady() {
            if (!confirm('Đánh dấu sẵn sàng giao?')) return;
            postAction('@Url.Action("MarkReady", "Delivery")', { orderId: orderId });
        }

        function cancelOrder() {
            var reason = prompt('Nhập lý do hủy đơn:');
            if (!reason) return;
            postAction('@Url.Action("CancelOrder", "Delivery")', { orderId: orderId, reason: reason });
        }

        function showAssignModal() {
            document.getElementById('assignModal').classList.remove('hidden');
            document.getElementById('assignModal').classList.add('flex');
        }

        function closeAssignModal() {
            document.getElementById('assignModal').classList.add('hidden');
            document.getElementById('assignModal').classList.remove('flex');
        }

        function assignShipper(shipperId) {
            postAction('@Url.Action("AssignShipper", "Delivery")', { orderId: orderId, shipperId: shipperId });
        }

        function autoAssign() {
            postAction('@Url.Action("AutoAssign", "Delivery")', { orderId: orderId });
        }

        function postAction(url, data) {
            var body = Object.keys(data).map(k => k + '=' + encodeURIComponent(data[k])).join('&');
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            })
            .then(r => r.json())
            .then(res => {
                alert(res.message || res.Message);
                if (res.success || res.Success) location.reload();
            })
            .catch(err => alert('Có lỗi xảy ra'));
        }
    </script>
</body>
</html>
