@model List<NhaHangLDP.Data.Entities.DeliveryZone>
@{
    ViewBag.Title = "Khu Vực Giao Hàng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà Hàng LDP</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0"
                    },
                    fontFamily: { "display": ["Manrope", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        .zone-card { transition: all 0.3s ease; }
        .zone-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-white/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Index", "Delivery")" class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-full bg-yellow-500 flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-2xl">location_on</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-text-primary">KHU VỰC</h1>
                            <p class="text-xs text-text-secondary">Delivery Zones</p>
                        </div>
                    </a>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Dashboard</a>
                    <a href="@Url.Action("Orders", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Đơn hàng</a>
                    <a href="@Url.Action("Shippers", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Shipper</a>
                    <a href="@Url.Action("Zones", "Delivery")" class="text-primary font-semibold border-b-2 border-primary pb-1">Khu vực</a>
                </div>
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Index", "Delivery")" class="flex items-center gap-2 px-4 py-2 rounded-full border-2 border-gray-300 text-text-secondary hover:bg-gray-100 transition-all font-semibold">
                        <span class="material-symbols-outlined text-lg">arrow_back</span>
                        Quay lại
                    </a>
                    <button onclick="openCreateModal()" class="flex items-center gap-2 px-6 py-2 bg-yellow-500 rounded-full text-white hover:bg-yellow-600 transition-all font-bold shadow-lg">
                        <span class="material-symbols-outlined text-lg">add_location</span>
                        Thêm Khu Vực
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-yellow-500 to-orange-500 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <h1 class="text-3xl md:text-4xl font-black text-white mb-2">
                <span class="material-symbols-outlined text-4xl align-middle mr-2">map</span>
                Khu Vực Giao Hàng
            </h1>
            <p class="text-white/80">Quản lý phí giao hàng theo khu vực</p>
        </div>
    </section>

    <!-- Zone List -->
    <section class="py-8">
        <div class="max-w-7xl mx-auto px-6">
            @if (Model != null && Model.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    @foreach (var zone in Model)
                    {
                        <div class="zone-card bg-white rounded-3xl shadow-lg overflow-hidden @(zone.IsActive ? "" : "opacity-60")">
                            <!-- Header -->
                            <div class="bg-gradient-to-r from-yellow-500 to-orange-500 p-6 relative">
                                <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto">
                                    <span class="material-symbols-outlined text-white text-3xl">pin_drop</span>
                                </div>
                                @if (!zone.IsActive)
                                {
                                    <div class="absolute top-4 right-4">
                                        <span class="px-2 py-1 rounded-full bg-gray-700 text-white text-xs font-semibold">Tạm ngưng</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Content -->
                            <div class="p-6">
                                <h3 class="text-xl font-bold text-text-primary text-center mb-1">@zone.ZoneName</h3>
                                <p class="text-text-secondary text-sm text-center mb-4">
                                    @zone.District @(!string.IsNullOrEmpty(zone.Ward) ? ", " + zone.Ward : "")
                                </p>

                                <!-- Fee -->
                                <div class="text-center mb-4">
                                    <span class="text-3xl font-black text-green-600">@zone.DeliveryFee.ToString("N0")đ</span>
                                    <p class="text-xs text-text-secondary">Phí giao hàng</p>
                                </div>

                                <!-- Info -->
                                <div class="space-y-2 text-sm mb-4">
                                    <div class="flex items-center gap-2 text-text-secondary">
                                        <span class="material-symbols-outlined text-blue-500 text-lg">schedule</span>
                                        <span>~@zone.EstimatedTime phút</span>
                                    </div>
                                    @if (zone.MinOrderForFreeDelivery > 0)
                                    {
                                        <div class="flex items-center gap-2 text-text-secondary">
                                            <span class="material-symbols-outlined text-green-500 text-lg">redeem</span>
                                            <span>Miễn phí từ: @zone.MinOrderForFreeDelivery.ToString("N0")đ</span>
                                        </div>
                                    }
                                    @if (zone.MaxDistance.HasValue)
                                    {
                                        <div class="flex items-center gap-2 text-text-secondary">
                                            <span class="material-symbols-outlined text-yellow-500 text-lg">route</span>
                                            <span>Khoảng cách: @zone.MaxDistance km</span>
                                        </div>
                                    }
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2">
                                    <button onclick="openEditModal(@zone.Id)" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold text-sm">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                        Sửa
                                    </button>
                                    <button onclick="deleteZone(@zone.Id)" class="w-12 h-12 rounded-xl border-2 border-red-300 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-3xl shadow-xl p-16 text-center">
                    <div class="w-32 h-32 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="material-symbols-outlined text-yellow-500 text-6xl">add_location</span>
                    </div>
                    <h3 class="text-2xl font-bold text-text-secondary mb-2">Chưa có khu vực giao hàng</h3>
                    <p class="text-text-secondary mb-6">Thêm khu vực để thiết lập phí giao hàng</p>
                    <button onclick="openCreateModal()" class="inline-flex items-center gap-2 px-8 py-4 bg-yellow-500 text-white rounded-full font-bold text-lg hover:bg-yellow-600 transition-all shadow-lg">
                        <span class="material-symbols-outlined">add_location</span>
                        Thêm Khu Vực Đầu Tiên
                    </button>
                </div>
            }
        </div>
    </section>

    <!-- Zone Modal -->
    <div id="zoneModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden max-h-[90vh] overflow-y-auto">
            <div class="bg-gradient-to-r from-yellow-500 to-orange-500 p-6 text-white sticky top-0">
                <h3 class="text-xl font-bold flex items-center gap-2" id="zoneModalTitle">
                    <span class="material-symbols-outlined">add_location</span>
                    Thêm Khu Vực
                </h3>
            </div>
            <div class="p-6 space-y-4">
                <input type="hidden" id="zoneId" value="0">
                
                <div>
                    <label class="flex items-center gap-2 text-sm font-bold text-text-primary mb-2">
                        <span class="material-symbols-outlined text-yellow-500 text-lg">label</span>
                        Tên khu vực <span class="text-red-500">*</span>
                    </label>
                    <input type="text" id="zoneName" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" placeholder="VD: Khu vực nội thành">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Quận/Huyện <span class="text-red-500">*</span></label>
                        <input type="text" id="zoneDistrict" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" placeholder="VD: Quận 1">
                    </div>
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Phường/Xã</label>
                        <input type="text" id="zoneWard" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" placeholder="Để trống = toàn quận">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Phí giao hàng (đ) <span class="text-red-500">*</span></label>
                        <input type="number" id="zoneDeliveryFee" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" value="25000" min="0" step="1000">
                    </div>
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Thời gian giao (phút)</label>
                        <input type="number" id="zoneEstimatedTime" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" value="30" min="5">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Miễn phí từ (đ)</label>
                        <input type="number" id="zoneMinOrderFree" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" value="0" min="0" step="10000">
                        <p class="text-xs text-text-secondary mt-1">0 = không miễn phí</p>
                    </div>
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Khoảng cách tối đa (km)</label>
                        <input type="number" id="zoneMaxDistance" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" placeholder="Không giới hạn" min="0" step="0.5">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm font-bold text-text-primary mb-2 block">Thứ tự hiển thị</label>
                        <input type="number" id="zoneDisplayOrder" class="w-full px-4 py-3 rounded-xl border-2 border-border-light focus:border-primary focus:outline-none transition-colors" value="0" min="0">
                    </div>
                    <div class="flex items-center gap-4 pt-6">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="zoneIsActive" class="sr-only peer" checked>
                            <div class="w-14 h-7 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-green-500"></div>
                        </label>
                        <span class="font-semibold">Đang hoạt động</span>
                    </div>
                </div>
            </div>
            <div class="p-6 border-t border-border-light flex gap-3 sticky bottom-0 bg-white">
                <button onclick="closeModal()" class="flex-1 py-3 rounded-full border-2 border-gray-300 text-text-secondary font-semibold hover:bg-gray-100 transition-all">
                    Đóng
                </button>
                <button onclick="saveZone()" class="flex-1 py-3 rounded-full bg-yellow-500 text-white font-semibold hover:bg-yellow-600 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">save</span>
                    Lưu
                </button>
            </div>
        </div>
    </div>

    <script>
        var zones = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model ?? new List<NhaHangLDP.Data.Entities.DeliveryZone>()));

        function openCreateModal() {
            document.getElementById('zoneModalTitle').innerHTML = '<span class="material-symbols-outlined">add_location</span> Thêm Khu Vực';
            document.getElementById('zoneId').value = '0';
            document.getElementById('zoneName').value = '';
            document.getElementById('zoneDistrict').value = '';
            document.getElementById('zoneWard').value = '';
            document.getElementById('zoneDeliveryFee').value = '25000';
            document.getElementById('zoneEstimatedTime').value = '30';
            document.getElementById('zoneMinOrderFree').value = '0';
            document.getElementById('zoneMaxDistance').value = '';
            document.getElementById('zoneDisplayOrder').value = '0';
            document.getElementById('zoneIsActive').checked = true;
            showModal();
        }

        function openEditModal(id) {
            var zone = zones.find(z => z.Id === id);
            if (!zone) return;

            document.getElementById('zoneModalTitle').innerHTML = '<span class="material-symbols-outlined">edit_location</span> Sửa Khu Vực';
            document.getElementById('zoneId').value = zone.Id;
            document.getElementById('zoneName').value = zone.ZoneName;
            document.getElementById('zoneDistrict').value = zone.District;
            document.getElementById('zoneWard').value = zone.Ward || "";
            document.getElementById('zoneDeliveryFee').value = zone.DeliveryFee;
            document.getElementById('zoneEstimatedTime').value = zone.EstimatedTime;
            document.getElementById('zoneMinOrderFree').value = zone.MinOrderForFreeDelivery;
            document.getElementById('zoneMaxDistance').value = zone.MaxDistance || "";
            document.getElementById('zoneDisplayOrder').value = zone.DisplayOrder;
            document.getElementById('zoneIsActive').checked = zone.IsActive;
            showModal();
        }

        function showModal() {
            document.getElementById('zoneModal').classList.remove('hidden');
            document.getElementById('zoneModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('zoneModal').classList.add('hidden');
            document.getElementById('zoneModal').classList.remove('flex');
        }

        function saveZone() {
            var id = parseInt(document.getElementById('zoneId').value);
            var zoneName = document.getElementById('zoneName').value.trim();
            var district = document.getElementById('zoneDistrict').value.trim();

            if (!zoneName || !district) {
                alert('Vui lòng nhập tên khu vực và quận/huyện');
                return;
            }

            var data = {
                Id: id,
                ZoneName: zoneName,
                District: district,
                Ward: document.getElementById('zoneWard').value.trim(),
                DeliveryFee: parseFloat(document.getElementById('zoneDeliveryFee').value) || 0,
                EstimatedTime: parseInt(document.getElementById('zoneEstimatedTime').value) || 30,
                MinOrderForFreeDelivery: parseFloat(document.getElementById('zoneMinOrderFree').value) || 0,
                MaxDistance: parseFloat(document.getElementById('zoneMaxDistance').value) || null,
                DisplayOrder: parseInt(document.getElementById('zoneDisplayOrder').value) || 0,
                IsActive: document.getElementById('zoneIsActive').checked
            };

            var url = id > 0 ? '@Url.Action("UpdateZone", "Delivery")' : '@Url.Action("CreateZone", "Delivery")';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(res => {
                alert(res.message);
                if (res.success) location.reload();
            })
            .catch(err => alert('Có lỗi xảy ra'));
        }

        function deleteZone(id) {
            if (!confirm('Bạn có chắc muốn xóa khu vực này?')) return;

            fetch('@Url.Action("DeleteZone", "Delivery")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(r => r.json())
            .then(res => {
                alert(res.message);
                if (res.success) location.reload();
            });
        }
    </script>
</body>
</html>
