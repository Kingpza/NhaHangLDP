@model NhaHangLDP.Models.ShipperManagementViewModel
@{
    ViewBag.Title = "Quản Lý Shipper";
    Layout = null;
    
    Func<string, string> GetStatusClass = (status) => {
        switch (status) {
            case "Available": return "bg-green-500";
            case "Busy": return "bg-yellow-500";
            default: return "bg-gray-400";
        }
    };
    
    Func<string, string> GetStatusText = (status) => {
        switch (status) {
            case "Available": return "Sẵn sàng";
            case "Busy": return "Đang giao";
            default: return "Offline";
        }
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title - Nhà hàng Hỷ Lạc Hotpot</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0"
                    },
                    fontFamily: { "display": ["Manrope", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        .shipper-card { transition: all 0.3s ease; }
        .shipper-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .stat-card { transition: all 0.3s ease; }
        .stat-card:hover { transform: translateY(-4px); }
        @@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .animate-pulse-dot { animation: pulse-dot 2s infinite; }
    </style>
</head>
<body class="bg-sidebar-surface font-display text-text-primary min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-white/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Index", "Delivery")" class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-2xl">local_shipping</span>
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-text-primary">GIAO HÀNG</h1>
                            <p class="text-xs text-text-secondary">Delivery Management</p>
                        </div>
                    </a>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Dashboard</a>
                    <a href="@Url.Action("Management", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Quản lý giao hàng</a>
                    <a href="@Url.Action("Orders", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Đơn hàng</a>
                    <a href="@Url.Action("Shippers", "Delivery")" class="text-primary font-semibold border-b-2 border-primary pb-1">Shipper</a>
                    <a href="@Url.Action("Tracking", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Theo dõi</a>
                    <a href="@Url.Action("FeeSettings", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Cài đặt phí</a>
                    <a href="@Url.Action("Statistics", "Delivery")" class="text-text-primary hover:text-primary transition-colors">Thống kê</a>
                </div>
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("CreateShipper", "Delivery")" class="flex items-center gap-2 px-6 py-2 bg-green-500 rounded-full text-white hover:bg-green-600 transition-all font-bold shadow-lg">
                        <span class="material-symbols-outlined text-lg">person_add</span>
                        Thêm Shipper
                    </a>
                    <a href="@Url.Action("Dashboard", "Management")" class="flex items-center gap-2 px-6 py-2 bg-primary rounded-full text-white hover:bg-blue-700 transition-all font-bold shadow-lg">
                        <span class="material-symbols-outlined text-lg">dashboard</span>
                        Quản lý
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="bg-gradient-to-r from-green-500 to-teal-500 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <h1 class="text-3xl md:text-4xl font-black text-white mb-2">
                <span class="material-symbols-outlined text-4xl align-middle mr-2">groups</span>
                Quản Lý Shipper
            </h1>
            <p class="text-white/80">Quản lý đội ngũ shipper giao hàng</p>
        </div>
    </section>

    <!-- Statistics -->
    <section class="py-8 -mt-8">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="stat-card bg-white rounded-2xl p-6 shadow-xl text-center">
                    <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-blue-600 text-2xl">groups</span>
                    </div>
                    <h3 class="text-3xl font-black text-blue-600">@Model.TotalActive</h3>
                    <p class="text-text-secondary text-sm">Tổng shipper</p>
                </div>
                <div class="stat-card bg-white rounded-2xl p-6 shadow-xl text-center">
                    <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-green-600 text-2xl">check_circle</span>
                    </div>
                    <h3 class="text-3xl font-black text-green-600">@Model.TotalAvailable</h3>
                    <p class="text-text-secondary text-sm">Sẵn sàng</p>
                </div>
                <div class="stat-card bg-white rounded-2xl p-6 shadow-xl text-center">
                    <div class="w-14 h-14 bg-yellow-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-yellow-600 text-2xl">two_wheeler</span>
                    </div>
                    <h3 class="text-3xl font-black text-yellow-600">@Model.TotalBusy</h3>
                    <p class="text-text-secondary text-sm">Đang giao</p>
                </div>
                <div class="stat-card bg-white rounded-2xl p-6 shadow-xl text-center">
                    <div class="w-14 h-14 bg-gray-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-gray-500 text-2xl">bedtime</span>
                    </div>
                    <h3 class="text-3xl font-black text-gray-500">@Model.TotalOffline</h3>
                    <p class="text-text-secondary text-sm">Offline</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Shipper List -->
    <section class="py-8">
        <div class="max-w-7xl mx-auto px-6">
            @if (Model.Shippers != null && Model.Shippers.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    @foreach (var shipper in Model.Shippers)
                    {
                        var statusClass = GetStatusClass(shipper.Status);
                        var statusText = GetStatusText(shipper.Status);
                        
                        <div class="shipper-card bg-white rounded-3xl shadow-lg overflow-hidden @(shipper.IsActive ? "" : "opacity-60")">
                            <!-- Header with avatar -->
                            <div class="bg-gradient-to-r from-primary to-purple-600 p-6 relative">
                                <div class="w-20 h-20 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto border-4 border-white/30">
                                    <span class="text-white text-3xl font-black">@shipper.FullName.Substring(0, 1).ToUpper()</span>
                                </div>
                                <!-- Status badge -->
                                <div class="absolute top-4 right-4">
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-white text-xs font-semibold @statusClass">
                                        <span class="w-2 h-2 rounded-full bg-white @(shipper.Status == "Available" ? "animate-pulse-dot" : "")"></span>
                                        @statusText
                                    </span>
                                </div>
                                @if (!shipper.IsActive)
                                {
                                    <div class="absolute top-4 left-4">
                                        <span class="px-2 py-1 rounded-full bg-red-500 text-white text-xs font-semibold">Vô hiệu</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Info -->
                            <div class="p-6">
                                <h3 class="text-xl font-bold text-text-primary text-center mb-4">@shipper.FullName</h3>
                                
                                <div class="space-y-3 text-sm">
                                    <div class="flex items-center gap-3 text-text-secondary">
                                        <span class="material-symbols-outlined text-primary">call</span>
                                        <span>@shipper.Phone</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(shipper.Email))
                                    {
                                        <div class="flex items-center gap-3 text-text-secondary">
                                            <span class="material-symbols-outlined text-primary">mail</span>
                                            <span class="truncate">@shipper.Email</span>
                                        </div>
                                    }
                                    <div class="flex items-center gap-3 text-text-secondary">
                                        <span class="material-symbols-outlined text-primary">two_wheeler</span>
                                        <span>@(shipper.VehicleType ?? "Xe máy") @(!string.IsNullOrEmpty(shipper.LicensePlate) ? $"- {shipper.LicensePlate}" : "")</span>
                                    </div>
                                </div>

                                <!-- Stats -->
                                <div class="grid grid-cols-3 gap-4 mt-6 pt-4 border-t border-border-light text-center">
                                    <div>
                                        <div class="text-yellow-500 font-bold text-lg">★ @shipper.Rating.ToString("F1")</div>
                                        <div class="text-xs text-text-secondary">Đánh giá</div>
                                    </div>
                                    <div>
                                        <div class="text-primary font-bold text-lg">@shipper.TotalDeliveries</div>
                                        <div class="text-xs text-text-secondary">Đơn giao</div>
                                    </div>
                                    <div>
                                        <div class="text-green-600 font-bold text-sm">@(shipper.TotalEarnings > 1000000 ? (shipper.TotalEarnings / 1000000).ToString("F1") + "M" : shipper.TotalEarnings.ToString("N0"))</div>
                                        <div class="text-xs text-text-secondary">Thu nhập</div>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 mt-6">
                                    <a href="@Url.Action("EditShipper", "Delivery", new { id = shipper.Id })" 
                                       class="flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold text-sm">
                                        <span class="material-symbols-outlined text-lg">edit</span>
                                        Sửa
                                    </a>
                                    @if (shipper.IsActive)
                                    {
                                        <div class="relative group">
                                            <button class="w-12 h-12 rounded-xl border-2 border-gray-300 text-text-secondary hover:bg-gray-100 transition-all flex items-center justify-center">
                                                <span class="material-symbols-outlined">more_vert</span>
                                            </button>
                                            <div class="absolute right-0 bottom-full mb-2 hidden group-hover:block bg-white rounded-xl shadow-xl border border-border-light overflow-hidden min-w-[160px]">
                                                @if (shipper.Status != "Available")
                                                {
                                                    <button onclick="updateStatus(@shipper.Id, 'Available')" class="w-full flex items-center gap-2 px-4 py-3 hover:bg-green-50 text-green-600 text-sm">
                                                        <span class="material-symbols-outlined text-lg">check_circle</span>
                                                        Đặt sẵn sàng
                                                    </button>
                                                }
                                                @if (shipper.Status != "Offline")
                                                {
                                                    <button onclick="updateStatus(@shipper.Id, 'Offline')" class="w-full flex items-center gap-2 px-4 py-3 hover:bg-gray-50 text-gray-600 text-sm">
                                                        <span class="material-symbols-outlined text-lg">bedtime</span>
                                                        Đặt offline
                                                    </button>
                                                }
                                                <button onclick="deleteShipper(@shipper.Id)" class="w-full flex items-center gap-2 px-4 py-3 hover:bg-red-50 text-red-600 text-sm border-t border-border-light">
                                                    <span class="material-symbols-outlined text-lg">delete</span>
                                                    Vô hiệu hóa
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-3xl shadow-xl p-16 text-center">
                    <div class="w-32 h-32 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <span class="material-symbols-outlined text-gray-400 text-6xl">person_off</span>
                    </div>
                    <h3 class="text-2xl font-bold text-text-secondary mb-2">Chưa có shipper nào</h3>
                    <p class="text-text-secondary mb-6">Thêm shipper để bắt đầu quản lý giao hàng</p>
                    <a href="@Url.Action("CreateShipper", "Delivery")" class="inline-flex items-center gap-2 px-8 py-4 bg-green-500 text-white rounded-full font-bold text-lg hover:bg-green-600 transition-all shadow-lg">
                        <span class="material-symbols-outlined">person_add</span>
                        Thêm Shipper Đầu Tiên
                    </a>
                </div>
            }
        </div>
    </section>

    <script>
        function updateStatus(shipperId, status) {
            fetch('@Url.Action("UpdateShipperStatus", "Delivery")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${shipperId}&status=${status}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Lỗi: ' + data.message);
            });
        }

        function deleteShipper(shipperId) {
            if (!confirm('Bạn có chắc muốn vô hiệu hóa shipper này?')) return;
            
            fetch('@Url.Action("DeleteShipper", "Delivery")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + shipperId
            })
            .then(r => r.json())
            .then(data => {
                alert(data.message);
                if (data.success) location.reload();
            });
        }
    </script>
</body>
</html>
