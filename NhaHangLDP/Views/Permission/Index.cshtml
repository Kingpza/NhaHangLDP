@model NhaHangLDP.Models.PermissionManagementViewModel
@{
    ViewBag.Title = "Quản Lý Phân Quyền";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <style>
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 22px;
        }
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc;
            transition: 0.3s;
            border-radius: 22px;
        }
        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }
        input:checked + .toggle-slider {
            background-color: #3b82f6;
        }
        input:checked + .toggle-slider:before {
            transform: translateX(18px);
        }

        .permission-tab {
            padding: 12px 24px;
            border-radius: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .permission-tab.active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: #fff !important;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }

        .permission-tab:not(.active):hover {
            background: #f0f4f8;
        }
    </style>
}

<div class="container-fluid"
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">
                                <i class="fas fa-shield-alt me-2" style="color: var(--primary-blue);"></i>Quản Lý Phân Quyền
                            </h4>
                            <p class="text-muted mb-0" style="font-size: 14px;">Thiết lập quyền truy cập cho từng vai trò trong hệ thống</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="stat-icon me-3" style="background: rgba(59, 130, 246, 0.1);">
                                <i class="fas fa-user-tag" style="color: #3b82f6;"></i>
                            </div>
                            <div>
                                <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.Roles.Count</h3>
                                <p class="text-muted mb-0" style="font-size: 14px;">Vai trò</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="stat-icon me-3" style="background: rgba(34, 197, 94, 0.1);">
                                <i class="fas fa-file-alt" style="color: #22c55e;"></i>
                            </div>
                            <div>
                                <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.AvailablePages.Count</h3>
                                <p class="text-muted mb-0" style="font-size: 14px;">Trang chức năng</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex align-items-center">
                            <div class="stat-icon me-3" style="background: rgba(245, 158, 11, 0.1);">
                                <i class="fas fa-users" style="color: #f59e0b;"></i>
                            </div>
                            <div>
                                <h3 class="mb-1" style="color: var(--primary-dark); font-weight: 700;">@Model.Roles.Sum(r => r.AccountCount)</h3>
                                <p class="text-muted mb-0" style="font-size: 14px;">Tài khoản</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Permission Management Card -->
            <div class="card border-0 shadow-sm">
                <!-- Tab Navigation -->
                <div class="card-header bg-white border-bottom">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        @for (int i = 0; i < Model.Roles.Count; i++)
                        {
                            var role = Model.Roles[i];
                            var roleColorClass = role.RoleName == "Admin" ? "text-danger" :
                                                 role.RoleName == "Manager" ? "text-primary" :
                                                 role.RoleName == "Cashier" ? "text-success" :
                                                 role.RoleName == "Delivery" ? "text-purple" : "text-secondary";
                            <li class="nav-item">
                                <a class="nav-link permission-tab @(i == 0 ? "active" : "")" 
                                   id="tab-@role.RoleId" 
                                   data-bs-toggle="tab" 
                                   href="#content-@role.RoleId" 
                                   role="tab">
                                    <span class="@roleColorClass fw-bold">@role.RoleName</span>
                                    <span class="badge bg-light text-dark ms-2">@role.AccountCount</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Tab Content -->
                <div class="tab-content card-body">
                    @foreach (var role in Model.Roles)
                    {
                        <div class="tab-pane fade @(role == Model.Roles.First() ? "show active" : "")" 
                             id="content-@role.RoleId" 
                             role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <h5 class="mb-1" style="color: var(--primary-dark); font-weight: 600;">Quyền của vai trò: @role.RoleName</h5>
                                    <p class="text-muted mb-0" style="font-size: 13px;">@role.AccountCount tài khoản đang sử dụng vai trò này</p>
                                </div>
                                <button onclick="saveAllPermissions(@role.RoleId)" 
                                        class="btn btn-primary-custom">
                                    <i class="fas fa-save me-2"></i>Lưu thay đổi
                                </button>
                            </div>

                            <!-- Permission Table -->
                            <div class="table-responsive">
                                <table class="table table-custom">
                                    <thead>
                                        <tr>
                                            <th style="width: 40%;">Trang / Chức năng</th>
                                            <th class="text-center" style="width: 15%;">
                                                <i class="fas fa-eye me-1"></i> Xem
                                            </th>
                                            <th class="text-center" style="width: 15%;">
                                                <i class="fas fa-plus-circle me-1"></i> Thêm
                                            </th>
                                            <th class="text-center" style="width: 15%;">
                                                <i class="fas fa-edit me-1"></i> Sửa
                                            </th>
                                            <th class="text-center" style="width: 15%;">
                                                <i class="fas fa-trash me-1"></i> Xóa
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var categories = Model.AvailablePages.Select(p => p.Category).Distinct();
                                        }
                                        @foreach (var category in categories)
                                        {
                                            <tr>
                                                <td colspan="5" class="pt-3 pb-2">
                                                    <span class="text-uppercase fw-bold" style="font-size: 11px; color: #94a3b8; letter-spacing: 0.5px;">@category</span>
                                                </td>
                                            </tr>
                                            foreach (var page in Model.AvailablePages.Where(p => p.Category == category))
                                            {
                                                var perm = role.Permissions.FirstOrDefault(p => p.Controller == page.Controller && p.ActionName == page.ActionName);
                                                var canView = perm?.CanView ?? false;
                                                var canAdd = perm?.CanAdd ?? false;
                                                var canEdit = perm?.CanEdit ?? false;
                                                var canDelete = perm?.CanDelete ?? false;

                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-@page.Icon me-2 text-muted"></i>
                                                            <span style="font-weight: 500; color: var(--text-dark);">@page.DisplayName</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="toggle-switch">
                                                            <input type="checkbox" class="perm-checkbox" 
                                                                   data-role="@role.RoleId" data-controller="@page.Controller" 
                                                                   data-action="@page.ActionName" data-type="view"
                                                                   @(canView ? "checked" : "") />
                                                            <span class="toggle-slider"></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="toggle-switch">
                                                            <input type="checkbox" class="perm-checkbox"
                                                                   data-role="@role.RoleId" data-controller="@page.Controller"
                                                                   data-action="@page.ActionName" data-type="add"
                                                                   @(canAdd ? "checked" : "") />
                                                            <span class="toggle-slider"></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="toggle-switch">
                                                            <input type="checkbox" class="perm-checkbox"
                                                                   data-role="@role.RoleId" data-controller="@page.Controller"
                                                                   data-action="@page.ActionName" data-type="edit"
                                                                   @(canEdit ? "checked" : "") />
                                                            <span class="toggle-slider"></span>
                                                        </label>
                                                    </td>
                                                    <td class="text-center">
                                                        <label class="toggle-switch">
                                                            <input type="checkbox" class="perm-checkbox"
                                                                   data-role="@role.RoleId" data-controller="@page.Controller"
                                                                   data-action="@page.ActionName" data-type="delete"
                                                                   @(canDelete ? "checked" : "") />
                                                            <span class="toggle-slider"></span>
                                                        </label>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @section scripts {
            <script>
                // Save all permissions for a role
                function saveAllPermissions(roleId) {
                    var permissions = [];
                    var checkboxes = document.querySelectorAll('#content-' + roleId + ' .perm-checkbox');
                    var permMap = {};

                    checkboxes.forEach(function(cb) {
                        var key = cb.dataset.controller + '|' + cb.dataset.action;
                        if (!permMap[key]) {
                            permMap[key] = {
                                RoleId: parseInt(cb.dataset.role),
                                Controller: cb.dataset.controller,
                                ActionName: cb.dataset.action,
                                CanView: false,
                                CanAdd: false,
                                CanEdit: false,
                                CanDelete: false,
                                Description: ''
                            };
                        }
                        if (cb.dataset.type === 'view') permMap[key].CanView = cb.checked;
                        if (cb.dataset.type === 'add') permMap[key].CanAdd = cb.checked;
                        if (cb.dataset.type === 'edit') permMap[key].CanEdit = cb.checked;
                        if (cb.dataset.type === 'delete') permMap[key].CanDelete = cb.checked;
                    });

                    for (var key in permMap) {
                        permissions.push(permMap[key]);
                    }

                    $.ajax({
                        url: '@Url.Action("BulkUpdatePermissions", "Permission")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ roleId: roleId, permissions: permissions }),
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            } else {
                                Swal.fire('Lỗi', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi', 'Có lỗi xảy ra khi lưu quyền!', 'error');
                        }
                    });
                }
            </script>
        }
