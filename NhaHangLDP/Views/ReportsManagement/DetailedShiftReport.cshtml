@{
    ViewBag.Title = "Báo Cáo Chi Tiết Ca Làm Việc";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

<link href="~/Content/detailed-shift-enhanced.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #333;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .detailed-shift-container {
        padding: 20px;
        min-height: 100vh;
    }

    .page-header {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        backdrop-filter: blur(15px);
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    }

        .page-header h2 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: #333;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
        }

    .filter-section {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        align-items: end;
    }

    .form-group label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        font-size: 0.95rem;
        color: #333;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 12px 16px;
        font-weight: 500;
        color: #333;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #f39c12;
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1);
            transform: translateY(-1px);
        }

    .btn-search {
        background: linear-gradient(135deg, #fdcb6e, #f39c12);
        color: #fff;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .btn-search:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(243, 156, 18, 0.3);
        }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .summary-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 25px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        text-align: center;
        transition: all 0.3s ease;
    }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

    .summary-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 1.8rem;
        font-weight: bold;
    }

    .summary-card.revenue .summary-icon {
        background: linear-gradient(135deg, #74b9ff, #0984e3);
    }

    .summary-card.orders .summary-icon {
        background: linear-gradient(135deg, #fd79a8, #e84393);
    }

    .summary-card.customers .summary-icon {
        background: linear-gradient(135deg, #fdcb6e, #e17055);
    }

    .summary-card.shifts .summary-icon {
        background: linear-gradient(135deg, #a29bfe, #6c5ce7);
    }

    .summary-number {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 8px;
        color: #333;
    }

    .summary-text {
        font-size: 1rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .shifts-container {
        display: grid;
        gap: 25px;
    }

    .shift-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 30px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .shift-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #fdcb6e, #f39c12);
        }

        .shift-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

    .shift-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
    }

    .shift-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #f39c12;
    }

    .shift-status {
        display: flex;
        align-items: center;
        font-size: 0.95rem;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
    }

        .shift-status.active {
            background: rgba(0, 184, 148, 0.1);
            color: #00b894;
            border: 1px solid rgba(0, 184, 148, 0.2);
        }

        .shift-status.closed {
            background: rgba(116, 185, 255, 0.1);
            color: #74b9ff;
            border: 1px solid rgba(116, 185, 255, 0.2);
        }

    .shift-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .info-item {
        text-align: center;
    }

    .info-label {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #f39c12;
    }

    .shift-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-item {
        background: rgba(248, 249, 250, 0.8);
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #333;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        font-weight: 600;
    }

    .shift-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 10px 20px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-cashier {
        background: linear-gradient(135deg, #74b9ff, #0984e3);
        color: #fff;
    }

    .btn-details {
        background: linear-gradient(135deg, #fdcb6e, #e17055);
        color: #fff;
    }

    .btn-print {
        background: linear-gradient(135deg, #a29bfe, #6c5ce7);
        color: #fff;
    }

    .btn-delete {
        background: linear-gradient(135deg, #ff7675, #d63031);
        color: #fff;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .loading-spinner {
        text-align: center;
        padding: 60px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    }

    .no-data {
        text-align: center;
        padding: 60px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        color: #666;
    }

    .cashier-info {
        background: rgba(248, 249, 250, 0.8);
        border-radius: 15px;
        padding: 20px;
        margin-top: 20px;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

        .cashier-info h5 {
            margin-bottom: 10px;
            color: #f39c12;
            font-weight: 700;
        }

    .support-staff-list {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: center;
        margin-top: 5px;
    }

    .support-staff-badge {
        display: inline-block;
        background: #6c757d;
        color: white;
        padding: 3px 10px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 500;
    }


    @@media (max-width: 768px) {
        .detailed-shift-container {
            padding: 15px;
        }

        .filter-row {
            grid-template-columns: 1fr;
        }

        .summary-cards {
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        }

        .shift-header {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .shift-info {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        }

        .shift-stats {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        }
    }
</style>

<div class="detailed-shift-container">
    <div class="page-header">
        <h2>
            <i class="fas fa-clock me-3"></i>Báo Cáo Chi Tiết Ca Làm Việc
        </h2>
        <p class="mb-0 opacity-90">Xem chi tiết doanh thu, đơn hàng và hiệu suất nhân viên theo từng ca</p>
    </div>

    <div class="filter-section">
        <div class="filter-row">
            <div class="form-group">
                <label for="shiftDate">
                    <i class="fas fa-calendar-alt me-2"></i>Ngày:
                </label>
                <input type="date" id="shiftDate" class="form-control" value="@ViewBag.ShiftDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label for="cashierName">
                    <i class="fas fa-user-tie me-2"></i>Thu ngân:
                </label>
                <select id="cashierName" class="form-control">
                    <option value="">Tất cả thu ngân</option>
                    @if (ViewBag.CashierList != null)
                    {
                        foreach (string cashier in ViewBag.CashierList)
                        {
                            <option value="@cashier">@cashier</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <button type="button" class="btn-search" onclick="loadShiftData()">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
        </div>
    </div>

    <div class="summary-cards" id="summaryCards" style="display: none;">
        <div class="summary-card revenue">
            <div class="summary-icon">
                💰
            </div>
            <div class="summary-number" id="totalRevenue">0 VNĐ</div>
            <div class="summary-text">Tổng Doanh Thu</div>
        </div>
        <div class="summary-card orders">
            <div class="summary-icon">
                🛒
            </div>
            <div class="summary-number" id="totalOrders">0</div>
            <div class="summary-text">Tổng Đơn Hàng</div>
        </div>
        <div class="summary-card customers">
            <div class="summary-icon">
                👥
            </div>
            <div class="summary-number" id="totalCustomers">0</div>
            <div class="summary-text">Khách Phục Vụ</div>
        </div>
        <div class="summary-card shifts">
            <div class="summary-icon">
                ⏰
            </div>
            <div class="summary-number" id="totalShifts">0</div>
            <div class="summary-text">Số Ca Làm Việc</div>
        </div>
    </div>

    <div class="shifts-container" id="shiftsContainer">
        <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin fa-3x mb-3"></i>
            <h4>Đang tải dữ liệu ca làm việc...</h4>
            <p>Vui lòng chờ trong giây lát</p>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            loadShiftData();
        });

        function loadShiftData() {
            const shiftDate = document.getElementById('shiftDate').value;
            const cashierName = document.getElementById('cashierName').value;

            document.getElementById('shiftsContainer').innerHTML = `
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin fa-3x mb-3"></i>
                    <h4>Đang tải dữ liệu ca làm việc...</h4>
                    <p>Vui lòng chờ trong giây lát</p>
                </div>`;

            document.getElementById('summaryCards').style.display = 'none';

            fetch('@Url.Action("GetDetailedShiftReportData", "ReportsManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `shiftDate=${encodeURIComponent(shiftDate)}&cashierName=${encodeURIComponent(cashierName)}`
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    renderShiftData(result.data);
                } else {
                    showError(result.message || 'Có lỗi xảy ra khi tải dữ liệu');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showError('Có lỗi xảy ra khi tải dữ liệu');
            });
        }

        function renderShiftData(data) {
            if (data.Summary) {
                document.getElementById('totalRevenue').textContent = formatCurrency(data.Summary.TotalRevenue);
document.getElementById('totalOrders').textContent = data.Summary.TotalOrders.toLocaleString();
                document.getElementById('totalCustomers').textContent = data.Summary.TotalCustomers.toLocaleString();
                document.getElementById('totalShifts').textContent = data.Summary.TotalShifts.toLocaleString();
                document.getElementById('summaryCards').style.display = 'grid';
            }

            let html = '';

            if (!data.Shifts || data.Shifts.length === 0) {
                html = `
                    <div class="no-data">
                        <i class="fas fa-exclamation-circle fa-3x mb-3"></i>
                        <h4>Không có dữ liệu ca làm việc</h4>
                        <p>Không tìm thấy ca làm việc nào cho ngày ${data.DateDisplay}</p>
                    </div>`;
            } else {
                data.Shifts.sort((a, b) => b.ShiftId - a.ShiftId);

                data.Shifts.forEach(shift => {
                    html += renderShiftCard(shift);
                });
            }

            document.getElementById('shiftsContainer').innerHTML = html;
        }

        function renderShiftCard(shift) {
            const statusClass = shift.Status === 'Active' ? 'active' : 'closed';
            const averageOrder = shift.TotalOrders > 0 ? shift.TotalRevenue / shift.TotalOrders : 0;

            let supportStaffHtml = '';
            if (shift.SupportStaff && shift.SupportStaff.length > 0) {
                supportStaffHtml = '<div class="support-staff-list">';
                shift.SupportStaff.forEach(name => {
                    supportStaffHtml += `<span class="support-staff-badge">${name}</span>`;
                });
                supportStaffHtml += '</div>';
            }

            return `
                <div class="shift-card" id="shift-card-${shift.ShiftId}">
                    <div class="shift-header">
                        <div class="shift-title">
                            <i class="fas fa-business-time me-2"></i>${shift.ShiftName}
                        </div>
                        <div class="shift-status ${statusClass}">
                            <i class="fas fa-circle me-2"></i>${shift.StatusDisplay}
                        </div>
                    </div>

                    <div class="shift-info">
                        <div class="info-item">
                            <div class="info-label">Thời gian</div>
                            <div class="info-value">${shift.StartTime} - ${shift.EndTime}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Thời lượng</div>
                            <div class="info-value">${shift.Duration}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Thu ngân</div>
<div class="info-value">${shift.MainCashier}</div>
                            ${supportStaffHtml}
                        </div>
                        <div class="info-item">
                            <div class="info-label">Bàn phục vụ</div>
                            <div class="info-value">${shift.TablesServed}</div>
                        </div>
                    </div>

                    <div class="shift-stats">
                        <div class="stat-item">
                            <div class="stat-value">${formatCurrency(shift.TotalRevenue)}</div>
                            <div class="stat-label">Doanh Thu</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${shift.TotalOrders}</div>
                            <div class="stat-label">Đơn Hàng</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${shift.CompletedOrders}</div>
                            <div class="stat-label">Hoàn Thành</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${shift.CancelledOrders}</div>
                            <div class="stat-label">Đã Hủy</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${formatCurrency(averageOrder)}</div>
                            <div class="stat-label">Đơn TB</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">${shift.CustomersServed}</div>
                            <div class="stat-label">Khách Hàng</div>
                        </div>
                    </div>

                    ${renderPaymentMethods(shift.PaymentMethods)}
                    ${renderTopDishes(shift.TopDishes)}

                    <div class="shift-actions">
                        <button class="btn-action btn-cashier" onclick="viewInCashier(${shift.ShiftId})">
                            <i class="fas fa-cash-register"></i>Xem Tại Thu Ngân
                        </button>
                        <button class="btn-action btn-details" onclick="viewShiftDetails(${shift.ShiftId})">
                            <i class="fas fa-info-circle"></i>Chi Tiết
                        </button>
                        <button class="btn-action btn-print" onclick="printShiftReport(${shift.ShiftId})">
                            <i class="fas fa-print"></i>In Báo Cáo
                        </button>
                        <button class="btn-action btn-delete" onclick="confirmDeleteShift(${shift.ShiftId}, '${shift.ShiftName}')">
                            <i class="fas fa-trash-alt"></i>Xóa Ca
                        </button>
                    </div>
                </div>
            `;
}

        function renderPaymentMethods(paymentMethods) {
            if (!paymentMethods || paymentMethods.length === 0) return '';

            let html = `
                <div class="cashier-info">
                    <h5><i class="fas fa-credit-card me-2"></i>Phương Thức Thanh Toán</h5>
                    <div class="row">`;

            paymentMethods.forEach(method => {
                html += `
                    <div class="col-md-6 mb-2">
                        <div class="d-flex justify-content-between">
                            <span>${method.Method} (${method.Count})</span>
                            <strong>${formatCurrency(method.Amount)}</strong>
                        </div>
                    </div>`;
            });

            html += `</div></div>`;
            return html;
        }

        function renderTopDishes(topDishes) {
            if (!topDishes || topDishes.length === 0) return '';

            let html = `
                <div class="cashier-info">
                    <h5><i class="fas fa-utensils me-2"></i>Món Bán Chạy</h5>
                    <div class="row">`;

            topDishes.forEach((dish, index) => {
                html += `
                    <div class="col-md-6 mb-2">
                        <div class="d-flex justify-content-between">
                            <span>${index + 1}. ${dish.DishName} (${dish.Quantity})</span>
                            <strong>${formatCurrency(dish.Revenue)}</strong>
                        </div>
                    </div>`;
            });

            html += `</div></div>`;
            return html;
        }

        function viewInCashier(shiftId) {
            window.open('@Url.Action("ShiftDetails", "Cashier")?shiftId=' + shiftId, '_blank');
        }

        function viewShiftDetails(shiftId) {
            window.location.href = '@Url.Action("ShiftDetails", "Cashier")?shiftId=' + shiftId;
        }

        function printShiftReport(shiftId) {
            window.open('@Url.Action("PrintShiftRevenueReport", "Cashier")?shiftId=' + shiftId, 'print', 'width=800,height=600');
        }

        function confirmDeleteShift(shiftId, shiftName) {
            if (confirm(`Bạn có chắc chắn muốn XÓA VĨNH VIỄN ca "${shiftName}" (ID: ${shiftId}) không?\n\nHành động này sẽ xóa tất cả đơn hàng, hóa đơn, và dữ liệu liên quan đến ca này. KHÔNG THỂ HOÀN TÁC!`)) {
                executeDeleteShift(shiftId);
            }
        }

        function executeDeleteShift(shiftId) {
            const card = document.getElementById(`shift-card-${shiftId}`);
            card.style.opacity = '0.5';

            fetch('@Url.Action("DeleteShift", "ReportsManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `shiftId=${shiftId}`
            })
            .then(response => response.json())
.then(result => {
                if (result.success) {
                    showToast('Đã xóa ca thành công!', 'success');
                    card.style.transition = 'all 0.5s ease';
                    card.style.transform = 'scale(0.9)';
                    card.style.opacity = '0';
                    setTimeout(() => {
                        card.remove();
                        loadShiftData();
                    }, 500);
                } else {
                    showToast('Xóa thất bại: ' + result.message, 'error');
                    card.style.opacity = '1';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('Lỗi kết nối khi xóa ca.', 'error');
                card.style.opacity = '1';
            });
        }

        function formatCurrency(amount) {
            return amount.toLocaleString('vi-VN') + ' VNĐ';
        }

        function showError(message) {
            document.getElementById('shiftsContainer').innerHTML = `
                <div class="no-data">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                    <h4>Có lỗi xảy ra</h4>
                    <p>${message}</p>
                    <button class="btn-search" onclick="loadShiftData()">
                        <i class="fas fa-redo me-2"></i>Thử lại
                    </button>
                </div>`;
        }

        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
            const color = type === 'success' ? '#28a745' : '#dc3545';

            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${color};
                color: white;
                padding: 15px 20px;
                border-radius: 10px;
                z-index: 9999;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
                font-weight: bold;
                animation: slideInRight 0.3s ease;
                max-width: 350px;
            `;
            toast.innerHTML = `<i class="fas ${icon} me-2"></i>${message}`;
            document.body.appendChild(toast);

            setTimeout(() => {
                if (toast.parentNode) {
                    toast.style.animation = 'slideOutRight 0.3s ease forwards';
                    toast.addEventListener('animationend', () => {
                        if (toast.parentNode) {
                             document.body.removeChild(toast);
                        }
                    });
                }
            }, 3000);
        }

        if (!document.getElementById('toast-animation-styles')) {
            var style = document.createElement('style');
            style.id = 'toast-animation-styles';
            style.textContent = `
        @@keyframes slideInRight {
                    from { transform: translateX(100%); opacity: 0; }
                    to { transform: translateX(0); opacity: 1; }
                }
                @@keyframes slideOutRight {
                    from { transform: translateX(0); opacity: 1; }
                    to { transform: translateX(100%); opacity: 0; }
                }
            `;
            document.head.appendChild(style);
        }
    </script>
}