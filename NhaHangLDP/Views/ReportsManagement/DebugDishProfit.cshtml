@{
    ViewBag.Title = "Debug - Dish Profit Analysis";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

<style>
    .debug-container {
        background: #1e1e1e;
        color: #d4d4d4;
        font-family: 'Consolas', 'Monaco', monospace;
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
    }

    .debug-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .debug-title {
        color: #569cd6;
        font-weight: bold;
        margin-bottom: 10px;
        font-size: 1.1rem;
    }

    .debug-json {
        background: #0d1117;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: 16px;
        overflow-x: auto;
        white-space: pre-wrap;
        font-size: 0.85rem;
        line-height: 1.45;
    }

    .error-section {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid #dc3545;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .success-section {
        background: rgba(40, 167, 69, 0.1);
        border: 1px solid #28a745;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .btn-test {
        background: #0969da;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-block;
        margin: 5px;
        transition: background 0.2s;
    }

    .btn-test:hover {
        background: #0860ca;
        color: white;
        text-decoration: none;
    }

    .table-debug {
        width: 100%;
        border-collapse: collapse;
        margin: 10px 0;
    }

    .table-debug th,
    .table-debug td {
        border: 1px solid #30363d;
        padding: 8px;
        text-align: left;
    }

    .table-debug th {
        background: #21262d;
        color: #f0f6fc;
    }

    .count-badge {
        background: #238636;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .zero-badge {
        background: #da3633;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: bold;
    }
</style>

<div class="row">
    <div class="col-12">
        <h2 class="text-white mb-4">
            <i class="fas fa-bug me-2"></i>Debug - Dish Profit Analysis Database
        </h2>
        
        <div class="mb-3">
            <a href="@Url.Action("DishProfitAnalysis", "ReportsManagement")" class="btn-test">
                <i class="fas fa-arrow-left me-1"></i>Quay lại Phân Tích Lợi Nhuận
            </a>
            <a href="@Url.Action("GetDishProfitAnalysisData", "ReportsManagement")" class="btn-test" onclick="testAPI(event)">
                <i class="fas fa-flask me-1"></i>Test API
            </a>
            <button class="btn-test" onclick="location.reload()">
                <i class="fas fa-sync me-1"></i>Refresh
            </button>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-section">
                <h4 class="text-danger mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>Database Connection Error
                </h4>
                <p><strong>Error:</strong> @ViewBag.Error</p>
                @if (ViewBag.InnerException != null)
                {
                    <p><strong>Inner Exception:</strong> @ViewBag.InnerException</p>
                }
                @if (ViewBag.StackTrace != null)
                {
                    <details>
                        <summary>Stack Trace</summary>
                        <pre class="debug-json">@ViewBag.StackTrace</pre>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="success-section">
                <h4 class="text-success mb-3">
                    <i class="fas fa-check-circle me-2"></i>Database Connection Successful
                </h4>
                <p>Kết nối database thành công. Thời gian: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
            </div>

            if (ViewBag.DebugInfo != null)
            {
                var debugInfo = ViewBag.DebugInfo;

                <div class="debug-section">
                    <div class="debug-title">📊 Database Tables Count</div>
                    <table class="table-debug">
                        <tr>
                            <th>Table</th>
                            <th>Count</th>
                            <th>Status</th>
                        </tr>
                        <tr>
                            <td>Orders</td>
                            <td>@debugInfo.TablesCount.Orders</td>
                            <td>@if (debugInfo.TablesCount.Orders > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>OrderDetails</td>
                            <td>@debugInfo.TablesCount.OrderDetails</td>
                            <td>@if (debugInfo.TablesCount.OrderDetails > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>Bills</td>
                            <td>@debugInfo.TablesCount.Bills</td>
                            <td>@if (debugInfo.TablesCount.Bills > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>MenuItems</td>
                            <td>@debugInfo.TablesCount.MenuItems</td>
                            <td>@if (debugInfo.TablesCount.MenuItems > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>Ingredients</td>
                            <td>@debugInfo.TablesCount.Ingredients</td>
                            <td>@if (debugInfo.TablesCount.Ingredients > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>MenuItemIngredients</td>
                            <td>@debugInfo.TablesCount.MenuItemIngredients</td>
                            <td>@if (debugInfo.TablesCount.MenuItemIngredients > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                        <tr>
                            <td>CashierShifts</td>
                            <td>@debugInfo.TablesCount.CashierShifts</td>
                            <td>@if (debugInfo.TablesCount.CashierShifts > 0) { <span class="count-badge">✓ Has Data</span> } else { <span class="zero-badge">⚠ Empty</span> }</td>
                        </tr>
                    </table>
                </div>

                if (debugInfo.RecentOrders != null && debugInfo.RecentOrders.Count > 0)
                {
                    <div class="debug-section">
                        <div class="debug-title">📋 Recent Orders (Top 5)</div>
                        <table class="table-debug">
                            <tr>
                                <th>ID</th>
                                <th>Order Time</th>
                                <th>Table ID</th>
                                <th>Status</th>
                                <th>Details Count</th>
                                <th>Bills Count</th>
                            </tr>
                            @foreach (var order in debugInfo.RecentOrders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.OrderTime</td>
                                    <td>@order.TableId</td>
                                    <td>@order.Status</td>
                                    <td>@order.OrderDetailsCount</td>
                                    <td>@order.BillsCount</td>
                                </tr>
                            }
                        </table>
                    </div>
                }

                if (debugInfo.RecentBills != null && debugInfo.RecentBills.Count > 0)
                {
                    <div class="debug-section">
                        <div class="debug-title">💰 Recent Bills (Top 5)</div>
                        <table class="table-debug">
                            <tr>
                                <th>ID</th>
                                <th>Bill Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Order ID</th>
                            </tr>
                            @foreach (var bill in debugInfo.RecentBills)
                            {
                                <tr>
                                    <td>@bill.Id</td>
                                    <td>@bill.BillDate</td>
                                    <td>@bill.FinalAmount.ToString("N0") VNĐ</td>
                                    <td>@bill.Status</td>
                                    <td>@bill.PaymentMethod</td>
                                    <td>@bill.OrderId</td>
                                </tr>
                            }
                        </table>
                    </div>
                }

                if (debugInfo.MenuItemsWithIngredients != null && debugInfo.MenuItemsWithIngredients.Count > 0)
                {
                    <div class="debug-section">
                        <div class="debug-title">🍽️ Menu Items with Ingredients (Sample)</div>
                        <table class="table-debug">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th>Ingredients Count</th>
                            </tr>
                            @foreach (var item in debugInfo.MenuItemsWithIngredients)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>@item.Price.ToString("N0") VNĐ</td>
                                    <td>@item.Category</td>
                                    <td>@item.IngredientsCount</td>
                                </tr>
                            }
                        </table>
                    </div>
                }

                if (debugInfo.SampleIngredientCosts != null && debugInfo.SampleIngredientCosts.Count > 0)
                {
                    <div class="debug-section">
                        <div class="debug-title">🥬 Sample Ingredient Costs</div>
                        <table class="table-debug">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Estimated Cost</th>
                                <th>Stock</th>
                                <th>Unit</th>
                            </tr>
                            @foreach (var ingredient in debugInfo.SampleIngredientCosts)
                            {
                                <tr>
                                    <td>@ingredient.Id</td>
                                    <td>@ingredient.Name</td>
                                    <td>@ingredient.EstimatedCost.ToString("N0") VNĐ</td>
                                    <td>@ingredient.AvailableStock.ToString("N2")</td>
                                    <td>@ingredient.Unit</td>
                                </tr>
                            }
                        </table>
                    </div>
                }
            }

            if (ViewBag.DebugJson != null)
            {
                <div class="debug-section">
                    <div class="debug-title">🔍 Full Debug JSON</div>
                    <div class="debug-json">@ViewBag.DebugJson</div>
                </div>
            }
        }
    </div>
</div>

<script>
    function testAPI(event) {
        event.preventDefault();
        
        console.log('Testing Dish Profit Analysis API...');
        
        fetch('@Url.Action("GetDishProfitAnalysisData", "ReportsManagement")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'period=month'
        })
        .then(response => {
            console.log('API Response Status:', response.status);
            return response.json();
        })
        .then(data => {
            console.log('API Response Data:', data);
            alert('API Test Successful! Check Console (F12) for details.');
        })
        .catch(error => {
            console.error('API Test Failed:', error);
            alert('API Test Failed: ' + error.message + '\nCheck Console (F12) for details.');
        });
    }

    // Auto refresh every 30 seconds
    setTimeout(function() {
        location.reload();
    }, 30000);

    console.log('Debug page loaded at:', new Date().toLocaleString());
</script>