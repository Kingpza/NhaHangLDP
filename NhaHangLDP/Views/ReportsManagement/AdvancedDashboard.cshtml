@{
    ViewBag.Title = "Dashboard Nâng Cao";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
    var period = ViewBag.Period ?? "today";
}

@section styles {
    <style>
        .dashboard-header {
            background: linear-gradient(135deg, #1e3a5f 0%, #0d1b2a 100%);
            color: white;
            padding: 25px 30px;
            margin: -25px -30px 25px -30px;
            border-radius: 0 0 20px 20px;
        }

        .period-selector {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .period-btn {
            padding: 8px 20px;
            border: 2px solid rgba(255,255,255,0.3);
            background: transparent;
            color: white;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .period-btn:hover, .period-btn.active {
            background: white;
            color: #1e3a5f;
            border-color: white;
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .kpi-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .kpi-card.revenue::before { background: #3b82f6; }
        .kpi-card.orders::before { background: #22c55e; }
        .kpi-card.avg-order::before { background: #f59e0b; }
        .kpi-card.profit::before { background: #8b5cf6; }

        .kpi-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 15px;
        }

        .kpi-card.revenue .kpi-icon { background: rgba(59,130,246,0.1); color: #3b82f6; }
        .kpi-card.orders .kpi-icon { background: rgba(34,197,94,0.1); color: #22c55e; }
        .kpi-card.avg-order .kpi-icon { background: rgba(245,158,11,0.1); color: #f59e0b; }
        .kpi-card.profit .kpi-icon { background: rgba(139,92,246,0.1); color: #8b5cf6; }

        .kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 5px;
        }

        .kpi-label {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .kpi-trend {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 600;
        }

        .kpi-trend.up { color: #22c55e; }
        .kpi-trend.down { color: #ef4444; }
        .kpi-trend.stable { color: #64748b; }

        /* Charts Container */
        .chart-container {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 25px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .chart-title {
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
        }

        .chart-actions {
            display: flex;
            gap: 10px;
        }

        .chart-btn {
            padding: 6px 14px;
            border: 1px solid #e2e8f0;
            background: white;
            border-radius: 8px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .chart-btn:hover, .chart-btn.active {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }

        /* Alerts Panel */
        .alerts-panel {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .alert-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 10px;
            transition: all 0.2s ease;
        }

        .alert-item:hover {
            background: #f8fafc;
        }

        .alert-item.danger { border-left: 4px solid #ef4444; }
        .alert-item.warning { border-left: 4px solid #f59e0b; }
        .alert-item.info { border-left: 4px solid #3b82f6; }
        .alert-item.success { border-left: 4px solid #22c55e; }

        .alert-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .alert-item.danger .alert-icon { background: #fee2e2; color: #ef4444; }
        .alert-item.warning .alert-icon { background: #fef3c7; color: #f59e0b; }
        .alert-item.info .alert-icon { background: #dbeafe; color: #3b82f6; }

        .alert-content h5 {
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
            margin: 0 0 5px 0;
        }

        .alert-content p {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }

        /* Prediction Card */
        .prediction-card {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .prediction-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .prediction-title {
            font-size: 18px;
            font-weight: 700;
        }

        .prediction-confidence {
            background: rgba(255,255,255,0.2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 13px;
        }

        .prediction-value {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .prediction-label {
            opacity: 0.8;
            font-size: 14px;
        }

        /* Top Performers Table */
        .performers-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .performers-table th {
            text-align: left;
            padding: 12px 15px;
            color: #64748b;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .performers-table td {
            padding: 15px;
            background: #f8fafc;
            border: none;
        }

        .performers-table tr td:first-child {
            border-radius: 10px 0 0 10px;
        }

        .performers-table tr td:last-child {
            border-radius: 0 10px 10px 0;
        }

        .performer-rank {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .performer-rank.gold { background: #fef3c7; color: #d97706; }
        .performer-rank.silver { background: #f1f5f9; color: #64748b; }
        .performer-rank.bronze { background: #fed7aa; color: #c2410c; }

        /* Loading Skeleton */
        .skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: 8px;
        }

        @@keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Grid Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        @@media (max-width: 1200px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="mb-1">📊 Dashboard Phân Tích Nâng Cao</h2>
            <p class="mb-0 opacity-75">Dữ liệu cập nhật lúc: <span id="lastUpdated">--:--</span></p>
        </div>
        <div class="period-selector">
            <button class="period-btn @(period == "today" ? "active" : "")" data-period="today">Hôm nay</button>
            <button class="period-btn @(period == "week" ? "active" : "")" data-period="week">Tuần này</button>
            <button class="period-btn @(period == "month" ? "active" : "")" data-period="month">Tháng này</button>
            <button class="period-btn @(period == "quarter" ? "active" : "")" data-period="quarter">Quý này</button>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid" id="kpiGrid">
    <div class="kpi-card revenue">
        <div class="kpi-icon"><i class="fas fa-chart-line"></i></div>
        <div class="kpi-value" id="kpiRevenue">--</div>
        <div class="kpi-label">Doanh thu</div>
        <div class="kpi-trend" id="kpiRevenueTrend">
            <i class="fas fa-minus"></i>
            <span>--</span>
        </div>
    </div>
    <div class="kpi-card orders">
        <div class="kpi-icon"><i class="fas fa-shopping-cart"></i></div>
        <div class="kpi-value" id="kpiOrders">--</div>
        <div class="kpi-label">Đơn hàng</div>
        <div class="kpi-trend" id="kpiOrdersTrend">
            <i class="fas fa-minus"></i>
            <span>--</span>
        </div>
    </div>
    <div class="kpi-card avg-order">
        <div class="kpi-icon"><i class="fas fa-receipt"></i></div>
        <div class="kpi-value" id="kpiAvgOrder">--</div>
        <div class="kpi-label">TB/Đơn hàng</div>
        <div class="kpi-trend" id="kpiAvgOrderTrend">
            <i class="fas fa-minus"></i>
            <span>--</span>
        </div>
    </div>
    <div class="kpi-card profit">
        <div class="kpi-icon"><i class="fas fa-coins"></i></div>
        <div class="kpi-value" id="kpiProfit">--</div>
        <div class="kpi-label">Lợi nhuận ròng</div>
        <div class="kpi-trend" id="kpiProfitTrend">
            <i class="fas fa-minus"></i>
            <span>--</span>
        </div>
    </div>
</div>

<!-- Prediction Card -->
<div class="prediction-card" id="predictionCard">
    <div class="prediction-header">
        <div class="prediction-title">🔮 Dự đoán doanh thu</div>
        <div class="prediction-confidence" id="predictionConfidence">Độ tin cậy: --</div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="prediction-value" id="predictedRevenue">--</div>
            <div class="prediction-label">Dự đoán kỳ tới</div>
        </div>
        <div class="col-md-4">
            <div class="prediction-value" id="predictedOrders">--</div>
            <div class="prediction-label">Đơn hàng dự kiến</div>
        </div>
        <div class="col-md-4">
            <div class="prediction-value" id="predictedProfit">--</div>
            <div class="prediction-label">Lợi nhuận dự kiến</div>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <!-- Left Column -->
    <div>
        <!-- Revenue Chart -->
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">📈 Xu hướng doanh thu</h5>
                <div class="chart-actions">
                    <button class="chart-btn active" data-chart="revenue">Doanh thu</button>
                    <button class="chart-btn" data-chart="profit">Lợi nhuận</button>
                    <button class="chart-btn" data-chart="orders">Đơn hàng</button>
                </div>
            </div>
            <div style="position: relative; height: 300px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Category Breakdown -->
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">🍽️ Doanh thu theo danh mục</h5>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div style="position: relative; height: 250px;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
                <div class="col-md-6">
                    <div id="categoryLegend"></div>
                </div>
            </div>
        </div>

        <!-- Top Performers -->
        <div class="chart-container">
            <div class="chart-header">
                <h5 class="chart-title">🏆 Top món bán chạy</h5>
                <a href="@Url.Action("MenuEngineering")" class="btn btn-outline-primary btn-sm">
                    Phân tích chi tiết <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <table class="performers-table" id="topPerformersTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Món ăn</th>
                        <th>Số lượng</th>
                        <th>Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Loaded via JS -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right Column -->
    <div>
        <!-- Alerts -->
        <div class="alerts-panel mb-4">
            <h5 class="chart-title mb-3">🔔 Cảnh báo</h5>
            <div id="alertsList">
                <p class="text-muted text-center py-3">Đang tải...</p>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="chart-container">
            <h5 class="chart-title mb-3">⚡ Truy cập nhanh</h5>
            <div class="d-grid gap-2">
                <a href="@Url.Action("MenuEngineering")" class="btn btn-outline-primary">
                    <i class="fas fa-puzzle-piece me-2"></i>Menu Engineering
                </a>
                <a href="@Url.Action("KPITracking")" class="btn btn-outline-success">
                    <i class="fas fa-bullseye me-2"></i>Theo dõi KPI
                </a>
                <a href="@Url.Action("PredictiveAnalytics")" class="btn btn-outline-info">
                    <i class="fas fa-crystal-ball me-2"></i>Dự đoán
                </a>
                <a href="@Url.Action("DishProfitAnalysis")" class="btn btn-outline-warning">
                    <i class="fas fa-coins me-2"></i>Phân tích lợi nhuận
                </a>
            </div>
        </div>

        <!-- Mini Stats -->
        <div class="chart-container">
            <h5 class="chart-title mb-3">📊 Thống kê nhanh</h5>
            <div class="row g-3">
                <div class="col-6">
                    <div class="text-center p-3 bg-light rounded-3">
                        <div class="fs-4 fw-bold text-primary" id="tableUtil">--%</div>
                        <div class="small text-muted">Sử dụng bàn</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="text-center p-3 bg-light rounded-3">
                        <div class="fs-4 fw-bold text-success" id="profitMargin">--%</div>
                        <div class="small text-muted">Biên lợi nhuận</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="text-center p-3 bg-light rounded-3">
                        <div class="fs-4 fw-bold text-warning" id="tableTurnover">--</div>
                        <div class="small text-muted">Vòng quay bàn</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="text-center p-3 bg-light rounded-3">
                        <div class="fs-4 fw-bold text-info" id="revPASH">--</div>
                        <div class="small text-muted">RevPASH</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let currentPeriod = '@period';
        let revenueChart = null;
        let categoryChart = null;
        let dashboardData = null;
        let isLoading = false; // Prevent multiple simultaneous loads

        $(document).ready(function() {
            console.log('Dashboard initialized');
            loadDashboardData(currentPeriod);

            // Period selector with proper event handling
            $('.period-btn').off('click').on('click', function() {
                if (isLoading) {
                    console.log('Still loading, ignoring click');
                    return;
                }
                
                currentPeriod = $(this).data('period');
                $('.period-btn').removeClass('active');
                $(this).addClass('active');
                loadDashboardData(currentPeriod);
            });

            // Chart type selector
            $('.chart-btn').off('click').on('click', function() {
                $('.chart-btn').removeClass('active');
                $(this).addClass('active');
                updateRevenueChart($(this).data('chart'));
            });

            // REMOVED auto refresh to prevent infinite loop
            // If you need auto refresh, uncomment below with proper protection
            // setInterval(function() {
            //     if (!isLoading) {
            //         loadDashboardData(currentPeriod);
            //     }
            // }, 300000); // 5 minutes
        });

        function loadDashboardData(period) {
            if (isLoading) {
                console.log('Already loading, skipping...');
                return;
            }

            console.log('Loading dashboard data for period:', period);
            isLoading = true;
            
            // Show loading state
            $('#kpiRevenue').text('Đang tải...');
            
            $.ajax({
                url: '@Url.Action("GetAdvancedDashboardData")',
                method: 'POST',
                data: { period: period },
                timeout: 10000,
                success: function(response) {
                    console.log('Dashboard data loaded successfully');
                    
                    if (response.success && response.data) {
                        dashboardData = response.data;
                        
                        if (response.data.Summary) {
                            updateKPIs(response.data.Summary);
                            updateMiniStats(response.data.Summary);
                        }
                        
                        if (response.data.Predictions) {
                            updatePredictions(response.data.Predictions);
                        }
                        
                        if (response.data.RevenueChart && response.data.RevenueChart.length > 0) {
                            updateRevenueChartData(response.data.RevenueChart);
                        }
                        
                        if (response.data.CategoryBreakdown && response.data.CategoryBreakdown.length > 0) {
                            updateCategoryChart(response.data.CategoryBreakdown);
                        }
                        
                        if (response.data.TopPerformers && response.data.TopPerformers.length > 0) {
                            updateTopPerformers(response.data.TopPerformers);
                        }
                        
                        if (response.data.Alerts) {
                            updateAlerts(response.data.Alerts);
                        }
                        
                        $('#lastUpdated').text(new Date().toLocaleTimeString('vi-VN'));
                    } else {
                        console.error('Invalid response data');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading dashboard data:', error);
                    $('#kpiRevenue').text('Lỗi');
                    $('#alertsList').html('<div class="alert alert-danger">Không thể tải dữ liệu. Vui lòng thử lại.</div>');
                },
                complete: function() {
                    isLoading = false;
                    console.log('Loading complete');
                }
            });
        }

        function updateKPIs(summary) {
            $('#kpiRevenue').text(formatCurrency(summary.TotalRevenue));
            $('#kpiOrders').text(summary.TotalOrders);
            $('#kpiAvgOrder').text(formatCurrency(summary.AvgOrderValue));
            $('#kpiProfit').text(formatCurrency(summary.NetProfit));

            // Trends
            updateTrend('#kpiRevenueTrend', summary.RevenueGrowth);
            updateTrend('#kpiOrdersTrend', summary.OrdersGrowth);
            updateTrend('#kpiAvgOrderTrend', summary.AvgOrderGrowth);
        }

        function updateTrend(selector, value) {
            const $el = $(selector);
            const icon = value > 0 ? 'fa-arrow-up' : value < 0 ? 'fa-arrow-down' : 'fa-minus';
            const cls = value > 0 ? 'up' : value < 0 ? 'down' : 'stable';
            
            $el.removeClass('up down stable').addClass(cls);
            $el.html(`<i class="fas ${icon}"></i><span>${Math.abs(value).toFixed(1)}%</span>`);
        }

        function updatePredictions(predictions) {
            if (!predictions) return;
            
            $('#predictedRevenue').text(formatCurrency(predictions.PredictedRevenue));
            $('#predictedOrders').text(predictions.PredictedOrders || '--');
            $('#predictedProfit').text(formatCurrency(predictions.PredictedProfit));
            $('#predictionConfidence').text('Độ tin cậy: ' + (predictions.Confidence || 0).toFixed(0) + '%');
        }

        function updateRevenueChartData(chartData) {
            console.log('Updating revenue chart with', chartData.length, 'data points');
            
            const ctx = document.getElementById('revenueChart');
            if (!ctx) {
                console.error('Canvas element not found');
                return;
            }

            // CRITICAL: Destroy old chart completely before creating new one
            if (revenueChart !== null && revenueChart !== undefined) {
                console.log('Destroying existing revenue chart');
                try {
                    revenueChart.destroy();
                } catch(e) {
                    console.error('Error destroying chart:', e);
                }
                revenueChart = null;
            }

            // Small delay to ensure DOM is clean
            setTimeout(function() {
                try {
                    console.log('Creating new revenue chart');
                    revenueChart = new Chart(ctx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: chartData.map(d => d.Label),
                            datasets: [{
                                label: 'Doanh thu',
                                data: chartData.map(d => d.Revenue),
                                borderColor: '#3b82f6',
                                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                fill: true,
                                tension: 0.4
                            }, {
                                label: 'Lợi nhuận',
                                data: chartData.map(d => d.Profit),
                                borderColor: '#22c55e',
                                backgroundColor: 'rgba(34, 197, 94, 0.1)',
                                fill: true,
                                tension: 0.4,
                                hidden: true
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'top'
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return context.dataset.label + ': ' + formatCurrency(context.raw);
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return formatCurrencyShort(value);
                                        }
                                    }
                                }
                            }
                        }
                    });
                    console.log('Revenue chart created successfully');
                } catch(e) {
                    console.error('Error creating chart:', e);
                }
            }, 100);
        }

        function updateRevenueChart(chartType) {
            if (!revenueChart || !dashboardData) {
                console.log('Cannot update chart - chart or data not available');
                return;
            }

            console.log('Switching to chart type:', chartType);

            // Update visibility of datasets
            revenueChart.data.datasets.forEach((dataset, index) => {
                if (chartType === 'revenue') {
                    dataset.hidden = index !== 0;
                } else if (chartType === 'profit') {
                    dataset.hidden = index !== 1;
                } else if (chartType === 'orders') {
                    dataset.hidden = index !== 2;
                }
            });

            revenueChart.update();
        }

        function updateCategoryChart(categories) {
            console.log('Updating category chart with', categories.length, 'categories');
            
            const ctx = document.getElementById('categoryChart');
            if (!ctx) {
                console.error('Category chart canvas not found');
                return;
            }
            
            // CRITICAL: Destroy old chart completely
            if (categoryChart !== null && categoryChart !== undefined) {
                console.log('Destroying existing category chart');
                try {
                    categoryChart.destroy();
                } catch(e) {
                    console.error('Error destroying category chart:', e);
                }
                categoryChart = null;
            }

            // Small delay to ensure DOM is clean
            setTimeout(function() {
                try {
                    console.log('Creating new category chart');
                    categoryChart = new Chart(ctx.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: categories.map(c => c.Category),
                            datasets: [{
                                data: categories.map(c => c.Revenue),
                                backgroundColor: categories.map(c => c.Color || '#3b82f6')
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            }
                        }
                    });
                    console.log('Category chart created successfully');
                } catch(e) {
                    console.error('Error creating category chart:', e);
                }
            }, 100);

            // Update legend
            let legendHtml = categories.map(c => `
                <div class="d-flex align-items-center mb-2">
                    <div style="width: 12px; height: 12px; border-radius: 3px; background: ${c.Color}; margin-right: 10px;"></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">${c.Category}</div>
                        <div class="small text-muted">${formatCurrency(c.Revenue)} (${c.Percentage.toFixed(1)}%)</div>
                    </div>
                </div>
            `).join('');
            $('#categoryLegend').html(legendHtml);
        }

        function updateTopPerformers(performers) {
            if (!performers || performers.length === 0) {
                $('#topPerformersTable tbody').html('<tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr>');
                return;
            }

            let html = performers.slice(0, 5).map((p, index) => {
                const rankClass = index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '';
                return `
                    <tr>
                        <td><div class="performer-rank ${rankClass}">${index + 1}</div></td>
                        <td><strong>${p.Name}</strong></td>
                        <td>${p.Count}</td>
                        <td class="fw-bold text-primary">${formatCurrency(p.Value)}</td>
                    </tr>
                `;
            }).join('');

            $('#topPerformersTable tbody').html(html);
        }

        function updateAlerts(alerts) {
            if (!alerts || alerts.length === 0) {
                $('#alertsList').html('<p class="text-muted text-center py-3">Không có cảnh báo</p>');
                return;
            }

            let html = alerts.slice(0, 5).map(a => {
                const icon = a.Type === 'danger' ? 'fa-exclamation-circle' : 
                            a.Type === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle';
                return `
                    <div class="alert-item ${a.Type}">
                        <div class="alert-icon"><i class="fas ${icon}"></i></div>
                        <div class="alert-content">
                            <h5>${a.Title}</h5>
                            <p>${a.Message}</p>
                        </div>
                    </div>
                `;
            }).join('');

            $('#alertsList').html(html);
        }

        function updateMiniStats(summary) {
            $('#tableUtil').text((summary.TableUtilization || 0).toFixed(0) + '%');
            $('#profitMargin').text((summary.ProfitMargin || 0).toFixed(1) + '%');
            $('#tableTurnover').text((summary.TableTurnover || 0).toFixed(1));
            $('#revPASH').text(formatCurrencyShort(summary.RevPASH || 0));
        }

        function formatCurrency(value) {
            if (!value) return '0đ';
            return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
        }

        function formatCurrencyShort(value) {
            if (!value) return '0';
            if (value >= 1000000) return (value / 1000000).toFixed(1) + 'M';
            if (value >= 1000) return (value / 1000).toFixed(0) + 'K';
            return value.toString();
        }

        // Cleanup on page unload
        $(window).on('beforeunload', function() {
            if (revenueChart) {
                revenueChart.destroy();
                revenueChart = null;
            }
            if (categoryChart) {
                categoryChart.destroy();
                categoryChart = null;
            }
        });
    </script>
}
