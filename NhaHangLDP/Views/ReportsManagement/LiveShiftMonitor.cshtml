@{
    ViewBag.Title = "Theo Dõi Ca Làm Việc Trực Tiếp";
    Layout = "~/Views/Shared/_ManagementLayout.cshtml";
}

@section styles {
    <link href="~/Content/revenue-analytics.css" rel="stylesheet" />
    <style>
        .live-monitor-container {
            padding: 0;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            color: #fff;
        }

        .monitor-header {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .live-dot {
            width: 12px;
            height: 12px;
            background: #e74c3c;
            border-radius: 50%;
            animation: live-pulse 1.5s infinite;
        }

        @@keyframes live-pulse {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        .shift-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .shift-monitor-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            position: relative;
        }

        .shift-monitor-card:hover {
            border-color: rgba(255, 204, 0, 0.5);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .shift-status-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .shift-status-badge.active {
            background: rgba(46, 204, 113, 0.2);
            color: #2ecc71;
            border: 1px solid rgba(46, 204, 113, 0.5);
        }

        .shift-cashier-info {
            margin-bottom: 20px;
        }

        .cashier-name {
            font-size: 1.3rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .shift-duration {
            color: #bdc3c7;
            font-size: 0.9rem;
        }

        .shift-metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .metric-box {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .metric-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ffcc00;
            margin-bottom: 5px;
        }

        .metric-label {
            font-size: 0.8rem;
            color: #bdc3c7;
        }

        .performance-bar {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .performance-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .performance-fill.excellent {
            background: linear-gradient(90deg, #2ecc71, #27ae60);
        }

        .performance-fill.good {
            background: linear-gradient(90deg, #f39c12, #e67e22);
        }

        .performance-fill.poor {
            background: linear-gradient(90deg, #e74c3c, #c0392b);
        }

        .shift-actions {
            display: flex;
            gap: 10px;
        }

        .btn-shift-action {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 6px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-shift-action:hover {
            background: rgba(255, 204, 0, 0.2);
            border-color: #ffcc00;
            color: #ffcc00;
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .alert-panel {
            background: rgba(231, 76, 60, 0.1);
            border: 1px solid rgba(231, 76, 60, 0.3);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .alert-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .cashier-connection-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
        }

        .connection-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #2ecc71;
        }

        .connection-dot.offline {
            background: #e74c3c;
        }
    </style>
}

<div class="live-monitor-container">
    <!-- Monitor Header -->
    <div class="monitor-header">
        <div>
            <h4 class="text-white mb-0">
                <i class="fas fa-tv me-2"></i>Theo Dõi Ca Làm Việc Trực Tiếp
            </h4>
            <p class="text-muted mb-0">Giám sát hiệu suất thu ngân và gửi cảnh báo realtime</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="live-indicator">
                <div class="live-dot"></div>
                <span>LIVE</span>
            </div>
            <span class="text-muted" id="lastUpdate">Cập nhật: --:--</span>
            <a href="@Url.Action("SalesAnalytics", "ReportsManagement")" class="btn btn-outline-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="revenue-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="revenue-amount" id="totalActiveShifts">0</div>
            <div class="revenue-label">Ca đang hoạt động</div>
        </div>
        <div class="summary-card">
            <div class="revenue-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="revenue-amount" id="totalRevenueToday">0 VNĐ</div>
            <div class="revenue-label">Doanh thu hôm nay</div>
        </div>
        <div class="summary-card">
            <div class="revenue-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="revenue-amount" id="totalOrdersToday">0</div>
            <div class="revenue-label">Tổng đơn hàng</div>
        </div>
        <div class="summary-card">
            <div class="revenue-icon">
                <i class="fas fa-calculator"></i>
            </div>
            <div class="revenue-amount" id="avgPerformance">0%</div>
            <div class="revenue-label">Hiệu suất trung bình</div>
        </div>
    </div>

    <!-- Alert Panel -->
    <div class="alert-panel" id="alertPanel" style="display: none;">
        <h6 class="text-danger mb-3">
            <i class="fas fa-exclamation-triangle me-2"></i>Cảnh báo hệ thống
        </h6>
        <div id="alertList">
            <!-- Alerts will be populated here -->
        </div>
    </div>

    <!-- Active Shifts Grid -->
    <div class="shift-grid" id="activeShiftsGrid">
        <!-- Shifts will be populated here -->
    </div>

    <!-- Loading state -->
    <div id="loadingState" class="text-center p-5">
        <i class="fas fa-spinner fa-spin fa-3x mb-3 text-warning"></i>
        <p>Đang kết nối với hệ thống thu ngân...</p>
    </div>
</div>

@section scripts {
    <script>
        let refreshInterval;
        let shiftsData = [];
        let alertsData = [];

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadActiveShifts();
            startAutoRefresh();
        });

        function loadActiveShifts() {
            fetch('@Url.Action("GetRealTimeCashierMetrics", "ReportsManagement")', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    shiftsData = data.shifts;
                    updateShiftsDisplay();
                    updateSummaryCards();
                    checkForAlerts();
                    document.getElementById('loadingState').style.display = 'none';
                } else {
                    showError('Lỗi khi tải dữ liệu: ' + data.message);
                }
                updateLastUpdateTime();
            })
            .catch(error => {
                console.error('Error:', error);
                showError('Mất kết nối với hệ thống thu ngân!');
                updateLastUpdateTime();
            });
        }

        function updateShiftsDisplay() {
            const grid = document.getElementById('activeShiftsGrid');
            let html = '';

            if (shiftsData.length === 0) {
                html = `
                    <div class="col-12 text-center p-5">
                        <i class="fas fa-info-circle fa-3x mb-3 text-muted"></i>
                        <p class="text-muted">Không có ca làm việc nào đang hoạt động</p>
                    </div>
                `;
            } else {
                shiftsData.forEach(shift => {
                    const performanceClass = getPerformanceClass(shift.Performance);
                    const performanceWidth = Math.min(100, Math.max(0, shift.Performance));
                    
                    html += `
                        <div class="shift-monitor-card">
                            <div class="shift-status-badge active">ĐANG HOẠT ĐỘNG</div>
                            
                            <div class="shift-cashier-info">
                                <div class="cashier-name">${shift.CashierName}</div>
                                <div class="shift-duration">
                                    <i class="fas fa-clock me-1"></i>
                                    Bắt đầu: ${shift.StartTime} | Thời gian: ${shift.Duration}
                                </div>
                                <div class="cashier-connection-status">
                                    <div class="connection-dot"></div>
                                    <span style="font-size: 0.8rem; color: #2ecc71;">Kết nối tốt</span>
                                </div>
                            </div>

                            <div class="shift-metrics-grid">
                                <div class="metric-box">
                                    <div class="metric-value">${shift.OrdersCount}</div>
                                    <div class="metric-label">Đơn hàng</div>
                                </div>
                                <div class="metric-box">
                                    <div class="metric-value">${(shift.Revenue / 1000000).toFixed(1)}M</div>
                                    <div class="metric-label">Doanh thu</div>
                                </div>
                            </div>

                            <div class="performance-bar">
                                <div class="performance-fill ${performanceClass}" 
                                     style="width: ${performanceWidth}%"></div>
                            </div>
                            <div class="text-center mb-3">
                                <span style="font-size: 0.9rem;">Hiệu suất: ${shift.Performance.toFixed(1)}%</span>
                            </div>

                            <div class="shift-actions">
                                <button class="btn-shift-action" onclick="sendAlert(${shift.ShiftId}, 'performance')">
                                    <i class="fas fa-bell me-1"></i>Gửi cảnh báo
                                </button>
                                <button class="btn-shift-action" onclick="viewShiftDetails(${shift.ShiftId})">
                                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                                </button>
                            </div>
                        </div>
                    `;
                });
            }

            grid.innerHTML = html;
        }

        function updateSummaryCards() {
            const totalShifts = shiftsData.length;
            const totalRevenue = shiftsData.reduce((sum, shift) => sum + shift.Revenue, 0);
            const totalOrders = shiftsData.reduce((sum, shift) => sum + shift.OrdersCount, 0);
            const avgPerformance = totalShifts > 0 ? 
                shiftsData.reduce((sum, shift) => sum + shift.Performance, 0) / totalShifts : 0;

            document.getElementById('totalActiveShifts').textContent = totalShifts;
            document.getElementById('totalRevenueToday').textContent = formatCurrency(totalRevenue);
            document.getElementById('totalOrdersToday').textContent = totalOrders.toLocaleString();
            document.getElementById('avgPerformance').textContent = avgPerformance.toFixed(1) + '%';
        }

        function checkForAlerts() {
            alertsData = [];

            // Check performance alerts
            shiftsData.forEach(shift => {
                if (shift.Performance < 50) {
                    alertsData.push({
                        type: 'performance',
                        shiftId: shift.ShiftId,
                        message: `Thu ngân ${shift.CashierName} có hiệu suất thấp (${shift.Performance.toFixed(1)}%)`,
                        severity: 'high'
                    });
                }

                // Check revenue alerts
                if (shift.Revenue < 500000 && shift.Duration.includes('h')) {
                    const hours = parseInt(shift.Duration.split('h')[0]);
                    if (hours > 2) {
                        alertsData.push({
                            type: 'revenue',
                            shiftId: shift.ShiftId,
                            message: `Thu ngân ${shift.CashierName} doanh thu thấp trong ${hours}h (${formatCurrency(shift.Revenue)})`,
                            severity: 'medium'
                        });
                    }
                }

                // Check order frequency alerts
                if (shift.LastOrderTime === 'Chưa có đơn') {
                    alertsData.push({
                        type: 'orders',
                        shiftId: shift.ShiftId,
                        message: `Thu ngân ${shift.CashierName} chưa có đơn hàng nào`,
                        severity: 'low'
                    });
                }
            });

            updateAlertsDisplay();
        }

        function updateAlertsDisplay() {
            const alertPanel = document.getElementById('alertPanel');
            const alertList = document.getElementById('alertList');

            if (alertsData.length === 0) {
                alertPanel.style.display = 'none';
                return;
            }

            alertPanel.style.display = 'block';
            let html = '';

            alertsData.forEach((alert, index) => {
                const severityColor = {
                    'high': '#e74c3c',
                    'medium': '#f39c12',
                    'low': '#95a5a6'
                }[alert.severity];

                html += `
                    <div class="alert-item">
                        <div>
                            <i class="fas fa-exclamation-triangle me-2" style="color: ${severityColor};"></i>
                            ${alert.message}
                        </div>
                        <button class="btn btn-sm btn-outline-light" onclick="resolveAlert(${index})">
                            <i class="fas fa-check"></i>
                        </button>
                    </div>
                `;
            });

            alertList.innerHTML = html;
        }

        function getPerformanceClass(performance) {
            if (performance >= 80) return 'excellent';
            if (performance >= 60) return 'good';
            return 'poor';
        }

        function sendAlert(shiftId, alertType) {
            const shift = shiftsData.find(s => s.ShiftId === shiftId);
            if (!shift) return;

            let message = '';
            switch(alertType) {
                case 'performance':
                    message = `Hiệu suất hiện tại: ${shift.Performance.toFixed(1)}%. Vui lòng cải thiện tốc độ phục vụ.`;
                    break;
                case 'revenue':
                    message = `Doanh thu hiện tại: ${formatCurrency(shift.Revenue)}. Cần tăng cường bán hàng.`;
                    break;
                default:
                    message = 'Thông báo từ quản lý ca làm việc.';
            }

            // Gửi alert đến API
            fetch('@Url.Action("SendCashierAlert", "ReportsManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `shiftId=${shiftId}&alertType=${alertType}&message=${encodeURIComponent(message)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccess(`Đã gửi cảnh báo đến ${shift.CashierName}`);
                } else {
                    showError('Lỗi khi gửi cảnh báo: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showError('Lỗi kết nối khi gửi cảnh báo!');
            });
        }

        function viewShiftDetails(shiftId) {
            window.open('@Url.Action("ShiftDetails", "Cashier")?shiftId=' + shiftId, '_blank');
        }

        function resolveAlert(alertIndex) {
            alertsData.splice(alertIndex, 1);
            updateAlertsDisplay();
        }

        function updateLastUpdateTime() {
            document.getElementById('lastUpdate').textContent = 
                'Cập nhật: ' + new Date().toLocaleTimeString('vi-VN');
        }

        function startAutoRefresh() {
            refreshInterval = setInterval(() => {
                loadActiveShifts();
            }, 10000); // Refresh every 10 seconds
        }

        function formatCurrency(amount) {
            return Math.round(amount).toLocaleString('vi-VN') + ' VNĐ';
        }

        function showSuccess(message) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = 'success-message';
            toast.style.cssText = `
                position: fixed; top: 20px; right: 20px; z-index: 9999;
                background: rgba(46, 204, 113, 0.2); color: #2ecc71;
                border: 1px solid rgba(46, 204, 113, 0.5);
                padding: 15px 20px; border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            `;
            toast.innerHTML = `<i class="fas fa-check me-2"></i>${message}`;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                document.body.removeChild(toast);
            }, 3000);
        }

        function showError(message) {
            const toast = document.createElement('div');
            toast.className = 'error-message';
            toast.style.cssText = `
                position: fixed; top: 20px; right: 20px; z-index: 9999;
                background: rgba(231, 76, 60, 0.2); color: #e74c3c;
                border: 1px solid rgba(231, 76, 60, 0.5);
                padding: 15px 20px; border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            `;
            toast.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i>${message}`;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                document.body.removeChild(toast);
            }, 5000);
        }

        // Clean up on page unload
        window.addEventListener('beforeunload', function() {
            if (refreshInterval) {
                clearInterval(refreshInterval);
            }
        });
    </script>
}