@{
    ViewBag.Title = "Trang Chủ Quản Lý Nhà Hàng";
}
<style>
    body {
        background-color: #000; 
        color: #fff; 
    }
    .hero-background {
        height: 70vh;
        background-image: url('/images/ảnh nhà hàng.jpg');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #000;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    }
        .hero-background::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.3);
            z-index: 1;
            border-radius: 8px;
        }
        .hero-content {
            position: relative;
            z-index: 2;
            padding: 20px;
        }
        .hero-content h1 {
            color: #ffcc00;
            font-size: 3.5rem;
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
        }

        .hero-content p {
            font-size: 1.5rem;
            margin-bottom: 30px;
            text-shadow: 1px 1px 3px #000;
        }
</style>
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="hero-background position-relative">
            <div class="hero-content">
                <h1 class="display-4 mb-3">Chào Mừng Đến Với Nhà Hàng LDP</h1>
                <p class="lead">Quản lý nhà hàng của bạn một cách hiệu quả và dễ dàng.</p>
            </div>
        </div>
    </div>
</div>
