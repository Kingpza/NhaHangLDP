@{
    ViewBag.Title = "Đặt Bàn - Nhà Hàng LLP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#007bff",
                        "background": "#ffffff",
                        "sidebar-surface": "#f0f2f5",
                        "text-secondary": "#6c757d",
                        "text-primary": "#212529",
                        "border-light": "#e0e0e0",
                        "hover-light": "#e9ecef"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                },
            },
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f0f2f5;
        }
        ::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #007bff;
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .animate-fadeInUp {
            animation: fadeInUp 0.8s ease-out forwards;
        }
        
        .hero-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .form-card {
            transition: all 0.3s ease;
        }
        
        .form-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .time-slot {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .time-slot:hover {
            transform: scale(1.05);
        }

        .time-slot.selected {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .party-size-btn {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .party-size-btn:hover {
            transform: scale(1.1);
        }

        .party-size-btn.selected {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
        }

        .success-animation {
            animation: bounceIn 0.6s ease-out;
        }

        @@keyframes bounceIn {
            0% { transform: scale(0); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .loading-spinner {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 3px solid white;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Custom SweetAlert2 Styling */
        .swal2-popup {
            font-family: 'Manrope', sans-serif !important;
            border-radius: 2rem !important;
        }

        .swal2-title {
            font-weight: 800 !important;
            color: #212529 !important;
        }

        .swal2-html-container {
            color: #6c757d !important;
        }

        .swal2-confirm {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            border-radius: 9999px !important;
            padding: 12px 30px !important;
            font-weight: 600 !important;
        }

        .swal2-cancel {
            background: #e9ecef !important;
            color: #212529 !important;
            border-radius: 9999px !important;
            padding: 12px 30px !important;
            font-weight: 600 !important;
        }

        .swal2-icon {
            border-width: 3px !important;
        }
    </style>
</head>
<body class="bg-background font-display text-text-primary">
    
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-border-light bg-background/95 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-2xl">restaurant</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-black text-text-primary">NHÀ HÀNG LLP</h1>
                        <p class="text-xs text-text-secondary">Fine Dining Experience</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center gap-6">
                    <a href="@Url.Action("Index", "Home")" class="text-text-primary hover:text-primary transition-colors">Trang chủ</a>
                    <a href="@Url.Action("Menu", "Public")" class="text-text-primary hover:text-primary transition-colors">Thực đơn</a>
                    <a href="@Url.Action("Booking", "Home")" class="text-primary font-semibold border-b-2 border-primary pb-1">Đặt bàn</a>
                    <a href="@Url.Action("Index", "Home")#contact" class="text-text-primary hover:text-primary transition-colors">Liên hệ</a>
                </div>
                <div class="flex items-center gap-3">
                    <a href="@Url.Action("Login", "Account")" class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all font-semibold">
                        <span class="material-symbols-outlined text-lg">login</span>
                        Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 hero-gradient"></div>
        <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('@Url.Content("~/images/ảnh nhà hàng.jpg")')"></div>
        <div class="absolute inset-0 bg-black/30"></div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
            <div class="animate-fadeInUp">
                <span class="inline-block px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm font-bold rounded-full mb-6">
                    🍽️ Đặt bàn trước - Nhận ngay ưu đãi
                </span>
                <h1 class="text-5xl md:text-7xl font-black text-white mb-6 leading-tight">
                    Đặt Bàn Ngay<br/>
                    <span class="text-yellow-300">Trải Nghiệm Tuyệt Vời</span>
                </h1>
                <p class="text-xl md:text-2xl text-white/90 mb-12 max-w-3xl mx-auto">
                    Đảm bảo chỗ ngồi tốt nhất cho bữa ăn đặc biệt của bạn tại Nhà Hàng LLP
                </p>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
            <span class="material-symbols-outlined text-white text-4xl">expand_more</span>
        </div>
    </section>

    <!-- Booking Form Section -->
    <section class="py-20 bg-sidebar-surface">
        <div class="max-w-4xl mx-auto px-6">
            <div class="text-center mb-12">
                <span class="text-primary font-bold text-sm uppercase tracking-wider">Đặt bàn dễ dàng</span>
                <h2 class="text-4xl md:text-5xl font-black text-text-primary mt-4 mb-6">
                    Điền Thông Tin <span class="text-primary">Đặt Bàn</span>
                </h2>
                <p class="text-text-secondary text-lg max-w-2xl mx-auto">
                    Chỉ cần 3 bước đơn giản để đặt bàn và trải nghiệm dịch vụ tuyệt vời
                </p>
            </div>
            
            <div class="form-card bg-white rounded-[2rem] p-8 md:p-12 shadow-xl border border-border-light">
                <form id="bookingForm">
                    <!-- Step 1: Thông tin cá nhân -->
                    <div class="booking-step" id="step1">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">1</span>
                            Thông tin liên hệ
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Họ và tên *</label>
                                <input type="text" id="customerName" name="customerName" required
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors"
                                       placeholder="Nguyễn Văn A">
                            </div>
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Số điện thoại *</label>
                                <input type="tel" id="customerPhone" name="customerPhone" required
                                       pattern="[0-9]{10}"
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors"
                                       placeholder="0901234567">
                            </div>
                        </div>

                        <div class="mb-6">
                            <label class="block text-text-primary font-semibold mb-2">Email (tùy chọn)</label>
                            <input type="email" id="customerEmail" name="customerEmail"
                                   class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors"
                                   placeholder="email@example.com">
                        </div>

                        <button type="button" onclick="nextStep(2)" 
                                class="w-full py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-[#0056b3] transition-all shadow-lg flex items-center justify-center gap-2">
                            Tiếp theo
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>

                    <!-- Step 2: Chọn ngày giờ và số người -->
                    <div class="booking-step hidden" id="step2">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">2</span>
                            Chọn thời gian và số người
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Ngày đặt bàn *</label>
                                <input type="date" id="bookingDate" name="bookingDate" required
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors">
                            </div>
                            <div>
                                <label class="block text-text-primary font-semibold mb-2">Giờ đặt bàn *</label>
                                <select id="bookingTime" name="bookingTime" required
                                        class="w-full px-6 py-4 rounded-full border-2 border-border-light focus:border-primary focus:outline-none transition-colors">
                                    <option value="">-- Chọn giờ --</option>
                                    <option value="11:00">11:00</option>
                                    <option value="11:30">11:30</option>
                                    <option value="12:00">12:00</option>
                                    <option value="12:30">12:30</option>
                                    <option value="13:00">13:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="17:30">17:30</option>
                                    <option value="18:00">18:00</option>
                                    <option value="18:30">18:30</option>
                                    <option value="19:00">19:00</option>
                                    <option value="19:30">19:30</option>
                                    <option value="20:00">20:00</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-6">
                            <label class="block text-text-primary font-semibold mb-3">Số lượng khách *</label>
                            <div class="grid grid-cols-4 md:grid-cols-8 gap-3">
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(1)">1</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(2)">2</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(3)">3</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(4)">4</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(5)">5</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(6)">6</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(7)">7</button>
                                <button type="button" class="party-size-btn px-4 py-3 border-2 border-border-light rounded-lg font-bold hover:border-primary transition-all" 
                                        onclick="selectPartySize(8)">8+</button>
                            </div>
                            <input type="hidden" id="numberOfGuests" name="numberOfGuests" required>
                        </div>

                        <div class="flex gap-4">
                            <button type="button" onclick="prevStep(1)" 
                                    class="flex-1 py-4 bg-gray-200 text-text-primary rounded-full font-bold text-lg hover:bg-gray-300 transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">arrow_back</span>
                                Quay lại
                            </button>
                            <button type="button" onclick="nextStep(3)" 
                                    class="flex-1 py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-[#0056b3] transition-all shadow-lg flex items-center justify-center gap-2">
                                Tiếp theo
                                <span class="material-symbols-outlined">arrow_forward</span>
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Ghi chú và xác nhận -->
                    <div class="booking-step hidden" id="step3">
                        <h3 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-3">
                            <span class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center">3</span>
                            Ghi chú và xác nhận
                        </h3>
                        
                        <div class="mb-6">
                            <label class="block text-text-primary font-semibold mb-2">Yêu cầu đặc biệt (tùy chọn)</label>
                            <textarea id="notes" name="notes" rows="4"
                                      class="w-full px-6 py-4 rounded-[1.5rem] border-2 border-border-light focus:border-primary focus:outline-none transition-colors resize-none"
                                      placeholder="Ví dụ: Khu vực yên tĩnh, ghế cao cho trẻ em, dị ứng thực phẩm..."></textarea>
                        </div>

                        <!-- Summary -->
                        <div class="bg-sidebar-surface rounded-[1.5rem] p-6 mb-6">
                            <h4 class="font-bold text-text-primary mb-4">Thông tin đặt bàn</h4>
                            <div class="space-y-3 text-text-secondary">
                                <div class="flex justify-between">
                                    <span>Tên khách hàng:</span>
                                    <strong id="summaryName" class="text-text-primary">-</strong>
                                </div>
                                <div class="flex justify-between">
                                    <span>Số điện thoại:</span>
                                    <strong id="summaryPhone" class="text-text-primary">-</strong>
                                </div>
                                <div class="flex justify-between">
                                    <span>Ngày giờ:</span>
                                    <strong id="summaryDateTime" class="text-text-primary">-</strong>
                                </div>
                                <div class="flex justify-between">
                                    <span>Số lượng khách:</span>
                                    <strong id="summaryGuests" class="text-text-primary">-</strong>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <button type="button" onclick="prevStep(2)" 
                                    class="flex-1 py-4 bg-gray-200 text-text-primary rounded-full font-bold text-lg hover:bg-gray-300 transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">arrow_back</span>
                                Quay lại
                            </button>
                            <button type="submit" id="submitBtn"
                                    class="flex-1 py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-[#0056b3] transition-all shadow-lg flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">check_circle</span>
                                Xác nhận đặt bàn
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Success Modal -->
    <div id="successModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-6">
        <div class="bg-white rounded-[2rem] p-8 md:p-12 max-w-md w-full text-center success-animation">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-green-500 text-4xl">check_circle</span>
            </div>
            <h3 class="text-3xl font-black text-text-primary mb-4">Đặt bàn thành công!</h3>
            <p class="text-text-secondary mb-2">Cảm ơn bạn đã đặt bàn tại Nhà Hàng LLP</p>
            <p class="text-text-secondary mb-6">Chúng tôi sẽ liên hệ với bạn để xác nhận trong thời gian sớm nhất.</p>
            <div class="bg-sidebar-surface rounded-xl p-4 mb-6 text-left">
                <p class="text-sm text-text-secondary mb-2">Mã đặt bàn của bạn:</p>
                <p class="text-2xl font-bold text-primary" id="bookingCode">-</p>
            </div>
            <div class="flex gap-3">
                <a href="@Url.Action("Index", "Home")" class="flex-1 py-3 bg-gray-200 text-text-primary rounded-full font-bold hover:bg-gray-300 transition-all">
                    Về trang chủ
                </a>
                <button onclick="closeSuccessModal()" class="flex-1 py-3 bg-primary text-white rounded-full font-bold hover:bg-[#0056b3] transition-all">
                    Đặt bàn mới
                </button>
            </div>
        </div>
    </div>

    <!-- Loading Modal -->
    <div id="loadingModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center">
        <div class="bg-white rounded-[2rem] p-12 text-center">
            <div class="loading-spinner mx-auto mb-6"></div>
            <p class="text-text-primary font-semibold">Đang xử lý đặt bàn...</p>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-text-primary text-white py-12">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <div class="flex items-center justify-center gap-3 mb-4">
                <div class="h-12 w-12 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-white text-2xl">restaurant</span>
                </div>
                <div>
                    <h3 class="text-xl font-black">NHÀ HÀNG LLP</h3>
                    <p class="text-xs text-white/70">Fine Dining</p>
                </div>
            </div>
            <p class="text-white/70 text-sm mb-4">
                123 Đường Lê Lợi, Quận 1, TP. Hồ Chí Minh | 028 1234 5678
            </p>
            <div class="border-t border-white/10 pt-6">
                <p class="text-white/70 text-sm">© 2024 Nhà Hàng LLP. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        let currentStep = 1;
        let selectedPartySize = 0;

        function nextStep(step) {
            // Validate current step
            if (step === 2) {
                const name = document.getElementById('customerName').value.trim();
                const phone = document.getElementById('customerPhone').value.trim();
                
                if (!name) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Vui lòng nhập họ tên!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                if (!phone || phone.length !== 10) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Số điện thoại không hợp lệ',
                        text: 'Vui lòng nhập số điện thoại hợp lệ (10 số)!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
            }
            
            if (step === 3) {
                const date = document.getElementById('bookingDate').value;
                const time = document.getElementById('bookingTime').value;
                
                if (!date) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Vui lòng chọn ngày đặt bàn!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                if (!time) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Vui lòng chọn giờ đặt bàn!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                if (selectedPartySize === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Vui lòng chọn số lượng khách!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                
                // Update summary
                updateSummary();
            }

            // Hide current step
            document.getElementById('step' + currentStep).classList.add('hidden');
            
            // Show next step
            currentStep = step;
            document.getElementById('step' + currentStep).classList.remove('hidden');
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function prevStep(step) {
            document.getElementById('step' + currentStep).classList.add('hidden');
            currentStep = step;
            document.getElementById('step' + currentStep).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function selectPartySize(size) {
            selectedPartySize = size;
            document.getElementById('numberOfGuests').value = size;
            
            // Update UI
            document.querySelectorAll('.party-size-btn').forEach(btn => {
                btn.classList.remove('selected');
            });
            event.target.classList.add('selected');
        }

        function updateSummary() {
            const name = document.getElementById('customerName').value;
            const phone = document.getElementById('customerPhone').value;
            const date = document.getElementById('bookingDate').value;
            const time = document.getElementById('bookingTime').value;
            const guests = selectedPartySize;

            document.getElementById('summaryName').textContent = name;
            document.getElementById('summaryPhone').textContent = phone;
            document.getElementById('summaryDateTime').textContent = formatDate(date) + ' lúc ' + time;
            document.getElementById('summaryGuests').textContent = guests + ' người';
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            const day = date.getDate().toString().padStart(2, '0');
            const month = (date.getMonth() + 1).toString().padStart(2, '0');
            const year = date.getFullYear();
            return day + '/' + month + '/' + year;
        }

        // Form submission
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Show loading with SweetAlert2
            Swal.fire({
                title: 'Đang xử lý đặt bàn...',
                html: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            const formData = {
                customerName: document.getElementById('customerName').value,
                customerPhone: document.getElementById('customerPhone').value,
                customerEmail: document.getElementById('customerEmail').value,
                bookingDate: document.getElementById('bookingDate').value,
                bookingTime: document.getElementById('bookingTime').value,
                numberOfGuests: selectedPartySize,
                notes: document.getElementById('notes').value
            };

            // Submit to server
            $.ajax({
                url: '@Url.Action("CreateBooking", "Home")',
                type: 'POST',
                data: formData,
                success: function(response) {
                    Swal.close();
                    
                    if (response.success) {
                        // Show success modal
                        document.getElementById('bookingCode').textContent = response.bookingCode || 'B' + Date.now();
                        document.getElementById('successModal').classList.remove('hidden');
                        
                        // Also show SweetAlert success
                        Swal.fire({
                            icon: 'success',
                            title: 'Đặt bàn thành công!',
                            html: `
                                <p>Cảm ơn bạn đã đặt bàn tại Nhà Hàng LLP</p>
                                <p class="mt-2">Mã đặt bàn: <strong class="text-primary">${response.bookingCode}</strong></p>
                            `,
                            confirmButtonText: 'Tuyệt vời!',
                            confirmButtonColor: '#667eea',
                            timer: 5000,
                            timerProgressBar: true
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Có lỗi xảy ra',
                            text: response.message || 'Vui lòng thử lại!',
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#667eea'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối',
                        text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau!',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#667eea'
                    });
                }
            });
        });

        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
            // Reset form
            document.getElementById('bookingForm').reset();
            selectedPartySize = 0;
            currentStep = 1;
            document.querySelectorAll('.booking-step').forEach(step => step.classList.add('hidden'));
            document.getElementById('step1').classList.remove('hidden');
            document.querySelectorAll('.party-size-btn').forEach(btn => btn.classList.remove('selected'));
        }

        // Set minimum date to today
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('bookingDate').setAttribute('min', today);
        
        // Show welcome message when page loads
        window.addEventListener('load', function() {
            Swal.fire({
                title: 'Chào mừng đến với LLP!',
                text: 'Hãy điền thông tin để đặt bàn cho bữa ăn tuyệt vời của bạn',
                icon: 'info',
                confirmButtonText: 'Bắt đầu đặt bàn',
                confirmButtonColor: '#667eea',
                timer: 3000,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
        });
    </script>
</body>
</html>