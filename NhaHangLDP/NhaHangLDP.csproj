<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyTitle>NhaHangLDP</AssemblyTitle>
    <Product>NhaHangLDP</Product>
    <Copyright>Copyright © 2025</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Entity Framework 6 for EDMX support -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    
    <!-- ASP.NET Core compatibility -->
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.2.1" />
    
    <!-- JSON handling -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    
    <!-- Configuration support -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.1" />
  </ItemGroup>
  
  <!-- EF6 EDMX file configuration -->
  <ItemGroup>
    <Compile Update="Models\NhaHangLDP.Context.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NhaHangLDP.Context.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\NhaHangLDP.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NhaHangLDP.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\NhaHangLDP.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NhaHangLDP.edmx</DependentUpon>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Models\NhaHangLDP.Context.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>NhaHangLDP.edmx</DependentUpon>
      <LastGenOutput>NhaHangLDP.Context.cs</LastGenOutput>
    </Content>
    <Content Include="Models\NhaHangLDP.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>NhaHangLDP.edmx</DependentUpon>
      <LastGenOutput>NhaHangLDP.cs</LastGenOutput>
    </Content>
    <EntityDeploy Include="Models\NhaHangLDP.edmx">
      <Generator>EntityModelCodeGenerator</Generator>
      <LastGenOutput>NhaHangLDP.Designer.cs</LastGenOutput>
    </EntityDeploy>
  </ItemGroup>
  
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
